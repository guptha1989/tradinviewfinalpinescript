    table.cell(sr_table, 1, 2, str.tostring(r5_val, "#.##") + " (" + str.tostring(final_strike + r5_val, "#.##") + ")", bgcolor=#131722, text_color=r_color, text_size=t_size, text_halign=text.align_center)

    table.cell(sr_table, 0, 3, "Resistance 4 (R4)", bgcolor=#1C2030, text_color=r_color, text_size=t_size, text_halign=text.align_left)
    table.cell(sr_table, 1, 3, str.tostring(r4_val, "#.##") + " (" + str.tostring(final_strike + r4_val, "#.##") + ")", bgcolor=#1C2030, text_color=r_color, text_size=t_size, text_halign=text.align_center)
    
    table.cell(sr_table, 0, 4, "Resistance 3 (R3)", bgcolor=#131722, text_color=r_color, text_size=t_size, text_halign=text.align_left)
    table.cell(sr_table, 1, 4, str.tostring(r3_val, "#.##") + " (" + str.tostring(final_strike + r3_val, "#.##") + ")", bgcolor=#131722, text_color=r_color, text_size=t_size, text_halign=text.align_center)
    
    table.cell(sr_table, 0, 5, "Resistance 2 (R2)", bgcolor=#1C2030, text_color=r_color, text_size=t_size, text_halign=text.align_left)
    table.cell(sr_table, 1, 5, str.tostring(r2_val, "#.##") + " (" + str.tostring(final_strike + r2_val, "#.##") + ")", bgcolor=#1C2030, text_color=r_color, text_size=t_size, text_halign=text.align_center)
    
    table.cell(sr_table, 0, 6, "Resistance 1 (R1)", bgcolor=#131722, text_color=r_color, text_size=t_size, text_halign=text.align_left)
    table.cell(sr_table, 1, 6, str.tostring(r1_val, "#.##") + " (" + str.tostring(Spot_R1, "#.##") + ")", bgcolor=#131722, text_color=r_color, text_size=t_size, text_halign=text.align_center)
    
    table.cell(sr_table, 0, 7, "Pivot / BEP", bgcolor=#2962FF, text_color=color.white, text_size=t_size, text_halign=text.align_left)
    table.cell(sr_table, 1, 7, str.tostring(pivot_val, "#.##") + " (" + str.tostring(pivot_target, "#.##") + ")", bgcolor=#2962FF, text_color=color.white, text_size=t_size, text_halign=text.align_center)
    
    table.cell(sr_table, 0, 8, "Support 1 (S1)", bgcolor=#131722, text_color=s_color, text_size=t_size, text_halign=text.align_left)
    table.cell(sr_table, 1, 8, str.tostring(s1_val, "#.##") + " (" + str.tostring(Spot_S1, "#.##") + ")", bgcolor=#131722, text_color=s_color, text_size=t_size, text_halign=text.align_center)
    
    table.cell(sr_table, 0, 9, "Support 2 (S2)", bgcolor=#1C2030, text_color=s_color, text_size=t_size, text_halign=text.align_left)
    table.cell(sr_table, 1, 9, str.tostring(s2_val, "#.##") + " (" + str.tostring(final_strike - s2_val, "#.##") + ")", bgcolor=#1C2030, text_color=s_color, text_size=t_size, text_halign=text.align_center)
    
    table.cell(sr_table, 0, 10, "Support 3 (S3)", bgcolor=#131722, text_color=s_color, text_size=t_size, text_halign=text.align_left)
    table.cell(sr_table, 1, 10, str.tostring(s3_val, "#.##") + " (" + str.tostring(final_strike - s3_val, "#.##") + ")", bgcolor=#131722, text_color=s_color, text_size=t_size, text_halign=text.align_center)
    
    table.cell(sr_table, 0, 11, "Support 4 (S4)", bgcolor=#1C2030, text_color=s_color, text_size=t_size, text_halign=text.align_left)
    table.cell(sr_table, 1, 11, str.tostring(s4_val, "#.##") + " (" + str.tostring(final_strike - s4_val, "#.##") + ")", bgcolor=#1C2030, text_color=s_color, text_size=t_size, text_halign=text.align_center)

    table.cell(sr_table, 0, 12, "Support 5 (S5)", bgcolor=#131722, text_color=s_color, text_size=t_size, text_halign=text.align_left)
    table.cell(sr_table, 1, 12, str.tostring(s5_val, "#.##") + " (" + str.tostring(final_strike - s5_val, "#.##") + ")", bgcolor=#131722, text_color=s_color, text_size=t_size, text_halign=text.align_center)

// REAL-TIME S/R LEVEL LABELS FOR EASY TROUBLESHOOTING
var label lbl_p = na
var label lbl_r1 = na, var label lbl_r2 = na, var label lbl_r3 = na, var label lbl_r4 = na, var label lbl_r5 = na
var label lbl_s1 = na, var label lbl_s2 = na, var label lbl_s3 = na, var label lbl_s4 = na, var label lbl_s5 = na

var label lbl_ce_int = na, var label lbl_pe_int = na, var label lbl_avg_int = na
var label lbl_ce_ext = na, var label lbl_pe_ext = na, var label lbl_avg_ext = na

var label lbl_orb_h = na, var label lbl_orb_l = na
var label lbl_running_bep = na

var label lbl_ce_vwap = na, var label lbl_pe_vwap = na

if barstate.islast
    if show_sr_plots
        label.delete(lbl_p)
        label.delete(lbl_r1), label.delete(lbl_r2), label.delete(lbl_r3), label.delete(lbl_r4), label.delete(lbl_r5)
        label.delete(lbl_s1), label.delete(lbl_s2), label.delete(lbl_s3), label.delete(lbl_s4), label.delete(lbl_s5)
        
        int label_x = bar_index + 5
        lbl_p  := label.new(label_x, p_plot,  "Pivot: " + str.tostring(p_plot, "#.##") + f_get_vol_suffix(5, 5) + f_get_pivot_probability(),  color=color.yellow, textcolor=color.black, style=label.style_label_left, size=size.small)
        lbl_r1 := label.new(label_x, r1_plot, "R1: " + str.tostring(r1_plot, "#.##") + f_get_vol_suffix(5, 5) + f_get_sr_probability(5, 5, true), color=color.new(color.red, 30), textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_r2 := label.new(label_x, r2_plot, "R2: " + str.tostring(r2_plot, "#.##") + f_get_vol_suffix(4, 6) + f_get_sr_probability(4, 6, true), color=color.new(color.red, 40), textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_r3 := label.new(label_x, r3_plot, "R3: " + str.tostring(r3_plot, "#.##") + f_get_vol_suffix(3, 7) + f_get_sr_probability(3, 7, true), color=color.new(color.red, 50), textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_r4 := label.new(label_x, r4_plot, "R4: " + str.tostring(r4_plot, "#.##") + f_get_vol_suffix(2, 8) + f_get_sr_probability(2, 8, true), color=color.new(color.red, 60), textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_r5 := label.new(label_x, r5_plot, "R5: " + str.tostring(r5_plot, "#.##") + f_get_vol_suffix(1, 9) + f_get_sr_probability(1, 9, true), color=color.new(color.red, 70), textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_s1 := label.new(label_x, s1_plot, "S1: " + str.tostring(s1_plot, "#.##") + f_get_vol_suffix(5, 5) + f_get_sr_probability(5, 5, false), color=color.new(color.green, 30), textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_s2 := label.new(label_x, s2_plot, "S2: " + str.tostring(s2_plot, "#.##") + f_get_vol_suffix(6, 4) + f_get_sr_probability(6, 4, false), color=color.new(color.green, 40), textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_s3 := label.new(label_x, s3_plot, "S3: " + str.tostring(s3_plot, "#.##") + f_get_vol_suffix(7, 3) + f_get_sr_probability(7, 3, false), color=color.new(color.green, 50), textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_s4 := label.new(label_x, s4_plot, "S4: " + str.tostring(s4_plot, "#.##") + f_get_vol_suffix(8, 2) + f_get_sr_probability(8, 2, false), color=color.new(color.green, 60), textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_s5 := label.new(label_x, s5_plot, "S5: " + str.tostring(s5_plot, "#.##") + f_get_vol_suffix(9, 1) + f_get_sr_probability(9, 1, false), color=color.new(color.green, 70), textcolor=color.white, style=label.style_label_left, size=size.small)

// Explanatory Calculation Table
var string t_pos_calc = position.bottom_left
if table_pos_calc_str == "Top Right"
    t_pos_calc := position.top_right
else if table_pos_calc_str == "Top Left"
    t_pos_calc := position.top_left
else if table_pos_calc_str == "Bottom Right"
    t_pos_calc := position.bottom_right

var table calc_box = table.new(t_pos_calc, 3, 13, bgcolor=color.new(color.black, 30), border_color=color.gray, border_width=1)
if barstate.islast and show_calc_box
    table.clear(calc_box, 0, 0, 2, 12)
    
    if show_calc_details
        table.cell(calc_box, 0, 0, "Metric / Level", text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 1, 0, "Chosen Strike", text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 0, "Option Base (" + calc_basis + ")", text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
        
        table.cell(calc_box, 0, 1, "ATM Strike (Basis Locked)", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 1, str.tostring(atm_strike_base), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 1, "CE:" + str.tostring(ce_atm_base, "#.##") + " | PE:" + str.tostring(pe_atm_base, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        
        string synth_diff_str = (ce_atm_base >= pe_atm_base) ? ("+ (" + str.tostring(ce_atm_base - pe_atm_base, "#.##") + ")") : ("- (" + str.tostring(pe_atm_base - ce_atm_base, "#.##") + ")")
        table.cell(calc_box, 0, 2, "Synthetic Future (Pivot)", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 2, str.tostring(atm_strike_base) + " (ATM)", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 2, "CE-PE Diff: " + synth_diff_str, text_color=color.white, text_size=t_size, text_halign=text.align_center)
        
        table.cell(calc_box, 0, 3, "Resistance 1 (R1)", text_color=#EF5350, text_size=t_size)
        table.cell(calc_box, 1, 3, str.tostring(atm_strike_base) + " CE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 3, str.tostring(ce_atm_base, "#.##"), text_color=#EF5350, text_size=t_size, text_halign=text.align_center)
        
        table.cell(calc_box, 0, 4, "Resistance 2 (R2)", text_color=#EF5350, text_size=t_size)
        table.cell(calc_box, 1, 4, str.tostring(atm_strike_base + 1 * strike_step) + " CE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 4, str.tostring(r1_ce_base, "#.##"), text_color=#EF5350, text_size=t_size, text_halign=text.align_center)
        
        table.cell(calc_box, 0, 5, "Resistance 3 (R3)", text_color=#EF5350, text_size=t_size)
        table.cell(calc_box, 1, 5, str.tostring(atm_strike_base + 2 * strike_step) + " CE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 5, str.tostring(r2_ce_base, "#.##"), text_color=#EF5350, text_size=t_size, text_halign=text.align_center)
        
        table.cell(calc_box, 0, 6, "Resistance 4 (R4)", text_color=#EF5350, text_size=t_size)
        table.cell(calc_box, 1, 6, str.tostring(atm_strike_base + 3 * strike_step) + " CE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 6, str.tostring(r3_ce_base, "#.##"), text_color=#EF5350, text_size=t_size, text_halign=text.align_center)
        
        table.cell(calc_box, 0, 7, "Resistance 5 (R5)", text_color=#EF5350, text_size=t_size)
        table.cell(calc_box, 1, 7, str.tostring(atm_strike_base + 4 * strike_step) + " CE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 7, str.tostring(r4_ce_base, "#.##"), text_color=#EF5350, text_size=t_size, text_halign=text.align_center)

        table.cell(calc_box, 0, 8, "Support 1 (S1)", text_color=#26A69A, text_size=t_size)
        table.cell(calc_box, 1, 8, str.tostring(atm_strike_base) + " PE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 8, str.tostring(pe_atm_base, "#.##"), text_color=#26A69A, text_size=t_size, text_halign=text.align_center)
        
        table.cell(calc_box, 0, 9, "Support 2 (S2)", text_color=#26A69A, text_size=t_size)
        table.cell(calc_box, 1, 9, str.tostring(atm_strike_base - 1 * strike_step) + " PE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 9, str.tostring(s1_pe_base, "#.##"), text_color=#26A69A, text_size=t_size, text_halign=text.align_center)
        
        table.cell(calc_box, 0, 10, "Support 3 (S3)", text_color=#26A69A, text_size=t_size)
        table.cell(calc_box, 1, 10, str.tostring(atm_strike_base - 2 * strike_step) + " PE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 10, str.tostring(s2_pe_base, "#.##"), text_color=#26A69A, text_size=t_size, text_halign=text.align_center)
        
        table.cell(calc_box, 0, 11, "Support 4 (S4)", text_color=#26A69A, text_size=t_size)
        table.cell(calc_box, 1, 11, str.tostring(atm_strike_base - 3 * strike_step) + " PE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 11, str.tostring(s3_pe_base, "#.##"), text_color=#26A69A, text_size=t_size, text_halign=text.align_center)

        table.cell(calc_box, 0, 12, "Support 5 (S5)", text_color=#26A69A, text_size=t_size)
        table.cell(calc_box, 1, 12, str.tostring(atm_strike_base - 4 * strike_step) + " PE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 12, str.tostring(s4_pe_base, "#.##"), text_color=#26A69A, text_size=t_size, text_halign=text.align_center)

// Selected Strikes Summary Table (ORB & PDH/PDL)
var string t_pos_sel = position.bottom_right
if table_pos_sel_str == "Top Left"
    t_pos_sel := position.top_left
else if table_pos_sel_str == "Top Right"
    t_pos_sel := position.top_right
else if table_pos_sel_str == "Bottom Left"
    t_pos_sel := position.bottom_left

var table sel_table = table.new(t_pos_sel, 3, 3, bgcolor=color.new(color.black, 30), border_color=color.gray, border_width=1)
if barstate.islast and show_sel_table
    table.clear(sel_table, 0, 0, 2, 2)
    
    // Header
    table.cell(sel_table, 0, 0, "Feature", bgcolor=#1E222D, text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
    table.cell(sel_table, 1, 0, "Strike / Selection Mode", bgcolor=#1E222D, text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
    table.cell(sel_table, 2, 0, "Contract Symbol", bgcolor=#1E222D, text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
    
    // ORB Details
    string orb_details_str = orb_strike_mode + " (" + str.tostring(orb_strike) + " " + orb_opt_type + ")"
    table.cell(sel_table, 0, 1, "ORB Range", bgcolor=#131722, text_color=#00E676, text_size=t_size, text_halign=text.align_left)
    table.cell(sel_table, 1, 1, orb_details_str, bgcolor=#131722, text_color=color.white, text_size=t_size, text_halign=text.align_center)
    table.cell(sel_table, 2, 1, orb_sym, bgcolor=#131722, text_color=color.white, text_size=t_size, text_halign=text.align_center)
    
    // PDH / PDL Details
    string pdhl_details_str = pdhl_strike_mode
    if pdhl_strike_mode == "ATM Strike"
        pdhl_details_str := pdhl_strike_mode + " (" + str.tostring(final_strike) + " " + pdhl_opt_type + ")"
    else if pdhl_strike_mode == "Manual Strike"
        pdhl_details_str := pdhl_strike_mode + " (" + str.tostring(pdhl_manual_strike) + " " + pdhl_opt_type + ")"
    else
        pdhl_details_str := "Current Chart (" + (is_option ? (str.tostring(strike_val) + " " + opt_type) : "Spot") + ")"
        
    table.cell(sel_table, 0, 2, "PDH / PDL", bgcolor=#1C2030, text_color=#FF9800, text_size=t_size, text_halign=text.align_left)
    table.cell(sel_table, 1, 2, pdhl_details_str, bgcolor=#1C2030, text_color=color.white, text_size=t_size, text_halign=text.align_center)
    table.cell(sel_table, 2, 2, pdhl_sym, bgcolor=#1C2030, text_color=color.white, text_size=t_size, text_halign=text.align_center)

// =========================================================================
// SWING REVERSALS & VOLUME ANALYTICS ENGINE (OPTION-NATIVE)
// =========================================================================
swing_tf = swing_tf_str == "Chart Timeframe" ? timeframe.period : (swing_tf_str == "1 Min" ? "1" : (swing_tf_str == "3 Min" ? "3" : (swing_tf_str == "5 Min" ? "5" : (sig_tf_str == "10 Min" ? "10" : (sig_tf_str == "15 Min" ? "15" : "30")))))
[chart_sh, chart_sl, chart_sc, chart_sv] = request.security(syminfo.tickerid, swing_tf, [high, low, close, volume])

[chart_sbuy, chart_ssell] = f_calc_buy_sell(chart_sh, chart_sl, chart_sc, chart_sv)
chart_sdelta = chart_sbuy - chart_ssell

p_high = ta.pivothigh(high, swing_len_left, swing_len_right)
p_low = ta.pivotlow(low, swing_len_left, swing_len_right)

var label manual_sh_lbl = na
var label manual_sl_lbl = na

if show_swings
    if swing_select_mode == "Automatic"
        if not na(p_high)
            float min_diff_ph = 1e9
            if not na(r1_plot) and math.abs(p_high - r1_plot) < min_diff_ph
                min_diff_ph := math.abs(p_high - r1_plot)
            if not na(r2_plot) and math.abs(p_high - r2_plot) < min_diff_ph
                min_diff_ph := math.abs(p_high - r2_plot)
            if not na(r3_plot) and math.abs(p_high - r3_plot) < min_diff_ph
                min_diff_ph := math.abs(p_high - r3_plot)
            if not na(r4_plot) and math.abs(p_high - r4_plot) < min_diff_ph
                min_diff_ph := math.abs(p_high - r4_plot)
            if not na(r5_plot) and math.abs(p_high - r5_plot) < min_diff_ph
                min_diff_ph := math.abs(p_high - r5_plot)

            float tolerance = 0.015 * close
            if min_diff_ph < tolerance
                float r = chart_sv > 0 ? (chart_sdelta / chart_sv) : 0.0
                string pred = ""
                color lbl_col = color.yellow
                if chart_sdelta < 0
                    float prob = 50.0 + 40.0 * math.abs(r)
                    pred := "Rev: " + str.tostring(prob, "#") + "%"
                    lbl_col := #FF5252
                else
                    float prob = 50.0 - 40.0 * r
                    pred := "Brk (Rev: " + str.tostring(prob, "#") + "%)"
                    lbl_col := #00E676
                    
                string label_txt = "SH | V:" + f_format_vol(chart_sv) + " | CVD:" + (chart_sdelta >= 0 ? "+" : "-") + f_format_vol(math.abs(chart_sdelta)) + " | " + pred
                label.new(bar_index - swing_len_right, high[swing_len_right], label_txt, color=color.new(lbl_col, 85), textcolor=lbl_col, style=label.style_label_down, size=size.small)

        if not na(p_low)
            float min_diff_pl = 1e9
            if not na(s1_plot) and math.abs(p_low - s1_plot) < min_diff_pl
                min_diff_pl := math.abs(p_low - s1_plot)
            if not na(s2_plot) and math.abs(p_low - s2_plot) < min_diff_pl
                min_diff_pl := math.abs(p_low - s2_plot)
            if not na(s3_plot) and math.abs(p_low - s3_plot) < min_diff_pl
                min_diff_pl := math.abs(p_low - s3_plot)
            if not na(s4_plot) and math.abs(p_low - s4_plot) < min_diff_pl
                min_diff_pl := math.abs(p_low - s4_plot)
            if not na(s5_plot) and math.abs(p_low - s5_plot) < min_diff_pl
                min_diff_pl := math.abs(p_low - s5_plot)

            float tolerance = 0.015 * close
            if min_diff_pl < tolerance
                float r = chart_sv > 0 ? (chart_sdelta / chart_sv) : 0.0
                string pred = ""
                color lbl_col = color.yellow
                if chart_sdelta >= 0
                    float prob = 50.0 + 40.0 * r
                    pred := "Rev: " + str.tostring(prob, "#") + "%"
                    lbl_col := #00E676
                else
                    float prob = 50.0 - 40.0 * math.abs(r)
                    pred := "Brk (Rev: " + str.tostring(prob, "#") + "%)"
                    lbl_col := #FF5252
                    
                string label_txt = "SL | V:" + f_format_vol(chart_sv) + " | CVD:" + (chart_sdelta >= 0 ? "+" : "-") + f_format_vol(math.abs(chart_sdelta)) + " | " + pred
                label.new(bar_index - swing_len_right, low[swing_len_right], label_txt, color=color.new(lbl_col, 85), textcolor=lbl_col, style=label.style_label_up, size=size.small)
    else
        if barstate.islast
            label.delete(manual_sh_lbl)
            label.delete(manual_sl_lbl)
            
            if manual_sh_price > 0
                float m_chart_sv = nz(chart_sv[manual_sh_bars_back])
                float m_chart_sdelta = nz(chart_sdelta[manual_sh_bars_back])
                float r = m_chart_sv > 0 ? (m_chart_sdelta / m_chart_sv) : 0.0
                string pred = ""
                color lbl_col = color.yellow
                if m_chart_sdelta < 0
                    float prob = 50.0 + 40.0 * math.abs(r)
                    pred := "Rev: " + str.tostring(prob, "#") + "%"
                    lbl_col := #FF5252
                else
                    float prob = 50.0 - 40.0 * r
                    pred := "Brk (Rev: " + str.tostring(prob, "#") + "%)"
                    lbl_col := #00E676
                string label_txt = "SH (M) | V:" + f_format_vol(m_chart_sv) + " | CVD:" + (m_chart_sdelta >= 0 ? "+" : "-") + f_format_vol(m_chart_sdelta) + " | " + pred
                manual_sh_lbl := label.new(bar_index - manual_sh_bars_back, manual_sh_price, label_txt, color=color.new(lbl_col, 85), textcolor=lbl_col, style=label.style_label_down, size=size.small)
                
            if manual_sl_price > 0
                float m_chart_sv = nz(chart_sv[manual_sl_bars_back])
                float m_chart_sdelta = nz(chart_sdelta[manual_sl_bars_back])
                float r = m_chart_sv > 0 ? (m_chart_sdelta / m_chart_sv) : 0.0
                string pred = ""
                color lbl_col = color.yellow
                if m_chart_sdelta >= 0
                    float prob = 50.0 + 40.0 * r
                    pred := "Rev: " + str.tostring(prob, "#") + "%"
                    lbl_col := #00E676
                else
                    float prob = 50.0 - 40.0 * math.abs(r)
                    pred := "Brk (Rev: " + str.tostring(prob, "#") + "%)"
                    lbl_col := #FF5252
                string label_txt = "SL (M) | V:" + f_format_vol(m_chart_sv) + " | CVD:" + (m_chart_sdelta >= 0 ? "+" : "-") + f_format_vol(m_chart_sdelta) + " | " + pred
                manual_sl_lbl := label.new(bar_index - manual_sl_bars_back, manual_sl_price, label_txt, color=color.new(lbl_col, 85), textcolor=lbl_col, style=label.style_label_up, size=size.small)
