//@version=6
indicator("Techfrost 3 Options Analysis Indicator v6 1_Extended", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500)

// =========================================================================
// INPUTS & USER SETTINGS
// =========================================================================
var string G_PARSER    = "Symbol & Strike Parsing"
var string G_CALC      = "Base Calculation Preferences"
var string G_PLOTS     = "Plot & Style Settings"
var string G_COLORS    = "Line Color & Style Settings"
var string G_DASHBOARD = "Dashboard Table Settings"

// 1. Parser & Underlying Settings
strike_step = input.int(50, "Strike Step Size", minval=1, group=G_PARSER,
  tooltip="Strike step interval. Typically 50 for Nifty, 100 for BankNifty, and stock-specific values.")
exchange = input.string("NSE", "Exchange Prefix", group=G_PARSER,
  tooltip="Exchange prefix used for requesting security data (usually NSE for Indian markets).")

underlying_ticker = input.string("NIFTY", "Underlying Ticker", group=G_PARSER,
  tooltip="Underlying ticker symbol (e.g. NIFTY, BANKNIFTY).")
expiry_input = input.string("260804", "Expiry String (YYMMDD/Code)", group=G_PARSER,
  tooltip="Expiry date string format like 260804 (YYMMDD) or 24JUN.")

atm_select_mode = input.string("Automatic", "ATM Strike Selection Mode", options=["Automatic", "Manual"], group=G_PARSER,
  tooltip="Choose whether ATM Strike is calculated automatically from Option CE/PE premium parity or set manually.")
manual_strike_val = input.int(24150, "Selected Strike (Manual)", group=G_PARSER,
  tooltip="Specified strike price used when ATM Strike Selection Mode is set to Manual.")
selected_opt_type = input.string("CE", "Option Type", options=["CE", "PE"], group=G_PARSER,
  tooltip="Option contract type (CE or PE).")

// 2. Calculation Settings
calc_basis = input.string("Day Open Price", "Calculation Basis",
  options=["Day Open Price", "Previous Day Settlement/Close"], group=G_CALC,
  tooltip="Select whether S/R levels, BEP, and table statistics use the Option Day Open price or Previous Day Settlement/Close price as the base reference.")

// 3. Display & Plots
show_intrinsic_plots = input.bool(true, "Show Intrinsic/Extrinsic Plots", group=G_PLOTS,
  tooltip="Draw the CE and PE Intrinsic and Extrinsic (Time) value plots on the chart.")
show_sr_plots = input.bool(true, "Show Support/Resistance (S/R) Plots", group=G_PLOTS,
  tooltip="Draw Pivot (BEP), R1-R5, and S1-S5 levels on the chart.")
show_opp_candles = input.bool(true, "Show Opposite Option Candles", group=G_PLOTS,
  tooltip="Draw the opposite option contract's historical price chart as candles on the main window.")
show_vwap_plots = input.bool(true, "Show Option VWAP Plots", group=G_PLOTS,
  tooltip="Toggle plotting of CE and PE selected strike VWAPs on the chart.")

sr_draw_mode = input.string("Standard Plots (Style Tab Customizable)", "S/R Level Rendering Mode",
  options=["Standard Plots (Style Tab Customizable)", "Horizontal Lines (Projected to Right)"], group=G_PLOTS,
  tooltip="Choose whether S/R levels are plotted standard (customizable via TradingView Style tab) or drawn as projected lines.")

use_dynamic_colors = input.bool(false, "Dynamic Volume Delta Colors for S/R", group=G_PLOTS,
  tooltip="Color S/R lines dynamically based on net volume delta (Bullish green, Bearish red).")

// Opposite Option Candles Color Settings
c_opp_bull = input.color(color.new(#2962FF, 40), "Opposite Option Bullish Candle Body", group=G_PLOTS)
c_opp_bear = input.color(color.new(#FF6D00, 40), "Opposite Option Bearish Candle Body", group=G_PLOTS)
c_opp_bull_wick = input.color(color.new(#2962FF, 60), "Opposite Option Bullish Candle Wick/Border", group=G_PLOTS)
c_opp_bear_wick = input.color(color.new(#FF6D00, 60), "Opposite Option Bearish Candle Wick/Border", group=G_PLOTS)

// Intrinsic & Extrinsic Colors
c_ce_int = input.color(#00E676, "CE Intrinsic Plot Color", group=G_PLOTS)
c_pe_int = input.color(#FF5252, "PE Intrinsic Plot Color", group=G_PLOTS)
c_avg_int = input.color(#FFD700, "Avg Intrinsic Plot Color", group=G_PLOTS)
c_ce_ext = input.color(#FF9100, "CE Extrinsic Plot Color", group=G_PLOTS)
c_pe_ext = input.color(#D500F9, "PE Extrinsic Plot Color", group=G_PLOTS)
c_avg_ext = input.color(#2979FF, "Avg Extrinsic Plot Color", group=G_PLOTS)

// VWAP & Running BEP Colors
c_ce_vwap = input.color(#009688, "CE VWAP Plot Color", group=G_PLOTS)
c_pe_vwap = input.color(#E91E63, "PE VWAP Plot Color", group=G_PLOTS)
c_running_bep = input.color(color.white, "Running BEP Line Color", group=G_PLOTS)

// S/R Level Colors & Styling
c_p_in  = input.color(color.yellow, "Pivot Line Color", group=G_COLORS)
width_p_in = input.int(2, "Pivot Line Width", minval=1, maxval=4, group=G_COLORS)
style_p_in = input.string("Solid", "Pivot Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)

c_r1_in = input.color(#EF5350, "R1 Line Color", group=G_COLORS)
width_r1_in = input.int(1, "R1 Line Width", minval=1, maxval=4, group=G_COLORS)
style_r1_in = input.string("Solid", "R1 Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)

c_r2_in = input.color(#EF5350, "R2 Line Color", group=G_COLORS)
width_r2_in = input.int(1, "R2 Line Width", minval=1, maxval=4, group=G_COLORS)
style_r2_in = input.string("Solid", "R2 Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)

c_r3_in = input.color(#EF5350, "R3 Line Color", group=G_COLORS)
width_r3_in = input.int(1, "R3 Line Width", minval=1, maxval=4, group=G_COLORS)
style_r3_in = input.string("Solid", "R3 Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)

c_r4_in = input.color(#EF5350, "R4 Line Color", group=G_COLORS)
width_r4_in = input.int(1, "R4 Line Width", minval=1, maxval=4, group=G_COLORS)
style_r4_in = input.string("Solid", "R4 Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)

c_r5_in = input.color(#EF5350, "R5 Line Color", group=G_COLORS)
width_r5_in = input.int(1, "R5 Line Width", minval=1, maxval=4, group=G_COLORS)
style_r5_in = input.string("Solid", "R5 Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)

c_s1_in = input.color(#26A69A, "S1 Line Color", group=G_COLORS)
width_s1_in = input.int(1, "S1 Line Width", minval=1, maxval=4, group=G_COLORS)
style_s1_in = input.string("Solid", "S1 Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)

c_s2_in = input.color(#26A69A, "S2 Line Color", group=G_COLORS)
width_s2_in = input.int(1, "S2 Line Width", minval=1, maxval=4, group=G_COLORS)
style_s2_in = input.string("Solid", "S2 Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)

c_s3_in = input.color(#26A69A, "S3 Line Color", group=G_COLORS)
width_s3_in = input.int(1, "S3 Line Width", minval=1, maxval=4, group=G_COLORS)
style_s3_in = input.string("Solid", "S3 Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)

c_s4_in = input.color(#26A69A, "S4 Line Color", group=G_COLORS)
width_s4_in = input.int(1, "S4 Line Width", minval=1, maxval=4, group=G_COLORS)
style_s4_in = input.string("Solid", "S4 Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)

c_s5_in = input.color(#26A69A, "S5 Line Color", group=G_COLORS)
width_s5_in = input.int(1, "S5 Line Width", minval=1, maxval=4, group=G_COLORS)
style_s5_in = input.string("Solid", "S5 Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)

c_orb_in = input.color(color.blue, "ORB Line Color", group=G_COLORS)
width_orb_in = input.int(1, "ORB Line Width", minval=1, maxval=4, group=G_COLORS)
style_orb_in = input.string("Dashed", "ORB Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)
show_pdhl = input.bool(true, "Show Previous Day High/Low (PDH/PDL)", group=G_COLORS, tooltip="Plots Previous Day High and Low lines.")
pdhl_strike_mode = input.string("Current Chart Option", "PDH/PDL Strike Selection Mode", options=["Current Chart Option", "ATM Strike", "Manual Strike"], group=G_COLORS, tooltip="Select which option contract's PDH/PDL to plot.")
pdhl_manual_strike = input.int(24150, "PDH/PDL Manual Strike Price", group=G_COLORS, tooltip="Manual strike price used when PDH/PDL Strike Mode is set to Manual Strike.")
pdhl_opt_type = input.string("CE", "PDH/PDL Option Type", options=["CE", "PE"], group=G_COLORS, tooltip="Option type (CE or PE) for PDH/PDL when using ATM Strike or Manual Strike.")
c_pdh_in = input.color(color.orange, "PDH Line Color", group=G_COLORS)
c_pdl_in = input.color(color.orange, "PDL Line Color", group=G_COLORS)
width_pdh_in = input.int(1, "PDH Line Width", minval=1, maxval=4, group=G_COLORS)
width_pdl_in = input.int(1, "PDL Line Width", minval=1, maxval=4, group=G_COLORS)
style_pdh_in = input.string("Dotted", "PDH Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)
style_pdl_in = input.string("Dotted", "PDL Line Style", options=["Solid", "Dashed", "Dotted"], group=G_COLORS)

// 4. ORB & Running BEP Settings
G_ORB = "ORB & Running BEP Settings"
show_orb_lines = input.bool(true, "Show ORB Lines", group=G_ORB, tooltip="Toggle ORB range lines on the chart.")
show_orb_labels = input.bool(true, "Show ORB Labels", group=G_ORB, tooltip="Toggle ORB range text labels on the chart.")
orb_timeframe = input.string("5", "ORB Timeframe (Mins)", options=["1", "3", "5", "15", "30"], group=G_ORB, tooltip="Specify the ORB breakout duration in minutes.")
orb_strike_mode = input.string("ATM", "ORB Strike Selection Mode", options=["ATM", "ITM", "OTM", "Manual Strike"], group=G_ORB, tooltip="Select strike price relative to ATM or set manually.")
orb_manual_strike = input.int(24150, "ORB Manual Strike Price", group=G_ORB, tooltip="Manual strike price used when ORB Strike Selection Mode is set to Manual Strike.")
orb_strike_offset = input.int(100, "ORB Strike Offset", minval=50, maxval=500, step=50, group=G_ORB, tooltip="Offset distance from ATM strike price.")
orb_opt_type = input.string("CE", "ORB Option Type", options=["CE", "PE"], group=G_ORB, tooltip="Option type for the ORB range contract.")
show_running_bep = input.bool(true, "Show Running BEP Line", group=G_ORB, tooltip="Toggle the real-time running BEP line for the selected strike on the chart.")

// 4c. CVD & Volume Settings
G_SIG = "CVD & Volume Settings"
sig_tf_str = input.string("Chart Timeframe", "CVD & Volume Timeframe", options=["Chart Timeframe", "1 Min", "3 Min", "5 Min", "10 Min", "15 Min", "30 Min"], group=G_SIG, tooltip="Select specific timeframe to compute volume delta and CVD.")

// 4d. Swing Reversals & Volume Analytics Settings
G_SWING = "Swing Reversals & Volume Settings"
show_swings = input.bool(true, "Show Swing Reversals Analytics", group=G_SWING, tooltip="Mark support and resistance on major swing points with volume delta & reversal probability summaries.")
swing_tf_str = input.string("15 Min", "Swing Volume Timeframe", options=["Chart Timeframe", "1 Min", "3 Min", "5 Min", "10 Min", "15 Min", "30 Min"], group=G_SWING, tooltip="Select timeframe to aggregate volume and CVD at swing points.")
swing_select_mode = input.string("Automatic", "Swing Selection Mode", options=["Automatic", "Manual"], group=G_SWING)
swing_len_left = input.int(10, "Automatic Swing Left Bars", minval=2, group=G_SWING)
swing_len_right = input.int(5, "Automatic Swing Right Bars", minval=1, group=G_SWING)
manual_sh_price = input.float(0.0, "Manual Swing High Price", group=G_SWING, tooltip="Enter price level of manual swing high.")
manual_sl_price = input.float(0.0, "Manual Swing Low Price", group=G_SWING, tooltip="Enter price level of manual swing low.")
manual_sh_bars_back = input.int(10, "Manual Swing High Bars Back", minval=0, group=G_SWING)
manual_sl_bars_back = input.int(10, "Manual Swing Low Bars Back", minval=0, group=G_SWING)

// 5. Advanced Dashboard Table Settings
show_table = input.bool(true, "Show Option Chain Table", group=G_DASHBOARD,
  tooltip="Toggle the rendering of the dashboard option chain table.")
num_strikes_display = input.int(5, "Number of Strikes to Display (N)", minval=1, maxval=5, group=G_DASHBOARD,
  tooltip="Displays the selected strike plus N strikes above and N strikes below. Max is 5 (total 11 strikes).")
table_size = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal", "Large"], group=G_DASHBOARD)
table_pos_str = input.string("Top Right", "Table Position", 
  options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_DASHBOARD)
show_sr_table = input.bool(true, "Show S/R Table", group=G_DASHBOARD,
  tooltip="Enable or disable the rendering of the Support/Resistance levels summary table.")
table_pos_sr_str = input.string("Top Left", "S/R Table Position", 
  options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_DASHBOARD)
show_calc_box = input.bool(true, "Show Calculation Explanatory Table", group=G_DASHBOARD)
show_calc_details = input.bool(true, "Show Strike & LTP Breakdown in Calculation Table", group=G_DASHBOARD,
  tooltip="When enabled, displays chosen strike prices and option LTPs alongside the S/R calculation values.")
table_pos_calc_str = input.string("Bottom Left", "Calculation Table Position", 
  options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_DASHBOARD)
show_sel_table = input.bool(true, "Show Selected Strikes Summary Table", group=G_DASHBOARD,
  tooltip="Toggle rendering of the summary table showing ORB and PDH/PDL strike selections.")
table_pos_sel_str = input.string("Bottom Right", "Selected Strikes Table Position", 
  options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_DASHBOARD)

// =========================================================================
// OPTION CONTRACT PARSER (AUTO-DETECT FROM CHART)
// =========================================================================
f_is_digit(string c) =>
    str.contains("0123456789", c)

// Parser variables
var string root = underlying_ticker
var string expiry = expiry_input
var string opt_type = selected_opt_type == "CE" or selected_opt_type == "C" ? "C" : "P"
var int strike_val = manual_strike_val
var bool is_option = false

ticker_str = syminfo.ticker
ticker_len = str.length(ticker_str)

if ticker_len > 7
    int idx = ticker_len - 1
    string strike_str = ""
    while idx >= 0 and f_is_digit(str.substring(ticker_str, idx, idx + 1))
        strike_str := str.substring(ticker_str, idx, idx + 1) + strike_str
        idx := idx - 1
        
    if idx > 2 and str.length(strike_str) > 0
        string opt_char = str.substring(ticker_str, idx, idx + 1)
        if opt_char == "C" or opt_char == "P"
            opt_type := opt_char
            strike_val := int(str.tonumber(strike_str))
            
            int exp_len = 5
            if idx >= 3 and f_is_digit(str.substring(ticker_str, idx - 3, idx - 2))
                exp_len := 6
                
            if idx >= exp_len
                expiry := str.substring(ticker_str, idx - exp_len, idx)
                root := str.substring(ticker_str, 0, idx - exp_len)
                is_option := true

// Resolve final contract variables
final_root = is_option ? root : underlying_ticker
final_expiry = is_option ? expiry : expiry_input
final_type = is_option ? opt_type : (selected_opt_type == "CE" or selected_opt_type == "C" ? "C" : "P")

// Data Retrieval for Underlying Ticker (to establish constant ATM strike on barstate.isfirst)
spot_sym_ext = exchange + ":" + final_root
spot_close_today_ext = request.security(spot_sym_ext, "1D", close, lookahead=barmerge.lookahead_on)

// To prevent exceeding TradingView's 40 unique request.security limit across historical bars,
// base_center_strike is fixed across historical execution so loop symbols remain constant.
var int base_center_strike = na
if barstate.isfirst or na(base_center_strike)
    int calc_strike = (atm_select_mode == "Manual") ? manual_strike_val : (is_option ? strike_val : int(math.round(nz(spot_close_today_ext, 24150.0) / strike_step) * strike_step))
    if calc_strike <= 0
        calc_strike := 24150
    base_center_strike := calc_strike

final_strike = base_center_strike

// Resolve PDH / PDL contract symbol based on user selection mode
string clean_chart_ticker = is_option ? (exchange + ":" + final_root + final_expiry + opt_type + str.tostring(strike_val)) : (syminfo.prefix + ":" + syminfo.ticker)
string pdhl_sym = clean_chart_ticker
if pdhl_strike_mode == "ATM Strike"
    string pdhl_type = (pdhl_opt_type == "CE" or pdhl_opt_type == "C") ? "C" : "P"
    pdhl_sym := exchange + ":" + final_root + final_expiry + pdhl_type + str.tostring(final_strike)
else if pdhl_strike_mode == "Manual Strike"
    string pdhl_type = (pdhl_opt_type == "CE" or pdhl_opt_type == "C") ? "C" : "P"
    pdhl_sym := exchange + ":" + final_root + final_expiry + pdhl_type + str.tostring(pdhl_manual_strike)

[pd_high_val, pd_low_val] = request.security(pdhl_sym, "1D", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// Build opposite option contract symbol
opp_type = final_type == "C" ? "P" : "C"
opp_sym = exchange + ":" + final_root + final_expiry + opp_type + str.tostring(final_strike)

// Calculation basis references the option's own Day Open or Previous Day Close price.

// Resolve levels timeframe
tf_to_use = sig_tf_str == "Chart Timeframe" ? timeframe.period : (sig_tf_str == "1 Min" ? "1" : (sig_tf_str == "3 Min" ? "3" : (sig_tf_str == "5 Min" ? "5" : (sig_tf_str == "10 Min" ? "10" : (sig_tf_str == "15 Min" ? "15" : "30")))))

// Arrays to hold data for 11 strikes centered around the selected strike (index 5)
var float[] ce_opens = array.new_float(11)
var float[] ce_prevs = array.new_float(11)
var float[] ce_ltps  = array.new_float(11)
var float[] ce_highs = array.new_float(11, na)
var float[] ce_lows  = array.new_float(11, na)
var float[] ce_vols  = array.new_float(11, na)
var float[] ce_vwaps = array.new_float(11, na)

var float[] pe_opens = array.new_float(11)
var float[] pe_prevs = array.new_float(11)
var float[] pe_ltps  = array.new_float(11)
var float[] pe_highs = array.new_float(11, na)
var float[] pe_lows  = array.new_float(11, na)
var float[] pe_vols  = array.new_float(11, na)
var float[] pe_vwaps = array.new_float(11, na)

var int[] strikes = array.new_int(11)

// Helper function to extract Day Open, Previous Day Close, and real-time tick-by-tick LTP
f_get_contract_tuple() =>
    var float day_open = na
    var float prev_close = na
    if ta.change(time("D")) != 0
        prev_close := close[1]
        day_open := open
    [nz(day_open, open), nz(prev_close, close[1]), close]

// Populating arrays. Security calls in loop are resolved using constant iteration boundaries
for i = 0 to 10
    int strike = base_center_strike + (i - 5) * strike_step
    array.set(strikes, i, strike)
    
    string ce_contract = exchange + ":" + final_root + final_expiry + "C" + str.tostring(strike)
    string pe_contract = exchange + ":" + final_root + final_expiry + "P" + str.tostring(strike)
    
    // Real-time tick-by-tick query on chart timeframe (timeframe.period)
    // Returns [Day Open, Previous Day Close, Real-time LTP] on every tick
    [ce_o, ce_p, ce_c] = request.security(ce_contract, timeframe.period, f_get_contract_tuple())
    [pe_o, pe_p, pe_c] = request.security(pe_contract, timeframe.period, f_get_contract_tuple())
    
    array.set(ce_opens, i, ce_o)
    array.set(ce_prevs, i, ce_p)
    array.set(ce_ltps,  i, ce_c)
    
    array.set(pe_opens, i, pe_o)
    array.set(pe_prevs, i, pe_p)
    array.set(pe_ltps,  i, pe_c)

// =========================================================================
// INTRADAY CVD / VOLUME QUERIES (Explicit calls for ATM-1, ATM, ATM+1 only)
// Kept outside loop to prevent Pine from counting loop-body calls × 11 iterations.
// This costs only 6 unique request.security calls (3 strikes × CE+PE).
// =========================================================================
string cvd_ce4 = exchange + ":" + final_root + final_expiry + "C" + str.tostring(final_strike - 1 * strike_step)
string cvd_pe4 = exchange + ":" + final_root + final_expiry + "P" + str.tostring(final_strike - 1 * strike_step)
string cvd_ce5 = exchange + ":" + final_root + final_expiry + "C" + str.tostring(final_strike)
string cvd_pe5 = exchange + ":" + final_root + final_expiry + "P" + str.tostring(final_strike)
string cvd_ce6 = exchange + ":" + final_root + final_expiry + "C" + str.tostring(final_strike + 1 * strike_step)
string cvd_pe6 = exchange + ":" + final_root + final_expiry + "P" + str.tostring(final_strike + 1 * strike_step)

[cvd4_ce_h, cvd4_ce_l, cvd4_ce_v, cvd4_ce_vw] = request.security(cvd_ce4, tf_to_use, [high, low, volume, ta.vwap])
[cvd4_pe_h, cvd4_pe_l, cvd4_pe_v, cvd4_pe_vw] = request.security(cvd_pe4, tf_to_use, [high, low, volume, ta.vwap])
[cvd5_ce_h, cvd5_ce_l, cvd5_ce_v, cvd5_ce_vw] = request.security(cvd_ce5, tf_to_use, [high, low, volume, ta.vwap])
[cvd5_pe_h, cvd5_pe_l, cvd5_pe_v, cvd5_pe_vw] = request.security(cvd_pe5, tf_to_use, [high, low, volume, ta.vwap])
[cvd6_ce_h, cvd6_ce_l, cvd6_ce_v, cvd6_ce_vw] = request.security(cvd_ce6, tf_to_use, [high, low, volume, ta.vwap])
[cvd6_pe_h, cvd6_pe_l, cvd6_pe_v, cvd6_pe_vw] = request.security(cvd_pe6, tf_to_use, [high, low, volume, ta.vwap])

// Populate the arrays at indices 4, 5, 6
array.set(ce_highs, 4, cvd4_ce_h), array.set(ce_lows, 4, cvd4_ce_l), array.set(ce_vols, 4, cvd4_ce_v), array.set(ce_vwaps, 4, cvd4_ce_vw)
array.set(pe_highs, 4, cvd4_pe_h), array.set(pe_lows, 4, cvd4_pe_l), array.set(pe_vols, 4, cvd4_pe_v), array.set(pe_vwaps, 4, cvd4_pe_vw)
array.set(ce_highs, 5, cvd5_ce_h), array.set(ce_lows, 5, cvd5_ce_l), array.set(ce_vols, 5, cvd5_ce_v), array.set(ce_vwaps, 5, cvd5_ce_vw)
array.set(pe_highs, 5, cvd5_pe_h), array.set(pe_lows, 5, cvd5_pe_l), array.set(pe_vols, 5, cvd5_pe_v), array.set(pe_vwaps, 5, cvd5_pe_vw)
array.set(ce_highs, 6, cvd6_ce_h), array.set(ce_lows, 6, cvd6_ce_l), array.set(ce_vols, 6, cvd6_ce_v), array.set(ce_vwaps, 6, cvd6_ce_vw)
array.set(pe_highs, 6, cvd6_pe_h), array.set(pe_lows, 6, cvd6_pe_l), array.set(pe_vols, 6, cvd6_pe_v), array.set(pe_vwaps, 6, cvd6_pe_vw)

// =========================================================================
// INTRINSIC & EXTRINSIC VALUE CALCULATIONS
// =========================================================================
ce_premium_sel = calc_basis == "Day Open Price" ? array.get(ce_opens, 5) : array.get(ce_prevs, 5)
pe_premium_sel = calc_basis == "Day Open Price" ? array.get(pe_opens, 5) : array.get(pe_prevs, 5)

// Intrinsic Value derived from option premium parity (no spot price needed)
ce_intrinsic = math.max(0.0, nz(ce_premium_sel) - nz(pe_premium_sel))
pe_intrinsic = math.max(0.0, nz(pe_premium_sel) - nz(ce_premium_sel))
avg_intrinsic = (ce_intrinsic + pe_intrinsic) / 2.0

// Extrinsic Value
ce_extrinsic = math.max(0.0, nz(ce_premium_sel) - ce_intrinsic)
pe_extrinsic = math.max(0.0, nz(pe_premium_sel) - pe_intrinsic)
avg_extrinsic = (ce_extrinsic + pe_extrinsic) / 2.0

float ce_int_plot = na
float pe_int_plot = na
float avg_int_plot = na
float ce_ext_plot = na
float pe_ext_plot = na
float avg_ext_plot = na

// Always option chart mode
ce_int_plot := ce_intrinsic
pe_int_plot := pe_intrinsic
avg_int_plot := avg_intrinsic
ce_ext_plot := ce_extrinsic
pe_ext_plot := pe_extrinsic
avg_ext_plot := avg_extrinsic

// =========================================================================
// SUPPORT & RESISTANCE (S/R) CALCULATIONS
// =========================================================================
f_get_base_premium(int idx, string basis, float[] opens, float[] prevs) =>
    basis == "Day Open Price" ? array.get(opens, idx) : array.get(prevs, idx)

f_orb_range() =>
    var float orb_high = na
    var float orb_low = na
    is_new = ta.change(time("D")) != 0
    if is_new
        orb_high := high
        orb_low := low
    [orb_high, orb_low]

// =========================================================================
// ATM STRIKE CALCULATION (LOCKED 9:15 DAY OPEN vs REAL-TIME LTP)
// =========================================================================
int atm_strike_base = base_center_strike
int atm_idx_base = 5

if atm_select_mode == "Automatic"
    float min_diff_base = 1e9
    for i = 0 to 10
        float ce_o_val = calc_basis == "Day Open Price" ? array.get(ce_opens, i) : array.get(ce_prevs, i)
        float pe_o_val = calc_basis == "Day Open Price" ? array.get(pe_opens, i) : array.get(pe_prevs, i)
        int strike = array.get(strikes, i)
        
        if not na(ce_o_val) and not na(pe_o_val)
            float diff = math.abs(ce_o_val - pe_o_val)
            if diff < min_diff_base
                min_diff_base := diff
                atm_strike_base := strike
                atm_idx_base := i
else
    atm_strike_base := manual_strike_val
    for i = 0 to 10
        if array.get(strikes, i) == manual_strike_val
            atm_idx_base := i
            break

// Base ATM premiums (9:15 Day Open locked)
float ce_atm_base = calc_basis == "Day Open Price" ? array.get(ce_opens, atm_idx_base) : array.get(ce_prevs, atm_idx_base)
float pe_atm_base = calc_basis == "Day Open Price" ? array.get(pe_opens, atm_idx_base) : array.get(pe_prevs, atm_idx_base)

// Locked Synthetic Future Formula (9:15 Day Open locked)
float Spot_Pivot = atm_strike_base
if not na(ce_atm_base) and not na(pe_atm_base)
    if ce_atm_base > pe_atm_base
        Spot_Pivot := atm_strike_base + (ce_atm_base - pe_atm_base)
    else
        Spot_Pivot := atm_strike_base - (pe_atm_base - ce_atm_base)

// Spot R1-R4 Option Base Premiums (9:15 Day Open locked)
float r1_ce_base = calc_basis == "Day Open Price" ? array.get(ce_opens, math.min(10, atm_idx_base + 1)) : array.get(ce_prevs, math.min(10, atm_idx_base + 1))
float r2_ce_base = calc_basis == "Day Open Price" ? array.get(ce_opens, math.min(10, atm_idx_base + 2)) : array.get(ce_prevs, math.min(10, atm_idx_base + 2))
float r3_ce_base = calc_basis == "Day Open Price" ? array.get(ce_opens, math.min(10, atm_idx_base + 3)) : array.get(ce_prevs, math.min(10, atm_idx_base + 3))
float r4_ce_base = calc_basis == "Day Open Price" ? array.get(ce_opens, math.min(10, atm_idx_base + 4)) : array.get(ce_prevs, math.min(10, atm_idx_base + 4))

// Spot S1-S4 Option Base Premiums (9:15 Day Open locked)
float s1_pe_base = calc_basis == "Day Open Price" ? array.get(pe_opens, math.max(0, atm_idx_base - 1)) : array.get(pe_prevs, math.max(0, atm_idx_base - 1))
float s2_pe_base = calc_basis == "Day Open Price" ? array.get(pe_opens, math.max(0, atm_idx_base - 2)) : array.get(pe_prevs, math.max(0, atm_idx_base - 2))
float s3_pe_base = calc_basis == "Day Open Price" ? array.get(pe_opens, math.max(0, atm_idx_base - 3)) : array.get(pe_prevs, math.max(0, atm_idx_base - 3))
float s4_pe_base = calc_basis == "Day Open Price" ? array.get(pe_opens, math.max(0, atm_idx_base - 4)) : array.get(pe_prevs, math.max(0, atm_idx_base - 4))

// Compute locked spot level projections (stationary across trading day)
// R1: ATM Strike + ATM CE 9:15 open value; R2 to R5: ATM+1 to ATM+4 CE levels
float Spot_R1 = atm_strike_base + ce_atm_base
float Spot_R2 = (atm_strike_base + 1 * strike_step) + r1_ce_base
float Spot_R3 = (atm_strike_base + 2 * strike_step) + r2_ce_base
float Spot_R4 = (atm_strike_base + 3 * strike_step) + r3_ce_base
float Spot_R5 = (atm_strike_base + 4 * strike_step) + r4_ce_base

// S1: ATM Strike - ATM PE 9:15 open value; S2 to S5: ATM-1 to ATM-4 PE levels
float Spot_S1 = atm_strike_base - pe_atm_base
float Spot_S2 = (atm_strike_base - 1 * strike_step) - s1_pe_base
float Spot_S3 = (atm_strike_base - 2 * strike_step) - s2_pe_base
float Spot_S4 = (atm_strike_base - 3 * strike_step) - s3_pe_base
float Spot_S5 = (atm_strike_base - 4 * strike_step) - s4_pe_base

// 2. Real-Time ATM Strike Calculation (LTP Premium Difference based)
float min_diff_rt = 1e9
int atm_strike_rt = final_strike
int atm_idx_rt = 5

for i = 0 to 10
    float ce_l_val = array.get(ce_ltps, i)
    float pe_l_val = array.get(pe_ltps, i)
    int strike = array.get(strikes, i)
    
    if not na(ce_l_val) and not na(pe_l_val)
        float diff = math.abs(ce_l_val - pe_l_val)
        if diff < min_diff_rt
            min_diff_rt := diff
            atm_strike_rt := strike
            atm_idx_rt := i

float ce_atm_rt_ltp = array.get(ce_ltps, atm_idx_rt)
float pe_atm_rt_ltp = array.get(pe_ltps, atm_idx_rt)

int atm_strike = atm_strike_base
int atm_idx = atm_idx_base

ce_base_sel = f_get_base_premium(5, calc_basis, ce_opens, ce_prevs)
pe_base_sel = f_get_base_premium(5, calc_basis, pe_opens, pe_prevs)

pivot_val = (ce_base_sel + pe_base_sel) / 2.0

r1_val = ce_base_sel
r2_val = (f_get_base_premium(4, calc_basis, ce_opens, ce_prevs) + f_get_base_premium(6, calc_basis, pe_opens, pe_prevs)) / 2.0
r3_val = (f_get_base_premium(3, calc_basis, ce_opens, ce_prevs) + f_get_base_premium(7, calc_basis, pe_opens, pe_prevs)) / 2.0
r4_val = (f_get_base_premium(2, calc_basis, ce_opens, ce_prevs) + f_get_base_premium(8, calc_basis, pe_opens, pe_prevs)) / 2.0
r5_val = (f_get_base_premium(1, calc_basis, ce_opens, ce_prevs) + f_get_base_premium(9, calc_basis, pe_opens, pe_prevs)) / 2.0

s1_val = pe_base_sel
s2_val = (f_get_base_premium(6, calc_basis, ce_opens, ce_prevs) + f_get_base_premium(4, calc_basis, pe_opens, pe_prevs)) / 2.0
s3_val = (f_get_base_premium(7, calc_basis, ce_opens, ce_prevs) + f_get_base_premium(3, calc_basis, pe_opens, pe_prevs)) / 2.0
s4_val = (f_get_base_premium(8, calc_basis, ce_opens, ce_prevs) + f_get_base_premium(2, calc_basis, pe_opens, pe_prevs)) / 2.0
s5_val = (f_get_base_premium(9, calc_basis, ce_opens, ce_prevs) + f_get_base_premium(1, calc_basis, pe_opens, pe_prevs)) / 2.0

float p_plot = na
float r1_plot = na, float r2_plot = na, float r3_plot = na, float r4_plot = na, float r5_plot = na
float s1_plot = na, float s2_plot = na, float s3_plot = na, float s4_plot = na, float s5_plot = na

// S/R levels plotted directly as raw option premium values
p_plot  := pivot_val
r1_plot := r1_val
r2_plot := r2_val
r3_plot := r3_val
r4_plot := r4_val
r5_plot := r5_val
s1_plot := s1_val
s2_plot := s2_val
s3_plot := s3_val
s4_plot := s4_val
s5_plot := s5_val

// Capture starting bar of current trading day (9:15 AM bar index)
is_new_day = ta.change(time("D")) != 0
var int day_start_bar = na
if is_new_day
    day_start_bar := bar_index
    p_plot  := na
    r1_plot := na, r2_plot := na, r3_plot := na, r4_plot := na, r5_plot := na
    s1_plot := na, s2_plot := na, s3_plot := na, s4_plot := na, s5_plot := na

// Resolve ORB Strike Price relative to selected strike or manual input
int orb_strike = final_strike
if orb_strike_mode == "Manual Strike"
    orb_strike := orb_manual_strike
else if orb_strike_mode == "ITM"
    if orb_opt_type == "CE"
        orb_strike := final_strike - orb_strike_offset
    else // PE
        orb_strike := final_strike + orb_strike_offset
else if orb_strike_mode == "OTM"
    if orb_opt_type == "CE"
        orb_strike := final_strike + orb_strike_offset
    else // PE
        orb_strike := final_strike - orb_strike_offset

string orb_sym = exchange + ":" + final_root + final_expiry + (orb_opt_type == "CE" ? "C" : "P") + str.tostring(orb_strike)

[orb_h_raw, orb_l_raw] = request.security(orb_sym, orb_timeframe, f_orb_range())

float orb_high_plot = show_orb_lines ? orb_h_raw : na
float orb_low_plot = show_orb_lines ? orb_l_raw : na

if is_new_day
    orb_high_plot := na
    orb_low_plot := na

// Calculate Running BEP for the selected strike
ce_ltp_sel = array.get(ce_ltps, 5)
pe_ltp_sel = array.get(pe_ltps, 5)

float running_bep_val = na
if not na(ce_ltp_sel) and not na(pe_ltp_sel)
    running_bep_val := (ce_ltp_sel + pe_ltp_sel) / 2.0

float running_bep_plot = show_running_bep ? running_bep_val : na
if is_new_day
    running_bep_plot := na

// Extract CVD strike values from arrays
c3_h = array.get(ce_highs, 4), c3_l = array.get(ce_lows, 4), c3_c = array.get(ce_ltps, 4), c3_v = array.get(ce_vols, 4)
c4_h = array.get(ce_highs, 4), c4_l = array.get(ce_lows, 4), c4_c = array.get(ce_ltps, 4), c4_v = array.get(ce_vols, 4)
c5_h = array.get(ce_highs, 5), c5_l = array.get(ce_lows, 5), c5_c = array.get(ce_ltps, 5), c5_v = array.get(ce_vols, 5)
c6_h = array.get(ce_highs, 6), c6_l = array.get(ce_lows, 6), c6_c = array.get(ce_ltps, 6), c6_v = array.get(ce_vols, 6)
c7_h = array.get(ce_highs, 6), c7_l = array.get(ce_lows, 6), c7_c = array.get(ce_ltps, 6), c7_v = array.get(ce_vols, 6)

p3_h = array.get(pe_highs, 4), p3_l = array.get(pe_lows, 4), p3_c = array.get(pe_ltps, 4), p3_v = array.get(pe_vols, 4)
p4_h = array.get(pe_highs, 4), p4_l = array.get(pe_lows, 4), p4_c = array.get(pe_ltps, 4), p4_v = array.get(pe_vols, 4)
p5_h = array.get(pe_highs, 5), p5_l = array.get(pe_lows, 5), p5_c = array.get(pe_ltps, 5), p5_v = array.get(pe_vols, 5)
p6_h = array.get(pe_highs, 6), p6_l = array.get(pe_lows, 6), p6_c = array.get(pe_ltps, 6), p6_v = array.get(pe_vols, 6)
p7_h = array.get(pe_highs, 6), p7_l = array.get(pe_lows, 6), p7_c = array.get(pe_ltps, 6), p7_v = array.get(pe_vols, 6)

f_calc_buy_sell(float h, float l, float c, float v) =>
    buy_v = nz(v) * (nz(c) - nz(l)) / math.max(nz(h) - nz(l), 0.001)
    sell_v = nz(v) * (nz(h) - nz(c)) / math.max(nz(h) - nz(l), 0.001)
    [buy_v, sell_v]

[c3_buy, c3_sell] = f_calc_buy_sell(c3_h, c3_l, c3_c, c3_v)
[c4_buy, c4_sell] = f_calc_buy_sell(c4_h, c4_l, c4_c, c4_v)
[c5_buy, c5_sell] = f_calc_buy_sell(c5_h, c5_l, c5_c, c5_v)
[c6_buy, c6_sell] = f_calc_buy_sell(c6_h, c6_l, c6_c, c6_v)
[c7_buy, c7_sell] = f_calc_buy_sell(c7_h, c7_l, c7_c, c7_v)

[p3_buy, p3_sell] = f_calc_buy_sell(p3_h, p3_l, p3_c, p3_v)
[p4_buy, p4_sell] = f_calc_buy_sell(p4_h, p4_l, p4_c, p4_v)
[p5_buy, p5_sell] = f_calc_buy_sell(p5_h, p5_l, p5_c, p5_v)
[p6_buy, p6_sell] = f_calc_buy_sell(p6_h, p6_l, p6_c, p6_v)
[p7_buy, p7_sell] = f_calc_buy_sell(p7_h, p7_l, p7_c, p7_v)

// Extract ATM values
ce_buy_vol = c5_buy
ce_sell_vol = c5_sell
ce_v = nz(c5_v)
ce_c = nz(c5_c)
ce_tot_vol = ce_buy_vol + ce_sell_vol
float ce_buy_pct = ce_tot_vol > 0 ? (ce_buy_vol * 100.0 / ce_tot_vol) : 50.0

pe_buy_vol = p5_buy
pe_sell_vol = p5_sell
pe_v = nz(p5_v)
pe_c = nz(p5_c)
pe_tot_vol = pe_buy_vol + pe_sell_vol
float pe_buy_pct = pe_tot_vol > 0 ? (pe_buy_vol * 100.0 / pe_tot_vol) : 50.0

ce_vwap_val = array.get(ce_vwaps, 5)
pe_vwap_val = array.get(pe_vwaps, 5)

var float ce_cvd = 0.0
var float pe_cvd = 0.0

if is_new_day
    ce_cvd := 0.0
    pe_cvd := 0.0

ce_delta = ce_buy_vol - ce_sell_vol
pe_delta = pe_buy_vol - pe_sell_vol

ce_cvd := ce_cvd + ce_delta
pe_cvd := pe_cvd + pe_delta

ce_v_ema = ta.ema(ce_v, 20)
pe_v_ema = ta.ema(pe_v, 20)

float ce_v_chg_pct = ce_v_ema > 0 ? ((ce_v - ce_v_ema) / ce_v_ema) * 100.0 : 0.0
float pe_v_chg_pct = pe_v_ema > 0 ? ((pe_v - pe_v_ema) / pe_v_ema) * 100.0 : 0.0

f_format_vol(float val) =>
    abs_val = math.abs(val)
    abs_val >= 1000000.0 ? str.tostring(abs_val / 1000000.0, "#.#") + "M" :
     abs_val >= 1000.0 ? str.tostring(abs_val / 1000.0, "#.#") + "K" :
     str.tostring(abs_val, "0")

f_get_vol_suffix(int c_idx, int p_idx) =>
    float buy_v = na, float sell_v = na
    string suffix = ""
    
    if is_option
        int idx = final_type == "C" ? c_idx : p_idx
        if idx == 5
            buy_v := final_type == "C" ? c5_buy : p5_buy
            sell_v := final_type == "C" ? c5_sell : p5_sell
        else if idx == 4
            buy_v := final_type == "C" ? c4_buy : p6_buy
            sell_v := final_type == "C" ? c4_sell : p6_sell
        else if idx == 6
            buy_v := final_type == "C" ? c6_buy : p4_buy
            sell_v := final_type == "C" ? c6_sell : p4_sell
        else if idx == 3 or idx == 2 or idx == 1
            buy_v := final_type == "C" ? c3_buy : p7_buy
            sell_v := final_type == "C" ? c3_sell : p7_sell
        else if idx == 7 or idx == 8 or idx == 9
            buy_v := final_type == "C" ? c7_buy : p3_buy
            sell_v := final_type == "C" ? c7_sell : p3_sell
            
        float delta_v = nz(buy_v) - nz(sell_v)
        string delta_sign = delta_v >= 0 ? "+" : "-"
        suffix := " (B: " + f_format_vol(buy_v) + " | S: " + f_format_vol(sell_v) + " | CVD: " + delta_sign + f_format_vol(delta_v) + ")"
    else
        float cb = na, float cs = na, float pb = na, float ps = na
        
        if c_idx == 5
            cb := c5_buy, cs := c5_sell
        else if c_idx == 4
            cb := c4_buy, cs := c4_sell
        else if c_idx == 6
            cb := c6_buy, cs := c6_sell
        else if c_idx == 3 or c_idx == 2 or c_idx == 1
            cb := c3_buy, cs := c3_sell
        else if c_idx == 7 or c_idx == 8 or c_idx == 9
            cb := c7_buy, cs := c7_sell
            
        if p_idx == 5
            pb := p5_buy, ps := p5_sell
        else if p_idx == 4
            pb := p4_buy, ps := p4_sell
        else if p_idx == 6
            pb := p6_buy, ps := p6_sell
        else if p_idx == 3 or p_idx == 2 or p_idx == 1
            pb := p3_buy, ps := p3_sell
        else if p_idx == 7 or p_idx == 8 or p_idx == 9
            pb := p7_buy, ps := p7_sell
            
        float ce_delta_v = nz(cb) - nz(cs)
        float pe_delta_v = nz(pb) - nz(ps)
        string ce_sign = ce_delta_v >= 0 ? "+" : "-"
        string pe_sign = pe_delta_v >= 0 ? "+" : "-"
        
        suffix := " (CE B:" + f_format_vol(cb) + " S:" + f_format_vol(cs) + " CVD:" + ce_sign + f_format_vol(ce_delta_v) + " | PE B:" + f_format_vol(pb) + " S:" + f_format_vol(ps) + " CVD:" + pe_sign + f_format_vol(pe_delta_v) + ")"
    suffix

f_get_sr_probability(int c_idx, int p_idx, bool is_resistance) =>
    float buy_v = 0.0, float sell_v = 0.0
    
    if is_option
        int idx = final_type == "C" ? c_idx : p_idx
        if idx == 5
            buy_v := final_type == "C" ? c5_buy : p5_buy
            sell_v := final_type == "C" ? c5_sell : p5_sell
        else if idx == 4
            buy_v := final_type == "C" ? c4_buy : p6_buy
            sell_v := final_type == "C" ? c4_sell : p6_sell
        else if idx == 6
            buy_v := final_type == "C" ? c6_buy : p4_buy
            sell_v := final_type == "C" ? c6_sell : p4_sell
        else if idx == 3 or idx == 2 or idx == 1
            buy_v := final_type == "C" ? c3_buy : p7_buy
            sell_v := final_type == "C" ? c3_sell : p7_sell
        else if idx == 7 or idx == 8 or idx == 9
            buy_v := final_type == "C" ? c7_buy : p3_buy
            sell_v := final_type == "C" ? c7_sell : p3_sell
    else
        float cb = na, float cs = na, float pb = na, float ps = na
        if c_idx == 5
            cb := c5_buy, cs := c5_sell
        else if c_idx == 4
            cb := c4_buy, cs := c4_sell
        else if c_idx == 6
            cb := c6_buy, cs := c6_sell
        else if c_idx == 3 or c_idx == 2 or c_idx == 1
            cb := c3_buy, cs := c3_sell
        else if c_idx == 7 or c_idx == 8 or c_idx == 9
            cb := c7_buy, cs := c7_sell
            
        if p_idx == 5
            pb := p5_buy, ps := p5_sell
        else if p_idx == 4
            pb := p4_buy, ps := p4_sell
        else if p_idx == 6
            pb := p6_buy, ps := p6_sell
        else if p_idx == 3 or p_idx == 2 or p_idx == 1
            pb := p3_buy, ps := p3_sell
        else if p_idx == 7 or p_idx == 8 or p_idx == 9
            pb := p7_buy, ps := p7_sell
            
        buy_v := nz(cb) + nz(ps)
        sell_v := nz(cs) + nz(pb)
        
    float tot_v = buy_v + sell_v
    float cvd = buy_v - sell_v
    float r = tot_v > 0 ? (cvd / tot_v) : 0.0
    
    string prob_text = ""
    if is_resistance
        if cvd >= 0
            float p_break = 50.0 + 40.0 * r
            prob_text := " | Break: " + str.tostring(p_break, "#") + "%"
        else
            float p_rev = 50.0 + 40.0 * math.abs(r)
            prob_text := " | Reversal: " + str.tostring(p_rev, "#") + "%"
    else
        if cvd < 0
            float p_break = 50.0 + 40.0 * math.abs(r)
            prob_text := " | Break: " + str.tostring(p_break, "#") + "%"
        else
            float p_rev = 50.0 + 40.0 * r
            prob_text := " | Reversal: " + str.tostring(p_rev, "#") + "%"
    prob_text

f_get_pivot_probability() =>
    float buy_v = final_type == "C" ? c5_buy : p5_buy
    float sell_v = final_type == "C" ? c5_sell : p5_sell
    float cvd = buy_v - sell_v
    cvd >= 0 ? " | Bullish Bias" : " | Bearish Bias"

float ce_vwap_plot = ce_vwap_val
float pe_vwap_plot = pe_vwap_val

float ce_vwap_plot_final = show_vwap_plots ? ce_vwap_plot : na
float pe_vwap_plot_final = show_vwap_plots ? pe_vwap_plot : na

if is_new_day
    ce_vwap_plot_final := na
    pe_vwap_plot_final := na

// Fetch real-time opposite option contract candles
[opp_o, opp_h, opp_l, opp_c] = request.security(opp_sym, timeframe.period, [open, high, low, close])

candle_o = is_option and show_opp_candles ? opp_o : na
candle_h = is_option and show_opp_candles ? opp_h : na
candle_l = is_option and show_opp_candles ? opp_l : na
candle_c = is_option and show_opp_candles ? opp_c : na

// =========================================================================
// PLOTS AND RENDERINGS (ON CHART)
// =========================================================================
opp_body_col = (candle_c >= candle_o) ? c_opp_bull : c_opp_bear
opp_wick_col = (candle_c >= candle_o) ? c_opp_bull_wick : c_opp_bear_wick

plotcandle(candle_o, candle_h, candle_l, candle_c, title="Opposite Option Candles", 
  color=opp_body_col, 
  wickcolor=opp_wick_col, 
  bordercolor=opp_wick_col)

plot(show_intrinsic_plots ? ce_int_plot : na, title="CE Intrinsic Value", color=c_ce_int, linewidth=2)
plot(show_intrinsic_plots ? pe_int_plot : na, title="PE Intrinsic Value", color=c_pe_int, linewidth=2)
plot(show_intrinsic_plots ? avg_int_plot : na, title="Average Intrinsic Value", color=c_avg_int, linewidth=1)

plot(show_intrinsic_plots ? ce_ext_plot : na, title="CE Extrinsic Value", color=c_ce_ext, linewidth=2)
plot(show_intrinsic_plots ? pe_ext_plot : na, title="PE Extrinsic Value", color=c_pe_ext, linewidth=2)
plot(show_intrinsic_plots ? avg_ext_plot : na, title="Average Extrinsic Value", color=c_avg_ext, linewidth=1)

f_get_level_color(int c_idx, int p_idx) =>
    float cb = na, float cs = na, float pb = na, float ps = na
    if c_idx == 5
        cb := c5_buy, cs := c5_sell
    else if c_idx == 4
        cb := c4_buy, cs := c4_sell
    else if c_idx == 6
        cb := c6_buy, cs := c6_sell
    else if c_idx == 3 or c_idx == 2 or c_idx == 1
        cb := c3_buy, cs := c3_sell
    else if c_idx == 7 or c_idx == 8 or c_idx == 9
        cb := c7_buy, cs := c7_sell
        
    if p_idx == 5
        pb := p5_buy, ps := p5_sell
    else if p_idx == 4
        pb := p4_buy, ps := p4_sell
    else if p_idx == 6
        pb := p6_buy, ps := p6_sell
    else if p_idx == 3 or p_idx == 2 or p_idx == 1
        pb := p3_buy, ps := p3_sell
    else if p_idx == 7 or p_idx == 8 or p_idx == 9
        pb := p7_buy, ps := p7_sell
        
    float ce_delta_v = nz(cb) - nz(cs)
    float pe_delta_v = nz(pb) - nz(ps)
    (ce_delta_v + pe_delta_v >= 0) ? #26A69A : #EF5350

col_p  = use_dynamic_colors ? f_get_level_color(5, 5) : c_p_in
col_r1 = use_dynamic_colors ? f_get_level_color(5, 5) : c_r1_in
col_r2 = use_dynamic_colors ? f_get_level_color(4, 6) : c_r2_in
col_r3 = use_dynamic_colors ? f_get_level_color(3, 7) : c_r3_in
col_r4 = use_dynamic_colors ? f_get_level_color(2, 8) : c_r4_in
col_r5 = use_dynamic_colors ? f_get_level_color(1, 9) : c_r5_in
col_s1 = use_dynamic_colors ? f_get_level_color(5, 5) : c_s1_in
col_s2 = use_dynamic_colors ? f_get_level_color(6, 4) : c_s2_in
col_s3 = use_dynamic_colors ? f_get_level_color(7, 3) : c_s3_in
col_s4 = use_dynamic_colors ? f_get_level_color(8, 2) : c_s4_in
col_s5 = use_dynamic_colors ? f_get_level_color(9, 1) : c_s5_in

plot(show_sr_plots and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? p_plot : na, title="Pivot (Selected Strike BEP)", color=col_p)
plot(show_sr_plots and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? r1_plot : na, title="R1 (ATM CE)", color=col_r1)
plot(show_sr_plots and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? r2_plot : na, title="R2 (ITM Avg 1)", color=col_r2)
plot(show_sr_plots and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? r3_plot : na, title="R3 (ITM Avg 2)", color=col_r3)
plot(show_sr_plots and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? r4_plot : na, title="R4 (ITM Avg 3)", color=col_r4)
plot(show_sr_plots and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? r5_plot : na, title="R5 (ITM Avg 4)", color=col_r5)
plot(show_sr_plots and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? s1_plot : na, title="S1 (ATM PE)", color=col_s1)
plot(show_sr_plots and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? s2_plot : na, title="S2 (OTM Avg 1)", color=col_s2)
plot(show_sr_plots and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? s3_plot : na, title="S3 (OTM Avg 2)", color=col_s3)
plot(show_sr_plots and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? s4_plot : na, title="S4 (OTM Avg 3)", color=col_s4)
plot(show_sr_plots and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? s5_plot : na, title="S5 (OTM Avg 4)", color=col_s5)

plot(show_orb_lines and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? orb_high_plot : na, title="ORB Range High", color=c_orb_in)
plot(show_orb_lines and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? orb_low_plot : na, title="ORB Range Low", color=c_orb_in)

plot(show_running_bep ? running_bep_plot : na, title="Running BEP", color=c_running_bep)

plot(show_pdhl and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? pd_high_val : na, title="PD High (PDH)", color=c_pdh_in)
plot(show_pdhl and sr_draw_mode == "Standard Plots (Style Tab Customizable)" ? pd_low_val : na, title="PD Low (PDL)", color=c_pdl_in)

plot(show_vwap_plots ? ce_vwap_plot_final : na, title="CE VWAP", color=c_ce_vwap)
plot(show_vwap_plots ? pe_vwap_plot_final : na, title="PE VWAP", color=c_pe_vwap)

// =========================================================================
// PROJECTED HORIZONTAL LINES ENGINE (ANCHORED AT 9:15 AM & EXTENDED FULL DAY)
// =========================================================================
f_get_line_style(string style_str) =>
    style_str == "Dashed" ? line.style_dashed :
     style_str == "Dotted" ? line.style_dotted :
     line.style_solid

var line ln_p = na
var line ln_r1 = na, var line ln_r2 = na, var line ln_r3 = na, var line ln_r4 = na, var line ln_r5 = na
var line ln_s1 = na, var line ln_s2 = na, var line ln_s3 = na, var line ln_s4 = na, var line ln_s5 = na
var line ln_orb_h = na, var line ln_orb_l = na
var line ln_pdh = na, var line ln_pdl = na

if sr_draw_mode == "Horizontal Lines (Projected to Right)"
    int target_x2 = barstate.islast ? bar_index + 100 : bar_index
    int start_x1 = na(day_start_bar) ? bar_index : day_start_bar

    if is_new_day
        // Freeze previous trading day's lines at session end
        line.set_x2(ln_p, bar_index - 1), line.set_extend(ln_p, extend.none)
        line.set_x2(ln_r1, bar_index - 1), line.set_extend(ln_r1, extend.none)
        line.set_x2(ln_r2, bar_index - 1), line.set_extend(ln_r2, extend.none)
        line.set_x2(ln_r3, bar_index - 1), line.set_extend(ln_r3, extend.none)
        line.set_x2(ln_r4, bar_index - 1), line.set_extend(ln_r4, extend.none)
        line.set_x2(ln_r5, bar_index - 1), line.set_extend(ln_r5, extend.none)
        line.set_x2(ln_s1, bar_index - 1), line.set_extend(ln_s1, extend.none)
        line.set_x2(ln_s2, bar_index - 1), line.set_extend(ln_s2, extend.none)
        line.set_x2(ln_s3, bar_index - 1), line.set_extend(ln_s3, extend.none)
        line.set_x2(ln_s4, bar_index - 1), line.set_extend(ln_s4, extend.none)
        line.set_x2(ln_s5, bar_index - 1), line.set_extend(ln_s5, extend.none)
        line.set_x2(ln_orb_h, bar_index - 1), line.set_extend(ln_orb_h, extend.none)
        line.set_x2(ln_orb_l, bar_index - 1), line.set_extend(ln_orb_l, extend.none)
        line.set_x2(ln_pdh, bar_index - 1), line.set_extend(ln_pdh, extend.none)
        line.set_x2(ln_pdl, bar_index - 1), line.set_extend(ln_pdl, extend.none)
        
        // Draw new day's lines starting at 9:15 AM (day_start_bar)
        if show_sr_plots and not na(p_plot)
            ln_p  := line.new(start_x1, p_plot, target_x2, p_plot, color=col_p, width=width_p_in, style=f_get_line_style(style_p_in))
            ln_r1 := line.new(start_x1, r1_plot, target_x2, r1_plot, color=col_r1, width=width_r1_in, style=f_get_line_style(style_r1_in))
            ln_r2 := line.new(start_x1, r2_plot, target_x2, r2_plot, color=col_r2, width=width_r2_in, style=f_get_line_style(style_r2_in))
            ln_r3 := line.new(start_x1, r3_plot, target_x2, r3_plot, color=col_r3, width=width_r3_in, style=f_get_line_style(style_r3_in))
            ln_r4 := line.new(start_x1, r4_plot, target_x2, r4_plot, color=col_r4, width=width_r4_in, style=f_get_line_style(style_r4_in))
            ln_r5 := line.new(start_x1, r5_plot, target_x2, r5_plot, color=col_r5, width=width_r5_in, style=f_get_line_style(style_r5_in))
            ln_s1 := line.new(start_x1, s1_plot, target_x2, s1_plot, color=col_s1, width=width_s1_in, style=f_get_line_style(style_s1_in))
            ln_s2 := line.new(start_x1, s2_plot, target_x2, s2_plot, color=col_s2, width=width_s2_in, style=f_get_line_style(style_s2_in))
            ln_s3 := line.new(start_x1, s3_plot, target_x2, s3_plot, color=col_s3, width=width_s3_in, style=f_get_line_style(style_s3_in))
            ln_s4 := line.new(start_x1, s4_plot, target_x2, s4_plot, color=col_s4, width=width_s4_in, style=f_get_line_style(style_s4_in))
            ln_s5 := line.new(start_x1, s5_plot, target_x2, s5_plot, color=col_s5, width=width_s5_in, style=f_get_line_style(style_s5_in))
        if show_orb_lines and not na(orb_high_plot)
            ln_orb_h := line.new(start_x1, orb_high_plot, target_x2, orb_high_plot, color=c_orb_in, width=width_orb_in, style=f_get_line_style(style_orb_in))
            ln_orb_l := line.new(start_x1, orb_low_plot, target_x2, orb_low_plot, color=c_orb_in, width=width_orb_in, style=f_get_line_style(style_orb_in))
        if show_pdhl and not na(pd_high_val)
            ln_pdh := line.new(start_x1, pd_high_val, target_x2, pd_high_val, color=c_pdh_in, width=width_pdh_in, style=f_get_line_style(style_pdh_in))
            ln_pdl := line.new(start_x1, pd_low_val, target_x2, pd_low_val, color=c_pdl_in, width=width_pdl_in, style=f_get_line_style(style_pdl_in))
            
    if show_sr_plots and not na(p_plot)
        if na(ln_p)
            ln_p  := line.new(start_x1, p_plot, target_x2, p_plot, color=col_p, width=width_p_in, style=f_get_line_style(style_p_in))
            ln_r1 := line.new(start_x1, r1_plot, target_x2, r1_plot, color=col_r1, width=width_r1_in, style=f_get_line_style(style_r1_in))
            ln_r2 := line.new(start_x1, r2_plot, target_x2, r2_plot, color=col_r2, width=width_r2_in, style=f_get_line_style(style_r2_in))
            ln_r3 := line.new(start_x1, r3_plot, target_x2, r3_plot, color=col_r3, width=width_r3_in, style=f_get_line_style(style_r3_in))
            ln_r4 := line.new(start_x1, r4_plot, target_x2, r4_plot, color=col_r4, width=width_r4_in, style=f_get_line_style(style_r4_in))
            ln_r5 := line.new(start_x1, r5_plot, target_x2, r5_plot, color=col_r5, width=width_r5_in, style=f_get_line_style(style_r5_in))
            ln_s1 := line.new(start_x1, s1_plot, target_x2, s1_plot, color=col_s1, width=width_s1_in, style=f_get_line_style(style_s1_in))
            ln_s2 := line.new(start_x1, s2_plot, target_x2, s2_plot, color=col_s2, width=width_s2_in, style=f_get_line_style(style_s2_in))
            ln_s3 := line.new(start_x1, s3_plot, target_x2, s3_plot, color=col_s3, width=width_s3_in, style=f_get_line_style(style_s3_in))
            ln_s4 := line.new(start_x1, s4_plot, target_x2, s4_plot, color=col_s4, width=width_s4_in, style=f_get_line_style(style_s4_in))
            ln_s5 := line.new(start_x1, s5_plot, target_x2, s5_plot, color=col_s5, width=width_s5_in, style=f_get_line_style(style_s5_in))
        else
            line.set_color(ln_p, col_p), line.set_y1(ln_p, p_plot), line.set_y2(ln_p, p_plot), line.set_x2(ln_p, target_x2), line.set_width(ln_p, width_p_in), line.set_style(ln_p, f_get_line_style(style_p_in))
            line.set_color(ln_r1, col_r1), line.set_y1(ln_r1, r1_plot), line.set_y2(ln_r1, r1_plot), line.set_x2(ln_r1, target_x2), line.set_width(ln_r1, width_r1_in), line.set_style(ln_r1, f_get_line_style(style_r1_in))
            line.set_color(ln_r2, col_r2), line.set_y1(ln_r2, r2_plot), line.set_y2(ln_r2, r2_plot), line.set_x2(ln_r2, target_x2), line.set_width(ln_r2, width_r2_in), line.set_style(ln_r2, f_get_line_style(style_r2_in))
            line.set_color(ln_r3, col_r3), line.set_y1(ln_r3, r3_plot), line.set_y2(ln_r3, r3_plot), line.set_x2(ln_r3, target_x2), line.set_width(ln_r3, width_r3_in), line.set_style(ln_r3, f_get_line_style(style_r3_in))
            line.set_color(ln_r4, col_r4), line.set_y1(ln_r4, r4_plot), line.set_y2(ln_r4, r4_plot), line.set_x2(ln_r4, target_x2), line.set_width(ln_r4, width_r4_in), line.set_style(ln_r4, f_get_line_style(style_r4_in))
            line.set_color(ln_r5, col_r5), line.set_y1(ln_r5, r5_plot), line.set_y2(ln_r5, r5_plot), line.set_x2(ln_r5, target_x2), line.set_width(ln_r5, width_r5_in), line.set_style(ln_r5, f_get_line_style(style_r5_in))
            line.set_color(ln_s1, col_s1), line.set_y1(ln_s1, s1_plot), line.set_y2(ln_s1, s1_plot), line.set_x2(ln_s1, target_x2), line.set_width(ln_s1, width_s1_in), line.set_style(ln_s1, f_get_line_style(style_s1_in))
            line.set_color(ln_s2, col_s2), line.set_y1(ln_s2, s2_plot), line.set_y2(ln_s2, s2_plot), line.set_x2(ln_s2, target_x2), line.set_width(ln_s2, width_s2_in), line.set_style(ln_s2, f_get_line_style(style_s2_in))
            line.set_color(ln_s3, col_s3), line.set_y1(ln_s3, s3_plot), line.set_y2(ln_s3, s3_plot), line.set_x2(ln_s3, target_x2), line.set_width(ln_s3, width_s3_in), line.set_style(ln_s3, f_get_line_style(style_s3_in))
            line.set_color(ln_s4, col_s4), line.set_y1(ln_s4, s4_plot), line.set_y2(ln_s4, s4_plot), line.set_x2(ln_s4, target_x2), line.set_width(ln_s4, width_s4_in), line.set_style(ln_s4, f_get_line_style(style_s4_in))
            line.set_color(ln_s5, col_s5), line.set_y1(ln_s5, s5_plot), line.set_y2(ln_s5, s5_plot), line.set_x2(ln_s5, target_x2), line.set_width(ln_s5, width_s5_in), line.set_style(ln_s5, f_get_line_style(style_s5_in))
    if show_orb_lines and not na(orb_high_plot)
        if na(ln_orb_h)
            ln_orb_h := line.new(start_x1, orb_high_plot, target_x2, orb_high_plot, color=c_orb_in, width=width_orb_in, style=f_get_line_style(style_orb_in))
            ln_orb_l := line.new(start_x1, orb_low_plot, target_x2, orb_low_plot, color=c_orb_in, width=width_orb_in, style=f_get_line_style(style_orb_in))
        else
            line.set_y1(ln_orb_h, orb_high_plot), line.set_y2(ln_orb_h, orb_high_plot), line.set_x2(ln_orb_h, target_x2)
            line.set_y1(ln_orb_l, orb_low_plot), line.set_y2(ln_orb_l, orb_low_plot), line.set_x2(ln_orb_l, target_x2)
    if show_pdhl and not na(pd_high_val)
        if na(ln_pdh)
            ln_pdh := line.new(start_x1, pd_high_val, target_x2, pd_high_val, color=c_pdh_in, width=width_pdh_in, style=f_get_line_style(style_pdh_in))
            ln_pdl := line.new(start_x1, pd_low_val, target_x2, pd_low_val, color=c_pdl_in, width=width_pdl_in, style=f_get_line_style(style_pdl_in))
        else
            line.set_y1(ln_pdh, pd_high_val), line.set_y2(ln_pdh, pd_high_val), line.set_x2(ln_pdh, target_x2)
            line.set_y1(ln_pdl, pd_low_val), line.set_y2(ln_pdl, pd_low_val), line.set_x2(ln_pdl, target_x2)

// =========================================================================
// TABLE UI RENDERING (DASHBOARD)
// =========================================================================
var string t_pos = position.top_right
if table_pos_str == "Top Left"
    t_pos := position.top_left
else if table_pos_str == "Bottom Right"
    t_pos := position.bottom_right
else if table_pos_str == "Bottom Left"
    t_pos := position.bottom_left

var string t_size = size.small
if table_size == "Tiny"
    t_size := size.tiny
else if table_size == "Normal"
    t_size := size.normal
else if table_size == "Large"
    t_size := size.large

var table chain_table = table.new(t_pos, 4, 17, bgcolor=color.new(color.black, 100), border_color=#2B2E3A, border_width=1)

if show_table and barstate.islast
    table.clear(chain_table, 0, 0, 3, 16)
    
    int atm_table_idx = 5
    for idx = 0 to 10
        if array.get(strikes, idx) == atm_strike_rt
            atm_table_idx := idx
            break
            
    int N = num_strikes_display
    int start_idx = math.max(0, math.min(10 - 2 * N, atm_table_idx - N))
    int end_idx = start_idx + 2 * N
    
    string status_text = final_root + " | Expiry: " + final_expiry + " | Basis: " + calc_basis
    table.cell(chain_table, 0, 0, status_text, bgcolor=#1E222D, text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
    table.merge_cells(chain_table, 0, 0, 3, 0)
    
    table.cell(chain_table, 0, 1, "CE LTP (Chg %)", bgcolor=#1E222D, text_color=color.white, text_size=t_size, text_halign=text.align_center)
    table.cell(chain_table, 1, 1, "STRIKE", bgcolor=#1E222D, text_color=color.white, text_size=t_size, text_halign=text.align_center)
    table.cell(chain_table, 2, 1, "PE LTP (Chg %)", bgcolor=#1E222D, text_color=color.white, text_size=t_size, text_halign=text.align_center)
    table.cell(chain_table, 3, 1, "BEP VALUE", bgcolor=#1E222D, text_color=color.white, text_size=t_size, text_halign=text.align_center)
    
    int row_offset = 2
    for idx = start_idx to end_idx
        int strike = array.get(strikes, idx)
        float t_ce_c = array.get(ce_ltps, idx)
        float ce_o = array.get(ce_opens, idx)
        float t_pe_c = array.get(pe_ltps, idx)
        float pe_o = array.get(pe_opens, idx)
        
        float ce_base_val = calc_basis == "Day Open Price" ? ce_o : array.get(ce_prevs, idx)
        float pe_base_val = calc_basis == "Day Open Price" ? pe_o : array.get(pe_prevs, idx)
        float bep = (ce_base_val + pe_base_val) / 2.0
        
        color base_row_bg = (idx % 2 == 0) ? #131722 : #1C2030
        color ce_bg = (strike < atm_strike_rt) ? color.new(#FFEB3B, 92) : base_row_bg
        color pe_bg = (strike > atm_strike_rt) ? color.new(#FFEB3B, 92) : base_row_bg
        color strike_bg = base_row_bg
        color strike_txt_color = color.white
        
        if strike == atm_strike_rt
            if not na(t_ce_c) and not na(t_pe_c)
                if t_ce_c > t_pe_c
                    strike_bg := #00E676
                    strike_txt_color := color.black
                else
                    strike_bg := #FF9800
                    strike_txt_color := color.black
            else
                strike_bg := #2962FF
                strike_txt_color := color.white
            
        float ce_chg = na(ce_base_val) or ce_base_val == 0 ? 0.0 : ((t_ce_c - ce_base_val) / ce_base_val) * 100.0
        float pe_chg = na(pe_base_val) or pe_base_val == 0 ? 0.0 : ((t_pe_c - pe_base_val) / pe_base_val) * 100.0
        
        string ce_chg_str = ce_chg >= 0 ? "+" + str.tostring(ce_chg, "#.##") + "%" : str.tostring(ce_chg, "#.##") + "%"
        string pe_chg_str = pe_chg >= 0 ? "+" + str.tostring(pe_chg, "#.##") + "%" : str.tostring(pe_chg, "#.##") + "%"
        
        color ce_chg_color = ce_chg >= 0 ? #26A69A : #EF5350
        color pe_chg_color = pe_chg >= 0 ? #26A69A : #EF5350
        
        string ce_text = na(t_ce_c) ? "-" : str.tostring(t_ce_c, "#.##") + " (" + ce_chg_str + ")"
        string pe_text = na(t_pe_c) ? "-" : str.tostring(t_pe_c, "#.##") + " (" + pe_chg_str + ")"
        
        if idx == 5
            ce_text := ce_text + " [B:" + str.tostring(ce_buy_pct, "0") + "%]"
            pe_text := pe_text + " [B:" + str.tostring(pe_buy_pct, "0") + "%]"
        
        int curr_row = idx - start_idx + row_offset
        
        table.cell(chain_table, 0, curr_row, ce_text, bgcolor=ce_bg, text_color=ce_chg_color, text_size=t_size, text_halign=text.align_center)
        table.cell(chain_table, 1, curr_row, str.tostring(strike), bgcolor=strike_bg, text_color=strike_txt_color, text_size=t_size, text_halign=text.align_center)
        table.cell(chain_table, 2, curr_row, pe_text, bgcolor=pe_bg, text_color=pe_chg_color, text_size=t_size, text_halign=text.align_center)
        table.cell(chain_table, 3, curr_row, na(bep) ? "-" : str.tostring(bep, "#.##"), bgcolor=base_row_bg, text_color=color.yellow, text_size=t_size, text_halign=text.align_center)

    int vol_row = (end_idx - start_idx + row_offset) + 1
    int cvd_row = vol_row + 1
    
    table.cell(chain_table, 0, vol_row, "Selected Strike Vol Delta", bgcolor=#1E222D, text_color=color.white, text_size=t_size, text_halign=text.align_left)
    table.merge_cells(chain_table, 0, vol_row, 1, vol_row)
    table.cell(chain_table, 2, vol_row, "CE: B " + str.tostring(ce_buy_pct, "0") + "% S " + str.tostring(100.0 - ce_buy_pct, "0") + "% | PE: B " + str.tostring(pe_buy_pct, "0") + "% S " + str.tostring(100.0 - pe_buy_pct, "0") + "%", bgcolor=#1E222D, text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
    table.merge_cells(chain_table, 2, vol_row, 3, vol_row)

    string ce_cvd_str = (ce_cvd >= 0 ? "+" : "-") + (math.abs(ce_cvd) >= 1000.0 ? str.tostring(math.abs(ce_cvd) / 1000.0, "#.#") + "K" : str.tostring(math.abs(ce_cvd), "0"))
    string pe_cvd_str = (pe_cvd >= 0 ? "+" : "-") + (math.abs(pe_cvd) >= 1000.0 ? str.tostring(math.abs(pe_cvd) / 1000.0, "#.#") + "K" : str.tostring(math.abs(pe_cvd), "0"))
    string ce_v_chg_str = (ce_v_chg_pct >= 0 ? "+" : "") + str.tostring(ce_v_chg_pct, "0") + "% [B:" + str.tostring(ce_buy_pct, "0") + "% S:" + str.tostring(100.0 - ce_buy_pct, "0") + "%]"
    string pe_v_chg_str = (pe_v_chg_pct >= 0 ? "+" : "") + str.tostring(pe_v_chg_pct, "0") + "% [B:" + str.tostring(pe_buy_pct, "0") + "% S:" + str.tostring(100.0 - pe_buy_pct, "0") + "%]"
    
    table.cell(chain_table, 0, cvd_row, "CVD / Volume Spike (%)", bgcolor=#131722, text_color=color.white, text_size=t_size, text_halign=text.align_left, tooltip="Volume Spike Formula: ((Current Vol - 20 EMA Vol) / 20 EMA Vol) * 100.")
    table.merge_cells(chain_table, 0, cvd_row, 1, cvd_row)
    table.cell(chain_table, 2, cvd_row, "CE: " + ce_cvd_str + " (" + ce_v_chg_str + ") | PE: " + pe_cvd_str + " (" + pe_v_chg_str + ")", bgcolor=#131722, text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
    table.merge_cells(chain_table, 2, cvd_row, 3, cvd_row)

// =========================================================================
// SUPPORT & RESISTANCE (S/R) LEVELS SUMMARY TABLE
// =========================================================================
var string t_pos_sr = position.top_left
if table_pos_sr_str == "Top Right"
    t_pos_sr := position.top_right
else if table_pos_sr_str == "Bottom Right"
    t_pos_sr := position.bottom_right
else if table_pos_sr_str == "Bottom Left"
    t_pos_sr := position.bottom_left

var table sr_table = table.new(t_pos_sr, 2, 13, bgcolor=color.new(color.black, 100), border_color=#2B2E3A, border_width=1)

if show_sr_table and barstate.islast
    table.clear(sr_table, 0, 0, 1, 12)
    
    table.cell(sr_table, 0, 0, "S/R Levels (" + calc_basis + ")", bgcolor=#1E222D, text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
    table.merge_cells(sr_table, 0, 0, 1, 0)
    
    table.cell(sr_table, 0, 1, "LEVEL", bgcolor=#1E222D, text_color=color.white, text_size=t_size, text_halign=text.align_center)
    table.cell(sr_table, 1, 1, "PREMIUM (TARGET PRICE)", bgcolor=#1E222D, text_color=color.white, text_size=t_size, text_halign=text.align_center)
    
    color r_color = #EF5350
    color s_color = #26A69A
    
    float pivot_target = final_strike + (ce_base_sel - pe_base_sel) / 2
    
