//@version=6
indicator("Techfrost Nifty 50 Stock Options ATM BEP & IV Analytics (Batch 1)", shorttitle="TF Nifty50 BEP-IV B1", overlay=true, precision=2)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum TablePos
    topRight   = "Top Right"
    topLeft    = "Top Left"
    bottomRight= "Bottom Right"
    bottomLeft = "Bottom Left"

enum TableSize
    auto   = "Auto"
    tiny   = "Tiny"
    small  = "Small"
    normal = "Normal"
    large  = "Large"

useOffHoursPrevClose = input.bool(true, "Use Previous Day Close When Market Is Closed", group="Data Source Settings",
  tooltip="When checked, automatically uses Previous Day Close price outside market hours so the table displays valid analytics 24/7.")

// --- Display Controls ---
showSummaryTable   = input.bool(true, "Show Dashboard Summary Table", group="Display Controls")
showStockListRow   = input.bool(true, "Show Evaluated Stock Symbols List", group="Display Controls")
tablePosInput      = input.enum(TablePos.topRight, "Table Position", group="Display Controls")
tableTextSizeInput = input.enum(TableSize.small, "Table Text Size", group="Display Controls")

// --- Styling & Colors ---
colorHeaderBg      = input.color(#1A237E, "Header Banner Background", group="Styling & Colors")
colorSectionBg     = input.color(#263238, "Section Banner Background", group="Styling & Colors")
colorCEColor       = input.color(#00E676, "CE / Bullish Accent Color", group="Styling & Colors")
colorPEColor       = input.color(#FF1744, "PE / Bearish Accent Color", group="Styling & Colors")
colorNeutralColor  = input.color(#FFD600, "Neutral Accent Color", group="Styling & Colors")

// ==========================================
// HELPER FUNCTIONS & STRIKE AUTO-DETECTION
// ==========================================

f_get_strike_step(float spot_price) =>
    float s = 50.0
    if na(spot_price) or spot_price <= 0
        s := 50.0
    else if spot_price < 100
        s := 1.0
    else if spot_price < 250
        s := 2.5
    else if spot_price < 500
        s := 5.0
    else if spot_price < 1200
        s := 10.0
    else if spot_price < 2500
        s := 20.0
    else if spot_price < 5000
        s := 50.0
    else
        s := 100.0
    s

f_calc_atm_strike(float spot_price) =>
    float step = f_get_strike_step(spot_price)
    math.round(spot_price / step) * step

// Struct to hold per-stock security data & analytics
type StockAnalytics
    string symbol
    bool enabled
    float spot_c
    float spot_o
    float spot_prev_c
    float atm_strike
    float open_atm_strike
    bool ce_above_real_bep
    bool pe_above_real_bep
    bool ce_above_open_bep
    bool pe_above_open_bep
    bool neutral_open_bep
    float ce_iv
    float pe_iv
    bool is_pe_iv_only
    bool is_ce_iv_only
    bool is_neutral_iv

// Single-Security Request Stock Evaluation Function (1 Security Call = 1 Stock)
f_eval_nifty_stock_single(string root_sym, bool is_enabled) =>
    StockAnalytics res = StockAnalytics.new()
    res.symbol := root_sym
    res.enabled := is_enabled
    
    if is_enabled
        [spot_close, spot_prev_close, spot_open] = request.security("NSE:" + root_sym, timeframe.period, [close, close[1], open], ignore_invalid_symbol=true)
        
        float eval_spot = spot_close
        if useOffHoursPrevClose and (na(spot_close) or spot_close <= 0 or not barstate.isrealtime)
            eval_spot := not na(spot_prev_close) and spot_prev_close > 0 ? spot_prev_close : spot_close
            
        if not na(eval_spot) and eval_spot > 0
            res.spot_c      := eval_spot
            res.spot_o      := spot_open
            res.spot_prev_c := spot_prev_close
            
            float atm_st  = f_calc_atm_strike(eval_spot)
            float open_st = f_calc_atm_strike(spot_open)
            res.atm_strike      := atm_st
            res.open_atm_strike := open_st
            
            res.ce_above_real_bep := eval_spot > atm_st
            res.pe_above_real_bep := eval_spot < atm_st
            
            res.ce_above_open_bep := eval_spot > open_st
            res.pe_above_open_bep := eval_spot < open_st
            res.neutral_open_bep  := (eval_spot == open_st)
            
            res.ce_iv := math.max(0.0, eval_spot - atm_st)
            res.pe_iv := math.max(0.0, atm_st - eval_spot)
            
            res.is_pe_iv_only := (res.pe_iv > 0.0) and (res.ce_iv <= 0.0)
            res.is_ce_iv_only := (res.ce_iv > 0.0) and (res.pe_iv <= 0.0)
            res.is_neutral_iv := ((res.ce_iv > 0.0) and (res.pe_iv > 0.0)) or ((res.ce_iv <= 0.0) and (res.pe_iv <= 0.0))
    res

// ==========================================
// BATCH 1 STOCKS (STOCKS 1 TO 25)
// ==========================================

StockAnalytics s1  = f_eval_nifty_stock_single("RELIANCE",   true)
StockAnalytics s2  = f_eval_nifty_stock_single("HDFCBANK",   true)
StockAnalytics s3  = f_eval_nifty_stock_single("ICICIBANK",  true)
StockAnalytics s4  = f_eval_nifty_stock_single("INFY",       true)
StockAnalytics s5  = f_eval_nifty_stock_single("TCS",        true)
StockAnalytics s6  = f_eval_nifty_stock_single("ITC",        true)
StockAnalytics s7  = f_eval_nifty_stock_single("BHARTIARTL", true)
StockAnalytics s8  = f_eval_nifty_stock_single("LT",         true)
StockAnalytics s9  = f_eval_nifty_stock_single("KOTAKBANK",  true)
StockAnalytics s10 = f_eval_nifty_stock_single("AXISBANK",   true)
StockAnalytics s11 = f_eval_nifty_stock_single("SBIN",       true)
StockAnalytics s12 = f_eval_nifty_stock_single("HINDUNILVR", true)
StockAnalytics s13 = f_eval_nifty_stock_single("BAJFINANCE", true)
StockAnalytics s14 = f_eval_nifty_stock_single("MARUTI",     true)
StockAnalytics s15 = f_eval_nifty_stock_single("HCLTECH",    true)
StockAnalytics s16 = f_eval_nifty_stock_single("SUNPHARMA",  true)
StockAnalytics s17 = f_eval_nifty_stock_single("TATAMOTORS", true)
StockAnalytics s18 = f_eval_nifty_stock_single("NTPC",       true)
StockAnalytics s19 = f_eval_nifty_stock_single("M_M",        true)
StockAnalytics s20 = f_eval_nifty_stock_single("POWERGRID",  true)
StockAnalytics s21 = f_eval_nifty_stock_single("ULTRACEMCO", true)
StockAnalytics s22 = f_eval_nifty_stock_single("TITAN",      true)
StockAnalytics s23 = f_eval_nifty_stock_single("ASIANPAINT", true)
StockAnalytics s24 = f_eval_nifty_stock_single("TATASTEEL",  true)
StockAnalytics s25 = f_eval_nifty_stock_single("COALINDIA",  true)

array<StockAnalytics> stockList = array.new<StockAnalytics>()

f_push_valid_stock(array<StockAnalytics> arr, StockAnalytics item) =>
    if item.enabled and not na(item.spot_c)
        array.push(arr, item)

f_push_valid_stock(stockList, s1)
f_push_valid_stock(stockList, s2)
f_push_valid_stock(stockList, s3)
f_push_valid_stock(stockList, s4)
f_push_valid_stock(stockList, s5)
f_push_valid_stock(stockList, s6)
f_push_valid_stock(stockList, s7)
f_push_valid_stock(stockList, s8)
f_push_valid_stock(stockList, s9)
f_push_valid_stock(stockList, s10)
f_push_valid_stock(stockList, s11)
f_push_valid_stock(stockList, s12)
f_push_valid_stock(stockList, s13)
f_push_valid_stock(stockList, s14)
f_push_valid_stock(stockList, s15)
f_push_valid_stock(stockList, s16)
f_push_valid_stock(stockList, s17)
f_push_valid_stock(stockList, s18)
f_push_valid_stock(stockList, s19)
f_push_valid_stock(stockList, s20)
f_push_valid_stock(stockList, s21)
f_push_valid_stock(stockList, s22)
f_push_valid_stock(stockList, s23)
f_push_valid_stock(stockList, s24)
f_push_valid_stock(stockList, s25)

// ==========================================
// AGGREGATE SUMMARY COUNTS (BATCH 1)
// ==========================================

int count_total_stocks = array.size(stockList)

int count_ce_above_real_bep = 0
int count_pe_above_real_bep = 0

int count_ce_above_open_bep = 0
int count_pe_above_open_bep = 0
int count_neutral_open_bep  = 0

int count_pe_iv_only     = 0
int count_ce_iv_only     = 0
int count_neutral_iv     = 0

string evaluatedSymbolsList = ""

if count_total_stocks > 0
    for i = 0 to count_total_stocks - 1
        StockAnalytics item = array.get(stockList, i)
        evaluatedSymbolsList += (i > 0 ? ", " : "") + item.symbol
        
        if item.ce_above_real_bep
            count_ce_above_real_bep += 1
        if item.pe_above_real_bep
            count_pe_above_real_bep += 1
        
        if item.ce_above_open_bep
            count_ce_above_open_bep += 1
        if item.pe_above_open_bep
            count_pe_above_open_bep += 1
        if item.neutral_open_bep
            count_neutral_open_bep  += 1
        
        if item.is_pe_iv_only
            count_pe_iv_only += 1
        if item.is_ce_iv_only
            count_ce_iv_only += 1
        if item.is_neutral_iv
            count_neutral_iv += 1

// --- PLOTS FOR CONSOLIDATED SCRIPT ---
plot(count_ce_above_real_bep, "B1_CE_RealBEP", display=display.none)
plot(count_pe_above_real_bep, "B1_PE_RealBEP", display=display.none)
plot(count_ce_above_open_bep, "B1_CE_OpenBEP", display=display.none)
plot(count_pe_above_open_bep, "B1_PE_OpenBEP", display=display.none)
plot(count_neutral_open_bep,  "B1_Neut_OpenBEP", display=display.none)
plot(count_pe_iv_only,     "B1_PE_IV_Only", display=display.none)
plot(count_ce_iv_only,     "B1_CE_IV_Only", display=display.none)
plot(count_neutral_iv,     "B1_Neut_IV", display=display.none)

// ==========================================
// RENDER BATCH 1 DASHBOARD TABLE
// ==========================================

f_get_table_pos(TablePos pos) =>
    switch pos
        TablePos.topRight    => position.top_right
        TablePos.topLeft     => position.top_left
        TablePos.bottomRight => position.bottom_right
        TablePos.bottomLeft  => position.bottom_left

f_get_table_text_size(TableSize sz) =>
    switch sz
        TableSize.auto   => size.auto
        TableSize.tiny   => size.tiny
        TableSize.small  => size.small
        TableSize.normal => size.normal
        TableSize.large  => size.large

var table summaryTbl = table.new(f_get_table_pos(tablePosInput), 4, 10, bgcolor=color.black, border_color=color.gray, border_width=1, force_overlay=true)
string curTextSize = f_get_table_text_size(tableTextSizeInput)

if barstate.islast
    if not showSummaryTable
        table.delete(summaryTbl)
    else
        table.cell(summaryTbl, 0, 0, "Nifty 50 ATM Stock Options Analytics [BATCH 1]", bgcolor=colorHeaderBg, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 0, "Active Stocks: " + str.tostring(count_total_stocks) + " / 25", bgcolor=colorHeaderBg, text_color=color.yellow, text_size=curTextSize)
        table.cell(summaryTbl, 2, 0, "", bgcolor=colorHeaderBg)
        table.cell(summaryTbl, 3, 0, "", bgcolor=colorHeaderBg)
        
        table.cell(summaryTbl, 0, 1, "--- REALTIME & DAY OPEN BEP ANALYTICS ---", bgcolor=colorSectionBg, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 1, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 2, 1, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 3, 1, "", bgcolor=colorSectionBg)
        
        table.cell(summaryTbl, 0, 2, "ATM CEs Above Realtime BEP", bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 2, str.tostring(count_ce_above_real_bep), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 2, "ATM PEs Above Realtime BEP", bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 2, str.tostring(count_pe_above_real_bep), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        
        table.cell(summaryTbl, 0, 3, "CEs Above Day Open BEP", bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 3, str.tostring(count_ce_above_open_bep), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 3, "PEs Above Day Open BEP", bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 3, str.tostring(count_pe_above_open_bep), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        
        table.cell(summaryTbl, 0, 4, "Neutral (Both Below Day Open BEP)", bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 4, str.tostring(count_neutral_open_bep), bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 4, "", bgcolor=color.black)
        table.cell(summaryTbl, 3, 4, "", bgcolor=color.black)
        
        table.cell(summaryTbl, 0, 5, "--- REALTIME INTRINSIC VALUE (IV) ANALYTICS ---", bgcolor=colorSectionBg, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 5, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 2, 5, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 3, 5, "", bgcolor=colorSectionBg)
        
        table.cell(summaryTbl, 0, 6, "PE IV Only (PE IV > 0)", bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 6, str.tostring(count_pe_iv_only), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 6, "CE IV Only (CE IV > 0)", bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 6, str.tostring(count_ce_iv_only), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        
        table.cell(summaryTbl, 0, 7, "Neutral IV (Both IVs Exist or Zero)", bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 7, str.tostring(count_neutral_iv), bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 7, "", bgcolor=color.black)
        table.cell(summaryTbl, 3, 7, "", bgcolor=color.black)

        if showStockListRow
            table.cell(summaryTbl, 0, 8, "--- EVALUATED BATCH 1 STOCKS LIST (" + str.tostring(count_total_stocks) + " STOCKS) ---", bgcolor=colorSectionBg, text_color=color.white, text_size=curTextSize)
            table.cell(summaryTbl, 1, 8, "", bgcolor=colorSectionBg)
            table.cell(summaryTbl, 2, 8, "", bgcolor=colorSectionBg)
            table.cell(summaryTbl, 3, 8, "", bgcolor=colorSectionBg)
            
            table.cell(summaryTbl, 0, 9, evaluatedSymbolsList, bgcolor=color.black, text_color=color.silver, text_size=size.tiny)
            table.cell(summaryTbl, 1, 9, "", bgcolor=color.black)
            table.cell(summaryTbl, 2, 9, "", bgcolor=color.black)
            table.cell(summaryTbl, 3, 9, "", bgcolor=color.black)
