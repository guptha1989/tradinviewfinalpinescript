//@version=6
indicator("17.Techfrost ATM Realtime & Static BEP Analytics with Basket Average Confluence", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ==========================================
// USER INPUTS & CONFIGURATIONS
// ==========================================

enum StrikeSelectionMode
    auto        = "Auto Strike (Dynamic Spot LTP)"
    fixed       = "Fixed Strike (Manual Input)"

enum UnderlyingAsset
    auto        = "Auto Detect"
    nifty       = "NIFTY"
    banknifty   = "BANKNIFTY"
    crudeoil    = "CRUDEOIL"
    gold        = "GOLD"
    stock       = "STOCK / EQUITY"

enum OptionType
    auto        = "Auto Detect"
    ce          = "CE (Call Option)"
    pe          = "PE (Put Option)"

// --- General Parameters ---
strikeModeInput         = input.enum(StrikeSelectionMode.auto, "Strike Selection Mode", group="General Settings",
  tooltip="Auto Strike selects closest ATM strike based on Spot LTP. Fixed Strike uses manual strike input.")
manualStrikeInput       = input.float(24000.0, "Manual Fixed Strike Price", step=50.0, group="General Settings",
  tooltip="Used only when Strike Selection Mode is set to Fixed Strike.")
underlyingInput         = input.enum(UnderlyingAsset.auto, "Underlying Asset", group="General Settings",
  tooltip="Auto Detect parses chart ticker. Explicit selection forces specific asset strike step rules.")
optionTypeInput         = input.enum(OptionType.auto, "Option Type", group="General Settings",
  tooltip="Auto Detect parses CE/PE from chart ticker. Explicit selection overrides chart ticker parsing.")
spotTicker              = input.symbol("NSE:NIFTY", "Spot Index Ticker", group="General Settings",
  tooltip="Spot index ticker used to calculate Realtime Intrinsic Value (e.g. NSE:NIFTY, NSE:BANKNIFTY).")

// --- Basket Average Module Inputs ---
numStrikesInput         = input.int(5, "Basket Average Strike Count (Per Side)", minval=1, maxval=7, group="Basket Average Settings",
  tooltip="Number of ITM/OTM strike pairs included in basket average calculations (1 = ATM pair only, 5 = ATM +/- 4 strikes).")
static_bep_basis        = input.string("Day Open Price", "Static BEP Calculation Basis", options=["Day Open Price", "Previous Day Close", "First 5 Min Close", "Previous Day Settlement"], group="Basket Average Settings",
  tooltip="Select baseline reference price used to compute Static BEP lines (Matches Indicator 4 & 5A).")

// --- Alert Engine Controls ---
bep_trigger_mode        = input.string("Both", "ATM BEP Trigger Mode", options=["Realtime ATM BEP", "Static ATM BEP", "Both"], group="Alert Engine Controls",
  tooltip="Choose whether Buy/Sell triggers fire on Realtime ATM BEP line, Static ATM BEP line, or Both.")
strict_iv_filter        = input.bool(false, "Require Strict Intrinsic Value (> 0)", group="Alert Engine Controls",
  tooltip="Set to false to keep Intrinsic Value non-blocking for ATM crossover alerts.")
use_delta_vol_filter    = input.bool(false, "Require 3-Candle Delta Volume Confluence", group="Alert Engine Controls",
  tooltip="Requires 3-candle cumulative Delta Volume to be positive (> 0) for CE Buy alert and negative (< 0) for PE Sell alert.")
invalidation_pts        = input.float(6.0, "Alert Invalidation Drawdown Threshold (Pts)", minval=0.5, group="Alert Engine Controls",
  tooltip="If price moves against an active signal by more than this point threshold, the current alert is invalidated and the engine re-arms immediately.")
show_status_table       = input.bool(true, "Show Alert Conditions Status Table", group="Alert Engine Controls",
  tooltip="Displays a live status panel in the corner showing the exact pass/fail state of all alert conditions.")
table_pos_input         = input.string("Top Right", "Status Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Alert Engine Controls")

// --- Formatting Options ---
col_atm_rt              = input.color(color.white, "ATM Realtime BEP Line (L0)", group="BEP Line Formatting")
col_atm_stat            = input.color(#00E676, "ATM Static BEP Line (L0)", group="BEP Line Formatting")
width_atm               = input.int(2, "ATM BEP Lines Width", minval=1, maxval=4, group="BEP Line Formatting")
show_opp_candles        = input.bool(true, "Show Opposite Option Candles Overlay", group="Visual Signals")
show_signal_shapes      = input.bool(true, "Show CE / PE Signal Markers", group="Visual Signals")
signal_marker_size      = input.string("Tiny", "Signal Marker Size", options=["Tiny", "Small", "Normal"], group="Visual Signals")

// ==========================================
// TICKER PARSING & AUTO-DETECTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

// Detect underlying
UnderlyingAsset actualUnderlying = na
if underlyingInput == UnderlyingAsset.auto
    if str.contains(cleanTicker, "BANKNIFTY")
        actualUnderlying := UnderlyingAsset.banknifty
    else if str.contains(cleanTicker, "NIFTY")
        actualUnderlying := UnderlyingAsset.nifty
    else if str.contains(cleanTicker, "CRUDEOIL")
        actualUnderlying := UnderlyingAsset.crudeoil
    else if str.contains(cleanTicker, "GOLD") and not str.contains(cleanTicker, "GOLDM") and not str.contains(cleanTicker, "GOLDPETAL")
        actualUnderlying := UnderlyingAsset.gold
    else if str.contains(cleanTicker, "GOLDM")
        actualUnderlying := UnderlyingAsset.gold
    else
        actualUnderlying := UnderlyingAsset.stock
else
    actualUnderlying := underlyingInput

// Detect option type
bool isCall = false
bool isPut  = false

if optionTypeInput == OptionType.ce
    isCall := true
else if optionTypeInput == OptionType.pe
    isPut := true
else
    if str.contains(cleanTicker, "CE")
        isCall := true
    else if str.contains(cleanTicker, "PE")
        isPut := true
    else if str.match(cleanTicker, "C\\d+$") != ""
        isCall := true
    else if str.match(cleanTicker, "P\\d+$") != ""
        isPut := true

// Strike extraction from chart symbol
float detectedStrike = na
string tickerWithoutCEPE = ""

int tickerLen = str.length(cleanTicker)
if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, tickerLen - 2)

string matchC = str.match(cleanTicker, "C\\d+$")
string matchP = str.match(cleanTicker, "P\\d+$")

if matchC != ""
    detectedStrike := str.tonumber(str.substring(matchC, 1))
else if matchP != ""
    detectedStrike := str.tonumber(str.substring(matchP, 1))

if na(detectedStrike) and tickerWithoutCEPE != ""
    int i = str.length(tickerWithoutCEPE) - 1
    string numStr = ""
    while i >= 0
        string ch = str.substring(tickerWithoutCEPE, i, i + 1)
        if str.match(ch, "\\d") != ""
            numStr := ch + numStr
            i := i - 1
        else
            break
    if numStr != ""
        detectedStrike := str.tonumber(numStr)

float strikeStep = 50.0
if actualUnderlying == UnderlyingAsset.banknifty
    strikeStep := 100.0
else if actualUnderlying == UnderlyingAsset.crudeoil
    strikeStep := 50.0
else if actualUnderlying == UnderlyingAsset.gold
    strikeStep := 100.0
else if actualUnderlying == UnderlyingAsset.stock
    strikeStep := 10.0

float spotForStrike = request.security(spotTicker, timeframe.period, close, ignore_invalid_symbol=true)
spotForStrike := na(spotForStrike) ? (na(detectedStrike) ? manualStrikeInput : detectedStrike) : spotForStrike

float autoATM = math.round(spotForStrike / strikeStep) * strikeStep

float chartStrikePrice = na
if strikeModeInput == StrikeSelectionMode.fixed
    chartStrikePrice := manualStrikeInput
else
    chartStrikePrice := na(detectedStrike) ? autoATM : detectedStrike

float ce_strike = chartStrikePrice
float pe_strike = chartStrikePrice

// Build Option Tickers
f_build_option_symbol(float strk, bool is_call) =>
    string root = syminfo.tickerid
    if isCall or isPut
        string suf = is_call ? "CE" : "PE"
        if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
            str.substring(root, 0, str.length(root) - 2) + suf
        else if matchC != ""
            str.replace_all(root, matchC, (is_call ? "C" : "P") + str.tostring(strk, "#"))
        else if matchP != ""
            str.replace_all(root, matchP, (is_call ? "C" : "P") + str.tostring(strk, "#"))
        else
            root
    else
        string baseSym = syminfo.prefix + ":" + cleanTicker
        string optType = is_call ? "CE" : "PE"
        string strkStr = str.tostring(strk, "#")
        baseSym + strkStr + optType

f_build_ce_ticker(float strk) => f_build_option_symbol(strk, true)
f_build_pe_ticker(float strk) => f_build_option_symbol(strk, false)

string ce_ticker = f_build_ce_ticker(ce_strike)
string pe_ticker = f_build_pe_ticker(pe_strike)

// Multi-Strike offsets
float k_0  = chartStrikePrice
float k_m1 = chartStrikePrice - (1 * strikeStep)
float k_p1 = chartStrikePrice + (1 * strikeStep)
float k_m2 = chartStrikePrice - (2 * strikeStep)
float k_p2 = chartStrikePrice + (2 * strikeStep)
float k_m3 = chartStrikePrice - (3 * strikeStep)
float k_p3 = chartStrikePrice + (3 * strikeStep)
float k_m4 = chartStrikePrice - (4 * strikeStep)
float k_p4 = chartStrikePrice + (4 * strikeStep)

// ==========================================
// DATA FETCHING & OPPOSITE CANDLES OVERLAY (Matches Indicator 4 & 5A)
// ==========================================

f_get_contract_data() =>
    float d_open  = ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0)
    [d_pdc, d_pdh, d_pdl] = request.security(syminfo.tickerid, "D", [close[1], high[1], low[1]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
    var float d_f5m = na
    if ta.change(time("D")) != 0
        d_f5m := na
    if (hour == 9 and minute >= 19) or hour > 9
        if na(d_f5m)
            d_f5m := close
    [d_open, d_pdc, d_pdh, d_pdl, na(d_f5m) ? d_open : d_f5m, close]

// Fetch Opposite Option Ticker & Candle Data for Overlay
string opp_ticker = f_build_option_symbol(chartStrikePrice, not isCall)
[opp_o, opp_h, opp_l, opp_c] = request.security(syminfo.prefix + ":" + opp_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)

// Plot Opposite Option Candles Overlay
bool opp_is_bull   = nz(opp_c) >= nz(opp_o)
color opp_body_col = opp_is_bull ? color.new(#2962FF, 40) : color.new(#FF6D00, 40)
color opp_wick_col = opp_is_bull ? color.new(#2962FF, 60) : color.new(#FF6D00, 60)

plotcandle(show_opp_candles ? opp_o : na,
           show_opp_candles ? opp_h : na,
           show_opp_candles ? opp_l : na,
           show_opp_candles ? opp_c : na,
           title="Opposite Option Candle", color=opp_body_col, wickcolor=opp_wick_col, bordercolor=opp_wick_col)

// Fetch Contract Data for Multi-Strikes
[ce_0_o, ce_0_pdc, ce_0_pdh, ce_0_pdl, ce_0_f5m, ce_0_ltp] = request.security(syminfo.prefix + ":" + ce_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_0_o, pe_0_pdc, pe_0_pdh, pe_0_pdl, pe_0_f5m, pe_0_ltp] = request.security(syminfo.prefix + ":" + pe_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

[ce_m1_o, ce_m1_pdc, ce_m1_pdh, ce_m1_pdl, ce_m1_f5m, ce_m1_ltp] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m1), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_m1_o, pe_m1_pdc, pe_m1_pdh, pe_m1_pdl, pe_m1_f5m, pe_m1_ltp] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m1), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

[ce_p1_o, ce_p1_pdc, ce_p1_pdh, ce_p1_pdl, ce_p1_f5m, ce_p1_ltp] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p1), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_p1_o, pe_p1_pdc, pe_p1_pdh, pe_p1_pdl, pe_p1_f5m, pe_p1_ltp] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p1), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

[ce_m2_o, ce_m2_pdc, ce_m2_pdh, ce_m2_pdl, ce_m2_f5m, ce_m2_ltp] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m2), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_m2_o, pe_m2_pdc, pe_m2_pdh, pe_m2_pdl, pe_m2_f5m, pe_m2_ltp] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m2), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

[ce_p2_o, ce_p2_pdc, ce_p2_pdh, ce_p2_pdl, ce_p2_f5m, ce_p2_ltp] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p2), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_p2_o, pe_p2_pdc, pe_p2_pdh, pe_p2_pdl, pe_p2_f5m, pe_p2_ltp] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p2), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

[ce_m3_o, ce_m3_pdc, ce_m3_pdh, ce_m3_pdl, ce_m3_f5m, ce_m3_ltp] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m3), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_m3_o, pe_m3_pdc, pe_m3_pdh, pe_m3_pdl, pe_m3_f5m, pe_m3_ltp] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m3), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

[ce_p3_o, ce_p3_pdc, ce_p3_pdh, ce_p3_pdl, ce_p3_f5m, ce_p3_ltp] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p3), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_p3_o, pe_p3_pdc, pe_p3_pdh, pe_p3_pdl, pe_p3_f5m, pe_p3_ltp] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p3), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

[ce_m4_o, ce_m4_pdc, ce_m4_pdh, ce_m4_pdl, ce_m4_f5m, ce_m4_ltp] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m4), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_m4_o, pe_m4_pdc, pe_m4_pdh, pe_m4_pdl, pe_m4_f5m, pe_m4_ltp] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m4), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

[ce_p4_o, ce_p4_pdc, ce_p4_pdh, ce_p4_pdl, ce_p4_f5m, ce_p4_ltp] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p4), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_p4_o, pe_p4_pdc, pe_p4_pdh, pe_p4_pdl, pe_p4_f5m, pe_p4_ltp] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p4), timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

float spot_ltp = request.security(spotTicker, timeframe.period, close, ignore_invalid_symbol=true)
spot_ltp := na(spot_ltp) ? chartStrikePrice : spot_ltp

// Resolve Basis Reference Values (Matches Indicator 4 f_resolve_basis)
f_resolve_basis(float dop, float pdc, float f5m) =>
    (static_bep_basis == "Previous Day Close" or static_bep_basis == "Previous Day Settlement") ? pdc : (static_bep_basis == "First 5 Min Close" ? f5m : dop)

float ce_0_ref  = f_resolve_basis(ce_0_o, ce_0_pdc, ce_0_f5m)
float pe_0_ref  = f_resolve_basis(pe_0_o, pe_0_pdc, pe_0_f5m)

float ce_m1_ref = f_resolve_basis(ce_m1_o, ce_m1_pdc, ce_m1_f5m)
float pe_m1_ref = f_resolve_basis(pe_m1_o, pe_m1_pdc, pe_m1_f5m)
float ce_p1_ref = f_resolve_basis(ce_p1_o, ce_p1_pdc, ce_p1_f5m)
float pe_p1_ref = f_resolve_basis(pe_p1_o, pe_p1_pdc, pe_p1_f5m)

float ce_m2_ref = f_resolve_basis(ce_m2_o, ce_m2_pdc, ce_m2_f5m)
float pe_m2_ref = f_resolve_basis(pe_m2_o, pe_m2_pdc, pe_m2_f5m)
float ce_p2_ref = f_resolve_basis(ce_p2_o, ce_p2_pdc, ce_p2_f5m)
float pe_p2_ref = f_resolve_basis(pe_p2_o, pe_p2_pdc, pe_p2_f5m)

float ce_m3_ref = f_resolve_basis(ce_m3_o, ce_m3_pdc, ce_m3_f5m)
float pe_m3_ref = f_resolve_basis(pe_m3_o, pe_m3_pdc, pe_m3_f5m)
float ce_p3_ref = f_resolve_basis(ce_p3_o, ce_p3_pdc, ce_p3_f5m)
float pe_p3_ref = f_resolve_basis(pe_p3_o, pe_p3_pdc, pe_p3_f5m)

float ce_m4_ref = f_resolve_basis(ce_m4_o, ce_m4_pdc, ce_m4_f5m)
float pe_m4_ref = f_resolve_basis(pe_m4_o, pe_m4_pdc, pe_m4_f5m)
float ce_p4_ref = f_resolve_basis(ce_p4_o, ce_p4_pdc, ce_p4_f5m)
float pe_p4_ref = f_resolve_basis(pe_p4_o, pe_p4_pdc, pe_p4_f5m)

// ==========================================
// BASKET AVERAGE MODULE CALCULATIONS
// ==========================================

float sum_ce_open = nz(ce_0_ref)
float sum_pe_open = nz(pe_0_ref)

float sum_ce_cur  = nz(ce_0_ltp)
float sum_pe_cur  = nz(pe_0_ltp)

int total_count = 1

if numStrikesInput >= 2
    sum_ce_open += nz(ce_p1_ref) + nz(ce_m1_ref)
    sum_pe_open += nz(pe_p1_ref) + nz(pe_m1_ref)
    sum_ce_cur  += nz(ce_p1_ltp) + nz(ce_m1_ltp)
    sum_pe_cur  += nz(pe_p1_ltp) + nz(pe_m1_ltp)
    total_count += 2

if numStrikesInput >= 3
    sum_ce_open += nz(ce_p2_ref) + nz(ce_m2_ref)
    sum_pe_open += nz(pe_p2_ref) + nz(pe_m2_ref)
    sum_ce_cur  += nz(ce_p2_ltp) + nz(ce_m2_ltp)
    sum_pe_cur  += nz(pe_p2_ltp) + nz(pe_m2_ltp)
    total_count += 2

if numStrikesInput >= 4
    sum_ce_open += nz(ce_p3_ref) + nz(ce_m3_ref)
    sum_pe_open += nz(pe_p3_ref) + nz(pe_m3_ref)
    sum_ce_cur  += nz(ce_p3_ltp) + nz(ce_m3_ltp)
    sum_pe_cur  += nz(pe_p3_ltp) + nz(pe_m3_ltp)
    total_count += 2

if numStrikesInput >= 5
    sum_ce_open += nz(ce_p4_ref) + nz(ce_m4_ref)
    sum_pe_open += nz(pe_p4_ref) + nz(pe_m4_ref)
    sum_ce_cur  += nz(ce_p4_ltp) + nz(ce_m4_ltp)
    sum_pe_cur  += nz(pe_p4_ltp) + nz(pe_m4_ltp)
    total_count += 2

float ceAvgOpen = sum_ce_open / total_count
float peAvgOpen = sum_pe_open / total_count

float ceAvgCur  = sum_ce_cur / total_count
float peAvgCur  = sum_pe_cur / total_count

float ceAvgChg  = ceAvgCur - ceAvgOpen
float peAvgChg  = peAvgCur - peAvgOpen

// Realtime Intrinsic Values (Matches Indicator 5A Formula)
float ce_iv_rt  = math.max(0.0, spot_ltp - ce_strike)
float pe_iv_rt  = math.max(0.0, pe_strike - spot_ltp)
float avg_iv_rt = (ce_iv_rt + pe_iv_rt) / 2.0

// Realtime Time Values (Matches Indicator 5A Formula)
float ce_0_ltp_clean = nz(ce_0_ltp, isCall ? close : nz(opp_c, close))
float pe_0_ltp_clean = nz(pe_0_ltp, isPut ? close : nz(opp_c, close))

float ce_tv_rt  = math.max(0.0, ce_0_ltp_clean - ce_iv_rt)
float pe_tv_rt  = math.max(0.0, pe_0_ltp_clean - pe_iv_rt)
float avg_tv_rt = (ce_tv_rt + pe_tv_rt) / 2.0

// ATM Realtime & Static BEP Lines (Matches Indicator 4 Formula)
float ce_0_ref_clean = nz(ce_0_ref, isCall ? open : nz(opp_o, open))
float pe_0_ref_clean = nz(pe_0_ref, isPut ? open : nz(opp_o, open))

float bep_rt_0   = (ce_0_ltp_clean + pe_0_ltp_clean) / 2.0
float bep_stat_0 = (ce_0_ref_clean + pe_0_ref_clean) / 2.0

// Plot ATM Realtime & Static BEP Lines ONLY
plot(bep_rt_0,   title="ATM Realtime BEP (L0)", color=col_atm_rt,   linewidth=width_atm)
plot(bep_stat_0, title="ATM Static BEP (L0)",   color=col_atm_stat, linewidth=width_atm)

// ==========================================
// TRIGGER 1 ENGINE: REALTIME / STATIC ATM BEP CROSSOVER
// ==========================================

// Top Position Rules:
// 1) Both Averages Above Day Open -> require current average line on top
// 2) Both Averages Below Day Open -> require current average line on top
bool both_above_day_open = (ceAvgCur > ceAvgOpen) and (peAvgCur > peAvgOpen)
bool both_below_day_open = (ceAvgCur < ceAvgOpen) and (peAvgCur < peAvgOpen)

bool ce_top_required = both_above_day_open or both_below_day_open
bool pe_top_required = both_above_day_open or both_below_day_open

bool ce_top_pass = not ce_top_required or (ceAvgCur > peAvgCur)
bool pe_top_pass = not pe_top_required or (peAvgCur > ceAvgCur)

// Average Pass Conditions (Bypassed when both averages are below Day Open):
bool ce_avg_pass = (ceAvgCur > ceAvgOpen) or both_below_day_open
bool pe_avg_pass = (peAvgCur > peAvgOpen) or both_below_day_open

// Change Pass Conditions (Bypassed when both averages are below Day Open - NOT mandatory):
bool ce_chg_pass = (ceAvgChg > 0) or both_below_day_open
bool pe_chg_pass = (peAvgChg > 0) or both_below_day_open

// Intrinsic Value Pass Conditions (Non-strict by default to prevent blocking ATM crossover alerts):
bool ce_iv_pass  = not strict_iv_filter or (ce_iv_rt > 0)
bool pe_iv_pass  = not strict_iv_filter or (pe_iv_rt > 0)

// --- 3-Candle Cumulative Delta Volume Calculation ---
float bar_delta    = (close >= open) ? volume : -volume
float delta_3bar   = math.sum(bar_delta, 3)

bool ce_delta_pass = not use_delta_vol_filter or (delta_3bar > 0)
bool pe_delta_pass = not use_delta_vol_filter or (delta_3bar < 0)

// Full Trigger 1 Confluence Evaluation:
bool ce_trig1_conds = ce_avg_pass and ce_chg_pass and ce_iv_pass and ce_top_pass and ce_delta_pass
bool pe_trig1_conds = pe_avg_pass and pe_chg_pass and pe_iv_pass and pe_top_pass and pe_delta_pass

//// --- Unconditional Crossover & Bounce Evaluators at Bar Level (Prevents CW10002 Warnings) ---
f_crossover_up(float curr_c, float prev_c, float bep_val) =>
    float prev_bep = nz(bep_val[1], bep_val)
    not na(curr_c) and not na(prev_c) and not na(bep_val) and (curr_c > bep_val) and (prev_c <= prev_bep)

f_bounce_up(float l_val, float c_val, float bep_val) =>
    bool bounce_now     = (l_val <= bep_val) and (c_val > bep_val)
    bool bounce_confirm = not na(l_val[1]) and not na(c_val[1]) and not na(bep_val[1]) and (l_val[1] <= bep_val[1]) and (c_val[1] > bep_val[1]) and (c_val > c_val[1])
    bounce_now or bounce_confirm

bool cross_chart_close_rt   = f_crossover_up(close, close[1], bep_rt_0)
bool cross_chart_close_stat = f_crossover_up(close, close[1], bep_stat_0)

bool cross_opp_close_rt     = f_crossover_up(opp_c, opp_c[1], bep_rt_0)
bool cross_opp_close_stat   = f_crossover_up(opp_c, opp_c[1], bep_stat_0)

bool cross_ce_sec_rt        = f_crossover_up(ce_0_ltp, ce_0_ltp[1], bep_rt_0)
bool cross_ce_sec_stat      = f_crossover_up(ce_0_ltp, ce_0_ltp[1], bep_stat_0)

bool cross_pe_sec_rt        = f_crossover_up(pe_0_ltp, pe_0_ltp[1], bep_rt_0)
bool cross_pe_sec_stat      = f_crossover_up(pe_0_ltp, pe_0_ltp[1], bep_stat_0)

// Mode Selection (Realtime ATM BEP, Static ATM BEP, or Both)
bool use_rt_bep   = (bep_trigger_mode == "Realtime ATM BEP") or (bep_trigger_mode == "Both")
bool use_stat_bep = (bep_trigger_mode == "Static ATM BEP")   or (bep_trigger_mode == "Both")

bool ce_cross_rt   = use_rt_bep   and (isCall ? (cross_chart_close_rt or f_bounce_up(low, close, bep_rt_0))   : (isPut ? (cross_opp_close_rt or f_bounce_up(opp_l, opp_c, bep_rt_0))   : cross_ce_sec_rt))
bool ce_cross_stat = use_stat_bep and (isCall ? (cross_chart_close_stat or f_bounce_up(low, close, bep_stat_0)) : (isPut ? (cross_opp_close_stat or f_bounce_up(opp_l, opp_c, bep_stat_0)) : cross_ce_sec_stat))
bool ce_crossover  = ce_cross_rt or ce_cross_stat

bool pe_cross_rt   = use_rt_bep   and (isPut ? (cross_chart_close_rt or f_bounce_up(low, close, bep_rt_0))   : (isCall ? (cross_opp_close_rt or f_bounce_up(opp_l, opp_c, bep_rt_0))   : cross_pe_sec_rt))
bool pe_cross_stat = use_stat_bep and (isPut ? (cross_chart_close_stat or f_bounce_up(low, close, bep_stat_0)) : (isCall ? (cross_opp_close_stat or f_bounce_up(opp_l, opp_c, bep_stat_0)) : cross_pe_sec_stat))
bool pe_crossover  = pe_cross_rt or pe_cross_stat

// Combined Raw Signals
bool raw_buy_alert  = ce_crossover and ce_trig1_conds
bool raw_sell_alert = pe_crossover and pe_trig1_conds

// --- Dynamic 6-Point Invalidation & Re-Arming Engine ---
var int activeSwing          = 0 // 0 = Neutral, 1 = In BUY Swing, -1 = In SELL Swing
var float active_entry_price = na

// Reset swing lock on new day open
if ta.change(time("D")) != 0
    activeSwing        := 0
    active_entry_price := na

// Check 6-Point Drawdown Invalidation on active swing
if activeSwing == 1 and not na(active_entry_price)
    float drawdown_ce       = isCall ? (active_entry_price - low) : (high - active_entry_price)
    float close_drawdown_ce = isCall ? (active_entry_price - close) : (close - active_entry_price)
    if (drawdown_ce > invalidation_pts) or (close_drawdown_ce > invalidation_pts)
        activeSwing        := 0 // Invalidate and Re-Arm engine!
        active_entry_price := na

if activeSwing == -1 and not na(active_entry_price)
    float drawdown_pe       = isPut ? (active_entry_price - low) : (high - active_entry_price)
    float close_drawdown_pe = isPut ? (active_entry_price - close) : (close - active_entry_price)
    if (drawdown_pe > invalidation_pts) or (close_drawdown_pe > invalidation_pts)
        activeSwing        := 0 // Invalidate and Re-Arm engine!
        active_entry_price := na

bool overall_buy_alert  = raw_buy_alert  and (ce_crossover or activeSwing != 1)
bool overall_sell_alert = raw_sell_alert and (pe_crossover or activeSwing != -1)

if overall_buy_alert
    activeSwing        := 1
    active_entry_price := close
else if overall_sell_alert
    activeSwing        := -1
    active_entry_price := close

// --- Signal Badges ---
f_get_marker_size(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        => size.normal

string m_size = f_get_marker_size(signal_marker_size)

if show_signal_shapes
    if overall_buy_alert
        label.new(bar_index, low, text="CE", style=label.style_label_up, color=#00E676, textcolor=color.white, size=m_size)
    else if overall_sell_alert
        label.new(bar_index, high, text="PE", style=label.style_label_down, color=#FF1744, textcolor=color.white, size=m_size)

// ==========================================
// LIVE ALERT CONDITIONS STATUS TABLE
// ==========================================

f_get_table_pos(string pos_str) =>
    switch pos_str
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

var table statusTable = table.new(f_get_table_pos(table_pos_input), 2, 7, bgcolor=color.black, border_width=1, border_color=color.gray, force_overlay=true)

if barstate.islast and show_status_table
    table.cell(statusTable, 0, 0, "Alert Condition Rule", bgcolor=#1565C0, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 0, "Current Status", bgcolor=#1565C0, text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 1, "ATM Realtime / Static Crossover", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 1, (ce_crossover or pe_crossover) ? "PASS (TRUE)" : "FAIL (FALSE)", bgcolor=(ce_crossover or pe_crossover) ? #1B5E20 : #880E4F, text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 2, "Basket Average > Day Open", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 2, ce_avg_pass ? "CE OK" : (pe_avg_pass ? "PE OK" : "FAIL"), bgcolor=(ce_avg_pass or pe_avg_pass) ? #1B5E20 : #880E4F, text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 3, "3-Candle Delta Vol Winner", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 3, (delta_3bar > 0) ? ("BUY WINNER (+" + str.tostring(delta_3bar, "#") + ")") : ("SELL WINNER (" + str.tostring(delta_3bar, "#") + ")"), bgcolor=(delta_3bar > 0) ? #1B5E20 : #880E4F, text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 4, "Basket Change > 0 (Optional)", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 4, ce_chg_pass ? "CE CHG OK" : (pe_chg_pass ? "PE CHG OK" : "FAIL"), bgcolor=(ce_chg_pass or pe_chg_pass) ? #1B5E20 : #880E4F, text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 5, "Top Position Rule", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 5, (ceAvgCur > peAvgCur) ? "CE ON TOP" : "PE ON TOP", bgcolor=(ceAvgCur > peAvgCur) ? #1B5E20 : #880E4F, text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 6, "Overall Alert Status", bgcolor=#37474F, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 6, overall_buy_alert ? "CE ALERT ACTIVE" : (overall_sell_alert ? "PE ALERT ACTIVE" : "WAITING"), bgcolor=overall_buy_alert ? #00E676 : (overall_sell_alert ? #FF1744 : color.black), text_color=overall_buy_alert ? color.black : color.white, text_size=size.small)

// --- TradingView Alert Conditions ---
alertcondition(overall_buy_alert,  title="CE Signal Alert (Call Buy)", message="CE ALERT: Call signal triggered on ATM BEP line on {{ticker}}!")
alertcondition(overall_sell_alert, title="PE Signal Alert (Put Sell)", message="PE ALERT: Put signal triggered on ATM BEP line on {{ticker}}!")
