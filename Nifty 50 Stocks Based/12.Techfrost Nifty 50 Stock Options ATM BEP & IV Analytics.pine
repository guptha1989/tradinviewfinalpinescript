//@version=6
indicator("Techfrost ATM Options BEP & Intrinsic Value Analytics", shorttitle="TF ATM BEP-IV", overlay=false, precision=2)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum TablePos
    topRight   = "Top Right"
    topLeft    = "Top Left"
    bottomRight= "Bottom Right"
    bottomLeft = "Bottom Left"

enum TableSize
    auto   = "Auto"
    tiny   = "Tiny"
    small  = "Small"
    normal = "Normal"
    large  = "Large"

enum StepOverrideChoice
    auto    = "Auto"
    step1   = "1"
    step2_5 = "2.5"
    step5   = "5"
    step10  = "10"
    step20  = "20"
    step25  = "25"
    step40  = "40"
    step50  = "50"
    step100 = "100"
    step200 = "200"

// --- Instrument Settings ---
spotTickerOverride = input.symbol("", "Spot Symbol Override (e.g. NSE:RELIANCE, NSE:NIFTY)", group="Instrument Settings",
  tooltip="Leave blank to use current chart instrument.")
strikeStepInput    = input.enum(StepOverrideChoice.auto, "Strike Step Override", group="Instrument Settings",
  tooltip="Set to Auto for auto-detection based on underlying stock/index (Auto-detects 1, 2.5, 5, 10, 20, 25, 40, 50, 100).")

// --- Display Controls ---
showSummaryTable   = input.bool(true, "Show ATM Analytics Table", group="Display Controls")
tablePosInput      = input.enum(TablePos.topRight, "Table Position", group="Display Controls")
tableTextSizeInput = input.enum(TableSize.small, "Table Text Size", group="Display Controls")

// --- Styling & Colors ---
colorHeaderBg      = input.color(#1A237E, "Header Banner Background", group="Styling & Colors")
colorSectionBg     = input.color(#263238, "Section Banner Background", group="Styling & Colors")
colorCEColor       = input.color(#00E676, "CE / Bullish Accent Color", group="Styling & Colors")
colorPEColor       = input.color(#FF1744, "PE / Bearish Accent Color", group="Styling & Colors")
colorNeutralColor  = input.color(#FFD600, "Neutral Accent Color", group="Styling & Colors")
colorCrossColor    = input.color(#00B0FF, "Crossover / Formation Highlight Color", group="Styling & Colors")

// ==========================================
// TICKER PARSING & SPOT RESOLUTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

// Extract base stock/symbol root
string tickerWithoutCEPE = cleanTicker
if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, str.length(cleanTicker) - 2)

string symbolRoot = str.match(tickerWithoutCEPE, "^[A-Z&]+")
if symbolRoot == ""
    symbolRoot := cleanTicker

string spotTicker = str.length(spotTickerOverride) > 0 ? spotTickerOverride : syminfo.prefix + ":" + symbolRoot

// Fetch Spot Price Data (Close, Previous Close, Open)
[spot_close, spot_prev_close, spot_open] = request.security(spotTicker, timeframe.period, [close, close[1], open], ignore_invalid_symbol=true)
float validSpot = na(spot_close) or spot_close <= 0 ? close : spot_close

// Dynamic Strike Step Auto-Detection
f_auto_detect_step(float spot_price) =>
    float s = 50.0
    if na(spot_price) or spot_price <= 0
        s := 50.0
    else if spot_price < 100
        s := 1.0
    else if spot_price < 250
        s := 2.5
    else if spot_price < 500
        s := 5.0
    else if spot_price < 1200
        s := 10.0
    else if spot_price < 2500
        s := 20.0
    else if spot_price < 5000
        s := 50.0
    else
        s := 100.0
    s

float stepVal = 50.0
switch strikeStepInput
    StepOverrideChoice.step1   => stepVal := 1.0
    StepOverrideChoice.step2_5 => stepVal := 2.5
    StepOverrideChoice.step5   => stepVal := 5.0
    StepOverrideChoice.step10  => stepVal := 10.0
    StepOverrideChoice.step20  => stepVal := 20.0
    StepOverrideChoice.step25  => stepVal := 25.0
    StepOverrideChoice.step40  => stepVal := 40.0
    StepOverrideChoice.step50  => stepVal := 50.0
    StepOverrideChoice.step100 => stepVal := 100.0
    StepOverrideChoice.step200 => stepVal := 200.0
    => stepVal := f_auto_detect_step(validSpot)

f_format_strike(float st) =>
    st == math.floor(st) ? str.tostring(int(st)) : str.tostring(st, "#.#")

f_build_opt_ticker(string root, float strike, bool is_ce) =>
    string st_str = f_format_strike(strike)
    string type_str = is_ce ? "CE" : "PE"
    syminfo.prefix + ":" + root + st_str + type_str

// ==========================================
// LEAST DIFFERENCE ATM STRIKE SELECTION (|CE - PE|)
// ==========================================

float k_floor = math.floor(validSpot / stepVal) * stepVal
float k_ceil  = math.ceil(validSpot / stepVal) * stepVal

string ce_ticker_fl = f_build_opt_ticker(symbolRoot, k_floor, true)
string pe_ticker_fl = f_build_opt_ticker(symbolRoot, k_floor, false)

string ce_ticker_cl = f_build_opt_ticker(symbolRoot, k_ceil, true)
string pe_ticker_cl = f_build_opt_ticker(symbolRoot, k_ceil, false)

// Fetch Candidate Option Prices
[ce_c_fl, ce_prev_fl, ce_o_fl] = request.security(ce_ticker_fl, timeframe.period, [close, close[1], open], ignore_invalid_symbol=true)
[pe_c_fl, pe_prev_fl, pe_o_fl] = request.security(pe_ticker_fl, timeframe.period, [close, close[1], open], ignore_invalid_symbol=true)

[ce_c_cl, ce_prev_cl, ce_o_cl] = request.security(ce_ticker_cl, timeframe.period, [close, close[1], open], ignore_invalid_symbol=true)
[pe_c_cl, pe_prev_cl, pe_o_cl] = request.security(pe_ticker_cl, timeframe.period, [close, close[1], open], ignore_invalid_symbol=true)

// Calculate Least Difference between CE and PE Prices
float diff_fl = math.abs(nz(ce_c_fl) - nz(pe_c_fl))
float diff_cl = math.abs(nz(ce_c_cl) - nz(pe_c_cl))

bool choose_floor = (k_floor == k_ceil) or (diff_fl <= diff_cl)

float atm_strike  = choose_floor ? k_floor : k_ceil
float ce_close    = choose_floor ? ce_c_fl : ce_c_cl
float ce_prev_c  = choose_floor ? ce_prev_fl : ce_prev_cl
float ce_open     = choose_floor ? ce_o_fl : ce_o_cl

float pe_close    = choose_floor ? pe_c_fl : pe_c_cl
float pe_prev_c  = choose_floor ? pe_prev_fl : pe_prev_cl
float pe_open     = choose_floor ? pe_o_fl : pe_o_cl

// ==========================================
// BEP & INTRINSIC VALUE (IV) CALCULATIONS
// ==========================================

float real_bep = (ce_close + pe_close) / 2.0
float open_bep = (ce_open + pe_open) / 2.0
float prev_real_bep = (ce_prev_c + pe_prev_c) / 2.0

bool ce_above_real_bep = ce_close > real_bep
bool pe_above_real_bep = pe_close > real_bep

bool ce_above_open_bep = ce_close > open_bep
bool pe_above_open_bep = pe_close > open_bep
bool neutral_open_bep  = (ce_close <= open_bep) and (pe_close <= open_bep)

// BEP Crossovers
bool ce_cross_above_real_bep = (ce_prev_c <= prev_real_bep) and (ce_close > real_bep)
bool ce_cross_below_real_bep = (ce_prev_c >= prev_real_bep) and (ce_close < real_bep)

bool pe_cross_above_real_bep = (pe_prev_c <= prev_real_bep) and (pe_close > real_bep)
bool pe_cross_below_real_bep = (pe_prev_c >= prev_real_bep) and (pe_close < real_bep)

// Intrinsic Value (IV) Calculations
float ce_iv = math.max(0.0, validSpot - atm_strike)
float pe_iv = math.max(0.0, atm_strike - validSpot)

bool is_pe_iv_only = (pe_iv > 0.0) and (ce_iv <= 0.0)
bool is_ce_iv_only = (ce_iv > 0.0) and (pe_iv <= 0.0)
bool is_neutral_iv = ((ce_iv > 0.0) and (pe_iv > 0.0)) or ((ce_iv <= 0.0) and (pe_iv <= 0.0))

float prev_ce_iv = math.max(0.0, spot_prev_close - atm_strike)
float prev_pe_iv = math.max(0.0, atm_strike - spot_prev_close)

bool pe_iv_just_formed = (pe_iv > 0.0) and (prev_pe_iv <= 0.0)
bool ce_iv_just_formed = (ce_iv > 0.0) and (prev_ce_iv <= 0.0)

// ==========================================
// RENDER ATM ANALYTICS TABLE
// ==========================================

f_get_table_pos(TablePos pos) =>
    switch pos
        TablePos.topRight    => position.top_right
        TablePos.topLeft     => position.top_left
        TablePos.bottomRight => position.bottom_right
        TablePos.bottomLeft  => position.bottom_left

f_get_table_text_size(TableSize sz) =>
    switch sz
        TableSize.auto   => size.auto
        TableSize.tiny   => size.tiny
        TableSize.small  => size.small
        TableSize.normal => size.normal
        TableSize.large  => size.large

var table summaryTbl = table.new(f_get_table_pos(tablePosInput), 2, 14, bgcolor=color.black, border_color=color.gray, border_width=1, force_overlay=true)

string curTextSize = f_get_table_text_size(tableTextSizeInput)

if barstate.islast
    if not showSummaryTable
        table.delete(summaryTbl)
    else
        // Row 0: Title Banner
        table.cell(summaryTbl, 0, 0, "ATM Options BEP & Intrinsic Analytics", bgcolor=colorHeaderBg, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 0, symbolRoot + " (" + f_format_strike(atm_strike) + " ATM)", bgcolor=colorHeaderBg, text_color=color.yellow, text_size=curTextSize)
        
        // Row 1: Section Banner - REALTIME BEP ANALYTICS
        table.cell(summaryTbl, 0, 1, "--- REALTIME & DAY OPEN BEP ANALYTICS ---", bgcolor=colorSectionBg, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 1, "", bgcolor=colorSectionBg)
        
        // Row 2: Realtime Prices & BEP
        table.cell(summaryTbl, 0, 2, "CE / PE Prices [Realtime BEP]", bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTbl, 1, 2, "CE:" + str.tostring(ce_close, "#.##") + " PE:" + str.tostring(pe_close, "#.##") + " [" + str.tostring(real_bep, "#.##") + "]", bgcolor=color.black, text_color=color.white, text_size=curTextSize)
        
        // Row 3: Realtime BEP Status
        string real_bep_status = ce_above_real_bep ? "ATM CE Above Realtime BEP" : (pe_above_real_bep ? "ATM PE Above Realtime BEP" : "Both Below Realtime BEP")
        color real_bep_col    = ce_above_real_bep ? colorCEColor : (pe_above_real_bep ? colorPEColor : colorNeutralColor)
        table.cell(summaryTbl, 0, 3, "Realtime BEP Status", bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTbl, 1, 3, real_bep_status, bgcolor=color.black, text_color=real_bep_col, text_size=curTextSize)
        
        // Row 4: Day Open BEP Status
        string open_bep_status = ce_above_open_bep ? "CE Above Day Open BEP" : (pe_above_open_bep ? "PE Above Day Open BEP" : "Neutral (Both Below Day Open BEP)")
        color open_bep_col    = ce_above_open_bep ? colorCEColor : (pe_above_open_bep ? colorPEColor : colorNeutralColor)
        table.cell(summaryTbl, 0, 4, "Day Open BEP Status", bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTbl, 1, 4, open_bep_status, bgcolor=color.black, text_color=open_bep_col, text_size=curTextSize)
        
        // Row 5: BEP Crossover Status
        string cross_status = "No Crossover"
        if ce_cross_above_real_bep
            cross_status := "CE Just Crossed Above Realtime BEP"
        else if ce_cross_below_real_bep
            cross_status := "CE Just Crossed Below Realtime BEP"
        else if pe_cross_above_real_bep
            cross_status := "PE Just Crossed Above Realtime BEP"
        else if pe_cross_below_real_bep
            cross_status := "PE Just Crossed Below Realtime BEP"
        table.cell(summaryTbl, 0, 5, "Just Crossed BEP Status", bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTbl, 1, 5, cross_status, bgcolor=color.black, text_color=cross_status != "No Crossover" ? colorCrossColor : color.gray, text_size=curTextSize)
        
        // Row 6: Section Banner - INTRINSIC VALUE ANALYTICS
        table.cell(summaryTbl, 0, 6, "--- REALTIME INTRINSIC VALUE (IV) ANALYTICS ---", bgcolor=colorSectionBg, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 6, "", bgcolor=colorSectionBg)
        
        // Row 7: Intrinsic Values (CE IV / PE IV)
        table.cell(summaryTbl, 0, 7, "CE IV / PE IV Values", bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTbl, 1, 7, "CE IV:" + str.tostring(ce_iv, "#.##") + " | PE IV:" + str.tostring(pe_iv, "#.##"), bgcolor=color.black, text_color=color.white, text_size=curTextSize)
        
        // Row 8: IV Segregation Status
        string iv_seg_status = is_pe_iv_only ? "PE IV Only (PE IV > 0)" : (is_ce_iv_only ? "CE IV Only (CE IV > 0)" : "Neutral IV (Both Exist / Zero)")
        color iv_seg_col    = is_pe_iv_only ? colorPEColor : (is_ce_iv_only ? colorCEColor : colorNeutralColor)
        table.cell(summaryTbl, 0, 8, "Realtime IV Segregation", bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTbl, 1, 8, iv_seg_status, bgcolor=color.black, text_color=iv_seg_col, text_size=curTextSize)
        
        // Row 9: Just Formed IV Status
        string iv_formed_status = "No New Formation"
        if pe_iv_just_formed
            iv_formed_status := "PE IV Just Formed (Prev Candle)"
        else if ce_iv_just_formed
            iv_formed_status := "CE IV Just Formed (Prev Candle)"
        table.cell(summaryTbl, 0, 9, "Just Formed IV Status", bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTbl, 1, 9, iv_formed_status, bgcolor=color.black, text_color=iv_formed_status != "No New Formation" ? colorCrossColor : color.gray, text_size=curTextSize)
