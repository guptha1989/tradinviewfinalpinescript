//@version=6
indicator("16. Techfrost Multi-Signal Confluence & BEP Alert Engine", shorttitle="TF Signals & BEP Engine", overlay=true, precision=2, max_labels_count=500, max_boxes_count=500, max_lines_count=500)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum UnderlyingAsset
    auto      = "Auto-Detect"
    nifty     = "NIFTY"
    banknifty = "BANKNIFTY"
    crudeoil  = "CRUDEOIL"
    gold      = "GOLD"
    stock     = "Stock (Equity)"

enum OptionType
    auto = "Auto-Detect"
    ce   = "Call (CE)"
    pe   = "Put (PE)"

// --- [1] Instrument & Strike Settings ---
G_INST               = "[1] Instrument & Strike Settings"
underlyingInput      = input.enum(UnderlyingAsset.auto, "Underlying Asset", group=G_INST)
optionTypeInput      = input.enum(OptionType.auto, "Option Type", group=G_INST)
spotTickerOverride   = input.symbol("", "Spot Symbol Override (e.g. NSE:RELIANCE)", group=G_INST)
strikeOverride       = input.float(0.0, "Strike Price Override", minval=0.0, group=G_INST)

// --- [2] Strategy Enable / Disable Controls ---
G_STRAT              = "[2] Strategy Enable / Disable Controls"
enableFreshIV        = input.bool(true, "Enable Strategy 1: Fresh Intrinsic Value", group=G_STRAT)
enableTV             = input.bool(true, "Enable Strategy 2: Time Value (from 5A)", group=G_STRAT)
enableBasket         = input.bool(true, "Enable Strategy 3: Basket Averages (from 6)", group=G_STRAT)
enableBEP            = input.bool(true, "Enable Strategy 4: BEP Level Touch", group=G_STRAT)
enableConfluence     = input.bool(true, "Enable Strategy 5: Strong Confluence", group=G_STRAT)

// --- [3] Master Dashboard & Performance Tables Controls ---
G_TABLES             = "[3] Master Tables & Sizing Controls"
showLiveTableInput   = input.bool(true, "Show Current Live Alerts Table", group=G_TABLES)
liveTablePosInput    = input.string("Top Right", "Current Alerts Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_TABLES)
liveTableSizeInput   = input.string("Small", "Current Alerts Table Size", options=["Auto", "Tiny", "Small", "Normal", "Large"], group=G_TABLES)

showPerfTableInput   = input.bool(true, "Show Master 5-Day Performance Table", group=G_TABLES)
perfTablePosInput    = input.string("Bottom Left", "Master Performance Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_TABLES)
perfTableSizeInput   = input.string("Small", "Master Performance Table Size", options=["Auto", "Tiny", "Small", "Normal", "Large"], group=G_TABLES)

targetPtsInput       = input.float(20.0, "Target Points for Win Definition", minval=1.0, step=1.0, group=G_TABLES)
stoplossPtsInput     = input.float(10.0, "Stop Loss Points for Loss Definition", minval=1.0, step=1.0, group=G_TABLES)

// ==========================================
// TICKER PARSING & AUTO-DETECTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

// ----- Detect underlying -----
UnderlyingAsset actualUnderlying = na
if underlyingInput == UnderlyingAsset.auto
    if str.contains(cleanTicker, "BANKNIFTY")
        actualUnderlying := UnderlyingAsset.banknifty
    else if str.contains(cleanTicker, "NIFTY")
        actualUnderlying := UnderlyingAsset.nifty
    else if str.contains(cleanTicker, "CRUDEOIL")
        actualUnderlying := UnderlyingAsset.crudeoil
    else if str.contains(cleanTicker, "GOLD") and not str.contains(cleanTicker, "GOLDM") and not str.contains(cleanTicker, "GOLDPETAL")
        actualUnderlying := UnderlyingAsset.gold
    else if str.contains(cleanTicker, "GOLDM")
        actualUnderlying := UnderlyingAsset.gold
    else
        actualUnderlying := UnderlyingAsset.stock
else
    actualUnderlying := underlyingInput

// ----- Detect option type -----
bool isCall = false
bool isPut  = false

if optionTypeInput == OptionType.ce
    isCall := true
else if optionTypeInput == OptionType.pe
    isPut := true
else
    if str.contains(cleanTicker, "CE")
        isCall := true
    else if str.contains(cleanTicker, "PE")
        isPut := true
    else if str.match(cleanTicker, "C\\d+$") != ""
        isCall := true
    else if str.match(cleanTicker, "P\\d+$") != ""
        isPut := true

// ----- Strike extraction from chart symbol -----
float detectedStrike = na
string tickerWithoutCEPE = ""

int tickerLen = str.length(cleanTicker)
if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, tickerLen - 2)

string matchC = str.match(cleanTicker, "C\\d+$")
string matchP = str.match(cleanTicker, "P\\d+$")

if matchC != ""
    detectedStrike := str.tonumber(str.substring(matchC, 1))
else if matchP != ""
    detectedStrike := str.tonumber(str.substring(matchP, 1))
else if tickerWithoutCEPE != ""
    string strikeDigits = str.match(tickerWithoutCEPE, "\\d+$")
    detectedStrike := str.tonumber(strikeDigits)

float chartStrikePrice = strikeOverride > 0.0 ? strikeOverride : detectedStrike

// ==========================================
// SPOT TICKER RESOLUTION & STRICT DAY OPEN ATM CENTER ANCHORING
// ==========================================

string spotTicker = ""
if str.length(spotTickerOverride) > 0
    spotTicker := spotTickerOverride
else
    switch actualUnderlying
        UnderlyingAsset.banknifty => spotTicker := "NSE:BANKNIFTY"
        UnderlyingAsset.nifty     => spotTicker := "NSE:NIFTY"
        UnderlyingAsset.crudeoil  => spotTicker := "MCX:CRUDEOIL1!"
        UnderlyingAsset.gold      => spotTicker := "MCX:GOLD1!"
        UnderlyingAsset.stock     =>
            string rootGuess = str.match(cleanTicker, "^[A-Z&]+")
            if rootGuess != ""
                spotTicker := syminfo.prefix + ":" + rootGuess
            else
                spotTicker := syminfo.prefix + ":" + cleanTicker

float spotDayOpen = request.security(spotTicker, "D", open, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

f_auto_detect_step(float ref_p) =>
    float s_res = 50.0
    if na(ref_p) or ref_p <= 0
        s_res := 50.0
    else if ref_p < 100
        s_res := 1.0
    else if ref_p < 250
        s_res := 2.5
    else if ref_p < 500
        s_res := 5.0
    else if ref_p < 1200
        s_res := 10.0
    else if ref_p < 2500
        s_res := 20.0
    else
        s_res := 50.0
    s_res

float stepVal = switch actualUnderlying
    UnderlyingAsset.banknifty => 100.0
    UnderlyingAsset.nifty     => 50.0
    UnderlyingAsset.crudeoil  => 50.0
    UnderlyingAsset.gold      => 100.0
    UnderlyingAsset.stock     => f_auto_detect_step(not na(chartStrikePrice) and chartStrikePrice > 0 ? chartStrikePrice : spotDayOpen)

var float baseCenterStrike = na
if barstate.isfirst or na(baseCenterStrike)
    float refPrice = strikeOverride > 0.0 ? strikeOverride : (not na(chartStrikePrice) and chartStrikePrice > 0 ? chartStrikePrice : spotDayOpen)
    baseCenterStrike := math.round(refPrice / stepVal) * stepVal

float baseStrike = baseCenterStrike

// ==========================================
// UNIVERSAL FAIL-SAFE CE & PE TICKER CONSTRUCTION
// ==========================================

f_build_option_symbol(float target_strike, bool target_is_ce) =>
    string st_digits = not na(chartStrikePrice) and chartStrikePrice > 0 ? (chartStrikePrice == math.floor(chartStrikePrice) ? str.tostring(int(chartStrikePrice)) : str.tostring(chartStrikePrice)) : (target_strike == math.floor(target_strike) ? str.tostring(int(target_strike)) : str.tostring(target_strike))
    int st_len = str.length(st_digits)
    string target_st_str = target_strike == math.floor(target_strike) ? str.tostring(int(target_strike)) : str.tostring(target_strike)
    
    if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
        int end_trim = 2
        string base_no_suffix = str.substring(cleanTicker, 0, str.length(cleanTicker) - end_trim)
        string pfx = str.substring(base_no_suffix, 0, str.length(base_no_suffix) - st_len)
        string sfx = target_is_ce ? "CE" : "PE"
        pfx + target_st_str + sfx
    else if str.match(cleanTicker, "[CP]\\d+$") != ""
        string matchCP = str.match(cleanTicker, "[CP]\\d+$")
        int matchPos = str.pos(cleanTicker, matchCP)
        string pfx = str.substring(cleanTicker, 0, matchPos)
        string cp_letter = target_is_ce ? "C" : "P"
        pfx + cp_letter + target_st_str
    else
        string rep_ticker = str.replace(cleanTicker, st_digits, target_st_str)
        rep_ticker

f_build_ce_ticker(float target_strike) => f_build_option_symbol(target_strike, true)
f_build_pe_ticker(float target_strike) => f_build_option_symbol(target_strike, false)

// 9 Strikes centered strictly around Day Open ATM
float k_0  = baseStrike
float k_p1 = baseStrike + 1.0 * stepVal
float k_p2 = baseStrike + 2.0 * stepVal
float k_p3 = baseStrike + 3.0 * stepVal
float k_p4 = baseStrike + 4.0 * stepVal

float k_m1 = baseStrike - 1.0 * stepVal
float k_m2 = baseStrike - 2.0 * stepVal
float k_m3 = baseStrike - 3.0 * stepVal
float k_m4 = baseStrike - 4.0 * stepVal

// ==========================================
// DATA FETCHING FOR STRIKES
// ==========================================

f_get_strike_close() => close

ce_c_p4 = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p4), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pe_c_p4 = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p4), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

ce_c_p3 = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p3), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pe_c_p3 = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p3), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

ce_c_p2 = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p2), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pe_c_p2 = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p2), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

ce_c_p1 = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p1), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pe_c_p1 = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p1), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

ce_c_0  = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_0),  timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pe_c_0  = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_0),  timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

ce_c_m1 = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m1), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pe_c_m1 = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m1), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

ce_c_m2 = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m2), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pe_c_m2 = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m2), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

ce_c_m3 = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m3), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pe_c_m3 = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m3), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

ce_c_m4 = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m4), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
pe_c_m4 = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m4), timeframe.period, f_get_strike_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

bool is_new_day = ta.change(time("D")) != 0

f_get_open_val(float cur_c) =>
    ta.valuewhen(is_new_day or bar_index == 0, cur_c, 0)

float ce_o_p4 = f_get_open_val(ce_c_p4), float pe_o_p4 = f_get_open_val(pe_c_p4)
float ce_o_p3 = f_get_open_val(ce_c_p3), float pe_o_p3 = f_get_open_val(pe_c_p3)
float ce_o_p2 = f_get_open_val(ce_c_p2), float pe_o_p2 = f_get_open_val(pe_c_p2)
float ce_o_p1 = f_get_open_val(ce_c_p1), float pe_o_p1 = f_get_open_val(pe_c_p1)
float ce_o_0  = f_get_open_val(ce_c_0),  float pe_o_0  = f_get_open_val(pe_c_0)
float ce_o_m1 = f_get_open_val(ce_c_m1), float pe_o_m1 = f_get_open_val(pe_c_m1)
float ce_o_m2 = f_get_open_val(ce_c_m2), float pe_o_m2 = f_get_open_val(pe_c_m2)
float ce_o_m3 = f_get_open_val(ce_c_m3), float pe_o_m3 = f_get_open_val(pe_c_m3)
float ce_o_m4 = f_get_open_val(ce_c_m4), float pe_o_m4 = f_get_open_val(pe_c_m4)

// ==========================================
// STRATEGY 1: FRESH INTRINSIC VALUE CREATION
// ==========================================

float spotLTP = close

f_calc_iv_tv(float st_val, float ce_ltp, float pe_ltp) =>
    float ce_iv = math.max(0.0, spotLTP - st_val)
    float pe_iv = math.max(0.0, st_val - spotLTP)
    float ce_tv = math.max(0.0, ce_ltp - ce_iv)
    float pe_tv = math.max(0.0, pe_ltp - pe_iv)
    [ce_iv, ce_tv, pe_iv, pe_tv]

[ce_iv_0, ce_tv_0, pe_iv_0, pe_tv_0] = f_calc_iv_tv(k_0, ce_c_0, pe_c_0)
[ce_iv_otm, ce_tv_otm, pe_iv_otm, pe_tv_otm] = f_calc_iv_tv(k_p1, ce_c_p1, pe_c_m1)
[ce_iv_itm, ce_tv_itm, pe_iv_itm, pe_tv_itm] = f_calc_iv_tv(k_m1, ce_c_m1, pe_c_p1)

bool fresh_ce_iv = enableFreshIV and (ce_iv_0 > 0 and (na(ce_iv_0[1]) or ce_iv_0[1] == 0))
bool fresh_pe_iv = enableFreshIV and (pe_iv_0 > 0 and (na(pe_iv_0[1]) or pe_iv_0[1] == 0))

bool fresh_ce_buy_signal = fresh_ce_iv
bool fresh_pe_buy_signal = fresh_pe_iv

plotshape(enableFreshIV and fresh_ce_buy_signal, title="Fresh IV BUY CE Signal", style=shape.labelup, location=location.belowbar, color=#00E676, textcolor=color.white, size=size.small, text="BUY CE (IV)")
plotshape(enableFreshIV and fresh_pe_buy_signal, title="Fresh IV BUY PE / SELL Signal", style=shape.labeldown, location=location.abovebar, color=#FF1744, textcolor=color.white, size=size.small, text="BUY PE / SELL (IV)")

alertcondition(fresh_ce_buy_signal, title="Fresh Intrinsic CE Buy Alert", message="FRESH IV ALERT: Call Option gained fresh Intrinsic Value on {{ticker}}!")
alertcondition(fresh_pe_buy_signal, title="Fresh Intrinsic PE Buy Alert", message="FRESH IV ALERT: Put Option gained fresh Intrinsic Value on {{ticker}}!")

// ==========================================
// STRATEGY 2: TIME VALUE ALERT SETUP (FROM 5A)
// ==========================================

float otm_avg_tv_rt = (ce_tv_otm + pe_tv_otm) / 2.0
float otm_avg_iv_rt = (ce_iv_otm + pe_iv_otm) / 2.0

float itm_avg_tv_rt = (ce_tv_itm + pe_tv_itm) / 2.0
float itm_avg_iv_rt = (ce_iv_itm + pe_iv_itm) / 2.0

bool otm_ce_above = close > otm_avg_tv_rt
bool otm_pe_below = pe_c_m1 < otm_avg_iv_rt
bool otm_ce_was_below = not otm_ce_above[1] or not otm_ce_above[2] or not otm_ce_above[3]
bool otm_pe_was_below = not otm_pe_below[1] or not otm_pe_below[2] or not otm_pe_below[3]

bool otm_bc_signal = (ta.crossover(close, otm_avg_tv_rt) and otm_pe_was_below) or (otm_ce_above and otm_pe_below and not (otm_ce_above[1] and otm_pe_below[1]))
bool otm_bp_signal = (ta.crossover(pe_c_m1, otm_avg_tv_rt) and otm_ce_was_below) or (not otm_ce_above and not otm_pe_below and not (not otm_ce_above[1] and not otm_pe_below[1]))

bool itm_ce_above = ce_c_m1 > itm_avg_iv_rt
bool itm_pe_below = pe_c_p1 < itm_avg_tv_rt
bool itm_ce_was_below = not itm_ce_above[1] or not itm_ce_above[2] or not itm_ce_above[3]
bool itm_pe_was_below = not itm_pe_below[1] or not itm_pe_below[2] or not itm_pe_below[3]

bool itm_bc_signal = (ta.crossover(ce_c_m1, itm_avg_iv_rt) and itm_pe_was_below) or (itm_ce_above and itm_pe_below and not (itm_ce_above[1] and itm_pe_below[1]))
bool itm_bp_signal = (ta.crossover(pe_c_p1, itm_avg_tv_rt) and itm_ce_was_below) or (itm_pe_below and not itm_ce_above and not (itm_pe_below[1] and not itm_ce_above[1]))

bool raw_bc_signal = otm_bc_signal or itm_bc_signal
bool raw_bp_signal = otm_bp_signal or itm_bp_signal

var int signal_state_itv = 0
bool tv_bc_signal = false
bool tv_bp_signal = false

if enableTV
    if raw_bc_signal and signal_state_itv != 1
        tv_bc_signal := true
        signal_state_itv := 1
    else if raw_bp_signal and signal_state_itv != -1
        tv_bp_signal := true
        signal_state_itv := -1

plotshape(enableTV and tv_bc_signal, title="Time Value BUY CE (BC)", style=shape.labelup, location=location.belowbar, color=#00E676, textcolor=color.white, size=size.small, text="BUY CE (TV)")
plotshape(enableTV and tv_bp_signal, title="Time Value BUY PE / SELL (BP)", style=shape.labeldown, location=location.abovebar, color=#FF1744, textcolor=color.white, size=size.small, text="BUY PE / SELL (TV)")

alertcondition(tv_bc_signal, title="Time Value Buy CE (BC) Alert", message="TV BC ALERT: Time Value Buy CE condition triggered on {{ticker}}!")
alertcondition(tv_bp_signal, title="Time Value Buy PE (BP) Alert", message="TV BP ALERT: Time Value Buy PE condition triggered on {{ticker}}!")

// ==========================================
// STRATEGY 3: BASKET AVERAGES CROSSOVER
// ==========================================

float sum_ce_open = nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1) + nz(ce_o_p2) + nz(ce_o_m2) + nz(ce_o_p3) + nz(ce_o_m3) + nz(ce_o_p4) + nz(ce_o_m4)
float sum_pe_open = nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1) + nz(pe_o_p2) + nz(pe_o_m2) + nz(pe_o_p3) + nz(pe_o_m3) + nz(pe_o_p4) + nz(pe_o_m4)
float sum_ce_cur  = nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1) + nz(ce_c_p2) + nz(ce_c_m2) + nz(ce_c_p3) + nz(ce_c_m3) + nz(ce_c_p4) + nz(ce_c_m4)
float sum_pe_cur  = nz(pe_c_0) + nz(pe_c_p1) + nz(pe_c_m1) + nz(pe_c_p2) + nz(pe_c_m2) + nz(pe_c_p3) + nz(pe_c_m3) + nz(pe_c_p4) + nz(pe_c_m4)

float ceAvgOpen = sum_ce_open / 9.0
float peAvgOpen = sum_pe_open / 9.0
float ceAvgCur  = sum_ce_cur  / 9.0
float peAvgCur  = sum_pe_cur  / 9.0

float ceAvgChg = ceAvgCur - ceAvgOpen
float peAvgChg = peAvgCur - peAvgOpen

bool ce_cross_above = ta.crossover(ceAvgCur, ceAvgOpen) or (ceAvgCur > ceAvgOpen and ceAvgCur[1] <= ceAvgOpen[1])
bool pe_cross_above = ta.crossover(peAvgCur, peAvgOpen) or (peAvgCur > peAvgOpen and peAvgCur[1] <= peAvgOpen[1])

bool basket_ce_buy = enableBasket and ce_cross_above and (ceAvgChg > 0)
bool basket_pe_buy = enableBasket and pe_cross_above and (peAvgChg > 0)

plotshape(enableBasket and basket_ce_buy, title="Basket Avg BUY CE Signal", style=shape.labelup, location=location.belowbar, color=#00E676, textcolor=color.white, size=size.small, text="BUY CE (BASKET)")
plotshape(enableBasket and basket_pe_buy, title="Basket Avg BUY PE / SELL Signal", style=shape.labeldown, location=location.abovebar, color=#FF1744, textcolor=color.white, size=size.small, text="BUY PE / SELL (BASKET)")

alertcondition(basket_ce_buy, title="Basket Buy CE Alert", message="BASKET CE ALERT: CE Current Avg crossed above Day Open Avg & Change is positive on {{ticker}}!")
alertcondition(basket_pe_buy, title="Basket Buy PE Alert", message="BASKET PE ALERT: PE Current Avg crossed above Day Open Avg & Change is positive on {{ticker}}!")

// ==========================================
// STRATEGY 4: BEP PROXIMITY / TOUCH ALERTS
// ==========================================

float atm_ce_bep    = baseStrike + ce_o_0
float atm_pe_bep    = baseStrike - pe_o_0
float atm_bep_pivot = (atm_ce_bep + atm_pe_bep) / 2.0

float otm_ce_bep    = k_p1 + ce_o_p1
float otm_pe_bep    = k_m1 - pe_o_m1

float itm_ce_bep    = k_m1 + ce_o_m1
float itm_pe_bep    = k_p1 - pe_o_p1

f_near_bep(float level) =>
    enableBEP and not na(level) and (math.abs(close - level) <= (stepVal * 0.1) or ta.cross(close, level))

bool bep_touch_alert = f_near_bep(atm_bep_pivot) or f_near_bep(atm_ce_bep) or f_near_bep(atm_pe_bep) or f_near_bep(otm_ce_bep) or f_near_bep(otm_pe_bep) or f_near_bep(itm_ce_bep) or f_near_bep(itm_pe_bep)

bool bep_ce_buy = bep_touch_alert and close >= open
bool bep_pe_buy = bep_touch_alert and close < open

plotshape(enableBEP and bep_ce_buy, title="BEP Touch BUY CE Signal", style=shape.labelup, location=location.belowbar, color=color.aqua, textcolor=color.black, size=size.small, text="BUY CE (BEP)")
plotshape(enableBEP and bep_pe_buy, title="BEP Touch BUY PE / SELL Signal", style=shape.labeldown, location=location.abovebar, color=#FF9100, textcolor=color.white, size=size.small, text="BUY PE / SELL (BEP)")

plot(enableBEP ? atm_bep_pivot : na, title="ATM BEP Pivot Line", color=#FFEE58, linewidth=2)
plot(enableBEP ? otm_ce_bep : na,    title="OTM Call Upper BEP", color=#FF5252, linewidth=1)
plot(enableBEP ? otm_pe_bep : na,    title="OTM Put Lower BEP",  color=#FF5252, linewidth=1)
plot(enableBEP ? itm_ce_bep : na,    title="ITM Call Upper BEP", color=#00E676, linewidth=1)
plot(enableBEP ? itm_pe_bep : na,    title="ITM Put Lower BEP",  color=#00E676, linewidth=1)

alertcondition(bep_touch_alert, title="Price at BEP Level Alert", message="BEP ALERT: Price reached an active BEP Level (ATM/OTM/ITM) on {{ticker}}!")

// ==========================================
// STRATEGY 5: STRONG CONFLUENCE ENGINE (STRONG BUY CE & STRONG BUY PE)
// ==========================================

int ce_confluence_count = (fresh_ce_buy_signal ? 1 : 0) + (tv_bc_signal ? 1 : 0) + (basket_ce_buy ? 1 : 0) + (bep_touch_alert ? 1 : 0)
int pe_confluence_count = (fresh_pe_buy_signal ? 1 : 0) + (tv_bp_signal ? 1 : 0) + (basket_pe_buy ? 1 : 0) + (bep_touch_alert ? 1 : 0)

bool strong_bc_signal = enableConfluence and (ce_confluence_count >= 2)
bool strong_bp_signal = enableConfluence and (pe_confluence_count >= 2)

plotshape(enableConfluence and strong_bc_signal, title="★ STRONG BUY CE ★", style=shape.labelup, location=location.belowbar, color=#76FF03, textcolor=color.black, size=size.normal, text="★ STRONG BUY CE ★")
plotshape(enableConfluence and strong_bp_signal, title="★ STRONG BUY PE / SELL ★", style=shape.labeldown, location=location.abovebar, color=#FF1744, textcolor=color.white, size=size.normal, text="★ STRONG BUY PE / SELL ★")

alertcondition(strong_bc_signal, title="Strong Buy CE (Strong BC) Alert", message="STRONG BC CONFLUENCE: Multiple Buy CE triggers aligned on {{ticker}}!")
alertcondition(strong_bp_signal, title="Strong Buy PE (Strong BP) Alert", message="STRONG BP CONFLUENCE: Multiple Buy PE triggers aligned on {{ticker}}!")

// ==========================================
// 5-DAY STRATEGY PERFORMANCE & SWING RISK ANALYTICS ENGINE
// ==========================================

f_eval_strategy_swing(bool sig_ce, bool sig_pe) =>
    var int trades = 0, var int wins = 0, var int losses = 0
    var float total_peak_pts = 0.0, var float total_max_dd = 0.0
    var float entry_price = na
    var bool active_ce = false, var bool active_pe = false
    var float swing_peak = 0.0, var float swing_dd = 0.0

    if active_ce
        float cur_gain = high - entry_price
        float cur_loss = entry_price - low
        if cur_gain > swing_peak
            swing_peak := cur_gain
        if cur_loss > swing_dd
            swing_dd := cur_loss

        if sig_pe or ta.change(time("D")) != 0 or barstate.islast
            trades += 1
            if swing_peak >= targetPtsInput
                wins += 1
            if swing_dd >= stoplossPtsInput
                losses += 1
            total_peak_pts += swing_peak
            total_max_dd   += swing_dd
            active_ce      := false

    else if active_pe
        float cur_gain = entry_price - low
        float cur_loss = high - entry_price
        if cur_gain > swing_peak
            swing_peak := cur_gain
        if cur_loss > swing_dd
            swing_dd := cur_loss

        if sig_ce or ta.change(time("D")) != 0 or barstate.islast
            trades += 1
            if swing_peak >= targetPtsInput
                wins += 1
            if swing_dd >= stoplossPtsInput
                losses += 1
            total_peak_pts += swing_peak
            total_max_dd   += swing_dd
            active_pe      := false

    if sig_ce and not active_ce
        active_ce   := true
        active_pe   := false
        entry_price := close
        swing_peak  := 0.0
        swing_dd    := 0.0
    else if sig_pe and not active_pe
        active_pe   := true
        active_ce   := false
        entry_price := close
        swing_peak  := 0.0
        swing_dd    := 0.0

    [trades, wins, losses, total_peak_pts, total_max_dd]

[st1_t, st1_w, st1_l, st1_pts, st1_dd] = f_eval_strategy_swing(fresh_ce_buy_signal, fresh_pe_buy_signal)
[st2_t, st2_w, st2_l, st2_pts, st2_dd] = f_eval_strategy_swing(tv_bc_signal, tv_bp_signal)
[st3_t, st3_w, st3_l, st3_pts, st3_dd] = f_eval_strategy_swing(basket_ce_buy, basket_pe_buy)
[st4_t, st4_w, st4_l, st4_pts, st4_dd] = f_eval_strategy_swing(bep_ce_buy, bep_pe_buy)
[st5_t, st5_w, st5_l, st5_pts, st5_dd] = f_eval_strategy_swing(strong_bc_signal, strong_bp_signal)

// ==========================================
// DASHBOARD TABLES
// ==========================================

f_get_table_pos(string pos_str) =>
    switch pos_str
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

f_get_table_text_size(string sz_str) =>
    switch sz_str
        "Auto"   => size.auto
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

// Table 1: Current Live Alert Matrix Table
var table dashTable = table.new(f_get_table_pos(liveTablePosInput), 4, 10, bgcolor=color.black, border_width=1, border_color=color.gray, force_overlay=true)

if barstate.islast
    if not showLiveTableInput
        table.delete(dashTable)
    else
        string sz = f_get_table_text_size(liveTableSizeInput)
        table.cell(dashTable, 0, 0, "Strategy / Trigger", bgcolor=#1565C0, text_color=color.white, text_size=sz)
        table.cell(dashTable, 1, 0, "Call (CE) Value", bgcolor=#1565C0, text_color=color.white, text_size=sz)
        table.cell(dashTable, 2, 0, "Put (PE) Value", bgcolor=#1565C0, text_color=color.white, text_size=sz)
        table.cell(dashTable, 3, 0, "Current Live Alert Status", bgcolor=#1565C0, text_color=color.white, text_size=sz)

        // Row 1: Fresh Intrinsic Value
        table.cell(dashTable, 0, 1, "1. Fresh Intrinsic Value", bgcolor=#212121, text_color=color.white, text_size=sz)
        table.cell(dashTable, 1, 1, str.tostring(ce_iv_0, "#.##"), bgcolor=color.black, text_color=ce_iv_0 > 0 ? #00E676 : color.gray, text_size=sz)
        table.cell(dashTable, 2, 1, str.tostring(pe_iv_0, "#.##"), bgcolor=color.black, text_color=pe_iv_0 > 0 ? #FF1744 : color.gray, text_size=sz)
        table.cell(dashTable, 3, 1, fresh_ce_buy_signal ? "BUY CE" : (fresh_pe_buy_signal ? "BUY PE / SELL" : "NO ALERT"), bgcolor=fresh_ce_buy_signal ? #1B5E20 : (fresh_pe_buy_signal ? #880E4F : color.black), text_color=color.white, text_size=sz)

        // Row 2: Time Value Alert
        table.cell(dashTable, 0, 2, "2. Time Value (5A)", bgcolor=#212121, text_color=color.white, text_size=sz)
        table.cell(dashTable, 1, 2, str.tostring(ce_tv_0, "#.##"), bgcolor=color.black, text_color=color.white, text_size=sz)
        table.cell(dashTable, 2, 2, str.tostring(pe_tv_0, "#.##"), bgcolor=color.black, text_color=color.white, text_size=sz)
        table.cell(dashTable, 3, 2, tv_bc_signal ? "BUY CE (BC)" : (tv_bp_signal ? "BUY PE / SELL (BP)" : "WAIT"), bgcolor=tv_bc_signal ? #1B5E20 : (tv_bp_signal ? #880E4F : color.black), text_color=color.white, text_size=sz)

        // Row 3: Basket Averages
        table.cell(dashTable, 0, 3, "3. Basket Averages (6)", bgcolor=#212121, text_color=color.white, text_size=sz)
        table.cell(dashTable, 1, 3, str.tostring(ceAvgCur, "#.##") + " (" + (ceAvgChg >= 0 ? "+" : "") + str.tostring(ceAvgChg, "#.##") + ")", bgcolor=color.black, text_color=ceAvgChg >= 0 ? #00E676 : #FF5252, text_size=sz)
        table.cell(dashTable, 2, 3, str.tostring(peAvgCur, "#.##") + " (" + (peAvgChg >= 0 ? "+" : "") + str.tostring(peAvgChg, "#.##") + ")", bgcolor=color.black, text_color=peAvgChg >= 0 ? #00E676 : #FF5252, text_size=sz)
        table.cell(dashTable, 3, 3, basket_ce_buy ? "BUY CE" : (basket_pe_buy ? "BUY PE / SELL" : "FLAT"), bgcolor=basket_ce_buy ? #1B5E20 : (basket_pe_buy ? #880E4F : color.black), text_color=color.white, text_size=sz)

        // Row 4: BEP Touch Status
        table.cell(dashTable, 0, 4, "4. BEP Level Touch", bgcolor=#212121, text_color=color.white, text_size=sz)
        table.cell(dashTable, 1, 4, "ATM Pivot: " + str.tostring(atm_bep_pivot, "#.##"), bgcolor=color.black, text_color=color.aqua, text_size=sz)
        table.cell(dashTable, 2, 4, "OTM/ITM BEP", bgcolor=color.black, text_color=color.silver, text_size=sz)
        table.cell(dashTable, 3, 4, bep_touch_alert ? (close >= open ? "BUY CE (BEP)" : "BUY PE / SELL (BEP)") : "CLEAR", bgcolor=bep_touch_alert ? #F57F17 : color.black, text_color=color.white, text_size=sz)

        // Row 5: Confluence State
        table.cell(dashTable, 0, 5, "5. Strong Confluence", bgcolor=#37474F, text_color=color.white, text_size=sz)
        table.cell(dashTable, 1, 5, "CE Triggers: " + str.tostring(ce_confluence_count), bgcolor=#37474F, text_color=#76FF03, text_size=sz)
        table.cell(dashTable, 2, 5, "PE Triggers: " + str.tostring(pe_confluence_count), bgcolor=#37474F, text_color=#FF1744, text_size=sz)
        table.cell(dashTable, 3, 5, strong_bc_signal ? "STRONG BUY CE" : (strong_bp_signal ? "STRONG BUY PE / SELL" : "NEUTRAL"), bgcolor=strong_bc_signal ? #76FF03 : (strong_bp_signal ? #FF1744 : color.black), text_color=strong_bc_signal ? color.black : color.white, text_size=sz)

// Table 2: Master 5-Day Strategy Performance Table (KEPT SEPARATELY)
var table perfTable = table.new(f_get_table_pos(perfTablePosInput), 7, 7, bgcolor=color.black, border_width=1, border_color=color.gray, force_overlay=true)

f_fill_perf_row(table tbl, int r, string st_name, int t_count, int w_count, int l_count, float peak_pts, float max_dd_pts, string sz_str) =>
    float win_rate = t_count > 0 ? (float(w_count) / float(t_count) * 100.0) : 0.0
    float net_profit = peak_pts - max_dd_pts
    color wr_color   = win_rate >= 50.0 ? #00E676 : (win_rate > 0 ? #FF9100 : color.gray)
    color net_color  = net_profit >= 0.0 ? #00E676 : #FF1744

    table.cell(tbl, 0, r, st_name, bgcolor=#212121, text_color=color.white, text_size=sz_str)
    table.cell(tbl, 1, r, str.tostring(t_count), bgcolor=color.black, text_color=color.white, text_size=sz_str)
    table.cell(tbl, 2, r, str.tostring(w_count) + " W / " + str.tostring(l_count) + " L", bgcolor=color.black, text_color=color.silver, text_size=sz_str)
    table.cell(tbl, 3, r, str.tostring(win_rate, "#.#") + "%", bgcolor=color.black, text_color=wr_color, text_size=sz_str)
    table.cell(tbl, 4, r, "+" + str.tostring(peak_pts, "#.#") + " pts", bgcolor=color.black, text_color=#00E676, text_size=sz_str)
    table.cell(tbl, 5, r, "-" + str.tostring(max_dd_pts, "#.#") + " pts", bgcolor=color.black, text_color=#FF1744, text_size=sz_str)
    table.cell(tbl, 6, r, (net_profit >= 0 ? "+" : "") + str.tostring(net_profit, "#.#") + " pts", bgcolor=color.black, text_color=net_color, text_size=sz_str)

if barstate.islast
    if not showPerfTableInput
        table.delete(perfTable)
    else
        string psz = f_get_table_text_size(perfTableSizeInput)
        table.cell(perfTable, 0, 0, "Master 5-Day Strategy Matrix", bgcolor=#006064, text_color=color.aqua, text_size=psz)
        table.cell(perfTable, 1, 0, "Trades", bgcolor=#006064, text_color=color.white, text_size=psz)
        table.cell(perfTable, 2, 0, "Win / Loss", bgcolor=#006064, text_color=color.white, text_size=psz)
        table.cell(perfTable, 3, 0, "Win Rate %", bgcolor=#006064, text_color=color.white, text_size=psz)
        table.cell(perfTable, 4, 0, "Max Swing Pts", bgcolor=#006064, text_color=color.white, text_size=psz)
        table.cell(perfTable, 5, 0, "Max Drawdown (SL)", bgcolor=#006064, text_color=color.white, text_size=psz)
        table.cell(perfTable, 6, 0, "Net Profit Pts", bgcolor=#006064, text_color=color.white, text_size=psz)

        f_fill_perf_row(perfTable, 1, "1. Fresh Intrinsic Value", st1_t, st1_w, st1_l, st1_pts, st1_dd, psz)
        f_fill_perf_row(perfTable, 2, "2. Time Value (5A)",       st2_t, st2_w, st2_l, st2_pts, st2_dd, psz)
        f_fill_perf_row(perfTable, 3, "3. Basket Averages (6)",  st3_t, st3_w, st3_l, st3_pts, st3_dd, psz)
        f_fill_perf_row(perfTable, 4, "4. BEP Level Touch",       st4_t, st4_w, st4_l, st4_pts, st4_dd, psz)
        f_fill_perf_row(perfTable, 5, "5. Strong Confluence",     st5_t, st5_w, st5_l, st5_pts, st5_dd, psz)
