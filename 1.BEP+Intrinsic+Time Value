//@version=6
indicator("Techfrost Intrinsic,BEP,Time Value All - Options Intrinsic Value (Spot Open-New) 1", overlay=true, precision=2)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum TimeValueFormula
    standard = "Option Price - Intrinsic Value"
    custom = "Strike Price - Intrinsic Value"

enum UnderlyingAsset
    auto     = "Auto-Detect"
    nifty    = "NIFTY"
    banknifty = "BANKNIFTY"
    crudeoil = "CRUDEOIL"
    gold     = "GOLD"
    stock    = "Stock (Equity)"

enum OptionType
    auto = "Auto-Detect"
    ce   = "Call (CE)"
    pe   = "Put (PE)"

enum CalculationBasis
    dayOpen   = "Today's Day Open"
    prevClose = "Previous Day Close"
    first5Min = "First 5 Min Close"

enum StrikeStepOption
    step50  = "50 Points (+50 / -50)"
    step100 = "100 Points (+100 / -100)"

// --- Instrument & Strike Settings ---
underlyingInput    = input.enum(UnderlyingAsset.auto, "Underlying Asset", group="Instrument Settings")
optionTypeInput    = input.enum(OptionType.auto, "Option Type", group="Instrument Settings")
spotTickerOverride = input.symbol("", "Spot Symbol Override (e.g. NSE:RELIANCE)", group="Instrument Settings")
strikeOverride     = input.float(0.0, "Strike Price Override", minval=0.0, group="Instrument Settings")

// --- Intrinsic & Time Value Settings ---
ivTvCalcBasisInput    = input.enum(CalculationBasis.dayOpen, "Intrinsic & Time Value Basis", group="Intrinsic & Time Value",
  tooltip="Choose whether static reference levels for Intrinsic and Time Value are calculated based on Today's 9:15 AM Open, Previous Day Close, or First 5 Min Close.")
minRangeInput        = input.float(0.0, "Min Intrinsic Value Range", group="Intrinsic & Time Value")
maxRangeInput        = input.float(5000.0, "Max Intrinsic Value Range", group="Intrinsic & Time Value")
timeValueFormulaInput = input.enum(TimeValueFormula.standard, "Time Value Formula", group="Intrinsic & Time Value")
useAverageValuesInput = input.bool(false, "Use Average Intrinsic & Time Value (CE + PE)", group="Intrinsic & Time Value",
  tooltip="When enabled, calculates the average Intrinsic and Time Value of CE and PE for the strike. When disabled, displays actual single option values.")

// --- BEP Settings ---
bepCalcBasisInput     = input.enum(CalculationBasis.dayOpen, "Static BEP Basis", group="BEP Settings",
  tooltip="Choose whether Static BEP is calculated based on Today's 9:15 AM Open, Previous Day Close, or First 5 Min Close.")
showStaticBEPInput   = input.bool(true, "Show Static BEP Line", group="BEP Settings",
  tooltip="Static BEP = (CE Ref Price + PE Ref Price) / 2")
showRealtimeBEPInput = input.bool(true, "Show Realtime Dynamic BEP Line", group="BEP Settings",
  tooltip="Realtime BEP = (CE Current Price + PE Current Price) / 2")

// --- VWAP Settings ---
showVWAPInput        = input.bool(true, "Show CE & PE VWAP Lines", group="VWAP Settings",
  tooltip="Plots intraday Volume Weighted Average Price (VWAP) for both Call (CE) and Put (PE) options.")

// --- CM Ultimate MACD Settings ---
showMACDSignalsInput   = input.bool(true, "Show MACD Buy/Sell Signals & Status", group="CM Ultimate MACD Settings")
macdTimeframeInput     = input.timeframe("", "MACD Timeframe", group="CM Ultimate MACD Settings")
macdFastLength         = input.int(12, "Fast Length", minval=1, group="CM Ultimate MACD Settings")
macdSlowLength         = input.int(26, "Slow Length", minval=1, group="CM Ultimate MACD Settings")
macdSignalLength       = input.int(9, "Signal Smoothing", minval=1, maxval=999, group="CM Ultimate MACD Settings")
macdSmaSource          = input.string("EMA", "Oscillator MA Type", options=["SMA", "EMA"], group="CM Ultimate MACD Settings")
macdSmaSignal          = input.string("EMA", "Signal Line MA Type", options=["SMA", "EMA"], group="CM Ultimate MACD Settings")

// --- PDC Line Settings ---
showPDCInput         = input.bool(true, "Show Selected Strike CE & PE Prev Close Lines", group="PDC Line Settings",
  tooltip="Plots horizontal lines for the Previous Day Close of both Call (CE) and Put (PE) for the selected strike.")

// --- Multi-Strike Table Settings ---
strikeStepChoice       = input.enum(StrikeStepOption.step50, "7-Strike Table Step Size", group="Multi-Strike Table Settings",
  tooltip="Select the strike offset step size (+50/-50 or +100/-100) for the 7-strike table.")
showMultiBEPTableInput = input.bool(true, "Show 7-Strike BEP & Change Table", group="Multi-Strike Table Settings",
  tooltip="Displays a 7-strike table (3 below, 1 selected, 3 above) showing Static BEP, Day Open, and Points Changed.")
multiBEPTablePosInput  = input.string("Bottom Right", "Multi-Strike Table Position", options=["Bottom Right", "Bottom Left", "Top Right", "Top Left"], group="Multi-Strike Table Settings")

// --- Opposite Candle Overlay Settings ---
showOppCandlesInput  = input.bool(true, "Show Opposite Option Candles", group="Opposite Candle Overlay",
  tooltip="Plots real-time opposite option contract candles (e.g. PE candles on CE chart, CE candles on PE chart).")

// --- Display Controls ---
showTableInput       = input.bool(true, "Show Info Dashboard", group="Display Controls")
showTimeValueInput   = input.bool(true, "Show Time Value", group="Display Controls")

// --- Styling & Colors ---
colorIV          = input.color(#FF00FF, "Intrinsic Value Color", group="Styling & Colors")
colorTimeValue   = input.color(color.yellow, "Time Value Color", group="Styling & Colors")
colorStaticBEP   = input.color(color.aqua, "Static BEP Line Color", group="Styling & Colors")
colorRealtimeBEP = input.color(color.orange, "Realtime BEP Line Color", group="Styling & Colors")

colorCEVWAP      = input.color(#00E676, "CE VWAP Color", group="Styling & Colors")
colorPEVWAP      = input.color(#FF5252, "PE VWAP Color", group="Styling & Colors")

colorCEPDC       = input.color(color.new(#00E676, 20), "CE Prev Close Line Color", group="Styling & Colors")
colorPEPDC       = input.color(color.new(#FF5252, 20), "PE Prev Close Line Color", group="Styling & Colors")

colorOppBull     = input.color(color.new(#2962FF, 40), "Opposite Bullish Body", group="Styling & Colors")
colorOppBear     = input.color(color.new(#FF6D00, 40), "Opposite Bearish Body", group="Styling & Colors")
colorOppWickBull = input.color(color.new(#2962FF, 60), "Opposite Bullish Wick", group="Styling & Colors")
colorOppWickBear = input.color(color.new(#FF6D00, 60), "Opposite Bearish Wick", group="Styling & Colors")

// ==========================================
// TICKER PARSING & AUTO-DETECTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

int tickerLen = str.length(cleanTicker)

// ----- Detect underlying -----
UnderlyingAsset actualUnderlying = na
if underlyingInput == UnderlyingAsset.auto
    if str.contains(cleanTicker, "BANKNIFTY")
        actualUnderlying := UnderlyingAsset.banknifty
    else if str.contains(cleanTicker, "NIFTY")
        actualUnderlying := UnderlyingAsset.nifty
    else if str.contains(cleanTicker, "CRUDEOIL")
        actualUnderlying := UnderlyingAsset.crudeoil
    else if str.contains(cleanTicker, "GOLD") and not str.contains(cleanTicker, "GOLDM") and not str.contains(cleanTicker, "GOLDPETAL")
        actualUnderlying := UnderlyingAsset.gold
    else if str.contains(cleanTicker, "GOLDM")
        actualUnderlying := UnderlyingAsset.gold
    else
        actualUnderlying := UnderlyingAsset.stock
else
    actualUnderlying := underlyingInput

// ----- Detect option type -----
bool isCall = false
bool isPut  = false

if optionTypeInput == OptionType.ce
    isCall := true
else if optionTypeInput == OptionType.pe
    isPut := true
else
    if str.contains(cleanTicker, "CE")
        isCall := true
    else if str.contains(cleanTicker, "PE")
        isPut := true
    else if str.match(cleanTicker, "C\\d+$") != ""
        isCall := true
    else if str.match(cleanTicker, "P\\d+$") != ""
        isPut := true

// ----- Construct Opposite Option Symbol -----
string oppTickerName = cleanTicker
if isCall
    if str.endswith(cleanTicker, "CE")
        oppTickerName := str.substring(cleanTicker, 0, tickerLen - 2) + "PE"
    else if str.match(cleanTicker, "C\\d+$") != ""
        string matchCStr = str.match(cleanTicker, "C\\d+$")
        int matchPos = str.pos(cleanTicker, matchCStr)
        oppTickerName := str.substring(cleanTicker, 0, matchPos) + "P" + str.substring(matchCStr, 1)
else if isPut
    if str.endswith(cleanTicker, "PE")
        oppTickerName := str.substring(cleanTicker, 0, tickerLen - 2) + "CE"
    else if str.match(cleanTicker, "P\\d+$") != ""
        string matchPStr = str.match(cleanTicker, "P\\d+$")
        int matchPos = str.pos(cleanTicker, matchPStr)
        oppTickerName := str.substring(cleanTicker, 0, matchPos) + "C" + str.substring(matchPStr, 1)

string oppSymbol = syminfo.prefix + ":" + oppTickerName

// ----- Strike extraction -----
float detectedStrike = na
string tickerWithoutCEPE = ""

if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, tickerLen - 2)

string matchC = str.match(cleanTicker, "C\\d+$")
string matchP = str.match(cleanTicker, "P\\d+$")

if matchC != ""
    detectedStrike := str.tonumber(str.substring(matchC, 1))
else if matchP != ""
    detectedStrike := str.tonumber(str.substring(matchP, 1))
else if tickerWithoutCEPE != ""
    string strikeDigits = str.match(tickerWithoutCEPE, "\\d+$")
    detectedStrike := str.tonumber(strikeDigits)

float strikePrice = strikeOverride > 0.0 ? strikeOverride : detectedStrike

// ==========================================
// MULTI-STRIKE TICKER CONSTRUCTION (-3 to +3 STRIKES)
// ==========================================

int stepVal = strikeStepChoice == StrikeStepOption.step50 ? 50 : 100
string strikeStr = str.tostring(int(strikePrice))

string currentCE_ticker = isCall ? cleanTicker : oppTickerName
string currentPE_ticker = isCall ? oppTickerName : cleanTicker

f_build_strike_ticker(string base_ticker, int target_strike) =>
    str.replace_all(base_ticker, strikeStr, str.tostring(target_strike))

int k_p3 = int(strikePrice) + 3 * stepVal
int k_p2 = int(strikePrice) + 2 * stepVal
int k_p1 = int(strikePrice) + 1 * stepVal
int k_0  = int(strikePrice)
int k_m1 = int(strikePrice) - 1 * stepVal
int k_m2 = int(strikePrice) - 2 * stepVal
int k_m3 = int(strikePrice) - 3 * stepVal

// ==========================================
// SPOT TICKER RESOLUTION
// ==========================================

string spotTicker = ""
if str.length(spotTickerOverride) > 0
    spotTicker := spotTickerOverride
else
    switch actualUnderlying
        UnderlyingAsset.banknifty => spotTicker := "NSE:BANKNIFTY"
        UnderlyingAsset.nifty     => spotTicker := "NSE:NIFTY"
        UnderlyingAsset.crudeoil  => spotTicker := "MCX:CRUDEOIL1!"
        UnderlyingAsset.gold      => spotTicker := "MCX:GOLD1!"
        UnderlyingAsset.stock     =>
            string rootGuess = str.match(cleanTicker, "^[A-Z&]+")
            if rootGuess != ""
                spotTicker := syminfo.prefix + ":" + rootGuess
            else
                spotTicker := syminfo.prefix + ":" + cleanTicker

// ==========================================
// DATA FETCHING (SPOT, 7 OPTION STRIKES & VWAP)
// ==========================================

// Helper function to extract 5m reference tuple and current close in ONE security call
f_get_opt_all_data() =>
    var float d_open = na
    var float p_close = na
    var float f5_close = na
    float d_change = ta.change(time("D"))
    bool is_new_day = d_change != 0 or na(d_change)
    if is_new_day
        p_close := close[1]
        d_open := open
        f5_close := close
    [nz(d_open, open), nz(p_close, close[1]), nz(f5_close, close), close]

get_spot_ref_data() =>
    var float daily_open_915 = na
    var float prev_close = na
    var float f5_close = na
    float d_change = ta.change(time("D"))
    bool is_new_day = d_change != 0 or na(d_change)
    if is_new_day
        prev_close := close[1]
        daily_open_915 := open
        f5_close := close
    [nz(daily_open_915, open), nz(prev_close, close[1]), nz(f5_close, close)]

// 1. Fetch Spot 5m reference tuple
[spotDayOpen, spotPrevClose, spotFirst5MinClose] = request.security(spotTicker, "5", get_spot_ref_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// 2. Fetch 7 strikes CE and PE data (+3 to -3)
[ce_o_p3, ce_p_p3, ce_f5_p3, ce_c_p3] = request.security(syminfo.prefix + ":" + f_build_strike_ticker(currentCE_ticker, k_p3), "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p3, pe_p_p3, pe_f5_p3, pe_c_p3] = request.security(syminfo.prefix + ":" + f_build_strike_ticker(currentPE_ticker, k_p3), "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p2, ce_p_p2, ce_f5_p2, ce_c_p2] = request.security(syminfo.prefix + ":" + f_build_strike_ticker(currentCE_ticker, k_p2), "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p2, pe_p_p2, pe_f5_p2, pe_c_p2] = request.security(syminfo.prefix + ":" + f_build_strike_ticker(currentPE_ticker, k_p2), "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p1, ce_p_p1, ce_f5_p1, ce_c_p1] = request.security(syminfo.prefix + ":" + f_build_strike_ticker(currentCE_ticker, k_p1), "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p1, pe_p_p1, pe_f5_p1, pe_c_p1] = request.security(syminfo.prefix + ":" + f_build_strike_ticker(currentPE_ticker, k_p1), "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_0,  ce_p_0,  ce_f5_0,  ce_c_0]  = request.security(syminfo.prefix + ":" + currentCE_ticker, "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_0,  pe_p_0,  pe_f5_0,  pe_c_0]  = request.security(syminfo.prefix + ":" + currentPE_ticker, "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m1, ce_p_m1, ce_f5_m1, ce_c_m1] = request.security(syminfo.prefix + ":" + f_build_strike_ticker(currentCE_ticker, k_m1), "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m1, pe_p_m1, pe_f5_m1, pe_c_m1] = request.security(syminfo.prefix + ":" + f_build_strike_ticker(currentPE_ticker, k_m1), "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m2, ce_p_m2, ce_f5_m2, ce_c_m2] = request.security(syminfo.prefix + ":" + f_build_strike_ticker(currentCE_ticker, k_m2), "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m2, pe_p_m2, pe_f5_m2, pe_c_m2] = request.security(syminfo.prefix + ":" + f_build_strike_ticker(currentPE_ticker, k_m2), "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m3, ce_p_m3, ce_f5_m3, ce_c_m3] = request.security(syminfo.prefix + ":" + f_build_strike_ticker(currentCE_ticker, k_m3), "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m3, pe_p_m3, pe_f5_m3, pe_c_m3] = request.security(syminfo.prefix + ":" + f_build_strike_ticker(currentPE_ticker, k_m3), "5", f_get_opt_all_data(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// 3. Fetch Opposite Option real-time OHLC for candle overlay & VWAP
string requestTimeframe = timeframe.isintraday ? timeframe.period : "D"
[oppCurOpen, oppCurHigh, oppCurLow, oppCurClose] = request.security(oppSymbol, requestTimeframe, [open, high, low, close], ignore_invalid_symbol=true)
float oppVWAPVal = request.security(oppSymbol, requestTimeframe, ta.vwap, ignore_invalid_symbol=true)

// Current Chart Option VWAP
float chartVWAPVal = ta.vwap

// Assign CE vs PE VWAP
float ceVWAP = isCall ? chartVWAPVal : oppVWAPVal
float peVWAP = isCall ? oppVWAPVal   : chartVWAPVal

// Select Reference Prices based on settings
// --- Spot Ref Price for Intrinsic & Time Value ---
float spotIvTvRefPrice = switch ivTvCalcBasisInput
    CalculationBasis.dayOpen   => spotDayOpen
    CalculationBasis.prevClose => spotPrevClose
    CalculationBasis.first5Min => spotFirst5MinClose

// Helper to select reference price for options based on BEP basis
f_select_bep_ref(float d_open, float p_close, float f5_close) =>
    switch bepCalcBasisInput
        CalculationBasis.dayOpen   => d_open
        CalculationBasis.prevClose => p_close
        CalculationBasis.first5Min => f5_close

// Option Ref Prices for Intrinsic & Time Value
float optionDayOpen         = isCall ? ce_o_0 : pe_o_0
float optionPrevClose       = isCall ? ce_p_0 : pe_p_0
float optionFirst5MinClose  = isCall ? ce_f5_0 : pe_f5_0
float oppDayOpen            = isCall ? pe_o_0 : ce_o_0
float oppPrevClose          = isCall ? pe_p_0 : ce_p_0
float oppFirst5MinClose     = isCall ? pe_f5_0 : ce_f5_0

float chartOptIvTvRefPrice = switch ivTvCalcBasisInput
    CalculationBasis.dayOpen   => optionDayOpen
    CalculationBasis.prevClose => optionPrevClose
    CalculationBasis.first5Min => optionFirst5MinClose

float oppOptIvTvRefPrice = switch ivTvCalcBasisInput
    CalculationBasis.dayOpen   => oppDayOpen
    CalculationBasis.prevClose => oppPrevClose
    CalculationBasis.first5Min => oppFirst5MinClose

float ceIvTvRefPrice = isCall ? chartOptIvTvRefPrice : oppOptIvTvRefPrice
float peIvTvRefPrice = isCall ? oppOptIvTvRefPrice   : chartOptIvTvRefPrice

// Current Realtime Close Prices
float ceCurClose = isCall ? close       : oppCurClose
float peCurClose = isCall ? oppCurClose : close

// ==========================================
// BEP & INTRINSIC/TIME VALUE CALCULATIONS
// ==========================================

// Static BEP for all 7 strikes (-3 to +3)
float static_bep_p3 = (f_select_bep_ref(ce_o_p3, ce_p_p3, ce_f5_p3) + f_select_bep_ref(pe_o_p3, pe_p_p3, pe_f5_p3)) / 2.0
float static_bep_p2 = (f_select_bep_ref(ce_o_p2, ce_p_p2, ce_f5_p2) + f_select_bep_ref(pe_o_p2, pe_p_p2, pe_f5_p2)) / 2.0
float static_bep_p1 = (f_select_bep_ref(ce_o_p1, ce_p_p1, ce_f5_p1) + f_select_bep_ref(pe_o_p1, pe_p_p1, pe_f5_p1)) / 2.0
float static_bep_0  = (f_select_bep_ref(ce_o_0,  ce_p_0,  ce_f5_0)  + f_select_bep_ref(pe_o_0,  pe_p_0,  pe_f5_0))  / 2.0
float static_bep_m1 = (f_select_bep_ref(ce_o_m1, ce_p_m1, ce_f5_m1) + f_select_bep_ref(pe_o_m1, pe_p_m1, pe_f5_m1)) / 2.0
float static_bep_m2 = (f_select_bep_ref(ce_o_m2, ce_p_m2, ce_f5_m2) + f_select_bep_ref(pe_o_m2, pe_p_m2, pe_f5_m2)) / 2.0
float static_bep_m3 = (f_select_bep_ref(ce_o_m3, ce_p_m3, ce_f5_m3) + f_select_bep_ref(pe_o_m3, pe_p_m3, pe_f5_m3)) / 2.0

float staticBEP = static_bep_0

// Realtime Dynamic BEP Value for selected strike
float realtimeBEP = (ce_c_0 + pe_c_0) / 2.0

// Intrinsic & Time Value Calculations
// --- Actual Single Option ---
float rawIntrinsicActual = isCall ? (spotIvTvRefPrice - strikePrice) : (strikePrice - spotIvTvRefPrice)
float actualIntrinsic    = math.max(minRangeInput, math.min(maxRangeInput, rawIntrinsicActual))
float actualTimeValue    = timeValueFormulaInput == TimeValueFormula.standard ? (chartOptIvTvRefPrice - actualIntrinsic) : (strikePrice - actualIntrinsic)

// --- Average CE + PE ---
float ceRawIntrinsic  = math.max(0.0, spotIvTvRefPrice - strikePrice)
float peRawIntrinsic  = math.max(0.0, strikePrice - spotIvTvRefPrice)
float avgIntrinsicRaw = (ceRawIntrinsic + peRawIntrinsic) / 2.0
float avgIntrinsic    = math.max(minRangeInput, math.min(maxRangeInput, avgIntrinsicRaw))

float ceTimeVal       = timeValueFormulaInput == TimeValueFormula.standard ? (ceIvTvRefPrice - ceRawIntrinsic) : (strikePrice - ceRawIntrinsic)
float peTimeVal       = timeValueFormulaInput == TimeValueFormula.standard ? (peIvTvRefPrice - peRawIntrinsic) : (strikePrice - peRawIntrinsic)
float avgTimeValue    = (ceTimeVal + peTimeVal) / 2.0

// Final selected metric based on useAverageValuesInput
float finalIntrinsic = useAverageValuesInput ? avgIntrinsic : actualIntrinsic
float finalTimeValue = useAverageValuesInput ? avgTimeValue : actualTimeValue

// ==========================================
// CM ULTIMATE MACD V2.1 CALCULATIONS & DUAL-LINE SIGNALS
// ==========================================

f_calc_ma(float src_series, int len, string ma_type) =>
    ma_type == "SMA" ? ta.sma(src_series, len) : ta.ema(src_series, len)

f_cm_macd_calc(int fast_l, int slow_l, int sig_l, string ma_src, string ma_sig) =>
    float f_ma = f_calc_ma(close, fast_l, ma_src)
    float s_ma = f_calc_ma(close, slow_l, ma_src)
    float m_line = f_ma - s_ma
    float sig_line = f_calc_ma(m_line, sig_l, ma_sig)
    float h_line = m_line - sig_line
    [m_line, sig_line, h_line]

string reqMacdTf = str.length(macdTimeframeInput) > 0 ? macdTimeframeInput : requestTimeframe
[cm_macd, cm_signal, cm_hist] = request.security(syminfo.tickerid, reqMacdTf, f_cm_macd_calc(macdFastLength, macdSlowLength, macdSignalLength, macdSmaSource, macdSmaSignal), ignore_invalid_symbol=true)

// Dual-Line Signal Logic:
// 1. Both lines above 0
bool bothAboveZero     = cm_macd > 0 and cm_signal > 0
bool bothBelowZero     = cm_macd < 0 and cm_signal < 0

bool prevBothAboveZero = cm_macd[1] > 0 and cm_signal[1] > 0
bool prevBothBelowZero = cm_macd[1] < 0 and cm_signal[1] < 0

// STRONG BUY: MACD crosses ABOVE Signal line while BOTH lines are above 0
bool macdStrongBuySignal = ta.crossover(cm_macd, cm_signal) and bothAboveZero

// BUY: Both lines crossed above 0 line
bool macdBuySignal       = bothAboveZero and not prevBothAboveZero and not macdStrongBuySignal

// STRONG SELL: MACD crosses BELOW Signal line while BOTH lines are below 0
bool macdStrongSellSignal = ta.crossunder(cm_macd, cm_signal) and bothBelowZero

// SELL: Both lines crossed below 0 line
bool macdSellSignal       = bothBelowZero and not prevBothBelowZero and not macdStrongSellSignal

var string macdRecommendation = "NEUTRAL"
if macdStrongBuySignal
    macdRecommendation := "STRONG BUY"
else if macdBuySignal
    macdRecommendation := "BUY"
else if macdStrongSellSignal
    macdRecommendation := "STRONG SELL"
else if macdSellSignal
    macdRecommendation := "SELL"

// ==========================================
// PLOTS & VISUALIZATION
// ==========================================

// --- Opposite Option Candles Overlay ---
bool oppIsBull    = nz(oppCurClose) >= nz(oppCurOpen)
color oppBodyCol  = oppIsBull ? colorOppBull : colorOppBear
color oppWickCol  = oppIsBull ? colorOppWickBull : colorOppWickBear

