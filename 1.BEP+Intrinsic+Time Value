// 2. Multi-Strike BEP & Change Table (7 Strikes: -3 to +3)
f_get_multi_table_pos(string pos_str) =>
    switch pos_str
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

var table multiTable = table.new(f_get_multi_table_pos(multiBEPTablePosInput), 6, 8, bgcolor=color.new(color.black, 20), border_color=color.new(color.gray, 50), border_width=1)

// Calculate Nearest BEP to Current Chart Price
float diff_p3 = math.abs(close - static_bep_p3)
float diff_p2 = math.abs(close - static_bep_p2)
float diff_p1 = math.abs(close - static_bep_p1)
float diff_0  = math.abs(close - static_bep_0)
float diff_m1 = math.abs(close - static_bep_m1)
float diff_m2 = math.abs(close - static_bep_m2)
float diff_m3 = math.abs(close - static_bep_m3)

float minBEPDiff = math.min(diff_p3, math.min(diff_p2, math.min(diff_p1, math.min(diff_0, math.min(diff_m1, math.min(diff_m2, diff_m3))))))

f_fill_strike_row(table tbl, int r, string st_name, float bep_val, bool is_near, float ce_op, float ce_cg, float pe_op, float pe_cg, bool is_sel) =>
    color st_bg = is_sel ? color.new(color.gray, 40) : color.new(color.black, 30)
    color st_tc = is_sel ? color.yellow : color.white
    table.cell(tbl, 0, r, st_name, bgcolor=st_bg, text_color=st_tc, text_size=size.small)

    color bep_bg = is_near ? color.new(#FFEE58, 10) : color.new(color.black, 30)
    color bep_tc = is_near ? color.black : color.aqua
    table.cell(tbl, 1, r, na(bep_val) ? "N/A" : str.tostring(bep_val, "#.##"), bgcolor=bep_bg, text_color=bep_tc, text_size=size.small)

    table.cell(tbl, 2, r, na(ce_op) ? "N/A" : str.tostring(ce_op, "#.##"), bgcolor=color.new(color.black, 30), text_color=color.white, text_size=size.small)

    string ce_cg_str = na(ce_cg) ? "N/A" : ((ce_cg >= 0 ? "+" : "") + str.tostring(ce_cg, "#.##"))
    color ce_cg_bg   = na(ce_cg) ? color.new(color.black, 30) : (ce_cg > 0 ? color.new(#00C853, 75) : (ce_cg < 0 ? color.new(#D50000, 75) : color.new(color.black, 30)))
    color ce_cg_tc   = na(ce_cg) ? color.silver : color.white
    table.cell(tbl, 3, r, ce_cg_str, bgcolor=ce_cg_bg, text_color=ce_cg_tc, text_size=size.small)

    table.cell(tbl, 4, r, na(pe_op) ? "N/A" : str.tostring(pe_op, "#.##"), bgcolor=color.new(color.black, 30), text_color=color.white, text_size=size.small)

    string pe_cg_str = na(pe_cg) ? "N/A" : ((pe_cg >= 0 ? "+" : "") + str.tostring(pe_cg, "#.##"))
    color pe_cg_bg   = na(pe_cg) ? color.new(color.black, 30) : (pe_cg > 0 ? color.new(#00C853, 75) : (pe_cg < 0 ? color.new(#D50000, 75) : color.new(color.black, 30)))
    color pe_cg_tc   = na(pe_cg) ? color.silver : color.white
    table.cell(tbl, 5, r, pe_cg_str, bgcolor=pe_cg_bg, text_color=pe_cg_tc, text_size=size.small)

if barstate.islast and showMultiBEPTableInput
    // Row 0: Column Headers
    table.cell(multiTable, 0, 0, "Strike",     bgcolor=color.new(color.gray, 30), text_color=color.white, text_size=size.small)
    table.cell(multiTable, 1, 0, "Static BEP", bgcolor=color.new(color.gray, 30), text_color=color.white, text_size=size.small)
    table.cell(multiTable, 2, 0, "CE Open",    bgcolor=color.new(color.gray, 30), text_color=color.white, text_size=size.small)
    table.cell(multiTable, 3, 0, "CE Chg",     bgcolor=color.new(color.gray, 30), text_color=color.white, text_size=size.small)
    table.cell(multiTable, 4, 0, "PE Open",    bgcolor=color.new(color.gray, 30), text_color=color.white, text_size=size.small)
    table.cell(multiTable, 5, 0, "PE Chg",     bgcolor=color.new(color.gray, 30), text_color=color.white, text_size=size.small)

    // Calculate Points Changed from Day Open
    float ce_cg_p3 = ce_c_p3 - ce_o_p3
    float pe_cg_p3 = pe_c_p3 - pe_o_p3

    float ce_cg_p2 = ce_c_p2 - ce_o_p2
    float pe_cg_p2 = pe_c_p2 - pe_o_p2

    float ce_cg_p1 = ce_c_p1 - ce_o_p1
    float pe_cg_p1 = pe_c_p1 - pe_o_p1

    float ce_cg_0  = ce_c_0  - ce_o_0
    float pe_cg_0  = pe_c_0  - pe_o_0

    float ce_cg_m1 = ce_c_m1 - ce_o_m1
    float pe_cg_m1 = pe_c_m1 - pe_o_m1

    float ce_cg_m2 = ce_c_m2 - ce_o_m2
    float pe_cg_m2 = pe_c_m2 - pe_o_m2

    float ce_cg_m3 = ce_c_m3 - ce_o_m3
    float pe_cg_m3 = pe_c_m3 - pe_o_m3

    // Row 1: +3 Strike
    f_fill_strike_row(multiTable, 1, str.tostring(k_p3), static_bep_p3, diff_p3 == minBEPDiff, ce_o_p3, ce_cg_p3, pe_o_p3, pe_cg_p3, false)

    // Row 2: +2 Strike
    f_fill_strike_row(multiTable, 2, str.tostring(k_p2), static_bep_p2, diff_p2 == minBEPDiff, ce_o_p2, ce_cg_p2, pe_o_p2, pe_cg_p2, false)

    // Row 3: +1 Strike
    f_fill_strike_row(multiTable, 3, str.tostring(k_p1), static_bep_p1, diff_p1 == minBEPDiff, ce_o_p1, ce_cg_p1, pe_o_p1, pe_cg_p1, false)

    // Row 4: Selected Strike (Offset 0)
    f_fill_strike_row(multiTable, 4, str.tostring(k_0) + " (Sel)", static_bep_0, diff_0 == minBEPDiff, ce_o_0, ce_cg_0, pe_o_0, pe_cg_0, true)

    // Row 5: -1 Strike
    f_fill_strike_row(multiTable, 5, str.tostring(k_m1), static_bep_m1, diff_m1 == minBEPDiff, ce_o_m1, ce_cg_m1, pe_o_m1, pe_cg_m1, false)

    // Row 6: -2 Strike
    f_fill_strike_row(multiTable, 6, str.tostring(k_m2), static_bep_m2, diff_m2 == minBEPDiff, ce_o_m2, ce_cg_m2, pe_o_m2, pe_cg_m2, false)

    // Row 7: -3 Strike
    f_fill_strike_row(multiTable, 7, str.tostring(k_m3), static_bep_m3, diff_m3 == minBEPDiff, ce_o_m3, ce_cg_m3, pe_o_m3, pe_cg_m3, false)