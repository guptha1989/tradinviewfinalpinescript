//@version=6
indicator("Techfrost Multi Strike BEP Lines", shorttitle="TF BEP", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500, precision=2)

// =========================================================================
// INPUTS & USER SETTINGS
// =========================================================================
var string G_PARSER  = "1. Symbol & Instrument Settings"
var string G_BEP     = "2. BEP Calculation & Offset Settings"
var string G_LEVELS  = "3. CE & PE Previous Day High/Low/Close Levels"
var string G_OPP     = "4. Opposite Option Candles Overlay"
var string G_COLORS  = "5. Colors & Line Styling"

// 1. Parser & Instrument Settings
stock_name_preset = input.string("NIFTY", "Stock Name", options=["NIFTY", "BANKNIFTY", "FINNIFTY", "MIDCPNIFTY", "CRUDEOIL", "Custom"], group=G_PARSER,
  tooltip="Select underlying instrument preset (NIFTY, BANKNIFTY, FINNIFTY, MIDCPNIFTY, CRUDEOIL, or Custom).")
underlying_ticker = input.string("NIFTY", "Custom Underlying Ticker", group=G_PARSER)
exchange          = input.string("NSE", "Exchange Prefix", group=G_PARSER)
strike_step_input = input.int(50, "Strike Step Size (Custom)", minval=1, group=G_PARSER)
expiry_input      = input.string("260804", "Select Expiry Date (YYMMDD/Code)", group=G_PARSER)
suffixStyle       = input.string("C/P", "Option Suffix Format", options=["CE/PE", "C/P"], group=G_PARSER)
atm_select_mode   = input.string("Automatic", "ATM Strike Selection Mode", options=["Automatic", "Manual"], group=G_PARSER)
manual_strike_val = input.int(24000, "ATM Strike Price (Manual)", group=G_PARSER)

// 2. BEP Offset & Calculation Settings
offset_choice_str = input.string("100 Points (+100 / -100)", "Strike Offset Points", options=["50 Points (+50 / -50)", "100 Points (+100 / -100)"], group=G_BEP,
  tooltip="Select offset points (50 or 100). Plots BEP for ATM strike, Upper strike (ATM + Offset), and Lower strike (ATM - Offset).")
standard_bep_basis = input.string("Today's Day Open", "Static BEP Calculation Basis",
  options=["Today's Day Open", "Previous Day Close", "First 5 Min Close"], group=G_BEP)

show_running_bep  = input.bool(true, "Show Realtime Dynamic BEP Lines", group=G_BEP,
  tooltip="Realtime BEP = (CE LTP + PE LTP) / 2")
show_standard_bep = input.bool(true, "Show Static BEP Horizontal Lines", group=G_BEP,
  tooltip="Static BEP = (CE Ref + PE Ref) / 2")
show_line_labels  = input.bool(true, "Show Line Labels at Chart End", group=G_BEP)

// 3. CE & PE Previous Day High/Low/Close Levels
show_pdc_lines     = input.bool(true, "Show CE & PE Previous Day Close Lines", group=G_LEVELS)
show_pdh_pdl_lines = input.bool(true, "Show CE & PE Previous Day High & Low Lines", group=G_LEVELS)

// 4. Opposite Option Candles Overlay
show_opp_candles  = input.bool(true, "Show Opposite Option Candles", group=G_OPP,
  tooltip="Draw historical & real-time opposite option contract candles (e.g. PE candles on CE chart, CE candles on PE chart).")
c_opp_bull        = input.color(color.new(#2962FF, 40), "Opposite Bullish Candle Body", group=G_OPP)
c_opp_bear        = input.color(color.new(#FF6D00, 40), "Opposite Bearish Candle Body", group=G_OPP)
c_opp_bull_wick   = input.color(color.new(#2962FF, 60), "Opposite Bullish Wick/Border", group=G_OPP)
c_opp_bear_wick   = input.color(color.new(#FF6D00, 60), "Opposite Bearish Wick/Border", group=G_OPP)

// 5. Colors & Line Styling
c_atm   = input.color(#FFD700, "ATM BEP Color (Selected Strike)", group=G_COLORS)
c_upper = input.color(#FF1744, "Upper BEP Color (+Offset)", group=G_COLORS)
c_lower = input.color(#00E676, "Lower BEP Color (-Offset)", group=G_COLORS)

c_ce_pdc = input.color(color.new(#00E676, 20), "CE Prev Close Line Color", group=G_COLORS)
c_ce_pdh = input.color(color.new(#00E676, 50), "CE Prev High Line Color", group=G_COLORS)
c_ce_pdl = input.color(color.new(#00E676, 70), "CE Prev Low Line Color", group=G_COLORS)

c_pe_pdc = input.color(color.new(#FF5252, 20), "PE Prev Close Line Color", group=G_COLORS)
c_pe_pdh = input.color(color.new(#FF5252, 50), "PE Prev High Line Color", group=G_COLORS)
c_pe_pdl = input.color(color.new(#FF5252, 70), "PE Prev Low Line Color", group=G_COLORS)

show_options_table = input.bool(true, "Show BEP & Details Table", group=G_COLORS)
table_pos_str      = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_COLORS)
table_size_str     = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal", "Large"], group=G_COLORS)

// =========================================================================
// HELPER FUNCTIONS (GLOBAL SCOPE)
// =========================================================================
f_is_digit(string c) =>
    str.contains("0123456789", c)

f_build_option_ticker(string exch, string rt, string exp, int st, string o_type, string sfx) =>
    string st_str = str.tostring(st)
    if sfx == "C/P"
        string letter = o_type == "CE" or o_type == "C" ? "C" : "P"
        exch + ":" + rt + exp + letter + st_str
    else
        string letter = o_type == "CE" or o_type == "C" ? "CE" : "PE"
        exch + ":" + rt + exp + st_str + letter

f_fill_table_row(tbl, r, lbl, ce_r, pe_r, stat_bep, ce_l, pe_l, rt_bep, ce_h, ce_lw, pe_h, pe_lw, row_bg, t_sz) =>
    table.cell(tbl, 0, r, lbl, bgcolor=row_bg, text_color=color.white, text_size=t_sz)
    table.cell(tbl, 1, r, na(ce_r) ? "N/A" : str.tostring(ce_r, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=t_sz)
    table.cell(tbl, 2, r, na(pe_r) ? "N/A" : str.tostring(pe_r, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=t_sz)
    table.cell(tbl, 3, r, na(stat_bep) ? "N/A" : str.tostring(stat_bep, "#.##"), bgcolor=#006064, text_color=color.aqua, text_size=t_sz)
    table.cell(tbl, 4, r, na(ce_l) ? "N/A" : str.tostring(ce_l, "#.##"), bgcolor=color.black, text_color=#00E676, text_size=t_sz)
    table.cell(tbl, 5, r, na(pe_l) ? "N/A" : str.tostring(pe_l, "#.##"), bgcolor=color.black, text_color=#FF5252, text_size=t_sz)
    table.cell(tbl, 6, r, na(rt_bep) ? "N/A" : str.tostring(rt_bep, "#.##"), bgcolor=#F57F17, text_color=color.yellow, text_size=t_sz)
    
    string ce_hl_str = (na(ce_h) ? "N/A" : str.tostring(ce_h, "#.#")) + " / " + (na(ce_lw) ? "N/A" : str.tostring(ce_lw, "#.#"))
    string pe_hl_str = (na(pe_h) ? "N/A" : str.tostring(pe_h, "#.#")) + " / " + (na(pe_lw) ? "N/A" : str.tostring(pe_lw, "#.#"))
    table.cell(tbl, 7, r, ce_hl_str, bgcolor=color.black, text_color=color.new(#00E676, 20), text_size=t_sz)
    table.cell(tbl, 8, r, pe_hl_str, bgcolor=color.black, text_color=color.new(#FF5252, 20), text_size=t_sz)

// =========================================================================
// OPTION CONTRACT PARSER & TICKER BUILDER
// =========================================================================
var string root = underlying_ticker
var string expiry = expiry_input
var string opt_type = "C"
var int strike_val = manual_strike_val
var bool is_option = false

ticker_str = syminfo.ticker
ticker_len = str.length(ticker_str)

if ticker_len > 7
    int idx = ticker_len - 1
    string strike_str = ""
    while idx >= 0 and f_is_digit(str.substring(ticker_str, idx, idx + 1))
        strike_str := str.substring(ticker_str, idx, idx + 1) + strike_str
        idx := idx - 1
        
    if idx > 2 and str.length(strike_str) > 0
        string opt_char = str.substring(ticker_str, idx, idx + 1)
        if opt_char == "C" or opt_char == "P" or opt_char == "E"
            opt_type := opt_char == "P" ? "P" : "C"
            strike_val := int(str.tonumber(strike_str))
            int exp_len = 5
            if idx >= 3 and f_is_digit(str.substring(ticker_str, idx - 3, idx - 2))
                exp_len := 6
            if idx >= exp_len
                expiry := str.substring(ticker_str, idx - exp_len, idx)
                root := str.substring(ticker_str, 0, idx - exp_len)
                is_option := true

preset_root = stock_name_preset == "NIFTY" ? "NIFTY" : (stock_name_preset == "BANKNIFTY" ? "BANKNIFTY" : (stock_name_preset == "FINNIFTY" ? "FINNIFTY" : (stock_name_preset == "MIDCPNIFTY" ? "MIDCPNIFTY" : (stock_name_preset == "CRUDEOIL" ? "CRUDEOIL" : underlying_ticker))))
preset_exchange = stock_name_preset == "CRUDEOIL" ? "MCX" : (stock_name_preset == "Custom" ? exchange : "NSE")
preset_step = stock_name_preset == "NIFTY" ? 50 : (stock_name_preset == "BANKNIFTY" ? 100 : (stock_name_preset == "FINNIFTY" ? 50 : (stock_name_preset == "MIDCPNIFTY" ? 25 : (stock_name_preset == "CRUDEOIL" ? 50 : strike_step_input))))

final_root     = is_option ? root : preset_root
final_exchange = is_option ? exchange : preset_exchange
final_expiry   = is_option ? expiry : expiry_input
strike_step    = preset_step

spot_sym = final_exchange + ":" + final_root
[spot_open, spot_prev_close, spot_close_today] = request.security(spot_sym, "1D", [open, close, close], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

var int base_center_strike = na
if barstate.isfirst or na(base_center_strike)
    int calc_strike = (atm_select_mode == "Manual") ? manual_strike_val : (is_option ? strike_val : int(math.round(nz(spot_close_today, spot_open) / strike_step) * strike_step))
    if calc_strike <= 0
        calc_strike := manual_strike_val
    base_center_strike := calc_strike

final_strike = base_center_strike

// =========================================================================
// OPPOSITE OPTION CONTRACT OVERLAY
// =========================================================================
string opp_type = (is_option and opt_type == "C") ? "P" : "C"
string opp_ticker = f_build_option_ticker(final_exchange, final_root, final_expiry, final_strike, opp_type, suffixStyle)

[opp_o, opp_h, opp_l, opp_c] = request.security(opp_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)

bool opp_is_bull  = nz(opp_c) >= nz(opp_o)
color opp_body_col = opp_is_bull ? c_opp_bull : c_opp_bear
color opp_wick_col = opp_is_bull ? c_opp_bull_wick : c_opp_bear_wick

plotcandle(show_opp_candles and is_option ? opp_o : na,
           show_opp_candles and is_option ? opp_h : na,
           show_opp_candles and is_option ? opp_l : na,
           show_opp_candles and is_option ? opp_c : na,
           title="Opposite Option Candle", color=opp_body_col, wickcolor=opp_wick_col, bordercolor=opp_wick_col)

// =========================================================================
// THREE STRIKES SELECTION (LOWER, ATM, UPPER)
// =========================================================================
int offsetPts = str.contains(offset_choice_str, "50") ? 50 : 100

int st_atm   = final_strike
int st_lower = final_strike - offsetPts
int st_upper = final_strike + offsetPts

f_get_contract_data() =>
    float d_open  = ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0)
    [d_pdc, d_pdh, d_pdl] = request.security(syminfo.tickerid, "D", [close[1], high[1], low[1]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
    var float d_f5m = na
    if ta.change(time("D")) != 0
        d_f5m := na
    if (hour == 9 and minute >= 19) or hour > 9
        if na(d_f5m)
            d_f5m := close
    [d_open, d_pdc, d_pdh, d_pdl, na(d_f5m) ? d_open : d_f5m, close]

// --- Fetch Data for ATM, Lower, Upper Strikes ---
string ce_atm_ticker = f_build_option_ticker(final_exchange, final_root, final_expiry, st_atm, "CE", suffixStyle)
string pe_atm_ticker = f_build_option_ticker(final_exchange, final_root, final_expiry, st_atm, "PE", suffixStyle)
[ce_atm_o, ce_atm_pdc, ce_atm_pdh, ce_atm_pdl, ce_atm_f5m, ce_atm_ltp] = request.security(ce_atm_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_atm_o, pe_atm_pdc, pe_atm_pdh, pe_atm_pdl, pe_atm_f5m, pe_atm_ltp] = request.security(pe_atm_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

string ce_lower_ticker = f_build_option_ticker(final_exchange, final_root, final_expiry, st_lower, "CE", suffixStyle)
string pe_lower_ticker = f_build_option_ticker(final_exchange, final_root, final_expiry, st_lower, "PE", suffixStyle)
[ce_lwr_o, ce_lwr_pdc, ce_lwr_pdh, ce_lwr_pdl, ce_lwr_f5m, ce_lwr_ltp] = request.security(ce_lower_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_lwr_o, pe_lwr_pdc, pe_lwr_pdh, pe_lwr_pdl, pe_lwr_f5m, pe_lwr_ltp] = request.security(pe_lower_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

string ce_upper_ticker = f_build_option_ticker(final_exchange, final_root, final_expiry, st_upper, "CE", suffixStyle)
string pe_upper_ticker = f_build_option_ticker(final_exchange, final_root, final_expiry, st_upper, "PE", suffixStyle)
[ce_upr_o, ce_upr_pdc, ce_upr_pdh, ce_upr_pdl, ce_upr_f5m, ce_upr_ltp] = request.security(ce_upper_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_upr_o, pe_upr_pdc, pe_upr_pdh, pe_upr_pdl, pe_upr_f5m, pe_upr_ltp] = request.security(pe_upper_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

f_resolve_basis(dop, pdc, f5m) =>
    standard_bep_basis == "Previous Day Close" ? pdc : (standard_bep_basis == "First 5 Min Close" ? f5m : dop)

float ce_atm_ref = f_resolve_basis(ce_atm_o, ce_atm_pdc, ce_atm_f5m)
float pe_atm_ref = f_resolve_basis(pe_atm_o, pe_atm_pdc, pe_atm_f5m)

float ce_lwr_ref = f_resolve_basis(ce_lwr_o, ce_lwr_pdc, ce_lwr_f5m)
float pe_lwr_ref = f_resolve_basis(pe_lwr_o, pe_lwr_pdc, pe_lwr_f5m)

float ce_upr_ref = f_resolve_basis(ce_upr_o, ce_upr_pdc, ce_upr_f5m)
float pe_upr_ref = f_resolve_basis(pe_upr_o, pe_upr_pdc, pe_upr_f5m)

// =========================================================================
// BEP CALCULATIONS: (CE + PE) / 2.0 FORMULA
// =========================================================================
float run_bep_atm   = (ce_atm_ltp + pe_atm_ltp) / 2.0
float run_bep_lower = (ce_lwr_ltp + pe_lwr_ltp) / 2.0
float run_bep_upper = (ce_upr_ltp + pe_upr_ltp) / 2.0

float std_bep_atm   = (ce_atm_ref + pe_atm_ref) / 2.0
float std_bep_lower = (ce_lwr_ref + pe_lwr_ref) / 2.0
float std_bep_upper = (ce_upr_ref + pe_upr_ref) / 2.0

// Plot Realtime Dynamic BEP Lines
plot(show_running_bep ? run_bep_lower : na, "Realtime Lower BEP (-Offset)", color=c_lower, linewidth=2)
plot(show_running_bep ? run_bep_atm   : na, "Realtime ATM BEP (Selected)", color=c_atm,   linewidth=2)
plot(show_running_bep ? run_bep_upper : na, "Realtime Upper BEP (+Offset)", color=c_upper, linewidth=2)

// =========================================================================
// STATIC BEP & PREVIOUS DAY HIGH / LOW / CLOSE HORIZONTAL LINES
// =========================================================================
var line[] level_lines  = array.new_line()
var label[] level_labels = array.new_label()

bool is_chart_new_day = ta.change(time("D")) != 0
var int day_start_bar = bar_index
if is_chart_new_day
    day_start_bar := bar_index

if barstate.islast
    for l in level_lines
        line.delete(l)
    array.clear(level_lines)
    
    for lb in level_labels
        label.delete(lb)
    array.clear(level_labels)

    int x1 = math.max(0, day_start_bar)
    int x2 = bar_index + 15

    // 1. Static BEP Horizontal Lines
    if show_standard_bep
        // ATM Static BEP
        array.push(level_lines, line.new(x1, std_bep_atm, x2, std_bep_atm, color=c_atm, width=1, style=line.style_dashed))
        if show_line_labels
            array.push(level_labels, label.new(x2, std_bep_atm, "ATM (" + str.tostring(st_atm) + ") Static BEP: " + str.tostring(std_bep_atm, "#.##"), color=color.new(c_atm, 80), textcolor=c_atm, style=label.style_label_left, size=size.small))
            
        // Upper Static BEP
        array.push(level_lines, line.new(x1, std_bep_upper, x2, std_bep_upper, color=c_upper, width=1, style=line.style_dashed))
        if show_line_labels
            array.push(level_labels, label.new(x2, std_bep_upper, "Upper (" + str.tostring(st_upper) + ") Static BEP: " + str.tostring(std_bep_upper, "#.##"), color=color.new(c_upper, 80), textcolor=c_upper, style=label.style_label_left, size=size.small))

        // Lower Static BEP
        array.push(level_lines, line.new(x1, std_bep_lower, x2, std_bep_lower, color=c_lower, width=1, style=line.style_dashed))
        if show_line_labels
            array.push(level_labels, label.new(x2, std_bep_lower, "Lower (" + str.tostring(st_lower) + ") Static BEP: " + str.tostring(std_bep_lower, "#.##"), color=color.new(c_lower, 80), textcolor=c_lower, style=label.style_label_left, size=size.small))

    // 2. CE & PE Previous Day Close Lines
    if show_pdc_lines
        array.push(level_lines, line.new(x1, ce_atm_pdc, x2, ce_atm_pdc, color=c_ce_pdc, width=1, style=line.style_dashed))
        if show_line_labels
            array.push(level_labels, label.new(x2, ce_atm_pdc, "CE Prev Close: " + str.tostring(ce_atm_pdc, "#.##"), color=color.new(c_ce_pdc, 80), textcolor=c_ce_pdc, style=label.style_label_left, size=size.small))

        array.push(level_lines, line.new(x1, pe_atm_pdc, x2, pe_atm_pdc, color=c_pe_pdc, width=1, style=line.style_dashed))
        if show_line_labels
            array.push(level_labels, label.new(x2, pe_atm_pdc, "PE Prev Close: " + str.tostring(pe_atm_pdc, "#.##"), color=color.new(c_pe_pdc, 80), textcolor=c_pe_pdc, style=label.style_label_left, size=size.small))

    // 3. CE & PE Previous Day High & Low Lines
    if show_pdh_pdl_lines
        array.push(level_lines, line.new(x1, ce_atm_pdh, x2, ce_atm_pdh, color=c_ce_pdh, width=1, style=line.style_dotted))
        if show_line_labels
            array.push(level_labels, label.new(x2, ce_atm_pdh, "CE Prev High: " + str.tostring(ce_atm_pdh, "#.##"), color=color.new(c_ce_pdh, 80), textcolor=c_ce_pdh, style=label.style_label_left, size=size.small))

        array.push(level_lines, line.new(x1, ce_atm_pdl, x2, ce_atm_pdl, color=c_ce_pdl, width=1, style=line.style_dotted))
        if show_line_labels
            array.push(level_labels, label.new(x2, ce_atm_pdl, "CE Prev Low: " + str.tostring(ce_atm_pdl, "#.##"), color=color.new(c_ce_pdl, 80), textcolor=c_ce_pdl, style=label.style_label_left, size=size.small))

        array.push(level_lines, line.new(x1, pe_atm_pdh, x2, pe_atm_pdh, color=c_pe_pdh, width=1, style=line.style_dotted))
        if show_line_labels
            array.push(level_labels, label.new(x2, pe_atm_pdh, "PE Prev High: " + str.tostring(pe_atm_pdh, "#.##"), color=color.new(c_pe_pdh, 80), textcolor=c_pe_pdh, style=label.style_label_left, size=size.small))

        array.push(level_lines, line.new(x1, pe_atm_pdl, x2, pe_atm_pdl, color=c_pe_pdl, width=1, style=line.style_dotted))
        if show_line_labels
            array.push(level_labels, label.new(x2, pe_atm_pdl, "PE Prev Low: " + str.tostring(pe_atm_pdl, "#.##"), color=color.new(c_pe_pdl, 80), textcolor=c_pe_pdl, style=label.style_label_left, size=size.small))

// =========================================================================
// SUMMARY DASHBOARD TABLE
// =========================================================================
var table info_table = na
if barstate.islast and show_options_table
    table.delete(info_table)
    
    position_choice = table_pos_str == "Top Right" ? position.top_right :
                      table_pos_str == "Top Left" ? position.top_left :
                      table_pos_str == "Bottom Right" ? position.bottom_right : position.bottom_left
                      
    t_sz = table_size_str == "Tiny" ? size.tiny :
           table_size_str == "Small" ? size.small :
           table_size_str == "Normal" ? size.normal : size.large
           
    info_table := table.new(position_choice, 9, 5, border_width=1, border_color=color.gray)
    
    // Header Row 0
    table.cell(info_table, 0, 0, "Asset: " + final_root, bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 1, 0, "Offset: " + str.tostring(offsetPts), bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 2, 0, "Basis: " + standard_bep_basis, bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 3, 0, "ATM Strike:", bgcolor=#1565C0, text_color=color.silver, text_size=t_sz)
    table.cell(info_table, 4, 0, str.tostring(st_atm), bgcolor=#FFEE58, text_color=color.black, text_size=t_sz)
    table.cell(info_table, 5, 0, "Formula:", bgcolor=#1565C0, text_color=color.silver, text_size=t_sz)
    table.cell(info_table, 6, 0, "(CE + PE) / 2", bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 7, 0, "", bgcolor=#1565C0)
    table.cell(info_table, 8, 0, "", bgcolor=#1565C0)

    // Row 1: Column Headers
    table.cell(info_table, 0, 1, "Strike Level", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 1, 1, "CE Ref", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 2, 1, "PE Ref", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 3, 1, "Static BEP", bgcolor=#37474F, text_color=color.aqua, text_size=t_sz)
    table.cell(info_table, 4, 1, "CE LTP", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 5, 1, "PE LTP", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 6, 1, "Realtime BEP", bgcolor=#37474F, text_color=color.yellow, text_size=t_sz)
    table.cell(info_table, 7, 1, "CE Prev High/Low", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 8, 1, "PE Prev High/Low", bgcolor=#37474F, text_color=color.white, text_size=t_sz)

    // Row 2: Upper Strike (+Offset)
    f_fill_table_row(info_table, 2, "Upper (" + str.tostring(st_upper) + ")", ce_upr_ref, pe_upr_ref, std_bep_upper, ce_upr_ltp, pe_upr_ltp, run_bep_upper, ce_upr_pdh, ce_upr_pdl, pe_upr_pdh, pe_upr_pdl, color.new(#C62828, 0), t_sz)

    // Row 3: ATM Strike (Selected)
    f_fill_table_row(info_table, 3, "ATM (" + str.tostring(st_atm) + ")", ce_atm_ref, pe_atm_ref, std_bep_atm, ce_atm_ltp, pe_atm_ltp, run_bep_atm, ce_atm_pdh, ce_atm_pdl, pe_atm_pdh, pe_atm_pdl, color.new(#F57F17, 0), t_sz)

    // Row 4: Lower Strike (-Offset)
    f_fill_table_row(info_table, 4, "Lower (" + str.tostring(st_lower) + ")", ce_lwr_ref, pe_lwr_ref, std_bep_lower, ce_lwr_ltp, pe_lwr_ltp, run_bep_lower, ce_lwr_pdh, ce_lwr_pdl, pe_lwr_pdh, pe_lwr_pdl, color.new(#2E7D32, 0), t_sz)
