//@version=6
indicator("Techfrost Multi-Strike ATM & Basket Average Analytics", overlay=false, precision=2)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum UnderlyingAsset
    auto      = "Auto-Detect"
    nifty     = "NIFTY"
    banknifty = "BANKNIFTY"
    crudeoil  = "CRUDEOIL"
    gold      = "GOLD"
    stock     = "Stock (Equity)"

enum OptionType
    auto = "Auto-Detect"
    ce   = "Call (CE)"
    pe   = "Put (PE)"

enum StepOverrideChoice
    auto    = "Auto"
    step25  = "25"
    step50  = "50"
    step100 = "100"
    step200 = "200"
    step500 = "500"

// --- Instrument Settings ---
underlyingInput    = input.enum(UnderlyingAsset.auto, "Underlying Asset", group="Instrument Settings")
optionTypeInput    = input.enum(OptionType.auto, "Option Type", group="Instrument Settings")
numStrikesInput    = input.int(4, "Number of ITM/OTM Strikes Each Side", minval=1, maxval=4, group="Instrument Settings",
  tooltip="1 = 3 Strikes (1 ITM + ATM + 1 OTM), 2 = 5 Strikes (2 ITM + ATM + 2 OTM), 3 = 7 Strikes, 4 = 9 Strikes.")
spotTickerOverride = input.symbol("", "Spot Symbol Override (e.g. NSE:RELIANCE)", group="Instrument Settings")
strikeOverride     = input.float(0.0, "Strike Price Override", minval=0.0, group="Instrument Settings")
strikeStepInput    = input.enum(StepOverrideChoice.auto, "Strike Step Override", group="Instrument Settings",
  tooltip="Set to Auto for auto-detection based on underlying (50 for Nifty/Crude, 100 for BankNifty/Gold).")

// --- Display Controls ---
showTableInput       = input.bool(true, "Show Summary & Strike Table", group="Display Controls",
  tooltip="Enable or disable the summary & strike analytics table.")
tablePosInput        = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Display Controls")
tableTextSizeInput   = input.string("Small", "Table Text Size / Resizing", options=["Auto", "Tiny", "Small", "Normal", "Large"], group="Display Controls",
  tooltip="Adjust the table font and cell size (Auto, Tiny, Small, Normal, Large).")

showPlotsInput       = input.bool(true, "Show Basket Average Lines", group="Display Controls",
  tooltip="Enable or disable the CE and PE average line charts.")
showHistogramsInput  = input.bool(true, "Show Average Change Plots", group="Display Controls",
  tooltip="Enable or disable the average change from Day Open plots.")
changePlotStyleInput = input.string("Line", "Avg Change Plot Style", options=["Line", "Histogram"], group="Display Controls",
  tooltip="Choose whether to plot average change series as continuous Lines or Histograms.")
showSignalPlotsInput = input.bool(true, "Show Strong Buy Signal Shapes", group="Display Controls",
  tooltip="Enable or disable visual Strong Buy CE / PE signal markers on chart.")

// --- Styling & Colors ---
colorCEAvgOpen     = input.color(color.new(#00C853, 50), "CE Day Open Basket Avg Line Color", group="Styling & Colors")
colorCEAvgCur      = input.color(#00E676, "CE Current Basket Avg Line Color", group="Styling & Colors")

colorPEAvgOpen     = input.color(color.new(#D50000, 50), "PE Day Open Basket Avg Line Color", group="Styling & Colors")
colorPEAvgCur      = input.color(#FF1744, "PE Current Basket Avg Line Color", group="Styling & Colors")

colorCurATMHighlight = input.color(#FFEE58, "Current ATM Cell Highlight (Yellow)", group="Styling & Colors")
colorDayATMHighlight = input.color(#00E5FF, "Day Open ATM Cell Highlight (Cyan)", group="Styling & Colors")

// ==========================================
// TICKER PARSING & AUTO-DETECTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

// ----- Detect underlying -----
UnderlyingAsset actualUnderlying = na
if underlyingInput == UnderlyingAsset.auto
    if str.contains(cleanTicker, "BANKNIFTY")
        actualUnderlying := UnderlyingAsset.banknifty
    else if str.contains(cleanTicker, "NIFTY")
        actualUnderlying := UnderlyingAsset.nifty
    else if str.contains(cleanTicker, "CRUDEOIL")
        actualUnderlying := UnderlyingAsset.crudeoil
    else if str.contains(cleanTicker, "GOLD") and not str.contains(cleanTicker, "GOLDM") and not str.contains(cleanTicker, "GOLDPETAL")
        actualUnderlying := UnderlyingAsset.gold
    else if str.contains(cleanTicker, "GOLDM")
        actualUnderlying := UnderlyingAsset.gold
    else
        actualUnderlying := UnderlyingAsset.stock
else
    actualUnderlying := underlyingInput

// ----- Detect option type -----
bool isCall = false
bool isPut  = false

if optionTypeInput == OptionType.ce
    isCall := true
else if optionTypeInput == OptionType.pe
    isPut := true
else
    if str.contains(cleanTicker, "CE")
        isCall := true
    else if str.contains(cleanTicker, "PE")
        isPut := true
    else if str.match(cleanTicker, "C\\d+$") != ""
        isCall := true
    else if str.match(cleanTicker, "P\\d+$") != ""
        isPut := true

// ----- Strike extraction from chart symbol -----
float detectedStrike = na
string tickerWithoutCEPE = ""

int tickerLen = str.length(cleanTicker)
if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, tickerLen - 2)

string matchC = str.match(cleanTicker, "C\\d+$")
string matchP = str.match(cleanTicker, "P\\d+$")

if matchC != ""
    detectedStrike := str.tonumber(str.substring(matchC, 1))
else if matchP != ""
    detectedStrike := str.tonumber(str.substring(matchP, 1))
else if tickerWithoutCEPE != ""
    string strikeDigits = str.match(tickerWithoutCEPE, "\\d+$")
    detectedStrike := str.tonumber(strikeDigits)

float chartStrikePrice = strikeOverride > 0.0 ? strikeOverride : detectedStrike

// ----- Determine Step Size -----
int stepVal = 50
switch strikeStepInput
    StepOverrideChoice.step25  => stepVal := 25
    StepOverrideChoice.step50  => stepVal := 50
    StepOverrideChoice.step100 => stepVal := 100
    StepOverrideChoice.step200 => stepVal := 200
    StepOverrideChoice.step500 => stepVal := 500
    =>
        switch actualUnderlying
            UnderlyingAsset.banknifty => stepVal := 100
            UnderlyingAsset.nifty     => stepVal := 50
            UnderlyingAsset.crudeoil  => stepVal := 50
            UnderlyingAsset.gold      => stepVal := 100
            UnderlyingAsset.stock     => stepVal := 50

// ==========================================
// SPOT TICKER RESOLUTION & STRICT DAY OPEN ATM CENTER ANCHORING
// ==========================================

string spotTicker = ""
if str.length(spotTickerOverride) > 0
    spotTicker := spotTickerOverride
else
    switch actualUnderlying
        UnderlyingAsset.banknifty => spotTicker := "NSE:BANKNIFTY"
        UnderlyingAsset.nifty     => spotTicker := "NSE:NIFTY"
        UnderlyingAsset.crudeoil  => spotTicker := "MCX:CRUDEOIL1!"
        UnderlyingAsset.gold      => spotTicker := "MCX:GOLD1!"
        UnderlyingAsset.stock     =>
            string rootGuess = str.match(cleanTicker, "^[A-Z&]+")
            if rootGuess != ""
                spotTicker := syminfo.prefix + ":" + rootGuess
            else
                spotTicker := syminfo.prefix + ":" + cleanTicker

// Fetch Day Open Spot Price for the underlying
float spotDayOpen = request.security(spotTicker, "D", open, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Base Center Strike is fixed statically on barstate.isfirst to keep security requests 100% constant across all bars
var int baseCenterStrike = na
if barstate.isfirst or na(baseCenterStrike)
    float refPrice = strikeOverride > 0.0 ? strikeOverride : (not na(chartStrikePrice) and chartStrikePrice > 0 ? chartStrikePrice : spotDayOpen)
    baseCenterStrike := int(math.round(refPrice / stepVal) * stepVal)

int baseStrike = baseCenterStrike

// ==========================================
// FAIL-SAFE CE & PE TICKER PREFIX CONSTRUCTION
// ==========================================

string strikeDigitsStr = str.tostring(int(chartStrikePrice))
int digitsLen = str.length(strikeDigitsStr)

string ce_prefix = ""
string pe_prefix = ""

if isCall
    ce_prefix := str.substring(cleanTicker, 0, str.length(cleanTicker) - digitsLen)
    int cPos = str.length(ce_prefix) - 1
    pe_prefix := str.substring(ce_prefix, 0, cPos) + "P"
else
    pe_prefix := str.substring(cleanTicker, 0, str.length(cleanTicker) - digitsLen)
    int pPos = str.length(pe_prefix) - 1
    ce_prefix := str.substring(pe_prefix, 0, pPos) + "C"

f_build_ce_ticker(int target_strike) =>
    ce_prefix + str.tostring(target_strike)

f_build_pe_ticker(int target_strike) =>
    pe_prefix + str.tostring(target_strike)

// 9 Strikes centered strictly around Day Open ATM (baseStrike is always middle row)
int k_0  = baseStrike
int k_p1 = baseStrike + 1 * stepVal
int k_p2 = baseStrike + 2 * stepVal
int k_p3 = baseStrike + 3 * stepVal
int k_p4 = baseStrike + 4 * stepVal

int k_m1 = baseStrike - 1 * stepVal
int k_m2 = baseStrike - 2 * stepVal
int k_m3 = baseStrike - 3 * stepVal
int k_m4 = baseStrike - 4 * stepVal

// ==========================================
// DATA FETCHING FOR STRIKES (STATIC 18 CALLS TOTAL)
// ==========================================

f_get_strike_open_and_close() =>
    float d_op = ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0)
    [d_op, close]

[ce_o_p4, ce_c_p4] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p4), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p4, pe_c_p4] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p4), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p3, ce_c_p3] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p3), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p3, pe_c_p3] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p3), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p2, ce_c_p2] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p2), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p2, pe_c_p2] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p2), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p1, ce_c_p1] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p1), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p1, pe_c_p1] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p1), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_0,  ce_c_0]  = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_0),  timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_0,  pe_c_0]  = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_0),  timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m1, ce_c_m1] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m1), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m1, pe_c_m1] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m1), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m2, ce_c_m2] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m2), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m2, pe_c_m2] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m2), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m3, ce_c_m3] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m3), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m3, pe_c_m3] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m3), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m4, ce_c_m4] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m4), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m4, pe_c_m4] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m4), timeframe.period, f_get_strike_open_and_close(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// ==========================================
// DAY OPEN ATM CALCULATION (MIN |CE OPEN - PE OPEN|)
// ==========================================

float diff_open_p4 = math.abs(ce_o_p4 - pe_o_p4)
float diff_open_p3 = math.abs(ce_o_p3 - pe_o_p3)
float diff_open_p2 = math.abs(ce_o_p2 - pe_o_p2)
float diff_open_p1 = math.abs(ce_o_p1 - pe_o_p1)
float diff_open_0  = math.abs(ce_o_0  - pe_o_0)
float diff_open_m1 = math.abs(ce_o_m1 - pe_o_m1)
float diff_open_m2 = math.abs(ce_o_m2 - pe_o_m2)
float diff_open_m3 = math.abs(ce_o_m3 - pe_o_m3)
float diff_open_m4 = math.abs(ce_o_m4 - pe_o_m4)

float minDiffOpen = math.min(diff_open_p4, math.min(diff_open_p3, math.min(diff_open_p2, math.min(diff_open_p1, math.min(diff_open_0, math.min(diff_open_m1, math.min(diff_open_m2, math.min(diff_open_m3, diff_open_m4))))))))

int dayOpenATMStrike = k_0
if minDiffOpen == diff_open_p4
    dayOpenATMStrike := k_p4
else if minDiffOpen == diff_open_p3
    dayOpenATMStrike := k_p3
else if minDiffOpen == diff_open_p2
    dayOpenATMStrike := k_p2
else if minDiffOpen == diff_open_p1
    dayOpenATMStrike := k_p1
else if minDiffOpen == diff_open_0
    dayOpenATMStrike := k_0
else if minDiffOpen == diff_open_m1
    dayOpenATMStrike := k_m1
else if minDiffOpen == diff_open_m2
    dayOpenATMStrike := k_m2
else if minDiffOpen == diff_open_m3
    dayOpenATMStrike := k_m3
else if minDiffOpen == diff_open_m4
    dayOpenATMStrike := k_m4

// ==========================================
// CURRENT REALTIME ATM CALCULATION (MIN |CE LTP - PE LTP|)
// ==========================================

float diff_cur_p4 = math.abs(ce_c_p4 - pe_c_p4)
float diff_cur_p3 = math.abs(ce_c_p3 - pe_c_p3)
float diff_cur_p2 = math.abs(ce_c_p2 - pe_c_p2)
float diff_cur_p1 = math.abs(ce_c_p1 - pe_c_p1)
float diff_cur_0  = math.abs(ce_c_0  - pe_c_0)
float diff_cur_m1 = math.abs(ce_c_m1 - pe_c_m1)
float diff_cur_m2 = math.abs(ce_c_m2 - pe_c_m2)
float diff_cur_m3 = math.abs(ce_c_m3 - pe_c_m3)
float diff_cur_m4 = math.abs(ce_c_m4 - pe_c_m4)

float minDiffCur = math.min(diff_cur_p4, math.min(diff_cur_p3, math.min(diff_cur_p2, math.min(diff_cur_p1, math.min(diff_cur_0, math.min(diff_cur_m1, math.min(diff_cur_m2, math.min(diff_cur_m3, diff_cur_m4))))))))

int curATMStrike = k_0
if minDiffCur == diff_cur_p4
    curATMStrike := k_p4
else if minDiffCur == diff_cur_p3
    curATMStrike := k_p3
else if minDiffCur == diff_cur_p2
    curATMStrike := k_p2
else if minDiffCur == diff_cur_p1
    curATMStrike := k_p1
else if minDiffCur == diff_cur_0
    curATMStrike := k_0
else if minDiffCur == diff_cur_m1
    curATMStrike := k_m1
else if minDiffCur == diff_cur_m2
    curATMStrike := k_m2
else if minDiffCur == diff_cur_m3
    curATMStrike := k_m3
else if minDiffCur == diff_cur_m4
    curATMStrike := k_m4

// ==========================================
// BASKET AVERAGE CALCULATIONS (BASED ON numStrikesInput)
// ==========================================

float sum_ce_open = ce_o_0
float sum_pe_open = pe_o_0
float sum_ce_cur  = ce_c_0
float sum_pe_cur  = pe_c_0
int total_count   = 1 + 2 * numStrikesInput

if numStrikesInput >= 1
    sum_ce_open += ce_o_p1 + ce_o_m1
    sum_pe_open += pe_o_p1 + pe_o_m1
    sum_ce_cur  += ce_c_p1 + ce_c_m1
    sum_pe_cur  += pe_c_p1 + pe_c_m1

if numStrikesInput >= 2
    sum_ce_open += ce_o_p2 + ce_o_m2
    sum_pe_open += pe_o_p2 + pe_o_m2
    sum_ce_cur  += ce_c_p2 + ce_c_m2
    sum_pe_cur  += pe_c_p2 + pe_c_m2

if numStrikesInput >= 3
    sum_ce_open += ce_o_p3 + ce_o_m3
    sum_pe_open += pe_o_p3 + pe_o_m3
    sum_ce_cur  += ce_c_p3 + ce_c_m3
    sum_pe_cur  += pe_c_p3 + pe_c_m3

if numStrikesInput >= 4
    sum_ce_open += ce_o_p4 + ce_o_m4
    sum_pe_open += pe_o_p4 + pe_o_m4
    sum_ce_cur  += ce_c_p4 + ce_c_m4
    sum_pe_cur  += pe_c_p4 + pe_c_m4

float ceAvgOpen = sum_ce_open / float(total_count)
float peAvgOpen = sum_pe_open / float(total_count)
float ceAvgCur  = sum_ce_cur  / float(total_count)
float peAvgCur  = sum_pe_cur  / float(total_count)

// Average Changes from Day Open
float ceAvgChg = ceAvgCur - ceAvgOpen
float peAvgChg = peAvgCur - peAvgOpen

// Combined Basket Averages
float basketAvgOpen = (ceAvgOpen + peAvgOpen) / 2.0
float basketAvgCur  = (ceAvgCur + peAvgCur) / 2.0
float basketAvgChg  = basketAvgCur - basketAvgOpen

// ==========================================
// STRONG BUY SIGNAL EVALUATION & ALERTS
// ==========================================

// Strong Buy CE (SB CE): CE current avg crosses over CE day open avg, PE current avg is <= PE day open avg, CE avg change > 0 AND PE avg change <= 0 (Images 1 & 2)
bool sb_ce_cond = ta.crossover(ceAvgCur, ceAvgOpen) and (peAvgCur <= peAvgOpen) and (ceAvgChg > 0) and (peAvgChg <= 0)

// Strong Buy PE (SB PE): PE current avg crosses over PE day open avg, CE current avg is <= CE day open avg, PE avg change > 0 AND CE avg change <= 0 (Image 3)
bool sb_pe_cond = ta.crossover(peAvgCur, peAvgOpen) and (ceAvgCur <= ceAvgOpen) and (peAvgChg > 0) and (ceAvgChg <= 0)

var bool in_sb_ce = false
var bool in_sb_pe = false

bool plot_sb_ce = false
bool plot_sb_pe = false

if sb_ce_cond and not in_sb_ce
    in_sb_ce   := true
    in_sb_pe   := false
    plot_sb_ce := true

if ta.crossunder(ceAvgCur, ceAvgOpen)
    in_sb_ce := false

if sb_pe_cond and not in_sb_pe
    in_sb_pe   := true
    in_sb_ce   := false
    plot_sb_pe := true

if ta.crossunder(peAvgCur, peAvgOpen)
    in_sb_pe := false

// Visual Signal Plotshapes (on sub-window chart)
plotshape(showSignalPlotsInput and plot_sb_ce, title="Strong Buy CE (SB CE)", style=shape.triangleup, location=location.belowbar, color=#00E676, size=size.small, text="SB CE")
plotshape(showSignalPlotsInput and plot_sb_pe, title="Strong Buy PE (SB PE)", style=shape.triangledown, location=location.abovebar, color=#FF1744, size=size.small, text="SB PE")

// TradingView Alert Conditions
alertcondition(plot_sb_ce, title="Strong Buy CE (SB CE)", message="STRONG BUY CE Signal: CE Current Avg Crossed Above Day Open Avg while PE Avg is Below Day Open Avg on {{ticker}}!")
alertcondition(plot_sb_pe, title="Strong Buy PE (SB PE)", message="STRONG BUY PE Signal: PE Current Avg Crossed Above Day Open Avg while CE Avg is Below Day Open Avg on {{ticker}}!")

// ==========================================
// AVERAGE PLOTS (SUB-WINDOW BOTTOM INDICATOR)
// ==========================================

plot(showPlotsInput ? ceAvgOpen : na, title="CE Basket Day Open Avg", color=colorCEAvgOpen, linewidth=1, style=plot.style_stepline)
plot(showPlotsInput ? ceAvgCur  : na, title="CE Basket Current Avg",  color=colorCEAvgCur,  linewidth=2)

plot(showPlotsInput ? peAvgOpen : na, title="PE Basket Day Open Avg", color=colorPEAvgOpen, linewidth=1, style=plot.style_stepline)
plot(showPlotsInput ? peAvgCur  : na, title="PE Basket Current Avg",  color=colorPEAvgCur,  linewidth=2)

// Average Change Series Plot (Lines or Histograms based on input choice with exact Image 2 styling)
color col_ceAvgChg = ceAvgChg >= 0 ? #00E676 : #FF1744
color col_peAvgChg = peAvgChg >= 0 ? #00B0FF : #FF9100

plot(showHistogramsInput and changePlotStyleInput == "Histogram" ? ceAvgChg : na, title="CE Basket Avg Change (Histogram)", color=color.new(col_ceAvgChg, 30), linewidth=2, style=plot.style_histogram)
plot(showHistogramsInput and changePlotStyleInput == "Histogram" ? peAvgChg : na, title="PE Basket Avg Change (Histogram)", color=color.new(col_peAvgChg, 30), linewidth=2, style=plot.style_histogram)

plot(showHistogramsInput and changePlotStyleInput == "Line" ? ceAvgChg : na, title="CE Basket Avg Change from Open", color=col_ceAvgChg, linewidth=2, style=plot.style_line)
plot(showHistogramsInput and changePlotStyleInput == "Line" ? peAvgChg : na, title="PE Basket Avg Change from Open", color=col_peAvgChg, linewidth=2, style=plot.style_line)

// ==========================================
// DASHBOARD & STRIKE TABLE
// ==========================================

f_get_table_pos(string pos_str) =>
    switch pos_str
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

f_get_table_text_size(string sz_str) =>
    switch sz_str
        "Auto"   => size.auto
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

var table summaryTable = table.new(f_get_table_pos(tablePosInput), 8, 15, bgcolor=color.black, border_color=color.gray, border_width=1, force_overlay=true)

string underlyingName = switch actualUnderlying
    UnderlyingAsset.banknifty => "BANKNIFTY"
    UnderlyingAsset.nifty     => "NIFTY"
    UnderlyingAsset.crudeoil  => "CRUDEOIL"
    UnderlyingAsset.gold      => "GOLD"
    UnderlyingAsset.stock     => "STOCK"
    => "Unknown"

string curTextSize = f_get_table_text_size(tableTextSizeInput)

f_fill_grid_row(table tbl, int r, int st_val, bool is_cur_atm, bool is_day_atm, float ce_op, float ce_ltp, float pe_op, float pe_ltp, string t_sz) =>
    string st_label = str.tostring(st_val) + (is_cur_atm and is_day_atm ? " (Cur & Day ATM)" : (is_cur_atm ? " (Cur ATM)" : (is_day_atm ? " (Day ATM)" : "")))
    color st_bg = (is_cur_atm and is_day_atm) ? color.new(#76FF03, 0) : (is_cur_atm ? colorCurATMHighlight : (is_day_atm ? colorDayATMHighlight : color.black))
    color st_tc = (is_cur_atm or is_day_atm) ? color.black : color.white
    table.cell(tbl, 0, r, st_label, bgcolor=st_bg, text_color=st_tc, text_size=t_sz)

    table.cell(tbl, 1, r, na(ce_op) ? "N/A" : str.tostring(ce_op, "#.##"), bgcolor=color.black, text_color=color.white, text_size=t_sz)
    table.cell(tbl, 2, r, na(ce_ltp) ? "N/A" : str.tostring(ce_ltp, "#.##"), bgcolor=color.black, text_color=color.white, text_size=t_sz)

    float ce_chg = ce_ltp - ce_op
    string ce_chg_str = na(ce_chg) ? "N/A" : ((ce_chg >= 0 ? "+" : "") + str.tostring(ce_chg, "#.##"))
    color ce_chg_bg   = na(ce_chg) ? color.black : (ce_chg > 0 ? color.new(#1B5E20, 0) : (ce_chg < 0 ? color.new(#880E4F, 0) : color.black))
    table.cell(tbl, 3, r, ce_chg_str, bgcolor=ce_chg_bg, text_color=color.white, text_size=t_sz)

    table.cell(tbl, 4, r, na(pe_op) ? "N/A" : str.tostring(pe_op, "#.##"), bgcolor=color.black, text_color=color.white, text_size=t_sz)
    table.cell(tbl, 5, r, na(pe_ltp) ? "N/A" : str.tostring(pe_ltp, "#.##"), bgcolor=color.black, text_color=color.white, text_size=t_sz)

    float pe_chg = pe_ltp - pe_op
    string pe_chg_str = na(pe_chg) ? "N/A" : ((pe_chg >= 0 ? "+" : "") + str.tostring(pe_chg, "#.##"))
    color pe_chg_bg   = na(pe_chg) ? color.black : (pe_chg > 0 ? color.new(#1B5E20, 0) : (pe_chg < 0 ? color.new(#880E4F, 0) : color.black))
    table.cell(tbl, 6, r, pe_chg_str, bgcolor=pe_chg_bg, text_color=color.white, text_size=t_sz)

    float raw_diff = ce_ltp - pe_ltp
    float abs_diff = na(raw_diff) ? na : math.abs(raw_diff)
    string diff_str = na(raw_diff) ? "N/A" : str.tostring(abs_diff, "#.##")
    color diff_bg = na(raw_diff) ? color.black : (raw_diff > 0 ? color.new(#1B5E20, 0) : (raw_diff < 0 ? color.new(#880E4F, 0) : color.black))
    table.cell(tbl, 7, r, diff_str, bgcolor=diff_bg, text_color=color.white, text_size=t_sz)

if barstate.islast
    if not showTableInput
        table.delete(summaryTable)
    else
        string strikeTag = str.tostring(total_count) + "-Strike Basket (" + str.tostring(numStrikesInput) + " ITM + ATM + " + str.tostring(numStrikesInput) + " OTM)"

        // Row 0: Top Header Banner
        table.cell(summaryTable, 0, 0, "Asset: " + underlyingName, bgcolor=color.new(#1565C0, 0), text_color=color.white, text_size=curTextSize)
        table.cell(summaryTable, 1, 0, "Step: " + str.tostring(stepVal), bgcolor=color.new(#1565C0, 0), text_color=color.white, text_size=curTextSize)
        table.cell(summaryTable, 2, 0, strikeTag, bgcolor=color.new(#1565C0, 0), text_color=color.yellow, text_size=curTextSize)
        table.cell(summaryTable, 3, 0, "Day Open ATM:", bgcolor=color.new(#1565C0, 0), text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTable, 4, 0, str.tostring(dayOpenATMStrike), bgcolor=colorDayATMHighlight, text_color=color.black, text_size=curTextSize)
        table.cell(summaryTable, 5, 0, "Current ATM:", bgcolor=color.new(#1565C0, 0), text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTable, 6, 0, str.tostring(curATMStrike), bgcolor=colorCurATMHighlight, text_color=color.black, text_size=curTextSize)
        table.cell(summaryTable, 7, 0, "", bgcolor=color.new(#1565C0, 0))

        // Row 1: Day Open Averages (CE & PE)
        table.cell(summaryTable, 0, 1, "Day Open Basket Avg", bgcolor=color.new(#212121, 0), text_color=color.white, text_size=curTextSize)
        table.cell(summaryTable, 1, 1, "CE Open Avg:", bgcolor=color.new(#212121, 0), text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTable, 2, 1, str.tostring(ceAvgOpen, "#.##"), bgcolor=color.new(#212121, 0), text_color=#00E676, text_size=curTextSize)
        table.cell(summaryTable, 3, 1, "PE Open Avg:", bgcolor=color.new(#212121, 0), text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTable, 4, 1, str.tostring(peAvgOpen, "#.##"), bgcolor=color.new(#212121, 0), text_color=#FF1744, text_size=curTextSize)
        table.cell(summaryTable, 5, 1, "Basket Open Avg:", bgcolor=color.new(#212121, 0), text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTable, 6, 1, str.tostring(basketAvgOpen, "#.##"), bgcolor=color.new(#212121, 0), text_color=color.white, text_size=curTextSize)
        table.cell(summaryTable, 7, 0, "", bgcolor=color.new(#212121, 0))

        // Row 2: Current Running Averages & Changes
        table.cell(summaryTable, 0, 2, "Current Running Avg", bgcolor=color.new(#1C1C1C, 0), text_color=color.white, text_size=curTextSize)
        table.cell(summaryTable, 1, 2, "CE Cur Avg:", bgcolor=color.new(#1C1C1C, 0), text_color=color.silver, text_size=curTextSize)

        string ceAvgStr = str.tostring(ceAvgCur, "#.##") + " (" + (ceAvgChg >= 0 ? "+" : "") + str.tostring(ceAvgChg, "#.##") + ")"
        color ceAvgColor = ceAvgChg >= 0 ? #00E676 : #FF5252
        table.cell(summaryTable, 2, 2, ceAvgStr, bgcolor=color.new(#1C1C1C, 0), text_color=ceAvgColor, text_size=curTextSize)

        table.cell(summaryTable, 3, 2, "PE Cur Avg:", bgcolor=color.new(#1C1C1C, 0), text_color=color.silver, text_size=curTextSize)
        string peAvgStr = str.tostring(peAvgCur, "#.##") + " (" + (peAvgChg >= 0 ? "+" : "") + str.tostring(peAvgChg, "#.##") + ")"
        color peAvgColor = peAvgChg >= 0 ? #00E676 : #FF5252
        table.cell(summaryTable, 4, 2, peAvgStr, bgcolor=color.new(#1C1C1C, 0), text_color=peAvgColor, text_size=curTextSize)

        table.cell(summaryTable, 5, 2, "Basket Cur Avg:", bgcolor=color.new(#1C1C1C, 0), text_color=color.silver, text_size=curTextSize)
        string basketAvgStr = str.tostring(basketAvgCur, "#.##") + " (" + (basketAvgChg >= 0 ? "+" : "") + str.tostring(basketAvgChg, "#.##") + ")"
        color basketAvgColor = basketAvgChg >= 0 ? #00E676 : #FF5252
        table.cell(summaryTable, 6, 2, basketAvgStr, bgcolor=color.new(#1C1C1C, 0), text_color=basketAvgColor, text_size=curTextSize)
        table.cell(summaryTable, 7, 2, "", bgcolor=color.new(#1C1C1C, 0))

        // Row 3: Grid Column Headers
        table.cell(summaryTable, 0, 3, "Strike",     bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
        table.cell(summaryTable, 1, 3, "CE Open",    bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
        table.cell(summaryTable, 2, 3, "CE LTP",     bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
        table.cell(summaryTable, 3, 3, "CE Chg",     bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
        table.cell(summaryTable, 4, 3, "PE Open",    bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
        table.cell(summaryTable, 5, 3, "PE LTP",     bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
        table.cell(summaryTable, 6, 3, "PE Chg",     bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
        table.cell(summaryTable, 7, 3, "|CE-PE| Diff", bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)

        // Rows 4+: Populate active selected strikes grid
        int rowIdx = 4
        if numStrikesInput >= 4
            f_fill_grid_row(summaryTable, rowIdx, k_p4, k_p4 == curATMStrike, k_p4 == dayOpenATMStrike, ce_o_p4, ce_c_p4, pe_o_p4, pe_c_p4, curTextSize)
            rowIdx += 1

        if numStrikesInput >= 3
            f_fill_grid_row(summaryTable, rowIdx, k_p3, k_p3 == curATMStrike, k_p3 == dayOpenATMStrike, ce_o_p3, ce_c_p3, pe_o_p3, pe_c_p3, curTextSize)
            rowIdx += 1

        if numStrikesInput >= 2
            f_fill_grid_row(summaryTable, rowIdx, k_p2, k_p2 == curATMStrike, k_p2 == dayOpenATMStrike, ce_o_p2, ce_c_p2, pe_o_p2, pe_c_p2, curTextSize)
            rowIdx += 1

        if numStrikesInput >= 1
            f_fill_grid_row(summaryTable, rowIdx, k_p1, k_p1 == curATMStrike, k_p1 == dayOpenATMStrike, ce_o_p1, ce_c_p1, pe_o_p1, pe_c_p1, curTextSize)
            rowIdx += 1

        // ATM Row (0)
        f_fill_grid_row(summaryTable, rowIdx, k_0, k_0 == curATMStrike, k_0 == dayOpenATMStrike, ce_o_0, ce_c_0, pe_o_0, pe_c_0, curTextSize)
        rowIdx += 1

        if numStrikesInput >= 1
            f_fill_grid_row(summaryTable, rowIdx, k_m1, k_m1 == curATMStrike, k_m1 == dayOpenATMStrike, ce_o_m1, ce_c_m1, pe_o_m1, pe_c_m1, curTextSize)
            rowIdx += 1

        if numStrikesInput >= 2
            f_fill_grid_row(summaryTable, rowIdx, k_m2, k_m2 == curATMStrike, k_m2 == dayOpenATMStrike, ce_o_m2, ce_c_m2, pe_o_m2, pe_c_m2, curTextSize)
            rowIdx += 1

        if numStrikesInput >= 3
            f_fill_grid_row(summaryTable, rowIdx, k_m3, k_m3 == curATMStrike, k_m3 == dayOpenATMStrike, ce_o_m3, ce_c_m3, pe_o_m3, pe_c_m3, curTextSize)
            rowIdx += 1

        if numStrikesInput >= 4
            f_fill_grid_row(summaryTable, rowIdx, k_m4, k_m4 == curATMStrike, k_m4 == dayOpenATMStrike, ce_o_m4, ce_c_m4, pe_o_m4, pe_c_m4, curTextSize)
            rowIdx += 1
