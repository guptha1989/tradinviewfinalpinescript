//@version=6
indicator("4. Techfrost Multi-Strike BEP Lines Analytics", shorttitle="TF MultiBEP Lines", overlay=true, precision=2)

// =========================================================================
// ENUMS & INPUTS
// =========================================================================
enum ATMSelectionMode
    auto   = "Auto-Detect (Chart Ticker)"
    manual = "Manual Strike Entry"

enum PresetStock
    custom     = "Custom"
    nifty      = "NIFTY"
    banknifty  = "BANKNIFTY"
    finnifty   = "FINNIFTY"
    midcpnifty = "MIDCPNIFTY"
    crudeoil   = "CRUDEOIL"

enum SuffixFormat
    cp    = "C/P"
    ce_pe = "CE/PE"

enum BEPBasis
    dayOpen   = "Day Open Price"
    prevClose = "Previous Day Close"
    prevSett  = "Previous Day Settlement"
    first5Min = "First 5 Min Close"

enum OffsetChoice
    offset50  = "50 Points"
    offset100 = "100 Points"

// --- Settings Groups ---
G_INST  = "Instrument & Strike Selection"
G_CALC  = "BEP Calculation Settings"
G_PLOTS = "Plot Controls"
G_COLORS= "Styling & Display"

// 1. Instrument & Strike Selection
atm_select_mode    = input.string("Auto-Detect (Chart Ticker)", "ATM Strike Selection", options=["Auto-Detect (Chart Ticker)", "Manual"], group=G_INST)
manual_strike_val  = input.int(24000, "Manual ATM Strike Price", group=G_INST)
stock_name_preset  = input.string("NIFTY", "Preset Underlying", options=["Custom", "NIFTY", "BANKNIFTY", "FINNIFTY", "MIDCPNIFTY", "CRUDEOIL"], group=G_INST)
underlying_ticker  = input.string("NIFTY", "Custom Underlying Ticker", group=G_INST)
exchange           = input.string("NSE", "Exchange", group=G_INST)
expiry_input       = input.string("24829", "Option Expiry (YYMdd)", group=G_INST)
suffixStyle        = input.string("CE/PE", "Option Suffix Format", options=["C/P", "CE/PE"], group=G_INST)
strike_step_input  = input.int(50, "Custom Strike Step", group=G_INST)

// 2. BEP Calculation Settings
offset_choice_str  = input.string("100 Points", "Strike Offset Points", options=["50 Points", "100 Points"], group=G_CALC)
standard_bep_basis = input.string("Day Open Price", "Static BEP Calculation Basis", options=["Day Open Price", "Previous Day Close", "Previous Day Settlement", "First 5 Min Close"], group=G_CALC)

// 3. Plot Controls
show_running_bep   = input.bool(true, "Show Realtime Dynamic BEP Lines (ATM, ITM 1, OTM 1 Only)", group=G_PLOTS)
show_standard_bep  = input.bool(true, "Show Static Level BEP Lines (All 7 Levels)", group=G_PLOTS)
show_pdc_lines     = input.bool(true, "Show Previous Day Settlement Lines", group=G_PLOTS)
show_pdh_pdl_lines = input.bool(true, "Show Previous Day High & Low Lines", group=G_PLOTS)
show_opp_candles   = input.bool(true, "Show Opposite Option Candles Overlay", group=G_PLOTS)

// 4. Styling & Colors
c_itm              = input.color(#00E676, "ITM BEP Line Color", group=G_COLORS)
c_atm              = input.color(color.aqua, "ATM BEP Line Color", group=G_COLORS)
c_otm              = input.color(#FF5252, "OTM BEP Line Color", group=G_COLORS)

c_opp_bull         = input.color(color.new(#2962FF, 40), "Opposite Bullish Body", group=G_COLORS)
c_opp_bear         = input.color(color.new(#FF6D00, 40), "Opposite Bearish Body", group=G_COLORS)
c_opp_bull_wick    = input.color(color.new(#2962FF, 60), "Opposite Bullish Wick", group=G_COLORS)
c_opp_bear_wick    = input.color(color.new(#FF6D00, 60), "Opposite Bearish Wick", group=G_COLORS)

c_ce_pdc           = input.color(color.new(#00E676, 20), "CE Prev Settlement Line Color", group=G_COLORS)
c_ce_pdh           = input.color(color.new(#00E676, 50), "CE Prev High Line Color", group=G_COLORS)
c_ce_pdl           = input.color(color.new(#00E676, 70), "CE Prev Low Line Color", group=G_COLORS)

c_pe_pdc           = input.color(color.new(#FF5252, 20), "PE Prev Settlement Line Color", group=G_COLORS)
c_pe_pdh           = input.color(color.new(#FF5252, 50), "PE Prev High Line Color", group=G_COLORS)
c_pe_pdl           = input.color(color.new(#FF5252, 70), "PE Prev Low Line Color", group=G_COLORS)

show_options_table = input.bool(true, "Show BEP & Details Table", group=G_COLORS)
table_pos_str      = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_COLORS)
table_size_str     = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal", "Large"], group=G_COLORS)

// =========================================================================
// HELPER FUNCTIONS (GLOBAL SCOPE)
// =========================================================================
f_is_digit(string c) =>
    str.contains("0123456789", c)

f_fill_table_row(tbl, r, lbl, ce_r, pe_r, stat_bep, ce_l, pe_l, float rt_bep, ce_h, ce_lw, pe_h, pe_lw, row_bg, t_sz) =>
    table.cell(tbl, 0, r, lbl, bgcolor=row_bg, text_color=color.white, text_size=t_sz)
    table.cell(tbl, 1, r, na(ce_r) ? "N/A" : str.tostring(ce_r, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=t_sz)
    table.cell(tbl, 2, r, na(pe_r) ? "N/A" : str.tostring(pe_r, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=t_sz)
    table.cell(tbl, 3, r, na(stat_bep) ? "N/A" : str.tostring(stat_bep, "#.##"), bgcolor=#006064, text_color=color.aqua, text_size=t_sz)
    table.cell(tbl, 4, r, na(ce_l) ? "N/A" : str.tostring(ce_l, "#.##"), bgcolor=color.black, text_color=#00E676, text_size=t_sz)
    table.cell(tbl, 5, r, na(pe_l) ? "N/A" : str.tostring(pe_l, "#.##"), bgcolor=color.black, text_color=#FF5252, text_size=t_sz)
    table.cell(tbl, 6, r, na(rt_bep) or rt_bep <= 0 ? "N/A" : str.tostring(rt_bep, "#.##"), bgcolor=#F57F17, text_color=color.yellow, text_size=t_sz)
    
    string ce_hl_str = (na(ce_h) ? "N/A" : str.tostring(ce_h, "#.#")) + " / " + (na(ce_lw) ? "N/A" : str.tostring(ce_lw, "#.#"))
    string pe_hl_str = (na(pe_h) ? "N/A" : str.tostring(pe_h, "#.#")) + " / " + (na(pe_lw) ? "N/A" : str.tostring(pe_lw, "#.#"))
    table.cell(tbl, 7, r, ce_hl_str, bgcolor=color.black, text_color=color.new(#00E676, 20), text_size=t_sz)
    table.cell(tbl, 8, r, pe_hl_str, bgcolor=color.black, text_color=color.new(#FF5252, 20), text_size=t_sz)

// =========================================================================
// OPTION CONTRACT PARSER & UNIVERSAL TICKER BUILDER
// =========================================================================
string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

int tickerLen = str.length(cleanTicker)

var string root = underlying_ticker
var string expiry = expiry_input
var string opt_type = "C"
var int strike_val = manual_strike_val
var bool is_option = false

if tickerLen > 7
    int idx = tickerLen - 1
    string strike_str = ""
    while idx >= 0 and f_is_digit(str.substring(cleanTicker, idx, idx + 1))
        strike_str := str.substring(cleanTicker, idx, idx + 1) + strike_str
        idx := idx - 1
        
    if idx > 2 and str.length(strike_str) > 0
        string opt_char = str.substring(cleanTicker, idx, idx + 1)
        if opt_char == "C" or opt_char == "P" or opt_char == "E"
            opt_type := opt_char == "P" ? "P" : "C"
            strike_val := int(str.tonumber(strike_str))
            int exp_len = 5
            if idx >= 3 and f_is_digit(str.substring(cleanTicker, idx - 3, idx - 2))
                exp_len := 6
            if idx >= exp_len
                expiry := str.substring(cleanTicker, idx - exp_len, idx)
                root := str.substring(cleanTicker, 0, idx - exp_len)
                is_option := true

preset_root = stock_name_preset == "NIFTY" ? "NIFTY" : (stock_name_preset == "BANKNIFTY" ? "BANKNIFTY" : (stock_name_preset == "FINNIFTY" ? "FINNIFTY" : (stock_name_preset == "MIDCPNIFTY" ? "MIDCPNIFTY" : (stock_name_preset == "CRUDEOIL" ? "CRUDEOIL" : underlying_ticker))))
preset_exchange = stock_name_preset == "CRUDEOIL" ? "MCX" : (stock_name_preset == "Custom" ? exchange : "NSE")
preset_step = stock_name_preset == "NIFTY" ? 50 : (stock_name_preset == "BANKNIFTY" ? 100 : (stock_name_preset == "FINNIFTY" ? 50 : (stock_name_preset == "MIDCPNIFTY" ? 25 : (stock_name_preset == "CRUDEOIL" ? 50 : strike_step_input))))

final_root     = is_option ? root : preset_root
final_exchange = is_option ? exchange : preset_exchange
final_expiry   = is_option ? expiry : expiry_input
strike_step    = preset_step

spot_sym = final_exchange + ":" + final_root
[spot_open, spot_prev_close, spot_close_today] = request.security(spot_sym, "1D", [open, close, close], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

var int base_center_strike = na
if barstate.isfirst or na(base_center_strike)
    int calc_strike = (atm_select_mode == "Manual") ? manual_strike_val : (is_option ? strike_val : int(math.round(nz(spot_close_today, spot_open) / strike_step) * strike_step))
    if calc_strike <= 0
        calc_strike := manual_strike_val
    base_center_strike := calc_strike

final_strike = base_center_strike

// Universal Fail-Safe Option Ticker Construction
f_build_option_symbol(int target_strike, bool target_is_ce) =>
    string st_digits = str.tostring(int(final_strike))
    int st_len = str.length(st_digits)
    
    if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
        int end_trim = 2
        string base_no_suffix = str.substring(cleanTicker, 0, str.length(cleanTicker) - end_trim)
        string pfx = str.substring(base_no_suffix, 0, str.length(base_no_suffix) - st_len)
        string sfx = target_is_ce ? "CE" : "PE"
        syminfo.prefix + ":" + pfx + str.tostring(target_strike) + sfx
    else if str.match(cleanTicker, "[CP]\\d+$") != ""
        string matchCP = str.match(cleanTicker, "[CP]\\d+$")
        int matchPos = str.pos(cleanTicker, matchCP)
        string pfx = str.substring(cleanTicker, 0, matchPos)
        string cp_letter = target_is_ce ? "C" : "P"
        syminfo.prefix + ":" + pfx + cp_letter + str.tostring(target_strike)
    else
        // Preset Ticker Fallback
        string cp_sfx = suffixStyle == "C/P" ? (target_is_ce ? "C" : "P") : (target_is_ce ? "CE" : "PE")
        if suffixStyle == "C/P"
            final_exchange + ":" + final_root + final_expiry + cp_sfx + str.tostring(target_strike)
        else
            final_exchange + ":" + final_root + final_expiry + str.tostring(target_strike) + cp_sfx

// =========================================================================
// OPPOSITE OPTION CONTRACT OVERLAY
// =========================================================================
bool chart_is_ce = is_option ? (opt_type == "C") : true
string opp_ticker = f_build_option_symbol(final_strike, not chart_is_ce)

[opp_o, opp_h, opp_l, opp_c] = request.security(opp_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)

bool opp_is_bull  = nz(opp_c) >= nz(opp_o)
color opp_body_col = opp_is_bull ? c_opp_bull : c_opp_bear
color opp_wick_col = opp_is_bull ? c_opp_bull_wick : c_opp_bear_wick

plotcandle(show_opp_candles and is_option ? opp_o : na,
           show_opp_candles and is_option ? opp_h : na,
           show_opp_candles and is_option ? opp_l : na,
           show_opp_candles and is_option ? opp_c : na,
           title="Opposite Option Candle", color=opp_body_col, wickcolor=opp_wick_col, bordercolor=opp_wick_col)

// =========================================================================
// STRIKES SELECTION (3 ITM, 1 ATM, 3 OTM STRIKES)
// =========================================================================
int offsetPts = str.contains(offset_choice_str, "50") ? 50 : 100

int st_m3  = final_strike - 3 * offsetPts
int st_m2  = final_strike - 2 * offsetPts
int st_m1  = final_strike - 1 * offsetPts
int st_atm = final_strike
int st_p1  = final_strike + 1 * offsetPts
int st_p2  = final_strike + 2 * offsetPts
int st_p3  = final_strike + 3 * offsetPts

f_get_contract_data() =>
    float d_open  = ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0)
    [d_pdc, d_pdh, d_pdl] = request.security(syminfo.tickerid, "D", [close[1], high[1], low[1]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
    var float d_f5m = na
    if ta.change(time("D")) != 0
        d_f5m := na
    if (hour == 9 and minute >= 19) or hour > 9
        if na(d_f5m)
            d_f5m := close
    [d_open, d_pdc, d_pdh, d_pdl, na(d_f5m) ? d_open : d_f5m, close]

// Fetch Contract Data for 7 Strikes (m3, m2, m1, atm, p1, p2, p3)
string ce_m3_ticker = f_build_option_symbol(st_m3, true)
string pe_m3_ticker = f_build_option_symbol(st_m3, false)
[ce_m3_o, ce_m3_pdc, ce_m3_pdh, ce_m3_pdl, ce_m3_f5m, ce_m3_ltp] = request.security(ce_m3_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_m3_o, pe_m3_pdc, pe_m3_pdh, pe_m3_pdl, pe_m3_f5m, pe_m3_ltp] = request.security(pe_m3_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

string ce_m2_ticker = f_build_option_symbol(st_m2, true)
string pe_m2_ticker = f_build_option_symbol(st_m2, false)
[ce_m2_o, ce_m2_pdc, ce_m2_pdh, ce_m2_pdl, ce_m2_f5m, ce_m2_ltp] = request.security(ce_m2_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_m2_o, pe_m2_pdc, pe_m2_pdh, pe_m2_pdl, pe_m2_f5m, pe_m2_ltp] = request.security(pe_m2_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

string ce_m1_ticker = f_build_option_symbol(st_m1, true)
string pe_m1_ticker = f_build_option_symbol(st_m1, false)
[ce_m1_o, ce_m1_pdc, ce_m1_pdh, ce_m1_pdl, ce_m1_f5m, ce_m1_ltp] = request.security(ce_m1_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_m1_o, pe_m1_pdc, pe_m1_pdh, pe_m1_pdl, pe_m1_f5m, pe_m1_ltp] = request.security(pe_m1_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

string ce_atm_ticker = f_build_option_symbol(st_atm, true)
string pe_atm_ticker = f_build_option_symbol(st_atm, false)
[ce_atm_o, ce_atm_pdc, ce_atm_pdh, ce_atm_pdl, ce_atm_f5m, ce_atm_ltp] = request.security(ce_atm_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_atm_o, pe_atm_pdc, pe_atm_pdh, pe_atm_pdl, pe_atm_f5m, pe_atm_ltp] = request.security(pe_atm_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

string ce_p1_ticker = f_build_option_symbol(st_p1, true)
string pe_p1_ticker = f_build_option_symbol(st_p1, false)
[ce_p1_o, ce_p1_pdc, ce_p1_pdh, ce_p1_pdl, ce_p1_f5m, ce_p1_ltp] = request.security(ce_p1_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_p1_o, pe_p1_pdc, pe_p1_pdh, pe_p1_pdl, pe_p1_f5m, pe_p1_ltp] = request.security(pe_p1_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

string ce_p2_ticker = f_build_option_symbol(st_p2, true)
string pe_p2_ticker = f_build_option_symbol(st_p2, false)
[ce_p2_o, ce_p2_pdc, ce_p2_pdh, ce_p2_pdl, ce_p2_f5m, ce_p2_ltp] = request.security(ce_p2_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_p2_o, pe_p2_pdc, pe_p2_pdh, pe_p2_pdl, pe_p2_f5m, pe_p2_ltp] = request.security(pe_p2_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

string ce_p3_ticker = f_build_option_symbol(st_p3, true)
string pe_p3_ticker = f_build_option_symbol(st_p3, false)
[ce_p3_o, ce_p3_pdc, ce_p3_pdh, ce_p3_pdl, ce_p3_f5m, ce_p3_ltp] = request.security(ce_p3_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)
[pe_p3_o, pe_p3_pdc, pe_p3_pdh, pe_p3_pdl, pe_p3_f5m, pe_p3_ltp] = request.security(pe_p3_ticker, timeframe.period, f_get_contract_data(), ignore_invalid_symbol=true)

// Resolve Basis Reference Values
f_resolve_basis(dop, pdc, f5m) =>
    (standard_bep_basis == "Previous Day Close" or standard_bep_basis == "Previous Day Settlement") ? pdc : (standard_bep_basis == "First 5 Min Close" ? f5m : dop)

float ce_m3_ref = f_resolve_basis(ce_m3_o, ce_m3_pdc, ce_m3_f5m)
float pe_m3_ref = f_resolve_basis(pe_m3_o, pe_m3_pdc, pe_m3_f5m)

float ce_m2_ref = f_resolve_basis(ce_m2_o, ce_m2_pdc, ce_m2_f5m)
float pe_m2_ref = f_resolve_basis(pe_m2_o, pe_m2_pdc, pe_m2_f5m)

float ce_m1_ref = f_resolve_basis(ce_m1_o, ce_m1_pdc, ce_m1_f5m)
float pe_m1_ref = f_resolve_basis(pe_m1_o, pe_m1_pdc, pe_m1_f5m)

float ce_atm_ref = f_resolve_basis(ce_atm_o, ce_atm_pdc, ce_atm_f5m)
float pe_atm_ref = f_resolve_basis(pe_atm_o, pe_atm_pdc, pe_atm_f5m)

float ce_p1_ref = f_resolve_basis(ce_p1_o, ce_p1_pdc, ce_p1_f5m)
float pe_p1_ref = f_resolve_basis(pe_p1_o, pe_p1_pdc, pe_p1_f5m)

float ce_p2_ref = f_resolve_basis(ce_p2_o, ce_p2_pdc, ce_p2_f5m)
float pe_p2_ref = f_resolve_basis(pe_p2_o, pe_p2_pdc, pe_p2_f5m)

float ce_p3_ref = f_resolve_basis(ce_p3_o, ce_p3_pdc, ce_p3_f5m)
float pe_p3_ref = f_resolve_basis(pe_p3_o, pe_p3_pdc, pe_p3_f5m)

// =========================================================================
// BEP CALCULATIONS: EXACT ITM & OTM STRIKE PAIRINGS FOR 7 LEVELS
// =========================================================================

// Realtime Dynamic BEP Values (ATM, ITM 1, OTM 1 Only)
float run_bep_itm1 = (ce_m1_ltp + pe_p1_ltp) / 2.0
float run_bep_atm  = (ce_atm_ltp + pe_atm_ltp) / 2.0
float run_bep_otm1 = (ce_p1_ltp + pe_m1_ltp) / 2.0

// Static Reference BEP Values (All 7 Levels)
float std_bep_itm3 = (ce_m3_ref + pe_p3_ref) / 2.0
float std_bep_itm2 = (ce_m2_ref + pe_p2_ref) / 2.0
float std_bep_itm1 = (ce_m1_ref + pe_p1_ref) / 2.0
float std_bep_atm  = (ce_atm_ref + pe_atm_ref) / 2.0
float std_bep_otm1 = (ce_p1_ref + pe_m1_ref) / 2.0
float std_bep_otm2 = (ce_p2_ref + pe_m2_ref) / 2.0
float std_bep_otm3 = (ce_p3_ref + pe_m3_ref) / 2.0

// =========================================================================
// PLOTTING ALL LINES (EXPOSED DIRECTLY IN TRADINGVIEW STYLE TAB)
// =========================================================================

// --- Realtime Plots (ATM, ITM 1, OTM 1 ONLY) ---
plot(show_running_bep and run_bep_itm1 > 0 ? run_bep_itm1 : na, "Realtime ITM 1 BEP", color=c_itm, linewidth=2)
plot(show_running_bep and run_bep_atm  > 0 ? run_bep_atm  : na, "Realtime ATM BEP",   color=c_atm, linewidth=2)
plot(show_running_bep and run_bep_otm1 > 0 ? run_bep_otm1 : na, "Realtime OTM 1 BEP", color=c_otm, linewidth=2)

// --- Static BEP Level Plots (Exposed Directly in TradingView Style Tab) ---
plot(show_standard_bep and std_bep_itm3 > 0 ? std_bep_itm3 : na, "ITM 3 Static BEP", color=color.new(c_itm, 40), style=plot.style_linebr)
plot(show_standard_bep and std_bep_itm2 > 0 ? std_bep_itm2 : na, "ITM 2 Static BEP", color=color.new(c_itm, 20), style=plot.style_linebr)
plot(show_standard_bep and std_bep_itm1 > 0 ? std_bep_itm1 : na, "ITM 1 Static BEP", color=c_itm, style=plot.style_linebr)
plot(show_standard_bep and std_bep_atm  > 0 ? std_bep_atm  : na, "ATM Static BEP",   color=c_atm, style=plot.style_linebr)
plot(show_standard_bep and std_bep_otm1 > 0 ? std_bep_otm1 : na, "OTM 1 Static BEP", color=c_otm, style=plot.style_linebr)
plot(show_standard_bep and std_bep_otm2 > 0 ? std_bep_otm2 : na, "OTM 2 Static BEP", color=color.new(c_otm, 20), style=plot.style_linebr)
plot(show_standard_bep and std_bep_otm3 > 0 ? std_bep_otm3 : na, "OTM 3 Static BEP", color=color.new(c_otm, 40), style=plot.style_linebr)

// --- Previous Day Level Plots (Exposed Directly in TradingView Style Tab) ---
plot(show_pdc_lines and ce_atm_pdc > 0 ? ce_atm_pdc : na, "CE Prev Settlement", color=c_ce_pdc, style=plot.style_linebr)
plot(show_pdc_lines and pe_atm_pdc > 0 ? pe_atm_pdc : na, "PE Prev Settlement", color=c_pe_pdc, style=plot.style_linebr)

plot(show_pdh_pdl_lines and ce_atm_pdh > 0 ? ce_atm_pdh : na, "CE Prev High", color=c_ce_pdh, style=plot.style_linebr)
plot(show_pdh_pdl_lines and ce_atm_pdl > 0 ? ce_atm_pdl : na, "CE Prev Low",  color=c_ce_pdl, style=plot.style_linebr)

plot(show_pdh_pdl_lines and pe_atm_pdh > 0 ? pe_atm_pdh : na, "PE Prev High", color=c_pe_pdh, style=plot.style_linebr)
plot(show_pdh_pdl_lines and pe_atm_pdl > 0 ? pe_atm_pdl : na, "PE Prev Low",  color=c_pe_pdl, style=plot.style_linebr)

// =========================================================================
// SUMMARY DASHBOARD TABLE
// =========================================================================
var table info_table = na
if barstate.islast and show_options_table
    table.delete(info_table)
    
    position_choice = table_pos_str == "Top Right" ? position.top_right :
                      table_pos_str == "Top Left" ? position.top_left :
                      table_pos_str == "Bottom Right" ? position.bottom_right : position.bottom_left
                      
    t_sz = table_size_str == "Tiny" ? size.tiny :
           table_size_str == "Small" ? size.small :
           table_size_str == "Normal" ? size.normal : size.large
           
    info_table := table.new(position_choice, 9, 9, border_width=1, border_color=color.gray)
    
    string basisTag = (standard_bep_basis == "Previous Day Close" or standard_bep_basis == "Previous Day Settlement") ? "Prev Settlement" : (standard_bep_basis == "First 5 Min Close" ? "First 5Min Close" : "Day Open")

    // Header Row 0
    table.cell(info_table, 0, 0, "Asset: " + final_root, bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 1, 0, "Offset: " + str.tostring(offsetPts), bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 2, 0, "Basis: " + basisTag, bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 3, 0, "ATM Strike:", bgcolor=#1565C0, text_color=color.silver, text_size=t_sz)
    table.cell(info_table, 4, 0, str.tostring(st_atm), bgcolor=#FFEE58, text_color=color.black, text_size=t_sz)
    table.cell(info_table, 5, 0, "Formula:", bgcolor=#1565C0, text_color=color.silver, text_size=t_sz)
    table.cell(info_table, 6, 0, "(CE + PE) / 2", bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 7, 0, "", bgcolor=#1565C0)
    table.cell(info_table, 8, 0, "", bgcolor=#1565C0)

    // Row 1: Column Headers
    table.cell(info_table, 0, 1, "Strike Level", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 1, 1, "CE Ref (" + basisTag + ")", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 2, 1, "PE Ref (" + basisTag + ")", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 3, 1, "Static BEP", bgcolor=#37474F, text_color=color.aqua, text_size=t_sz)
    table.cell(info_table, 4, 1, "CE LTP", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 5, 1, "PE LTP", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 6, 1, "Realtime BEP", bgcolor=#37474F, text_color=color.yellow, text_size=t_sz)
    table.cell(info_table, 7, 1, "CE Prev High/Low", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
    table.cell(info_table, 8, 1, "PE Prev High/Low", bgcolor=#37474F, text_color=color.white, text_size=t_sz)

    // Rows 2-4: ITM 3, ITM 2, ITM 1 BEP Pairs
    f_fill_table_row(info_table, 2, "ITM 3 (" + str.tostring(st_m3) + "CE / " + str.tostring(st_p3) + "PE)", ce_m3_ref, pe_p3_ref, std_bep_itm3, ce_m3_ltp, pe_p3_ltp, na, ce_m3_pdh, ce_m3_pdl, pe_p3_pdh, pe_p3_pdl, color.new(#1B5E20, 0), t_sz)
    f_fill_table_row(info_table, 3, "ITM 2 (" + str.tostring(st_m2) + "CE / " + str.tostring(st_p2) + "PE)", ce_m2_ref, pe_p2_ref, std_bep_itm2, ce_m2_ltp, pe_p2_ltp, na, ce_m2_pdh, ce_m2_pdl, pe_p2_pdh, pe_p2_pdl, color.new(#2E7D32, 0), t_sz)
    f_fill_table_row(info_table, 4, "ITM 1 (" + str.tostring(st_m1) + "CE / " + str.tostring(st_p1) + "PE)", ce_m1_ref, pe_p1_ref, std_bep_itm1, ce_m1_ltp, pe_p1_ltp, run_bep_itm1, ce_m1_pdh, ce_m1_pdl, pe_p1_pdh, pe_p1_pdl, color.new(#388E3C, 0), t_sz)

    // Row 5: ATM BEP Pair: (CE 24000 + PE 24000) / 2
    f_fill_table_row(info_table, 5, "ATM (" + str.tostring(st_atm) + ")", ce_atm_ref, pe_atm_ref, std_bep_atm, ce_atm_ltp, pe_atm_ltp, run_bep_atm, ce_atm_pdh, ce_atm_pdl, pe_atm_pdh, pe_atm_pdl, color.new(#F57F17, 0), t_sz)

    // Rows 6-8: OTM 1, OTM 2, OTM 3 BEP Pairs
    f_fill_table_row(info_table, 6, "OTM 1 (" + str.tostring(st_p1) + "CE / " + str.tostring(st_m1) + "PE)", ce_p1_ref, pe_m1_ref, std_bep_otm1, ce_p1_ltp, pe_m1_ltp, run_bep_otm1, ce_p1_pdh, ce_p1_pdl, pe_m1_pdh, pe_m1_pdl, color.new(#D32F2F, 0), t_sz)
    f_fill_table_row(info_table, 7, "OTM 2 (" + str.tostring(st_p2) + "CE / " + str.tostring(st_m2) + "PE)", ce_p2_ref, pe_m2_ref, std_bep_otm2, ce_p2_ltp, pe_m2_ltp, na, ce_p2_pdh, ce_p2_pdl, pe_m2_pdh, pe_m2_pdl, color.new(#C62828, 0), t_sz)
    f_fill_table_row(info_table, 8, "OTM 3 (" + str.tostring(st_p3) + "CE / " + str.tostring(st_m3) + "PE)", ce_p3_ref, pe_m3_ref, std_bep_otm3, ce_p3_ltp, pe_m3_ltp, na, ce_p3_pdh, ce_p3_pdl, pe_m3_pdh, pe_m3_pdl, color.new(#B71C1C, 0), t_sz)
