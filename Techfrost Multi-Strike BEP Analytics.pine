//@version=6
indicator("Techfrost Multi-Strike BEP Analytics", shorttitle="Techfrost BEP Analytics", overlay=true, max_labels_count=500, max_lines_count=500, precision=2)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum UnderlyingAsset
    auto      = "Auto-Detect"
    nifty     = "NIFTY"
    banknifty = "BANKNIFTY"
    crudeoil  = "CRUDEOIL"
    gold      = "GOLD"
    stock     = "Stock (Equity)"

enum OptionType
    auto = "Auto-Detect"
    ce   = "Call (CE)"
    pe   = "Put (PE)"

enum CalculationBasis
    dayOpen   = "Today's Day Open"
    prevClose = "Previous Day Close"
    first5Min = "First 5 Min Close"

enum OffsetChoice
    offset50  = "50 Points (+50 / -50)"
    offset100 = "100 Points (+100 / -100)"

// --- Instrument & Strike Settings ---
underlyingInput    = input.enum(UnderlyingAsset.auto, "Underlying Asset", group="Instrument Settings")
optionTypeInput    = input.enum(OptionType.auto, "Option Type", group="Instrument Settings")
spotTickerOverride = input.symbol("", "Spot Symbol Override (e.g. NSE:RELIANCE)", group="Instrument Settings")
strikeOverride     = input.float(0.0, "Strike Price Override", minval=0.0, group="Instrument Settings")

// --- BEP Calculation Settings ---
offsetChoiceInput  = input.enum(OffsetChoice.offset100, "Strike Offset Points", group="BEP Calculation Settings",
  tooltip="Choose offset points (50 or 100). For example, if selected strike is 24000 and offset is 100, BEP values for 23900 (ITM) and 24100 (OTM) will be plotted alongside 24000.")
bepCalcBasisInput  = input.enum(CalculationBasis.dayOpen, "Static BEP Basis", group="BEP Calculation Settings",
  tooltip="Choose reference price basis for Static BEP: Today's Day Open, Previous Day Close, or First 5 Min Close.")

// --- Plot & Display Controls ---
showRealtimeBEPInput = input.bool(true, "Show Realtime Dynamic BEP Lines", group="Plot Controls",
  tooltip="Plots real-time dynamic BEP curves: (CE LTP + PE LTP) / 2")
showStaticBEPInput   = input.bool(true, "Show Static BEP Horizontal Lines", group="Plot Controls",
  tooltip="Plots static horizontal BEP lines based on selected basis: (CE Ref + PE Ref) / 2")
showTableInput       = input.bool(true, "Show BEP Summary Dashboard Table", group="Plot Controls")
tablePosInput        = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Plot Controls")
tableTextSizeInput   = input.string("Small", "Table Text Size", options=["Auto", "Tiny", "Small", "Normal", "Large"], group="Plot Controls")

// --- Styling & Colors ---
colorSelectedReal = input.color(#FFD700, "Selected Strike Realtime BEP Color", group="Styling & Colors")
colorSelectedStat = input.color(color.new(#FFD700, 30), "Selected Strike Static BEP Color", group="Styling & Colors")

colorITMReal      = input.color(#00E676, "ITM Strike Realtime BEP Color", group="Styling & Colors")
colorITMStat      = input.color(color.new(#00C853, 30), "ITM Strike Static BEP Color", group="Styling & Colors")

colorOTMReal      = input.color(#FF1744, "OTM Strike Realtime BEP Color", group="Styling & Colors")
colorOTMStat      = input.color(color.new(#D50000, 30), "OTM Strike Static BEP Color", group="Styling & Colors")

// ==========================================
// TICKER PARSING & AUTO-DETECTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

int tickerLen = str.length(cleanTicker)

// ----- Detect underlying -----
UnderlyingAsset actualUnderlying = na
if underlyingInput == UnderlyingAsset.auto
    if str.contains(cleanTicker, "BANKNIFTY")
        actualUnderlying := UnderlyingAsset.banknifty
    else if str.contains(cleanTicker, "NIFTY")
        actualUnderlying := UnderlyingAsset.nifty
    else if str.contains(cleanTicker, "CRUDEOIL")
        actualUnderlying := UnderlyingAsset.crudeoil
    else if str.contains(cleanTicker, "GOLD") and not str.contains(cleanTicker, "GOLDM") and not str.contains(cleanTicker, "GOLDPETAL")
        actualUnderlying := UnderlyingAsset.gold
    else if str.contains(cleanTicker, "GOLDM")
        actualUnderlying := UnderlyingAsset.gold
    else
        actualUnderlying := UnderlyingAsset.stock
else
    actualUnderlying := underlyingInput

// ----- Detect option type -----
bool isCall = false
bool isPut  = false

if optionTypeInput == OptionType.ce
    isCall := true
else if optionTypeInput == OptionType.pe
    isPut := true
else
    if str.contains(cleanTicker, "CE")
        isCall := true
    else if str.contains(cleanTicker, "PE")
        isPut := true
    else if str.match(cleanTicker, "C\\d+$") != ""
        isCall := true
    else if str.match(cleanTicker, "P\\d+$") != ""
        isPut := true

// ----- Strike extraction -----
float detectedStrike = na
string tickerWithoutCEPE = ""

if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, tickerLen - 2)

string matchC = str.match(cleanTicker, "C\\d+$")
string matchP = str.match(cleanTicker, "P\\d+$")

if matchC != ""
    detectedStrike := str.tonumber(str.substring(matchC, 1))
else if matchP != ""
    detectedStrike := str.tonumber(str.substring(matchP, 1))
else if tickerWithoutCEPE != ""
    string strikeDigits = str.match(tickerWithoutCEPE, "\\d+$")
    detectedStrike := str.tonumber(strikeDigits)

float chartStrikePrice = strikeOverride > 0.0 ? strikeOverride : (not na(detectedStrike) ? detectedStrike : 24000.0)

// ==========================================
// FAIL-SAFE CE & PE TICKER PREFIX CONSTRUCTION
// ==========================================

string strikeDigitsStr = str.tostring(int(chartStrikePrice))
int digitsLen = str.length(strikeDigitsStr)

string ce_prefix = ""
string pe_prefix = ""

if isCall
    ce_prefix := str.substring(cleanTicker, 0, str.length(cleanTicker) - digitsLen)
    int cPos = str.length(ce_prefix) - 1
    pe_prefix := str.substring(ce_prefix, 0, cPos) + "P"
else if isPut
    pe_prefix := str.substring(cleanTicker, 0, str.length(cleanTicker) - digitsLen)
    int pPos = str.length(pe_prefix) - 1
    ce_prefix := str.substring(pe_prefix, 0, pPos) + "C"
else
    ce_prefix := cleanTicker + "C"
    pe_prefix := cleanTicker + "P"

f_build_ce_ticker(int target_strike) =>
    ce_prefix + str.tostring(target_strike)

f_build_pe_ticker(int target_strike) =>
    pe_prefix + str.tostring(target_strike)

// ==========================================
// STRIKE SELECTION & OFFSET CALCULATION
// ==========================================

int offsetPts = offsetChoiceInput == OffsetChoice.offset50 ? 50 : 100
int selStrike = int(chartStrikePrice)

// ITM & OTM Strike Calculation:
// For Call (CE): ITM is lower strike (selStrike - offset), OTM is higher strike (selStrike + offset)
// For Put (PE): ITM is higher strike (selStrike + offset), OTM is lower strike (selStrike - offset)
int itmStrike = isPut ? (selStrike + offsetPts) : (selStrike - offsetPts)
int otmStrike = isPut ? (selStrike - offsetPts) : (selStrike + offsetPts)

// ==========================================
// DATA FETCHING & REFERENCE PRICE RESOLUTION
// ==========================================

f_get_option_prices() =>
    float d_open = ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0)
    float d_pdc  = request.security(syminfo.ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
    var float d_f5m = na
    if ta.change(time("D")) != 0
        d_f5m := na
    if (hour == 9 and minute >= 19) or hour > 9
        if na(d_f5m)
            d_f5m := close
    [d_open, d_pdc, na(d_f5m) ? d_open : d_f5m, close]

// Fetch data for ITM, Selected, and OTM strikes
[ce_op_itm, ce_pdc_itm, ce_f5m_itm, ce_ltp_itm] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(itmStrike), timeframe.period, f_get_option_prices(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_op_itm, pe_pdc_itm, pe_f5m_itm, pe_ltp_itm] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(itmStrike), timeframe.period, f_get_option_prices(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_op_sel, ce_pdc_sel, ce_f5m_sel, ce_ltp_sel] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(selStrike), timeframe.period, f_get_option_prices(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_op_sel, pe_pdc_sel, pe_f5m_sel, pe_ltp_sel] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(selStrike), timeframe.period, f_get_option_prices(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_op_otm, ce_pdc_otm, ce_f5m_otm, ce_ltp_otm] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(otmStrike), timeframe.period, f_get_option_prices(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_op_otm, pe_pdc_otm, pe_f5m_otm, pe_ltp_otm] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(otmStrike), timeframe.period, f_get_option_prices(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Helper to extract ref price based on user selection
f_resolve_ref(float op, float pdc, float f5m, CalculationBasis basis) =>
    basis == CalculationBasis.prevClose ? pdc : (basis == CalculationBasis.first5Min ? f5m : op)

float ce_ref_itm = f_resolve_ref(ce_op_itm, ce_pdc_itm, ce_f5m_itm, bepCalcBasisInput)
float pe_ref_itm = f_resolve_ref(pe_op_itm, pe_pdc_itm, pe_f5m_itm, bepCalcBasisInput)

float ce_ref_sel = f_resolve_ref(ce_op_sel, ce_pdc_sel, ce_f5m_sel, bepCalcBasisInput)
float pe_ref_sel = f_resolve_ref(pe_op_sel, pe_pdc_sel, pe_f5m_sel, bepCalcBasisInput)

float ce_ref_otm = f_resolve_ref(ce_op_otm, ce_pdc_otm, ce_f5m_otm, bepCalcBasisInput)
float pe_ref_otm = f_resolve_ref(pe_op_otm, pe_pdc_otm, pe_f5m_otm, bepCalcBasisInput)

// ==========================================
// STRICT BEP CALCULATIONS: (PE + CE) / 2
// ==========================================

// Realtime BEP = (CE LTP + PE LTP) / 2
float bep_realtime_itm = (ce_ltp_itm + pe_ltp_itm) / 2.0
float bep_realtime_sel = (ce_ltp_sel + pe_ltp_sel) / 2.0
float bep_realtime_otm = (ce_ltp_otm + pe_ltp_otm) / 2.0

// Static BEP = (CE Ref + PE Ref) / 2
float bep_static_itm   = (ce_ref_itm + pe_ref_itm) / 2.0
float bep_static_sel   = (ce_ref_sel + pe_ref_sel) / 2.0
float bep_static_otm   = (ce_ref_otm + pe_ref_otm) / 2.0

// ==========================================
// PLOTTING BEP LINES ON CHART
// ==========================================

// --- ITM BEP Lines ---
plot(showRealtimeBEPInput ? bep_realtime_itm : na, "ITM Realtime BEP", color=colorITMReal, linewidth=2)
plot(showStaticBEPInput ? bep_static_itm : na, "ITM Static BEP", color=colorITMStat, linewidth=1, style=plot.style_linebr)

// --- Selected Strike BEP Lines ---
plot(showRealtimeBEPInput ? bep_realtime_sel : na, "Selected Strike Realtime BEP", color=colorSelectedReal, linewidth=2)
plot(showStaticBEPInput ? bep_static_sel : na, "Selected Strike Static BEP", color=colorSelectedStat, linewidth=1, style=plot.style_linebr)

// --- OTM BEP Lines ---
plot(showRealtimeBEPInput ? bep_realtime_otm : na, "OTM Realtime BEP", color=colorOTMReal, linewidth=2)
plot(showStaticBEPInput ? bep_static_otm : na, "OTM Static BEP", color=colorOTMStat, linewidth=1, style=plot.style_linebr)

// ==========================================
// DASHBOARD & SUMMARY TABLE
// ==========================================

var table summaryTable = na
if showTableInput and barstate.islast
    table.delete(summaryTable)
    
    position_choice = tablePosInput == "Top Right" ? position.top_right :
                      tablePosInput == "Top Left" ? position.top_left :
                      tablePosInput == "Bottom Right" ? position.bottom_right : position.bottom_left
                      
    t_sz = tableTextSizeInput == "Tiny" ? size.tiny :
           tableTextSizeInput == "Small" ? size.small :
           tableTextSizeInput == "Normal" ? size.normal :
           tableTextSizeInput == "Large" ? size.large : size.auto
           
    summaryTable := table.new(position_choice, 8, 4, border_width=1, border_color=color.gray)
    
    basisText = bepCalcBasisInput == CalculationBasis.prevClose ? "Prev Close" : (bepCalcBasisInput == CalculationBasis.first5Min ? "First 5Min Close" : "Day Open")
    underlyingName = actualUnderlying == UnderlyingAsset.banknifty ? "BANKNIFTY" : (actualUnderlying == UnderlyingAsset.nifty ? "NIFTY" : (actualUnderlying == UnderlyingAsset.crudeoil ? "CRUDEOIL" : (actualUnderlying == UnderlyingAsset.gold ? "GOLD" : "Stock")))
    
    // Row 0: Top Header Banner
    table.cell(summaryTable, 0, 0, "Asset: " + underlyingName, bgcolor=color.new(#1565C0, 0), text_color=color.white, text_size=t_sz)
    table.cell(summaryTable, 1, 0, "Offset: " + str.tostring(offsetPts), bgcolor=color.new(#1565C0, 0), text_color=color.white, text_size=t_sz)
    table.cell(summaryTable, 2, 0, "Basis: " + basisText, bgcolor=color.new(#1565C0, 0), text_color=color.white, text_size=t_sz)
    table.cell(summaryTable, 3, 0, "Selected Strike:", bgcolor=color.new(#1565C0, 0), text_color=color.silver, text_size=t_sz)
    table.cell(summaryTable, 4, 0, str.tostring(selStrike), bgcolor=color.new(#FFEE58, 0), text_color=color.black, text_size=t_sz)
    table.cell(summaryTable, 5, 0, "BEP Formula:", bgcolor=color.new(#1565C0, 0), text_color=color.silver, text_size=t_sz)
    table.cell(summaryTable, 6, 0, "(CE + PE) / 2", bgcolor=color.new(#1565C0, 0), text_color=color.white, text_size=t_sz)
    table.cell(summaryTable, 7, 0, "", bgcolor=color.new(#1565C0, 0))

    // Row 1: Column Headers
    table.cell(summaryTable, 0, 1, "Strike (Type)", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=t_sz)
    table.cell(summaryTable, 1, 1, "CE Ref", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=t_sz)
    table.cell(summaryTable, 2, 1, "PE Ref", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=t_sz)
    table.cell(summaryTable, 3, 1, "Static BEP", bgcolor=color.new(#37474F, 0), text_color=color.cyan, text_size=t_sz)
    table.cell(summaryTable, 4, 1, "CE LTP", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=t_sz)
    table.cell(summaryTable, 5, 1, "PE LTP", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=t_sz)
    table.cell(summaryTable, 6, 1, "Realtime BEP", bgcolor=color.new(#37474F, 0), text_color=color.yellow, text_size=t_sz)
    table.cell(summaryTable, 7, 1, "BEP Chg", bgcolor=color.new(#37474F, 0), text_color=color.white, text_size=t_sz)

    f_fill_bep_row(table tbl, int r, string lbl, float ce_r, float pe_r, float stat_bep, float ce_l, float pe_l, float rt_bep, color row_bg) =>
        table.cell(tbl, 0, r, lbl, bgcolor=row_bg, text_color=color.white, text_size=t_sz)
        table.cell(tbl, 1, r, na(ce_r) ? "N/A" : str.tostring(ce_r, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=t_sz)
        table.cell(tbl, 2, r, na(pe_r) ? "N/A" : str.tostring(pe_r, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=t_sz)
        table.cell(tbl, 3, r, na(stat_bep) ? "N/A" : str.tostring(stat_bep, "#.##"), bgcolor=color.new(#006064, 0), text_color=color.cyan, text_size=t_sz)
        table.cell(tbl, 4, r, na(ce_l) ? "N/A" : str.tostring(ce_l, "#.##"), bgcolor=color.black, text_color=color.white, text_size=t_sz)
        table.cell(tbl, 5, r, na(pe_l) ? "N/A" : str.tostring(pe_l, "#.##"), bgcolor=color.black, text_color=color.white, text_size=t_sz)
        table.cell(tbl, 6, r, na(rt_bep) ? "N/A" : str.tostring(rt_bep, "#.##"), bgcolor=color.new(#F57F17, 0), text_color=color.yellow, text_size=t_sz)
        
        float chg = rt_bep - stat_bep
        string chg_str = na(chg) ? "N/A" : ((chg >= 0 ? "+" : "") + str.tostring(chg, "#.##"))
        color chg_bg   = na(chg) ? color.black : (chg > 0 ? color.new(#1B5E20, 0) : (chg < 0 ? color.new(#880E4F, 0) : color.black))
        table.cell(tbl, 7, r, chg_str, bgcolor=chg_bg, text_color=color.white, text_size=t_sz)

    // Row 2: ITM Strike
    f_fill_bep_row(summaryTable, 2, str.tostring(itmStrike) + " (ITM)", ce_ref_itm, pe_ref_itm, bep_static_itm, ce_ltp_itm, pe_ltp_itm, bep_realtime_itm, color.new(#2E7D32, 0))

    // Row 3: Selected Strike (Gold Highlight)
    f_fill_bep_row(summaryTable, 3, str.tostring(selStrike) + " (Selected)", ce_ref_sel, pe_ref_sel, bep_static_sel, ce_ltp_sel, pe_ltp_sel, bep_realtime_sel, color.new(#F57F17, 0))

    // Row 4: OTM Strike
    f_fill_bep_row(summaryTable, 4, str.tostring(otmStrike) + " (OTM)", ce_ref_otm, pe_ref_otm, bep_static_otm, ce_ltp_otm, pe_ltp_otm, bep_realtime_otm, color.new(#C62828, 0))
