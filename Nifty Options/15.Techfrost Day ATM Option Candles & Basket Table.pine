//@version=6
indicator("15. Techfrost Day ATM Option Candles & Basket Table", overlay=true, precision=2, max_labels_count=500, max_boxes_count=500, max_lines_count=500)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum UnderlyingAsset
    auto      = "Auto-Detect"
    nifty     = "NIFTY"
    banknifty = "BANKNIFTY"
    crudeoil  = "CRUDEOIL"
    gold      = "GOLD"
    stock     = "Stock (Equity)"

enum OptionType
    auto = "Auto-Detect"
    ce   = "Call (CE)"
    pe   = "Put (PE)"

enum StepOverrideChoice
    auto    = "Auto"
    step1   = "1"
    step2_5 = "2.5"
    step5   = "5"
    step10  = "10"
    step20  = "20"
    step25  = "25"
    step50  = "50"
    step100 = "100"
    step200 = "200"
    step500 = "500"

enum StrikeSelectionMode
    auto   = "Auto (ATM Center)"
    manual = "Manual 3 Strikes Selection"

// --- Instrument Settings ---
underlyingInput    = input.enum(UnderlyingAsset.auto, "Underlying Asset", group="Instrument Settings")
optionTypeInput    = input.enum(OptionType.auto, "Option Type", group="Instrument Settings")
strikeSelectMode   = input.enum(StrikeSelectionMode.auto, "Strike Selection Mode", group="Instrument Settings", tooltip="Auto centers around Day Open ATM. Manual 3 Strikes allows choosing 3 specific custom strikes.")
manualStrikeLower  = input.float(0.0, "Manual Strike 1 (ITM / Lower)", minval=0.0, group="Instrument Settings")
manualStrikeCenter = input.float(0.0, "Manual Strike 2 (ATM / Center)", minval=0.0, group="Instrument Settings")
manualStrikeUpper  = input.float(0.0, "Manual Strike 3 (OTM / Upper)", minval=0.0, group="Instrument Settings")

numStrikesInput    = input.int(4, "Number of ITM/OTM Strikes Each Side", minval=1, maxval=4, group="Instrument Settings",
  tooltip="1 = 3 Strikes (1 ITM + ATM + 1 OTM), 2 = 5 Strikes (2 ITM + ATM + 2 OTM), 3 = 7 Strikes, 4 = 9 Strikes.")
spotTickerOverride = input.symbol("", "Spot Symbol Override (e.g. NSE:RELIANCE)", group="Instrument Settings")
strikeOverride     = input.float(0.0, "Strike Price Override", minval=0.0, group="Instrument Settings")
strikeStepInput    = input.enum(StepOverrideChoice.auto, "Strike Step Override", group="Instrument Settings",
  tooltip="Set to Auto for auto-detection based on underlying stock/index (Auto-detects 1, 2.5, 5, 10, 20, 50, 100).")

// --- Realtime ATM Option Candles Controls ---
G_CANDLES            = "Realtime ATM Option Candles Controls"
atm_candle_source    = input.string("Both (Day Open & Current ATM)", "ATM Candle Selection Source", options=["Both (Day Open & Current ATM)", "Day Open ATM Only", "Current Realtime ATM Only"], group=G_CANDLES, tooltip="Select whether to plot candles for Both (Day Open & Current ATM simultaneously), Day Open ATM Only, or Current Realtime ATM Only.")
showCE_Candles       = input.bool(true, "Show Call (CE) Candles", group=G_CANDLES, tooltip="Plot real-time tick-by-tick candles of Call (CE) options.")
showPE_Candles       = input.bool(true, "Show Put (PE) Candles", group=G_CANDLES, tooltip="Plot real-time tick-by-tick candles of Put (PE) options.")
plot_candle_mode     = input.string("Auto-Detect (Direct on Option Chart, Overlay on Spot)", "Candle Scaling Mode", options=["Auto-Detect (Direct on Option Chart, Overlay on Spot)", "Direct Option Premium Values", "Overlay on Spot (Strike +/- Premium)"], group=G_CANDLES, tooltip="Auto-Detect automatically plots direct premium on Option charts and scaled overlay on Spot charts.")

color_day_ce_bull    = input.color(#26A69A, "Day ATM CE Bullish Candle Body", group=G_CANDLES)
color_day_ce_bear    = input.color(#EF5350, "Day ATM CE Bearish Candle Body", group=G_CANDLES)
color_day_pe_bull    = input.color(#00B0FF, "Day ATM PE Bullish Candle Body", group=G_CANDLES)
color_day_pe_bear    = input.color(#FF9100, "Day ATM PE Bearish Candle Body", group=G_CANDLES)

color_cur_ce_bull    = input.color(#76FF03, "Cur ATM CE Bullish Candle Body", group=G_CANDLES)
color_cur_ce_bear    = input.color(#FF1744, "Cur ATM CE Bearish Candle Body", group=G_CANDLES)
color_cur_pe_bull    = input.color(#00E5FF, "Cur ATM PE Bullish Candle Body", group=G_CANDLES)
color_cur_pe_bear    = input.color(#F57C00, "Cur ATM PE Bearish Candle Body", group=G_CANDLES)

show_candle_labels   = input.bool(true, "Show Floating Right-Side LTP Labels", group=G_CANDLES)

// --- Dashboard Table Controls ---
G_TABLE              = "Dashboard Table Settings"
showTableInput       = input.bool(true, "Show Selected Strikes Table", group=G_TABLE, tooltip="Enable or disable the selected strikes table.")
tableStyleInput      = input.string("Small Selected Strikes Table", "Table Style", options=["Small Selected Strikes Table", "Full Analytics Grid Table"], group=G_TABLE)
tablePosInput        = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_TABLE)
tableTextSizeInput   = input.string("Small", "Table Text Size / Resizing", options=["Auto", "Tiny", "Small", "Normal", "Large"], group=G_TABLE)

colorCurATMHighlight = input.color(#FFEE58, "Current ATM Cell Highlight (Yellow)", group="Styling & Colors")
colorDayATMHighlight = input.color(#00E5FF, "Day Open ATM Cell Highlight (Cyan)", group="Styling & Colors")

// ==========================================
// TICKER PARSING & AUTO-DETECTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

// ----- Detect underlying -----
UnderlyingAsset actualUnderlying = na
if underlyingInput == UnderlyingAsset.auto
    if str.contains(cleanTicker, "BANKNIFTY")
        actualUnderlying := UnderlyingAsset.banknifty
    else if str.contains(cleanTicker, "NIFTY")
        actualUnderlying := UnderlyingAsset.nifty
    else if str.contains(cleanTicker, "CRUDEOIL")
        actualUnderlying := UnderlyingAsset.crudeoil
    else if str.contains(cleanTicker, "GOLD") and not str.contains(cleanTicker, "GOLDM") and not str.contains(cleanTicker, "GOLDPETAL")
        actualUnderlying := UnderlyingAsset.gold
    else if str.contains(cleanTicker, "GOLDM")
        actualUnderlying := UnderlyingAsset.gold
    else
        actualUnderlying := UnderlyingAsset.stock
else
    actualUnderlying := underlyingInput

// ----- Detect option type -----
bool isCall = false
bool isPut  = false

if optionTypeInput == OptionType.ce
    isCall := true
else if optionTypeInput == OptionType.pe
    isPut := true
else
    if str.contains(cleanTicker, "CE")
        isCall := true
    else if str.contains(cleanTicker, "PE")
        isPut := true
    else if str.match(cleanTicker, "C\\d+$") != ""
        isCall := true
    else if str.match(cleanTicker, "P\\d+$") != ""
        isPut := true

// ----- Strike extraction from chart symbol -----
float detectedStrike = na
string tickerWithoutCEPE = ""

int tickerLen = str.length(cleanTicker)
if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, tickerLen - 2)

string matchC = str.match(cleanTicker, "C\\d+$")
string matchP = str.match(cleanTicker, "P\\d+$")

if matchC != ""
    detectedStrike := str.tonumber(str.substring(matchC, 1))
else if matchP != ""
    detectedStrike := str.tonumber(str.substring(matchP, 1))
else if tickerWithoutCEPE != ""
    string strikeDigits = str.match(tickerWithoutCEPE, "\\d+$")
    detectedStrike := str.tonumber(strikeDigits)

float chartStrikePrice = strikeOverride > 0.0 ? strikeOverride : detectedStrike

// Check if current active chart is an Option contract chart
bool isChartAnOptionContract = isCall or isPut or not na(detectedStrike)

// ==========================================
// SPOT TICKER RESOLUTION & STRICT DAY OPEN ATM CENTER ANCHORING
// ==========================================

string spotTicker = ""
if str.length(spotTickerOverride) > 0
    spotTicker := spotTickerOverride
else
    switch actualUnderlying
        UnderlyingAsset.banknifty => spotTicker := "NSE:BANKNIFTY"
        UnderlyingAsset.nifty     => spotTicker := "NSE:NIFTY"
        UnderlyingAsset.crudeoil  => spotTicker := "MCX:CRUDEOIL1!"
        UnderlyingAsset.gold      => spotTicker := "MCX:GOLD1!"
        UnderlyingAsset.stock     =>
            string rootGuess = str.match(cleanTicker, "^[A-Z&]+")
            if rootGuess != ""
                spotTicker := syminfo.prefix + ":" + rootGuess
            else
                spotTicker := syminfo.prefix + ":" + cleanTicker

// Fetch Day Open Spot Price for the underlying
float spotDayOpen = request.security(spotTicker, "D", open, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Dynamic Smart Strike Step Auto-Detection
f_auto_detect_step(float ref_p) =>
    float s_res = 50.0
    if na(ref_p) or ref_p <= 0
        s_res := 50.0
    else if ref_p < 100
        s_res := 1.0
    else if ref_p < 250
        s_res := 2.5
    else if ref_p < 500
        s_res := 5.0
    else if ref_p < 1200
        s_res := 10.0
    else if ref_p < 2500
        s_res := 20.0
    else
        s_res := 50.0
    s_res

float stepVal = 50.0
switch strikeStepInput
    StepOverrideChoice.step1   => stepVal := 1.0
    StepOverrideChoice.step2_5 => stepVal := 2.5
    StepOverrideChoice.step5   => stepVal := 5.0
    StepOverrideChoice.step10  => stepVal := 10.0
    StepOverrideChoice.step20  => stepVal := 20.0
    StepOverrideChoice.step25  => stepVal := 25.0
    StepOverrideChoice.step50  => stepVal := 50.0
    StepOverrideChoice.step100 => stepVal := 100.0
    StepOverrideChoice.step200 => stepVal := 200.0
    StepOverrideChoice.step500 => stepVal := 500.0
    =>
        switch actualUnderlying
            UnderlyingAsset.banknifty => stepVal := 100.0
            UnderlyingAsset.nifty     => stepVal := 50.0
            UnderlyingAsset.crudeoil  => stepVal := 50.0
            UnderlyingAsset.gold      => stepVal := 100.0
            UnderlyingAsset.stock     => stepVal := f_auto_detect_step(not na(chartStrikePrice) and chartStrikePrice > 0 ? chartStrikePrice : spotDayOpen)

// Base Center Strike
var float baseCenterStrike = na
if barstate.isfirst or na(baseCenterStrike)
    float refPrice = strikeOverride > 0.0 ? strikeOverride : (not na(chartStrikePrice) and chartStrikePrice > 0 ? chartStrikePrice : spotDayOpen)
    baseCenterStrike := math.round(refPrice / stepVal) * stepVal

float baseStrike = baseCenterStrike

// ==========================================
// UNIVERSAL FAIL-SAFE CE & PE TICKER CONSTRUCTION
// ==========================================

f_build_option_symbol(float target_strike, bool target_is_ce) =>
    string target_st_str = target_strike == math.floor(target_strike) ? str.tostring(int(target_strike)) : str.tostring(target_strike)
    
    if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
        int end_trim = 2
        string base_no_suffix = str.substring(cleanTicker, 0, str.length(cleanTicker) - end_trim)
        string strikeDigits = str.match(base_no_suffix, "\\d+$")
        if strikeDigits != ""
            string pfx = str.substring(base_no_suffix, 0, str.length(base_no_suffix) - str.length(strikeDigits))
            string sfx = target_is_ce ? "CE" : "PE"
            pfx + target_st_str + sfx
        else
            cleanTicker
    else if str.match(cleanTicker, "[CP]\\d+$") != ""
        string matchCP = str.match(cleanTicker, "[CP]\\d+$")
        int matchPos = str.pos(cleanTicker, matchCP)
        string pfx = str.substring(cleanTicker, 0, matchPos)
        string cp_letter = target_is_ce ? "C" : "P"
        pfx + cp_letter + target_st_str
    else
        string root = str.match(cleanTicker, "^[A-Z&]+")
        string sfx = target_is_ce ? "CE" : "PE"
        (root != "" ? root : cleanTicker) + target_st_str + sfx

f_build_ce_ticker(float target_strike) => f_build_option_symbol(target_strike, true)
f_build_pe_ticker(float target_strike) => f_build_option_symbol(target_strike, false)

// Strike determination (Auto vs Manual 3 Strikes)
bool isManualMode = strikeSelectMode == StrikeSelectionMode.manual and manualStrikeCenter > 0.0

float k_0  = isManualMode ? manualStrikeCenter : baseStrike
float k_p1 = isManualMode ? (manualStrikeUpper > 0.0 ? manualStrikeUpper : k_0 + stepVal) : baseStrike + 1.0 * stepVal
float k_p2 = isManualMode ? k_0 + 2.0 * stepVal : baseStrike + 2.0 * stepVal
float k_p3 = isManualMode ? k_0 + 3.0 * stepVal : baseStrike + 3.0 * stepVal
float k_p4 = isManualMode ? k_0 + 4.0 * stepVal : baseStrike + 4.0 * stepVal

float k_m1 = isManualMode ? (manualStrikeLower > 0.0 ? manualStrikeLower : k_0 - stepVal) : baseStrike - 1.0 * stepVal
float k_m2 = isManualMode ? k_0 - 2.0 * stepVal : baseStrike - 2.0 * stepVal
float k_m3 = isManualMode ? k_0 - 3.0 * stepVal : baseStrike - 3.0 * stepVal
float k_m4 = isManualMode ? k_0 - 4.0 * stepVal : baseStrike - 4.0 * stepVal

int activeNumStrikes = isManualMode ? 1 : numStrikesInput

// ==========================================
// DATA FETCHING FOR STRIKES
// ==========================================

f_get_strike_full_ohlc() =>
    float d_op = ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0)
    [d_op, open, high, low, close]

[ce_o_p4, ce_opn_p4, ce_h_p4, ce_l_p4, ce_c_p4] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p4), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p4, pe_opn_p4, pe_h_p4, pe_l_p4, pe_c_p4] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p4), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p3, ce_opn_p3, ce_h_p3, ce_l_p3, ce_c_p3] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p3), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p3, pe_opn_p3, pe_h_p3, pe_l_p3, pe_c_p3] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p3), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p2, ce_opn_p2, ce_h_p2, ce_l_p2, ce_c_p2] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p2), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p2, pe_opn_p2, pe_h_p2, pe_l_p2, pe_c_p2] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p2), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p1, ce_opn_p1, ce_h_p1, ce_l_p1, ce_c_p1] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p1), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p1, pe_opn_p1, pe_h_p1, pe_l_p1, pe_c_p1] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p1), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_0,  ce_opn_0,  ce_h_0,  ce_l_0,  ce_c_0]  = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_0),  timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_0,  pe_opn_0,  pe_h_0,  pe_l_0,  pe_c_0]  = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_0),  timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m1, ce_opn_m1, ce_h_m1, ce_l_m1, ce_c_m1] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m1), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m1, pe_opn_m1, pe_h_m1, pe_l_m1, pe_c_m1] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m1), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m2, ce_opn_m2, ce_h_m2, ce_l_m2, ce_c_m2] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m2), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m2, pe_opn_m2, pe_h_m2, pe_l_m2, pe_c_m2] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m2), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m3, ce_opn_m3, ce_h_m3, ce_l_m3, ce_c_m3] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m3), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m3, pe_opn_m3, pe_h_m3, pe_l_m3, pe_c_m3] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m3), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m4, ce_opn_m4, ce_h_m4, ce_l_m4, ce_c_m4] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m4), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m4, pe_opn_m4, pe_h_m4, pe_l_m4, pe_c_m4] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m4), timeframe.period, f_get_strike_full_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Realtime Spot LTP & ATM Resolution
float spotLTP = request.security(spotTicker, timeframe.period, close, ignore_invalid_symbol=true)

float curATMStrike = math.round((na(spotLTP) ? baseStrike : spotLTP) / stepVal) * stepVal
float dayOpenATMStrike = baseStrike

// Find which strike corresponds to Current Realtime ATM
float cur_ce_opn = curATMStrike == k_p4 ? ce_opn_p4 : (curATMStrike == k_p3 ? ce_opn_p3 : (curATMStrike == k_p2 ? ce_opn_p2 : (curATMStrike == k_p1 ? ce_opn_p1 : (curATMStrike == k_0 ? ce_opn_0 : (curATMStrike == k_m1 ? ce_opn_m1 : (curATMStrike == k_m2 ? ce_opn_m2 : (curATMStrike == k_m3 ? ce_opn_m3 : ce_opn_m4)))))))
float cur_ce_h   = curATMStrike == k_p4 ? ce_h_p4   : (curATMStrike == k_p3 ? ce_h_p3   : (curATMStrike == k_p2 ? ce_h_p2   : (curATMStrike == k_p1 ? ce_h_p1   : (curATMStrike == k_0 ? ce_h_0   : (curATMStrike == k_m1 ? ce_h_m1   : (curATMStrike == k_m2 ? ce_h_m2   : (curATMStrike == k_m3 ? ce_h_m3   : ce_h_m4)))))))
float cur_ce_l   = curATMStrike == k_p4 ? ce_l_p4   : (curATMStrike == k_p3 ? ce_l_p3   : (curATMStrike == k_p2 ? ce_l_p2   : (curATMStrike == k_p1 ? ce_l_p1   : (curATMStrike == k_0 ? ce_l_0   : (curATMStrike == k_m1 ? ce_l_m1   : (curATMStrike == k_m2 ? ce_l_m2   : (curATMStrike == k_m3 ? ce_l_m3   : ce_l_m4)))))))
float cur_ce_c   = curATMStrike == k_p4 ? ce_c_p4   : (curATMStrike == k_p3 ? ce_c_p3   : (curATMStrike == k_p2 ? ce_c_p2   : (curATMStrike == k_p1 ? ce_c_p1   : (curATMStrike == k_0 ? ce_c_0   : (curATMStrike == k_m1 ? ce_c_m1   : (curATMStrike == k_m2 ? ce_c_m2   : (curATMStrike == k_m3 ? ce_c_m3   : ce_c_m4)))))))

float cur_pe_opn = curATMStrike == k_p4 ? pe_opn_p4 : (curATMStrike == k_p3 ? pe_opn_p3 : (curATMStrike == k_p2 ? pe_opn_p2 : (curATMStrike == k_p1 ? pe_opn_p1 : (curATMStrike == k_0 ? pe_opn_0 : (curATMStrike == k_m1 ? pe_opn_m1 : (curATMStrike == k_m2 ? pe_opn_m2 : (curATMStrike == k_m3 ? pe_opn_m3 : pe_opn_m4)))))))
float cur_pe_h   = curATMStrike == k_p4 ? pe_h_p4   : (curATMStrike == k_p3 ? pe_h_p3   : (curATMStrike == k_p2 ? pe_h_p2   : (curATMStrike == k_p1 ? pe_h_p1   : (curATMStrike == k_0 ? pe_h_0   : (curATMStrike == k_m1 ? pe_h_m1   : (curATMStrike == k_m2 ? pe_h_m2   : (curATMStrike == k_m3 ? pe_h_m3   : pe_h_m4)))))))
float cur_pe_l   = curATMStrike == k_p4 ? pe_l_p4   : (curATMStrike == k_p3 ? pe_l_p3   : (curATMStrike == k_p2 ? pe_l_p2   : (curATMStrike == k_p1 ? pe_l_p1   : (curATMStrike == k_0 ? pe_l_0   : (curATMStrike == k_m1 ? pe_l_m1   : (curATMStrike == k_m2 ? pe_l_m2   : (curATMStrike == k_m3 ? pe_l_m3   : pe_l_m4)))))))
float cur_pe_c   = curATMStrike == k_p4 ? pe_c_p4   : (curATMStrike == k_p3 ? pe_c_p3   : (curATMStrike == k_p2 ? pe_c_p2   : (curATMStrike == k_p1 ? pe_c_p1   : (curATMStrike == k_0 ? pe_c_0   : (curATMStrike == k_m1 ? pe_c_m1   : (curATMStrike == k_m2 ? pe_c_m2   : (curATMStrike == k_m3 ? pe_c_m3   : pe_c_m4)))))))

// ==========================================
// CANDLE SCALING & PLOTTING LOGIC
// ==========================================

bool directOptionMode = (plot_candle_mode == "Direct Option Premium Values") or (plot_candle_mode == "Auto-Detect (Direct on Option Chart, Overlay on Spot)" and isChartAnOptionContract)

f_scale_val(float raw_p, float ref_st) =>
    directOptionMode ? raw_p : (ref_st + raw_p)

bool plotDayOpenCandles = (atm_candle_source == "Both (Day Open & Current ATM)") or (atm_candle_source == "Day Open ATM Only")
bool plotCurRealtimeCandles = (atm_candle_source == "Both (Day Open & Current ATM)") or (atm_candle_source == "Current Realtime ATM Only")

// Day Open ATM CE Candle
plotcandle(showCE_Candles and plotDayOpenCandles ? f_scale_val(ce_opn_0, dayOpenATMStrike) : na, showCE_Candles and plotDayOpenCandles ? f_scale_val(ce_h_0, dayOpenATMStrike) : na, showCE_Candles and plotDayOpenCandles ? f_scale_val(ce_l_0, dayOpenATMStrike) : na, showCE_Candles and plotDayOpenCandles ? f_scale_val(ce_c_0, dayOpenATMStrike) : na,
  title="Day Open ATM CE Candle", color=ce_c_0 >= ce_opn_0 ? color_day_ce_bull : color_day_ce_bear, wickcolor=ce_c_0 >= ce_opn_0 ? color_day_ce_bull : color_day_ce_bear, bordercolor=ce_c_0 >= ce_opn_0 ? color_day_ce_bull : color_day_ce_bear)

// Day Open ATM PE Candle
plotcandle(showPE_Candles and plotDayOpenCandles ? f_scale_val(pe_opn_0, dayOpenATMStrike) : na, showPE_Candles and plotDayOpenCandles ? f_scale_val(pe_h_0, dayOpenATMStrike) : na, showPE_Candles and plotDayOpenCandles ? f_scale_val(pe_l_0, dayOpenATMStrike) : na, showPE_Candles and plotDayOpenCandles ? f_scale_val(pe_c_0, dayOpenATMStrike) : na,
  title="Day Open ATM PE Candle", color=pe_c_0 >= pe_opn_0 ? color_day_pe_bull : color_day_pe_bear, wickcolor=pe_c_0 >= pe_opn_0 ? color_day_pe_bull : color_day_pe_bear, bordercolor=pe_c_0 >= pe_opn_0 ? color_day_pe_bull : color_day_pe_bear)

// Current Realtime ATM CE Candle
plotcandle(showCE_Candles and plotCurRealtimeCandles ? f_scale_val(cur_ce_opn, curATMStrike) : na, showCE_Candles and plotCurRealtimeCandles ? f_scale_val(cur_ce_h, curATMStrike) : na, showCE_Candles and plotCurRealtimeCandles ? f_scale_val(cur_ce_l, curATMStrike) : na, showCE_Candles and plotCurRealtimeCandles ? f_scale_val(cur_ce_c, curATMStrike) : na,
  title="Current Realtime ATM CE Candle", color=cur_ce_c >= cur_ce_opn ? color_cur_ce_bull : color_cur_ce_bear, wickcolor=cur_ce_c >= cur_ce_opn ? color_cur_ce_bull : color_cur_ce_bear, bordercolor=cur_ce_c >= cur_ce_opn ? color_cur_ce_bull : color_cur_ce_bear)

// Current Realtime ATM PE Candle
plotcandle(showPE_Candles and plotCurRealtimeCandles ? f_scale_val(cur_pe_opn, curATMStrike) : na, showPE_Candles and plotCurRealtimeCandles ? f_scale_val(cur_pe_h, curATMStrike) : na, showPE_Candles and plotCurRealtimeCandles ? f_scale_val(cur_pe_l, curATMStrike) : na, showPE_Candles and plotCurRealtimeCandles ? f_scale_val(cur_pe_c, curATMStrike) : na,
  title="Current Realtime ATM PE Candle", color=cur_pe_c >= cur_pe_opn ? color_cur_pe_bull : color_cur_pe_bear, wickcolor=cur_pe_c >= cur_pe_opn ? color_cur_pe_bull : color_cur_pe_bear)

// Floating Right-Side Labels with Explicit Fail-Safe Contract Strike Names & Prices
var label lbl_day_ce = na, var label lbl_day_pe = na
var label lbl_cur_ce = na, var label lbl_cur_pe = na

if barstate.islast and show_candle_labels
    label.delete(lbl_day_ce), label.delete(lbl_day_pe)
    label.delete(lbl_cur_ce), label.delete(lbl_cur_pe)
    
    int labelBar = bar_index + 2
    
    string day_ce_name = "Day " + (dayOpenATMStrike == math.floor(dayOpenATMStrike) ? str.tostring(int(dayOpenATMStrike)) : str.tostring(dayOpenATMStrike, "#.##")) + "CE"
    string day_pe_name = "Day " + (dayOpenATMStrike == math.floor(dayOpenATMStrike) ? str.tostring(int(dayOpenATMStrike)) : str.tostring(dayOpenATMStrike, "#.##")) + "PE"

    string cur_ce_name = "Cur " + (curATMStrike == math.floor(curATMStrike) ? str.tostring(int(curATMStrike)) : str.tostring(curATMStrike, "#.##")) + "CE"
    string cur_pe_name = "Cur " + (curATMStrike == math.floor(curATMStrike) ? str.tostring(int(curATMStrike)) : str.tostring(curATMStrike, "#.##")) + "PE"

    float val_dce = na(ce_c_0) ? close : ce_c_0
    float val_dpe = na(pe_c_0) ? close : pe_c_0
    float val_cce = na(cur_ce_c) ? val_dce : cur_ce_c
    float val_cpe = na(cur_pe_c) ? val_dpe : cur_pe_c

    if showCE_Candles and plotDayOpenCandles
        float y_dce = f_scale_val(val_dce, dayOpenATMStrike)
        lbl_day_ce := label.new(labelBar, y_dce, day_ce_name + ": " + str.tostring(val_dce, "#.##"), color=color_day_ce_bull, textcolor=color.black, style=label.style_label_left, size=size.small)
        
    if showPE_Candles and plotDayOpenCandles
        float y_dpe = f_scale_val(val_dpe, dayOpenATMStrike)
        lbl_day_pe := label.new(labelBar, y_dpe, day_pe_name + ": " + str.tostring(val_dpe, "#.##"), color=color_day_pe_bull, textcolor=color.black, style=label.style_label_left, size=size.small)
        
    if showCE_Candles and plotCurRealtimeCandles
        float y_cce = f_scale_val(val_cce, curATMStrike)
        lbl_cur_ce := label.new(labelBar + 12, y_cce, cur_ce_name + ": " + str.tostring(val_cce, "#.##"), color=color_cur_ce_bull, textcolor=color.black, style=label.style_label_left, size=size.small)
        
    if showPE_Candles and plotCurRealtimeCandles
        float y_cpe = f_scale_val(val_cpe, curATMStrike)
        lbl_cur_pe := label.new(labelBar + 12, y_cpe, cur_pe_name + ": " + str.tostring(val_cpe, "#.##"), color=color_cur_pe_bull, textcolor=color.black, style=label.style_label_left, size=size.small)

// ==========================================
// BASKET AVERAGE MATH CALCULATIONS
// ==========================================

int total_count = activeNumStrikes == 4 ? 9 : (activeNumStrikes == 3 ? 7 : (activeNumStrikes == 2 ? 5 : 3))

float sum_ce_open = activeNumStrikes == 4 ? (nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1) + nz(ce_o_p2) + nz(ce_o_m2) + nz(ce_o_p3) + nz(ce_o_m3) + nz(ce_o_p4) + nz(ce_o_m4)) : (activeNumStrikes == 3 ? (nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1) + nz(ce_o_p2) + nz(ce_o_m2) + nz(ce_o_p3) + nz(ce_o_m3)) : (activeNumStrikes == 2 ? (nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1) + nz(ce_o_p2) + nz(ce_o_m2)) : (nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1))))
float sum_pe_open = activeNumStrikes == 4 ? (nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1) + nz(pe_o_p2) + nz(pe_o_m2) + nz(pe_o_p3) + nz(pe_o_m3) + nz(pe_o_p4) + nz(pe_o_m4)) : (activeNumStrikes == 3 ? (nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1) + nz(pe_o_p2) + nz(pe_o_m2) + nz(pe_o_p3) + nz(pe_o_m3)) : (activeNumStrikes == 2 ? (nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1) + nz(pe_o_p2) + nz(pe_o_m2)) : (nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1))))

float ceAvgOpen     = sum_ce_open / total_count
float peAvgOpen     = sum_pe_open / total_count
float basketAvgOpen = (ceAvgOpen + peAvgOpen) / 2.0

float sum_ce_cur = activeNumStrikes == 4 ? (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1) + nz(ce_c_p2) + nz(ce_c_m2) + nz(ce_c_p3) + nz(ce_c_m3) + nz(ce_c_p4) + nz(ce_c_m4)) : (activeNumStrikes == 3 ? (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1) + nz(ce_c_p2) + nz(ce_c_m2) + nz(ce_c_p3) + nz(ce_c_m3)) : (activeNumStrikes == 2 ? (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1) + nz(ce_c_p2) + nz(ce_c_m2)) : (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1))))
float sum_pe_cur = activeNumStrikes == 4 ? (nz(pe_c_0) + nz(pe_c_p1) + nz(pe_c_m1) + nz(pe_c_p2) + nz(pe_c_m2) + nz(pe_c_p3) + nz(pe_c_m3) + nz(pe_c_p4) + nz(pe_c_m4)) : (activeNumStrikes == 3 ? (nz(pe_c_0) + nz(pe_c_p1) + nz(pe_c_m1) + nz(pe_c_p2) + nz(pe_c_m2) + nz(pe_c_p3) + nz(pe_c_m3)) : (activeNumStrikes == 2 ? (nz(pe_c_0) + nz(pe_c_p1) + nz(pe_c_m1) + nz(pe_c_p2) + nz(pe_c_m2)) : (nz(pe_c_0) + nz(pe_c_p1) + nz(pe_c_m1))))

float ceAvgCur     = sum_ce_cur / total_count
float peAvgCur     = sum_pe_cur / total_count
float basketAvgCur = (ceAvgCur + peAvgCur) / 2.0

float ceAvgChg     = ceAvgCur - ceAvgOpen
float peAvgChg     = peAvgCur - peAvgOpen
float basketAvgChg = basketAvgCur - basketAvgOpen

// ==========================================
// SUMMARY DASHBOARD & GRID TABLE RENDERING
// ==========================================

f_get_table_pos(string pos_str) =>
    switch pos_str
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

f_get_table_text_size(string sz_str) =>
    switch sz_str
        "Auto"   => size.auto
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

// Global Helper Functions for Table Population
f_fill_compact_row(table tbl, int r, float st_val, string role_tag, color bg_col, color tx_col, string t_sz) =>
    string st_fmt = st_val == math.floor(st_val) ? str.tostring(int(st_val)) : str.tostring(st_val, "#.##")
    string ce_st_name = st_fmt + "CE"
    string pe_st_name = st_fmt + "PE"
    table.cell(tbl, 0, r, ce_st_name + " / " + pe_st_name, bgcolor=bg_col, text_color=tx_col, text_size=t_sz)
    table.cell(tbl, 1, r, role_tag, bgcolor=bg_col, text_color=tx_col, text_size=t_sz)

f_fill_grid_row(table tbl, int r, float st_val, bool is_cur_atm, bool is_day_atm, float ce_o, float ce_ltp, float pe_o, float pe_ltp, string t_sz) =>
    string st_fmt = st_val == math.floor(st_val) ? str.tostring(int(st_val)) : str.tostring(st_val, "#.##")
    color st_bg = is_cur_atm ? colorCurATMHighlight : (is_day_atm ? colorDayATMHighlight : color.new(#262626, 0))
    color st_tx = (is_cur_atm or is_day_atm) ? color.black : color.white
    table.cell(tbl, 0, r, st_fmt, bgcolor=st_bg, text_color=st_tx, text_size=t_sz)

    table.cell(tbl, 1, r, na(ce_o) ? "N/A" : str.tostring(ce_o, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=t_sz)
    table.cell(tbl, 2, r, na(ce_ltp) ? "N/A" : str.tostring(ce_ltp, "#.##"), bgcolor=color.black, text_color=#00E676, text_size=t_sz)

    float ce_chg = ce_ltp - ce_o
    string ce_chg_str = na(ce_chg) ? "N/A" : ((ce_chg >= 0 ? "+" : "") + str.tostring(ce_chg, "#.##"))
    color ce_chg_bg   = na(ce_chg) ? color.black : (ce_chg > 0 ? color.new(#1B5E20, 0) : (ce_chg < 0 ? color.new(#880E4F, 0) : color.black))
    table.cell(tbl, 3, r, ce_chg_str, bgcolor=ce_chg_bg, text_color=color.white, text_size=t_sz)

    table.cell(tbl, 4, r, na(pe_o) ? "N/A" : str.tostring(pe_o, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=t_sz)
    table.cell(tbl, 5, r, na(pe_ltp) ? "N/A" : str.tostring(pe_ltp, "#.##"), bgcolor=color.black, text_color=#FF1744, text_size=t_sz)

    float pe_chg = pe_ltp - pe_o
    string pe_chg_str = na(pe_chg) ? "N/A" : ((pe_chg >= 0 ? "+" : "") + str.tostring(pe_chg, "#.##"))
    color pe_chg_bg   = na(pe_chg) ? color.black : (pe_chg > 0 ? color.new(#1B5E20, 0) : (pe_chg < 0 ? color.new(#880E4F, 0) : color.black))
    table.cell(tbl, 6, r, pe_chg_str, bgcolor=pe_chg_bg, text_color=color.white, text_size=t_sz)

    float raw_diff = ce_ltp - pe_ltp
    float abs_diff = na(raw_diff) ? na : math.abs(raw_diff)
    string diff_str = na(raw_diff) ? "N/A" : str.tostring(abs_diff, "#.##")
    color diff_bg = na(raw_diff) ? color.black : (raw_diff > 0 ? color.new(#1B5E20, 0) : (raw_diff < 0 ? color.new(#880E4F, 0) : color.black))
    table.cell(tbl, 7, r, diff_str, bgcolor=diff_bg, text_color=color.white, text_size=t_sz)

// Table 1: Small Compact Selected Strikes Table
var table compactTable = table.new(f_get_table_pos(tablePosInput), 2, 12, bgcolor=color.black, border_width=1, border_color=color.gray, force_overlay=true)

// Table 2: Full Analytics Grid Table
var table summaryTable = table.new(f_get_table_pos(tablePosInput), 8, 15, bgcolor=color.black, border_width=1, border_color=color.gray, force_overlay=true)

if barstate.islast
    if not showTableInput
        table.delete(compactTable)
        table.delete(summaryTable)
    else
        string curTextSize = f_get_table_text_size(tableTextSizeInput)
        string underlyingName = actualUnderlying == UnderlyingAsset.banknifty ? "BANKNIFTY" : (actualUnderlying == UnderlyingAsset.nifty ? "NIFTY" : (actualUnderlying == UnderlyingAsset.crudeoil ? "CRUDEOIL" : (actualUnderlying == UnderlyingAsset.gold ? "GOLD" : cleanTicker)))
        string strikeTag = isManualMode ? "Manual 3-Strike Basket" : (str.tostring(total_count) + "-Strike Basket (" + str.tostring(activeNumStrikes) + " ITM + ATM + " + str.tostring(activeNumStrikes) + " OTM)")
        string stepFmt = stepVal == math.floor(stepVal) ? str.tostring(int(stepVal)) : str.tostring(stepVal, "#.##")
        string dayOpenFmt = dayOpenATMStrike == math.floor(dayOpenATMStrike) ? str.tostring(int(dayOpenATMStrike)) : str.tostring(dayOpenATMStrike, "#.##")
        string curAtmFmt = curATMStrike == math.floor(curATMStrike) ? str.tostring(int(curATMStrike)) : str.tostring(curATMStrike, "#.##")

        if tableStyleInput == "Small Selected Strikes Table"
            table.delete(summaryTable)

            table.cell(compactTable, 0, 0, "Selected Strike Names (" + underlyingName + ")", bgcolor=#1565C0, text_color=color.white, text_size=curTextSize)
            table.cell(compactTable, 1, 0, "Strike Role / Tag", bgcolor=#1565C0, text_color=color.white, text_size=curTextSize)

            int c_row = 1

            if activeNumStrikes >= 4
                f_fill_compact_row(compactTable, c_row, k_p4, "OTM Call / ITM Put (Upper 4)", color.new(#262626, 0), color.white, curTextSize)
                c_row += 1
            if activeNumStrikes >= 3
                f_fill_compact_row(compactTable, c_row, k_p3, "OTM Call / ITM Put (Upper 3)", color.new(#262626, 0), color.white, curTextSize)
                c_row += 1
            if activeNumStrikes >= 2
                f_fill_compact_row(compactTable, c_row, k_p2, "OTM Call / ITM Put (Upper 2)", color.new(#262626, 0), color.white, curTextSize)
                c_row += 1
            if activeNumStrikes >= 1
                f_fill_compact_row(compactTable, c_row, k_p1, "OTM Call / ITM Put (Upper 1)", color.new(#262626, 0), color.white, curTextSize)
                c_row += 1

            // ATM Center Strike
            color atm_bg = k_0 == curATMStrike ? colorCurATMHighlight : (k_0 == dayOpenATMStrike ? colorDayATMHighlight : #212121)
            color atm_tx = (k_0 == curATMStrike or k_0 == dayOpenATMStrike) ? color.black : color.white
            string atm_tag = "ATM Center Strike (" + (k_0 == dayOpenATMStrike ? "Day Open ATM" : "") + (k_0 == curATMStrike ? " / Cur ATM" : "") + ")"
            f_fill_compact_row(compactTable, c_row, k_0, atm_tag, atm_bg, atm_tx, curTextSize)
            c_row += 1

            if activeNumStrikes >= 1
                f_fill_compact_row(compactTable, c_row, k_m1, "ITM Call / OTM Put (Lower 1)", color.new(#262626, 0), color.white, curTextSize)
                c_row += 1
            if activeNumStrikes >= 2
                f_fill_compact_row(compactTable, c_row, k_m2, "ITM Call / OTM Put (Lower 2)", color.new(#262626, 0), color.white, curTextSize)
                c_row += 1
            if activeNumStrikes >= 3
                f_fill_compact_row(compactTable, c_row, k_m3, "ITM Call / OTM Put (Lower 3)", color.new(#262626, 0), color.white, curTextSize)
                c_row += 1
            if activeNumStrikes >= 4
                f_fill_compact_row(compactTable, c_row, k_m4, "ITM Call / OTM Put (Lower 4)", color.new(#262626, 0), color.white, curTextSize)
                c_row += 1

        else
            table.delete(compactTable)

            // Row 0: Top Header Banner
            table.cell(summaryTable, 0, 0, "Asset: " + underlyingName, bgcolor=color.new(#1565C0, 0), text_color=color.white, text_size=curTextSize)
            table.cell(summaryTable, 1, 0, "Step: " + stepFmt, bgcolor=color.new(#1565C0, 0), text_color=color.white, text_size=curTextSize)
            table.cell(summaryTable, 2, 0, strikeTag, bgcolor=color.new(#1565C0, 0), text_color=color.yellow, text_size=curTextSize)
            table.cell(summaryTable, 3, 0, "Day Open ATM:", bgcolor=color.new(#1565C0, 0), text_color=color.silver, text_size=curTextSize)
            table.cell(summaryTable, 4, 0, dayOpenFmt, bgcolor=colorDayATMHighlight, text_color=color.black, text_size=curTextSize)
            table.cell(summaryTable, 5, 0, "Current ATM:", bgcolor=color.new(#1565C0, 0), text_color=color.silver, text_size=curTextSize)
            table.cell(summaryTable, 6, 0, curAtmFmt, bgcolor=colorCurATMHighlight, text_color=color.black, text_size=curTextSize)
            table.cell(summaryTable, 7, 0, "", bgcolor=color.new(#1565C0, 0))

            // Row 1: Day Open Averages (CE & PE)
            table.cell(summaryTable, 0, 1, "Day Open Basket Avg", bgcolor=color.new(#212121, 0), text_color=color.white, text_size=curTextSize)
            table.cell(summaryTable, 1, 1, "CE Open Avg:", bgcolor=color.new(#212121, 0), text_color=color.silver, text_size=curTextSize)
            table.cell(summaryTable, 2, 1, str.tostring(ceAvgOpen, "#.##"), bgcolor=color.new(#212121, 0), text_color=#00E676, text_size=curTextSize)
            table.cell(summaryTable, 3, 1, "PE Open Avg:", bgcolor=color.new(#212121, 0), text_color=color.silver, text_size=curTextSize)
            table.cell(summaryTable, 4, 1, str.tostring(peAvgOpen, "#.##"), bgcolor=color.new(#212121, 0), text_color=#FF1744, text_size=curTextSize)
            table.cell(summaryTable, 5, 1, "Basket Open Avg:", bgcolor=color.new(#212121, 0), text_color=color.silver, text_size=curTextSize)
            table.cell(summaryTable, 6, 1, str.tostring(basketAvgOpen, "#.##"), bgcolor=color.new(#212121, 0), text_color=color.white, text_size=curTextSize)
            table.cell(summaryTable, 7, 1, "", bgcolor=color.new(#212121, 0))

            // Row 2: Current Running Averages & Changes
            table.cell(summaryTable, 0, 2, "Current Running Avg", bgcolor=color.new(#1C1C1C, 0), text_color=color.white, text_size=curTextSize)
            table.cell(summaryTable, 1, 2, "CE Cur Avg:", bgcolor=color.new(#1C1C1C, 0), text_color=color.silver, text_size=curTextSize)

            string ceAvgStr = str.tostring(ceAvgCur, "#.##") + " (" + (ceAvgChg >= 0 ? "+" : "") + str.tostring(ceAvgChg, "#.##") + ")"
            color ceAvgColor = ceAvgChg >= 0 ? #00E676 : #FF5252
            table.cell(summaryTable, 2, 2, ceAvgStr, bgcolor=color.new(#1C1C1C, 0), text_color=ceAvgColor, text_size=curTextSize)

            table.cell(summaryTable, 3, 2, "PE Cur Avg:", bgcolor=color.new(#1C1C1C, 0), text_color=color.silver, text_size=curTextSize)
            string peAvgStr = str.tostring(peAvgCur, "#.##") + " (" + (peAvgChg >= 0 ? "+" : "") + str.tostring(peAvgChg, "#.##") + ")"
            color peAvgColor = peAvgChg >= 0 ? #00E676 : #FF5252
            table.cell(summaryTable, 4, 2, peAvgStr, bgcolor=color.new(#1C1C1C, 0), text_color=peAvgColor, text_size=curTextSize)

            table.cell(summaryTable, 5, 2, "Basket Cur Avg:", bgcolor=color.new(#1C1C1C, 0), text_color=color.silver, text_size=curTextSize)
            string basketAvgStr = str.tostring(basketAvgCur, "#.##") + " (" + (basketAvgChg >= 0 ? "+" : "") + str.tostring(basketAvgChg, "#.##") + ")"
            color basketAvgColor = basketAvgChg >= 0 ? #00E676 : #FF5252
            table.cell(summaryTable, 6, 2, basketAvgStr, bgcolor=color.new(#1C1C1C, 0), text_color=basketAvgColor, text_size=curTextSize)
            table.cell(summaryTable, 7, 2, "", bgcolor=color.new(#1C1C1C, 0))

            // Row 3: Grid Column Headers
            table.cell(summaryTable, 0, 3, "Strike",     bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
            table.cell(summaryTable, 1, 3, "CE Open",    bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
            table.cell(summaryTable, 2, 3, "CE LTP",     bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
            table.cell(summaryTable, 3, 3, "CE Chg",     bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
            table.cell(summaryTable, 4, 3, "PE Open",    bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
            table.cell(summaryTable, 5, 3, "PE LTP",     bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
            table.cell(summaryTable, 6, 3, "PE Chg",     bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)
            table.cell(summaryTable, 7, 3, "|CE-PE| Diff", bgcolor=color.new(#333333, 0), text_color=color.white, text_size=curTextSize)

            // Rows 4+: Populate active selected strikes grid
            int rowIdx = 4
            if activeNumStrikes >= 4
                f_fill_grid_row(summaryTable, rowIdx, k_p4, k_p4 == curATMStrike, k_p4 == dayOpenATMStrike, ce_o_p4, ce_c_p4, pe_o_p4, pe_c_p4, curTextSize)
                rowIdx += 1

            if activeNumStrikes >= 3
                f_fill_grid_row(summaryTable, rowIdx, k_p3, k_p3 == curATMStrike, k_p3 == dayOpenATMStrike, ce_o_p3, ce_c_p3, pe_o_p3, pe_c_p3, curTextSize)
                rowIdx += 1

            if activeNumStrikes >= 2
                f_fill_grid_row(summaryTable, rowIdx, k_p2, k_p2 == curATMStrike, k_p2 == dayOpenATMStrike, ce_o_p2, ce_c_p2, pe_o_p2, pe_c_p2, curTextSize)
                rowIdx += 1

            if activeNumStrikes >= 1
                f_fill_grid_row(summaryTable, rowIdx, k_p1, k_p1 == curATMStrike, k_p1 == dayOpenATMStrike, ce_o_p1, ce_c_p1, pe_o_p1, pe_c_p1, curTextSize)
                rowIdx += 1

            // ATM Row (0)
            f_fill_grid_row(summaryTable, rowIdx, k_0, k_0 == curATMStrike, k_0 == dayOpenATMStrike, ce_o_0, ce_c_0, pe_o_0, pe_c_0, curTextSize)
            rowIdx += 1

            if activeNumStrikes >= 1
                f_fill_grid_row(summaryTable, rowIdx, k_m1, k_m1 == curATMStrike, k_m1 == dayOpenATMStrike, ce_o_m1, ce_c_m1, pe_o_m1, pe_c_m1, curTextSize)
                rowIdx += 1

            if activeNumStrikes >= 2
                f_fill_grid_row(summaryTable, rowIdx, k_m2, k_m2 == curATMStrike, k_m2 == dayOpenATMStrike, ce_o_m2, ce_c_m2, pe_o_m2, pe_c_m2, curTextSize)
                rowIdx += 1

            if activeNumStrikes >= 3
                f_fill_grid_row(summaryTable, rowIdx, k_m3, k_m3 == curATMStrike, k_m3 == dayOpenATMStrike, ce_o_m3, ce_c_m3, pe_o_m3, pe_c_m3, curTextSize)
                rowIdx += 1

            if activeNumStrikes >= 4
                f_fill_grid_row(summaryTable, rowIdx, k_m4, k_m4 == curATMStrike, k_m4 == dayOpenATMStrike, ce_o_m4, ce_c_m4, pe_o_m4, pe_c_m4, curTextSize)
                rowIdx += 1
