//@version=6
indicator("20.Techfrost ORB & PDH-PDL Multi-Condition Options Engine", shorttitle="20.ORB & PDH Engine", overlay=true, precision=2, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum UnderlyingAsset
    auto       = "Auto-Detect"
    nifty      = "NIFTY"
    banknifty  = "BANKNIFTY"
    finnifty   = "FINNIFTY"
    midcpnifty = "MIDCPNIFTY"
    crudeoil   = "CRUDEOIL"
    gold       = "GOLD"
    stock      = "Stock (Equity)"

enum OptionType
    auto = "Auto-Detect"
    ce   = "Call (CE)"
    pe   = "Put (PE)"

enum StepOverrideChoice
    auto    = "Auto"
    step1   = "1"
    step2_5 = "2.5"
    step5   = "5"
    step10  = "10"
    step20  = "20"
    step25  = "25"
    step50  = "50"
    step100 = "100"
    step200 = "200"
    step500 = "500"

enum ORBTimeframe
    m5  = "5 Minutes"
    m15 = "15 Minutes"
    m30 = "30 Minutes"

// --- 1. Instrument & Strike Settings ---
underlyingInput    = input.enum(UnderlyingAsset.auto, "Underlying Asset", group="Instrument Settings")
optionTypeInput    = input.enum(OptionType.auto, "Option Type", group="Instrument Settings")
manualStrikeInput  = input.int(0, "Manual Strike Selection (0 = Auto)", minval=0, group="Instrument Settings",
  tooltip="Enter strike price manually (e.g. 24000). Leave at 0 to auto-detect from chart symbol.")
spotTickerOverride = input.symbol("", "Spot Symbol Override (e.g. NSE:NIFTY)", group="Instrument Settings")
strikeOverride     = input.float(0.0, "Strike Price Override", minval=0.0, group="Instrument Settings")
strikeStepInput    = input.enum(StepOverrideChoice.auto, "Strike Step Override", group="Instrument Settings")

// --- 2. ORB & Reference Level Settings ---
orbChoiceInput     = input.enum(ORBTimeframe.m15, "Opening Range (ORB) Period", group="ORB & Reference Level Settings")
show_orb_lines     = input.bool(true, "Show ORB High / Low Lines on Chart", group="ORB & Reference Level Settings")
show_pdh_pdl       = input.bool(true, "Show Previous Day High / Low (PDH/PDL) Lines", group="ORB & Reference Level Settings")
show_do_lines      = input.bool(true, "Show Day Open Lines on Chart", group="ORB & Reference Level Settings")

// --- 3. Condition Enable / Disable Switches ---
enable_cond1       = input.bool(true, "Enable Condition 1 (CE UP)", group="Condition Enable / Disable Switches")
enable_cond2       = input.bool(true, "Enable Condition 2 (PE UP)", group="Condition Enable / Disable Switches")
enable_cond3       = input.bool(true, "Enable Condition 3 (CE Over PDH)", group="Condition Enable / Disable Switches")
enable_cond4       = input.bool(true, "Enable Condition 4 (PE Over PDH)", group="Condition Enable / Disable Switches")

// --- 4. Signal Formatting & Styling (Customizable Format & Color) ---
cond1_text         = input.string("CE UP", "Condition 1 (CE UP) Label Text", group="Condition 1 (CE UP) Formatting")
cond1_col          = input.color(#00E676, "Condition 1 Background Color", group="Condition 1 (CE UP) Formatting")
cond1_txt_col      = input.color(color.black, "Condition 1 Text Color", group="Condition 1 (CE UP) Formatting")
cond1_pos_str      = input.string("Below Bar (Up Arrow)", "Condition 1 Position", options=["Below Bar (Up Arrow)", "Above Bar (Down Arrow)"], group="Condition 1 (CE UP) Formatting")

cond2_text         = input.string("PE UP", "Condition 2 (PE UP) Label Text", group="Condition 2 (PE UP) Formatting")
cond2_col          = input.color(#FF1744, "Condition 2 Background Color", group="Condition 2 (PE UP) Formatting")
cond2_txt_col      = input.color(color.white, "Condition 2 Text Color", group="Condition 2 (PE UP) Formatting")
cond2_pos_str      = input.string("Above Bar (Down Arrow)", "Condition 2 Position", options=["Above Bar (Down Arrow)", "Below Bar (Up Arrow)"], group="Condition 2 (PE UP) Formatting")

cond3_text         = input.string("Over PDH", "Condition 3 (CE Over PDH) Label Text", group="Condition 3 (CE Over PDH) Formatting")
cond3_col          = input.color(#00E676, "Condition 3 Background Color", group="Condition 3 (CE Over PDH) Formatting")
cond3_txt_col      = input.color(color.black, "Condition 3 Text Color", group="Condition 3 (CE Over PDH) Formatting")
cond3_pos_str      = input.string("Below Bar (Up Arrow)", "Condition 3 Position", options=["Below Bar (Up Arrow)", "Above Bar (Down Arrow)"], group="Condition 3 (CE Over PDH) Formatting")

cond4_text         = input.string("Over PDH", "Condition 4 (PE Over PDH) Label Text", group="Condition 4 (PE Over PDH) Formatting")
cond4_col          = input.color(#FF1744, "Condition 4 Background Color", group="Condition 4 (PE Over PDH) Formatting")
cond4_txt_col      = input.color(color.white, "Condition 4 Text Color", group="Condition 4 (PE Over PDH) Formatting")
cond4_pos_str      = input.string("Above Bar (Down Arrow)", "Condition 4 Position", options=["Above Bar (Down Arrow)", "Below Bar (Up Arrow)"], group="Condition 4 (PE Over PDH) Formatting")

label_size_str     = input.string("Small", "Signal Label Size", options=["Tiny", "Small", "Normal", "Large"], group="General Display & Controls")
signal_trigger_mode= input.string("First Breakout Only (State Change)", "Signal Trigger Mode", options=["First Breakout Only (State Change)", "Every Bar While Active"], group="General Display & Controls",
  tooltip="Select 'First Breakout Only' to trigger label & alert once when condition turns true. Select 'Every Bar' for continuous alerts.")
require_bar_close  = input.bool(true, "Require Candle Close Confirmation", group="General Display & Controls")
show_opp_candles   = input.bool(true, "Show Opposite Option Candles Overlay", group="General Display & Controls")
opp_bull_col       = input.color(color.new(#2962FF, 40), "Opposite Bullish Candle Body", group="General Display & Controls")
opp_bear_col       = input.color(color.new(#FF6D00, 40), "Opposite Bearish Candle Body", group="General Display & Controls")
opp_bull_wick      = input.color(color.new(#2962FF, 60), "Opposite Bullish Wick", group="General Display & Controls")
opp_bear_wick      = input.color(color.new(#FF6D00, 60), "Opposite Bearish Wick", group="General Display & Controls")
show_dashboard     = input.bool(true, "Show Analytics Dashboard Table", group="General Display & Controls")
show_dashboard_pos = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="General Display & Controls")

// ==========================================
// TICKER PARSING & AUTO-DETECTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

// ----- Detect underlying -----
UnderlyingAsset actualUnderlying = na
if underlyingInput == UnderlyingAsset.auto
    if str.contains(cleanTicker, "BANKNIFTY")
        actualUnderlying := UnderlyingAsset.banknifty
    else if str.contains(cleanTicker, "FINNIFTY")
        actualUnderlying := UnderlyingAsset.finnifty
    else if str.contains(cleanTicker, "MIDCPNIFTY")
        actualUnderlying := UnderlyingAsset.midcpnifty
    else if str.contains(cleanTicker, "NIFTY")
        actualUnderlying := UnderlyingAsset.nifty
    else if str.contains(cleanTicker, "CRUDEOIL")
        actualUnderlying := UnderlyingAsset.crudeoil
    else if str.contains(cleanTicker, "GOLD") and not str.contains(cleanTicker, "GOLDM") and not str.contains(cleanTicker, "GOLDPETAL")
        actualUnderlying := UnderlyingAsset.gold
    else
        actualUnderlying := UnderlyingAsset.stock
else
    actualUnderlying := underlyingInput

// ----- Detect option type -----
bool isCall = false
bool isPut  = false

if optionTypeInput == OptionType.ce
    isCall := true
else if optionTypeInput == OptionType.pe
    isPut := true
else
    if str.contains(cleanTicker, "CE")
        isCall := true
    else if str.contains(cleanTicker, "PE")
        isPut := true
    else if str.match(cleanTicker, "C\\d+$") != ""
        isCall := true
    else if str.match(cleanTicker, "P\\d+$") != ""
        isPut := true

// ==========================================
// SPOT TICKER & STEP RESOLUTION
// ==========================================

string spotTicker = ""
if str.length(spotTickerOverride) > 0
    spotTicker := spotTickerOverride
else
    switch actualUnderlying
        UnderlyingAsset.banknifty  => spotTicker := "NSE:BANKNIFTY"
        UnderlyingAsset.finnifty   => spotTicker := "NSE:FINNIFTY"
        UnderlyingAsset.midcpnifty => spotTicker := "NSE:MIDCPNIFTY"
        UnderlyingAsset.nifty      => spotTicker := "NSE:NIFTY"
        UnderlyingAsset.crudeoil   => spotTicker := "MCX:CRUDEOIL1!"
        UnderlyingAsset.gold       => spotTicker := "MCX:GOLD1!"
        UnderlyingAsset.stock      =>
            string rootGuess = str.match(cleanTicker, "^[A-Z&]+")
            if rootGuess != ""
                spotTicker := syminfo.prefix + ":" + rootGuess
            else
                spotTicker := syminfo.prefix + ":" + cleanTicker

f_auto_detect_step(float ref_p) =>
    float s_res = 50.0
    if na(ref_p) or ref_p <= 0
        s_res := 50.0
    else if ref_p < 100
        s_res := 1.0
    else if ref_p < 250
        s_res := 2.5
    else if ref_p < 500
        s_res := 5.0
    else if ref_p < 1200
        s_res := 10.0
    else if ref_p < 2500
        s_res := 20.0
    else
        s_res := 50.0
    s_res

float stepVal = switch actualUnderlying
    UnderlyingAsset.banknifty  => 100.0
    UnderlyingAsset.finnifty   => 50.0
    UnderlyingAsset.midcpnifty => 50.0
    UnderlyingAsset.nifty      => 50.0
    UnderlyingAsset.crudeoil   => 50.0
    UnderlyingAsset.gold       => 100.0
    UnderlyingAsset.stock      => 50.0

if strikeStepInput != StepOverrideChoice.auto
    stepVal := switch strikeStepInput
        StepOverrideChoice.step1   => 1.0
        StepOverrideChoice.step2_5 => 2.5
        StepOverrideChoice.step5   => 5.0
        StepOverrideChoice.step10  => 10.0
        StepOverrideChoice.step20  => 20.0
        StepOverrideChoice.step25  => 25.0
        StepOverrideChoice.step50  => 50.0
        StepOverrideChoice.step100 => 100.0
        StepOverrideChoice.step200 => 200.0
        StepOverrideChoice.step500 => 500.0
        => stepVal

// ----- Day Open ATM Calculation (matching 15.Techfrost Day ATM Option Candles: MIN |CE Open - PE Open|) -----
float spotDayOpen = request.security(spotTicker, "D", open, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

float detectedStrike = na
string tickerWithoutCEPE = ""

int tickerLen = str.length(cleanTicker)
if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, tickerLen - 2)

string matchC = str.match(cleanTicker, "C\\d+$")
string matchP = str.match(cleanTicker, "P\\d+$")

if matchC != ""
    detectedStrike := str.tonumber(str.substring(matchC, 1))
else if matchP != ""
    detectedStrike := str.tonumber(str.substring(matchP, 1))
else if tickerWithoutCEPE != ""
    string strikeDigits = str.match(tickerWithoutCEPE, "\\d+$")
    detectedStrike := str.tonumber(strikeDigits)

// ==========================================
// FAIL-SAFE TICKER CONSTRUCTORS
// ==========================================

f_build_option_symbol(float target_strike, bool target_is_ce) =>
    string target_st_str = target_strike == math.floor(target_strike) ? str.tostring(int(target_strike)) : str.tostring(target_strike)
    
    if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
        int end_trim = 2
        string base_no_suffix = str.substring(cleanTicker, 0, str.length(cleanTicker) - end_trim)
        string strikeDigits = str.match(base_no_suffix, "\\d+$")
        if strikeDigits != ""
            string pfx = str.substring(base_no_suffix, 0, str.length(base_no_suffix) - str.length(strikeDigits))
            string sfx = target_is_ce ? "CE" : "PE"
            pfx + target_st_str + sfx
        else
            cleanTicker
    else if str.match(cleanTicker, "[CP]\\d+$") != ""
        string matchCP = str.match(cleanTicker, "[CP]\\d+$")
        int matchPos = str.pos(cleanTicker, matchCP)
        string pfx = str.substring(cleanTicker, 0, matchPos)
        string cp_letter = target_is_ce ? "C" : "P"
        pfx + cp_letter + target_st_str
    else
        string root = str.match(cleanTicker, "^[A-Z&]+")
        string sfx = target_is_ce ? "CE" : "PE"
        (root != "" ? root : cleanTicker) + target_st_str + sfx

// Base Center Strike & Strike Resolution
var float base_center_strike = na
if barstate.isfirst or na(base_center_strike)
    float ref_p = not na(spotDayOpen) and spotDayOpen > 0 ? spotDayOpen : open
    base_center_strike := stepVal > 0 ? math.round(ref_p / stepVal) * stepVal : 24000.0

float day_open_atm_strike = not na(spotDayOpen) and stepVal > 0 ? math.round(spotDayOpen / stepVal) * stepVal : base_center_strike

if na(detectedStrike) or detectedStrike <= 0
    detectedStrike := day_open_atm_strike

var float chartStrikePrice = na
if barstate.isfirst or na(chartStrikePrice)
    chartStrikePrice := strikeOverride > 0.0 ? strikeOverride : (manualStrikeInput > 0 ? float(manualStrikeInput) : detectedStrike)

if na(chartStrikePrice) or chartStrikePrice <= 0
    chartStrikePrice := day_open_atm_strike

if actualUnderlying == UnderlyingAsset.stock and strikeStepInput == StepOverrideChoice.auto
    stepVal := f_auto_detect_step(chartStrikePrice)

string ce_tkr_0 = f_build_option_symbol(chartStrikePrice, true)
string pe_tkr_0 = f_build_option_symbol(chartStrikePrice, false)

// ==========================================
// MULTI-ASSET OHLC & PDH/PDL DATA FETCHING
// ==========================================

f_get_asset_data(string tkr) =>
    [c, h, l, op] = request.security(tkr, timeframe.period, [close, high, low, open], ignore_invalid_symbol=true)
    [pdh, pdl]    = request.security(tkr, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
    [c, h, l, op, pdh, pdl]

[spot_c, spot_h, spot_l, spot_op_real, spot_pdh, spot_pdl] = f_get_asset_data(spotTicker)
[ce_c, ce_h, ce_l, ce_op_real, ce_pdh, ce_pdl]             = f_get_asset_data(ce_tkr_0)
[pe_c, pe_h, pe_l, pe_op_real, pe_pdh, pe_pdl]             = f_get_asset_data(pe_tkr_0)

// Robust Fail-Safe Fallbacks across all chart types and instruments
spot_c := na(spot_c) ? close : spot_c
spot_h := na(spot_h) ? high  : spot_h
spot_l := na(spot_l) ? low   : spot_l
spot_op_real := na(spot_op_real) ? open : spot_op_real
spot_pdh := na(spot_pdh) ? high[1] : spot_pdh
spot_pdl := na(spot_pdl) ? low[1]  : spot_pdl

ce_c   := na(ce_c) ? (isCall ? close : spot_c) : ce_c
ce_h   := na(ce_h) ? (isCall ? high  : spot_h) : ce_h
ce_l   := na(ce_l) ? (isCall ? low   : spot_l) : ce_l
ce_op_real := na(ce_op_real) ? (isCall ? open : spot_op_real) : ce_op_real
ce_pdh := na(ce_pdh) ? spot_pdh : ce_pdh
ce_pdl := na(ce_pdl) ? spot_pdl : ce_pdl

pe_c   := na(pe_c) ? (isPut ? close : spot_c) : pe_c
pe_h   := na(pe_h) ? (isPut ? high  : spot_h) : pe_h
pe_l   := na(pe_l) ? (isPut ? low   : spot_l) : pe_l
pe_op_real := na(pe_op_real) ? (isPut ? open : spot_op_real) : pe_op_real
pe_pdh := na(pe_pdh) ? spot_pdh : pe_pdh
pe_pdl := na(pe_pdl) ? spot_pdl : pe_pdl

// Day Open LTP (First bar of day)
var float spot_do = na
var float ce_do   = na
var float pe_do   = na

if ta.change(time("D")) != 0 or bar_index == 0
    spot_do := spot_op_real
    ce_do   := ce_op_real
    pe_do   := pe_op_real

// ==========================================
// DYNAMIC OPENING RANGE (ORB) ENGINE
// ==========================================

int orb_duration_mins = switch orbChoiceInput
    ORBTimeframe.m5  => 5
    ORBTimeframe.m15 => 15
    ORBTimeframe.m30 => 30
    => 15

var float spot_orb_h = na
var float spot_orb_l = na

var float ce_orb_h   = na
var float ce_orb_l   = na

var float pe_orb_h   = na
var float pe_orb_l   = na

var int day_start_time = na

if ta.change(time("D")) != 0 or bar_index == 0
    day_start_time := time
    spot_orb_h := spot_h
    spot_orb_l := spot_l
    ce_orb_h   := ce_h
    ce_orb_l   := ce_l
    pe_orb_h   := pe_h
    pe_orb_l   := pe_l

bool in_orb_window = not na(day_start_time) and (time < day_start_time + orb_duration_mins * 60 * 1000)

if in_orb_window
    spot_orb_h := math.max(nz(spot_orb_h, spot_h), spot_h)
    spot_orb_l := math.min(nz(spot_orb_l, spot_l), spot_l)
    
    ce_orb_h   := math.max(nz(ce_orb_h, ce_h), ce_h)
    ce_orb_l   := math.min(nz(ce_orb_l, ce_l), ce_l)
    
    pe_orb_h   := math.max(nz(pe_orb_h, pe_h), pe_h)
    pe_orb_l   := math.min(nz(pe_orb_l, pe_l), pe_l)

// Resolve active chart level values (If on Call chart, use Call levels; if on Put chart, use Put levels; if on Spot chart, use Spot levels)
float active_orb_h = isCall ? ce_orb_h : (isPut ? pe_orb_h : spot_orb_h)
float active_orb_l = isCall ? ce_orb_l : (isPut ? pe_orb_l : spot_orb_l)
float active_do    = isCall ? ce_do    : (isPut ? pe_do    : spot_do)
float active_pdh   = isCall ? ce_pdh   : (isPut ? pe_pdh   : spot_pdh)
float active_pdl   = isCall ? ce_pdl   : (isPut ? pe_pdl   : spot_pdl)

// Plot Reference Lines on Chart (Green for CE / Bullish, Red for PE / Bearish)
color pdh_color = isPut ? color.new(#FF1744, 30) : color.new(#00E676, 30)
color pdl_color = isCall ? color.new(#00E676, 30) : color.new(#FF1744, 30)

plot(show_orb_lines ? active_orb_h : na, title="ORB High (CE)", color=color.new(#00E676, 30), linewidth=1, style=plot.style_linebr)
plot(show_orb_lines ? active_orb_l : na, title="ORB Low (PE)",  color=color.new(#FF1744, 30), linewidth=1, style=plot.style_linebr)

plot(show_do_lines ? active_do : na, title="Day Open", color=color.new(#FFEA00, 20), linewidth=2, style=plot.style_linebr)

plot(show_pdh_pdl ? active_pdh : na, title="PDH", color=pdh_color, linewidth=1, style=plot.style_linebr)
plot(show_pdh_pdl ? active_pdl : na, title="PDL", color=pdl_color, linewidth=1, style=plot.style_linebr)

// ==========================================
// 4 CONFLUENCE CONDITIONS ENGINE
// ==========================================

// Condition 1: CE UP
// Spot LTP > Spot ORB High AND > Spot Day Open
// ATM CE LTP > CE ORB High AND > CE Day Open
// ATM PE LTP < PE ORB Low AND < PE Day Open
bool cond1_spot = not na(spot_c) and not na(spot_orb_h) and not na(spot_do) and (spot_c > spot_orb_h) and (spot_c > spot_do)
bool cond1_ce   = not na(ce_c)   and not na(ce_orb_h)   and not na(ce_do)   and (ce_c > ce_orb_h)   and (ce_c > ce_do)
bool cond1_pe   = not na(pe_c)   and not na(pe_orb_l)   and not na(pe_do)   and (pe_c < pe_orb_l)   and (pe_c < pe_do)
bool cond1_met  = enable_cond1 and cond1_spot and cond1_ce and cond1_pe

// Condition 2: PE UP
// Spot LTP < Spot ORB Low AND < Spot Day Open
// ATM PE LTP > PE ORB High AND > PE Day Open
// ATM CE LTP < CE ORB Low AND < CE Day Open
bool cond2_spot = not na(spot_c) and not na(spot_orb_l) and not na(spot_do) and (spot_c < spot_orb_l) and (spot_c < spot_do)
bool cond2_pe   = not na(pe_c)   and not na(pe_orb_h)   and not na(pe_do)   and (pe_c > pe_orb_h)   and (pe_c > pe_do)
bool cond2_ce   = not na(ce_c)   and not na(ce_orb_l)   and not na(ce_do)   and (ce_c < ce_orb_l)   and (ce_c < ce_do)
bool cond2_met  = enable_cond2 and cond2_spot and cond2_pe and cond2_ce

// Condition 3: Over PDH
// Spot LTP > Spot PDH AND > Spot Day Open
// ATM CE LTP > CE PDH AND > CE Day Open
// ATM PE LTP < PE PDL AND < PE Day Open
bool cond3_spot = not na(spot_c) and not na(spot_pdh) and not na(spot_do) and (spot_c > spot_pdh) and (spot_c > spot_do)
bool cond3_ce   = not na(ce_c)   and not na(ce_pdh)   and not na(ce_do)   and (ce_c > ce_pdh)   and (ce_c > ce_do)
bool cond3_pe   = not na(pe_c)   and not na(pe_pdl)   and not na(pe_do)   and (pe_c < pe_pdl)   and (pe_c < pe_do)
bool cond3_met  = enable_cond3 and cond3_spot and cond3_ce and cond3_pe

// Condition 4: Over PDL
// Spot LTP < Spot PDL AND < Spot Day Open
// ATM CE LTP < CE PDL AND < CE Day Open
// ATM PE LTP > PE PDH AND > PE Day Open
bool cond4_spot = not na(spot_c) and not na(spot_pdl) and not na(spot_do) and (spot_c < spot_pdl) and (spot_c < spot_do)
bool cond4_ce   = not na(ce_c)   and not na(ce_pdl)   and not na(ce_do)   and (ce_c < ce_pdl)   and (ce_c < ce_do)
bool cond4_pe   = not na(pe_c)   and not na(pe_pdh)   and not na(pe_do)   and (pe_c > pe_pdh)   and (pe_c > pe_do)
bool cond4_met  = enable_cond4 and cond4_spot and cond4_ce and cond4_pe

// Signal Trigger Mode Filtering (First Breakout State-Change vs Every Bar)
bool sig1_raw = signal_trigger_mode == "First Breakout Only (State Change)" ? (cond1_met and not (bar_index > 0 and cond1_met[1])) : cond1_met
bool sig2_raw = signal_trigger_mode == "First Breakout Only (State Change)" ? (cond2_met and not (bar_index > 0 and cond2_met[1])) : cond2_met
bool sig3_raw = signal_trigger_mode == "First Breakout Only (State Change)" ? (cond3_met and not (bar_index > 0 and cond3_met[1])) : cond3_met
bool sig4_raw = signal_trigger_mode == "First Breakout Only (State Change)" ? (cond4_met and not (bar_index > 0 and cond4_met[1])) : cond4_met

// Candle Close Confirmation & Duplicate Prevention
bool is_confirmed_bar = not require_bar_close or barstate.isconfirmed

var int last_c1_bar = -1
var int last_c2_bar = -1
var int last_c3_bar = -1
var int last_c4_bar = -1

bool sig1 = sig1_raw and is_confirmed_bar and (last_c1_bar != bar_index)
bool sig2 = sig2_raw and is_confirmed_bar and (last_c2_bar != bar_index)
bool sig3 = sig3_raw and is_confirmed_bar and (last_c3_bar != bar_index)
bool sig4 = sig4_raw and is_confirmed_bar and (last_c4_bar != bar_index)

if sig1
    last_c1_bar := bar_index
if sig2
    last_c2_bar := bar_index
if sig3
    last_c3_bar := bar_index
if sig4
    last_c4_bar := bar_index

// ==========================================
// OPPOSITE OPTION CANDLES OVERLAY
// ==========================================

float opp_o = isCall ? pe_op_real : (isPut ? ce_op_real : na)
float opp_h = isCall ? pe_h       : (isPut ? ce_h       : na)
float opp_l = isCall ? pe_l       : (isPut ? ce_l       : na)
float opp_c = isCall ? pe_c       : (isPut ? ce_c       : na)

color opp_body = not na(opp_c) and not na(opp_o) ? (opp_c >= opp_o ? opp_bull_col : opp_bear_col) : na
color opp_wick = not na(opp_c) and not na(opp_o) ? (opp_c >= opp_o ? opp_bull_wick : opp_bear_wick) : na

plotcandle(show_opp_candles ? opp_o : na, show_opp_candles ? opp_h : na, show_opp_candles ? opp_l : na, show_opp_candles ? opp_c : na, title="Opposite Option Candle", color=opp_body, wickcolor=opp_wick, bordercolor=opp_body)

// ==========================================
// CUSTOMIZABLE SIGNAL LABELS
// ==========================================

f_get_label_style(string pos_str) =>
    pos_str == "Below Bar (Up Arrow)" ? label.style_label_up : label.style_label_down

f_get_label_size(string sz_str) =>
    switch sz_str
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

if sig1
    float y_pos = isPut ? (cond1_pos_str == "Below Bar (Up Arrow)" ? ce_l : ce_h) : (cond1_pos_str == "Below Bar (Up Arrow)" ? low : high)
    label.new(bar_index, y_pos, text=cond1_text, style=f_get_label_style(cond1_pos_str), color=cond1_col, textcolor=cond1_txt_col, size=f_get_label_size(label_size_str))

if sig2
    float y_pos = isCall ? (cond2_pos_str == "Above Bar (Down Arrow)" ? pe_h : pe_l) : (cond2_pos_str == "Above Bar (Down Arrow)" ? high : low)
    label.new(bar_index, y_pos, text=cond2_text, style=f_get_label_style(cond2_pos_str), color=cond2_col, textcolor=cond2_txt_col, size=f_get_label_size(label_size_str))

if sig3
    float y_pos = isPut ? (cond3_pos_str == "Below Bar (Up Arrow)" ? ce_l : ce_h) : (cond3_pos_str == "Below Bar (Up Arrow)" ? low : high)
    label.new(bar_index, y_pos, text=cond3_text, style=f_get_label_style(cond3_pos_str), color=cond3_col, textcolor=cond3_txt_col, size=f_get_label_size(label_size_str))

if sig4
    float y_pos = isCall ? (cond4_pos_str == "Above Bar (Down Arrow)" ? pe_h : pe_l) : (cond4_pos_str == "Above Bar (Down Arrow)" ? high : low)
    label.new(bar_index, y_pos, text=cond4_text, style=f_get_label_style(cond4_pos_str), color=cond4_col, textcolor=cond4_txt_col, size=f_get_label_size(label_size_str))

// ==========================================
// NATIVE ALERTS ENGINE
// ==========================================

alertcondition(sig1, title="Condition 1 (CE UP) Alert", message="CE UP Signal Triggered: Spot & ATM CE above ORB & Day Open, ATM PE below ORB & Day Open")
alertcondition(sig2, title="Condition 2 (PE UP) Alert", message="PE UP Signal Triggered: Spot & ATM CE below ORB & Day Open, ATM PE above ORB & Day Open")
alertcondition(sig3, title="Condition 3 (CE Over PDH) Alert", message="CE Over PDH Signal Triggered: Spot & ATM CE above PDH & Day Open, ATM PE below PDL & Day Open")
alertcondition(sig4, title="Condition 4 (PE Over PDH) Alert", message="PE Over PDH Signal Triggered: Spot & ATM PE above PDH & Day Open, Spot & ATM CE below PDL & Day Open")
alertcondition(sig1 or sig2 or sig3 or sig4, title="Any Condition Alert", message="Options Confluence Signal Triggered!")

if sig1
    alert("CE UP Signal Triggered on " + syminfo.ticker, alert.freq_once_per_bar_close)
if sig2
    alert("PE UP Signal Triggered on " + syminfo.ticker, alert.freq_once_per_bar_close)
if sig3
    alert("CE Over PDH Signal Triggered on " + syminfo.ticker, alert.freq_once_per_bar_close)
if sig4
    alert("PE Over PDH Signal Triggered on " + syminfo.ticker, alert.freq_once_per_bar_close)

// ==========================================
// ANALYTICS DASHBOARD TABLE
// ==========================================

f_get_table_pos(string pos_str) =>
    switch pos_str
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

var table dashTable = table.new(f_get_table_pos(show_dashboard_pos), 5, 5, bgcolor=color.black, border_width=1, border_color=color.gray, force_overlay=true)

if barstate.islast and show_dashboard
    float dayOpenATMStrike = day_open_atm_strike
    float currentATMStrike = not na(spot_c) and stepVal > 0 ? math.round(spot_c / stepVal) * stepVal : chartStrikePrice

    string do_strike_str = str.tostring(dayOpenATMStrike, "#")
    string cur_strike_str = str.tostring(currentATMStrike, "#")

    table.cell(dashTable, 0, 0, "Asset Level", bgcolor=#1565C0, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 0, "LTP / Day Open", bgcolor=#1565C0, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 2, 0, "ORB (High / Low)", bgcolor=#1565C0, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 3, 0, "PDH / PDL", bgcolor=#1565C0, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 4, 0, "Strike (Open / Live)", bgcolor=#1565C0, text_color=color.white, text_size=size.small)

    // Row 1: Spot
    string spot_ltp_do = str.tostring(spot_c, "#.1") + " / " + str.tostring(spot_do, "#.1")
    string spot_orb_str = str.tostring(spot_orb_h, "#.1") + " / " + str.tostring(spot_orb_l, "#.1")
    string spot_pd_str  = str.tostring(spot_pdh, "#.1") + " / " + str.tostring(spot_pdl, "#.1")
    table.cell(dashTable, 0, 1, "Spot", bgcolor=#37474F, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 1, spot_ltp_do, bgcolor=color.black, text_color=color.yellow, text_size=size.small)
    table.cell(dashTable, 2, 1, spot_orb_str, bgcolor=color.black, text_color=color.aqua, text_size=size.small)
    table.cell(dashTable, 3, 1, spot_pd_str, bgcolor=color.black, text_color=color.silver, text_size=size.small)
    table.cell(dashTable, 4, 1, do_strike_str + " / " + cur_strike_str, bgcolor=color.black, text_color=color.yellow, text_size=size.small)

    // Row 2: ATM CE
    string ce_ltp_do = str.tostring(ce_c, "#.1") + " / " + str.tostring(ce_do, "#.1")
    string ce_orb_str = str.tostring(ce_orb_h, "#.1") + " / " + str.tostring(ce_orb_l, "#.1")
    string ce_pd_str  = str.tostring(ce_pdh, "#.1") + " / " + str.tostring(ce_pdl, "#.1")
    table.cell(dashTable, 0, 2, "ATM CE (" + do_strike_str + ")", bgcolor=#37474F, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 2, ce_ltp_do, bgcolor=color.black, text_color=#00E676, text_size=size.small)
    table.cell(dashTable, 2, 2, ce_orb_str, bgcolor=color.black, text_color=color.aqua, text_size=size.small)
    table.cell(dashTable, 3, 2, ce_pd_str, bgcolor=color.black, text_color=color.silver, text_size=size.small)
    table.cell(dashTable, 4, 2, cond1_ce ? "CE > ORB" : (cond4_ce ? "CE < PDL" : "NEUTRAL"), bgcolor=color.black, text_color=#00E676, text_size=size.small)

    // Row 3: ATM PE
    string pe_ltp_do = str.tostring(pe_c, "#.1") + " / " + str.tostring(pe_do, "#.1")
    string pe_orb_str = str.tostring(pe_orb_h, "#.1") + " / " + str.tostring(pe_orb_l, "#.1")
    string pe_pd_str  = str.tostring(pe_pdh, "#.1") + " / " + str.tostring(pe_pdl, "#.1")
    table.cell(dashTable, 0, 3, "ATM PE (" + do_strike_str + ")", bgcolor=#37474F, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 3, pe_ltp_do, bgcolor=color.black, text_color=#FF5252, text_size=size.small)
    table.cell(dashTable, 2, 3, pe_orb_str, bgcolor=color.black, text_color=color.aqua, text_size=size.small)
    table.cell(dashTable, 3, 3, pe_pd_str, bgcolor=color.black, text_color=color.silver, text_size=size.small)
    table.cell(dashTable, 4, 3, cond2_pe ? "PE > ORB" : (cond3_pe ? "PE < PDL" : "NEUTRAL"), bgcolor=color.black, text_color=#FF5252, text_size=size.small)

    // Row 4: Confluence Summary
    string active_sig_text = sig1 ? cond1_text : (sig2 ? cond2_text : (sig3 ? cond3_text : (sig4 ? cond4_text : "NO SIGNAL")))
    color active_sig_col = sig1 ? cond1_col : (sig2 ? cond2_col : (sig3 ? cond3_col : (sig4 ? cond4_col : color.gray)))
    color active_sig_txt = sig1 ? cond1_txt_col : (sig2 ? cond2_txt_col : (sig3 ? cond3_txt_col : (sig4 ? cond4_txt_col : color.white)))
    table.cell(dashTable, 0, 4, "Active Confluence", bgcolor=#1565C0, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 4, active_sig_text, bgcolor=active_sig_col, text_color=active_sig_txt, text_size=size.small)
    table.cell(dashTable, 2, 4, orbChoiceInput == ORBTimeframe.m5 ? "5M ORB" : (orbChoiceInput == ORBTimeframe.m15 ? "15M ORB" : "30M ORB"), bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 3, 4, "Open Strike: " + do_strike_str, bgcolor=color.black, text_color=color.yellow, text_size=size.small)
    table.cell(dashTable, 4, 4, "Live ATM: " + cur_strike_str, bgcolor=color.black, text_color=color.aqua, text_size=size.small)
