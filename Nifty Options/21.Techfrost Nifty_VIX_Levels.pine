//@version=6
indicator("21.Techfrost Nifty_VIX_Levels", shorttitle="21.Techfrost VIX_Levels", overlay=true, max_labels_count=500, max_lines_count=500)

// =========================================================================
// INPUTS & USER SETTINGS
// =========================================================================
var string G_SYM    = "Symbol & Data Settings"
var string G_CALC   = "Volatility Formula Settings"
var string G_STYLE  = "Line Format & Style Settings"
var string G_DASH   = "Dashboard Table Settings"

// 1. Symbol Settings
use_chart_sym     = input.bool(true, "Use Current Chart Symbol for Calculation", group=G_SYM,
  tooltip="Enable to calculate levels automatically for ANY chart instrument (MCX Crudeoil, Nifty, Banknifty, Sensex, Stocks, Futures & Options).")
vix_ticker_input  = input.string("NSE:INDIAVIX", "VIX Ticker Symbol", group=G_SYM,
  tooltip="Ticker symbol for VIX (e.g. NSE:INDIAVIX). Defaults to 15.0 if unavailable.")
exchange_input    = input.string("NSE", "Exchange Prefix (if not using chart symbol)", group=G_SYM)
underlying_ticker = input.string("NIFTY", "Spot Ticker Symbol (if not using chart symbol)", group=G_SYM)

// 2. Calculation Settings
calc_mode = input.string("First 5 Minutes (VIX 5m & Spot 5m)", "Calculation Source Mode",
  options=["Previous Day (VIX Close & Spot High/Low)", "First 5 Minutes (VIX 5m & Spot 5m)", "First 30 Minutes (VIX 30m & Spot 30m)"], group=G_CALC,
  tooltip="Choose data source: 1) Prev Day VIX Close & Prev Day Spot High/Low, 2) First 5m VIX Close & First 5m Spot High/Low, 3) First 30m VIX & Spot.")

time_factor_val = input.float(24.0, "Formula Time Factor (Default 24)", group=G_CALC,
  tooltip="Time factor inside square root in formula: X = Spot * (VIX / 100)% * sqrt(TimeFactor).")
spot_calc_ref = input.string("Spot Close", "Spot Price Reference for X", 
  options=["Spot Close", "Spot Low", "Spot High", "Spot Open"], group=G_CALC,
  tooltip="Choose which price reference (Close, Low, High, Open of selected Mode) is used in X formula.")
sell_ref_mode = input.string("Spot High - Y", "Sell Level Formula Mode",
  options=["Spot High - Y", "Spot Low - Y", "Spot High + Y"], group=G_CALC,
  tooltip="Select formula for Sell Level calculation.")

// 3. Line Formatting & Style Settings
days_to_show        = input.int(5, "Number of Days to Plot (Default 5)", minval=1, maxval=30, group=G_STYLE,
  tooltip="Number of historical trading days to plot levels for.")
show_buy_sell_lines = input.bool(true, "Show Buy & Sell Level Lines", group=G_STYLE)
show_support_lines  = input.bool(true, "Show Support Lines (S1-S6)", group=G_STYLE)
show_resist_lines   = input.bool(true, "Show Resistance Lines (R1-R7)", group=G_STYLE)
show_median_lines   = input.bool(true, "Show Median (Midpoint) Lines", group=G_STYLE,
  tooltip="Bisects space between each adjacent level into equal halves (e.g. Buy/S1, S1/S2, Sell/R1, etc.)")

line_render_mode = input.string("Horizontal Lines (Projected to Right)", "Line Rendering Mode",
  options=["Standard Plots (Style Tab Customizable)", "Horizontal Lines (Projected to Right)"], group=G_STYLE)

// Colors
c_buy   = input.color(#00E676, "Buy Level Color", group=G_STYLE)
c_sell  = input.color(#FF5252, "Sell Level Color", group=G_STYLE)
c_sup   = input.color(#00B0FF, "Support Lines Color (S1-S6)", group=G_STYLE)
c_res   = input.color(#FF9100, "Resistance Lines Color (R1-R7)", group=G_STYLE)
c_med   = input.color(color.new(#E040FB, 20), "Median Lines Color", group=G_STYLE)

// Line Styles & Widths
line_pattern_str = input.string("Solid", "Main Line Pattern / Style", options=["Solid", "Dashed", "Dotted"], group=G_STYLE)
med_pattern_str  = input.string("Dashed", "Median Line Pattern / Style", options=["Solid", "Dashed", "Dotted"], group=G_STYLE)
line_width_val   = input.int(2, "Main Line Width", minval=1, maxval=4, group=G_STYLE)
med_width_val    = input.int(1, "Median Line Width", minval=1, maxval=4, group=G_STYLE)

// Direct evaluation for plot style to ensure input plot_style type
p_style     = line_pattern_str == "Dotted" ? plot.style_circles : plot.style_line
med_p_style = med_pattern_str == "Dotted" ? plot.style_circles : plot.style_line

f_get_line_pattern(string p_str) =>
    p_str == "Dashed" ? line.style_dashed : (p_str == "Dotted" ? line.style_dotted : line.style_solid)

// 4. Dashboard Table Settings
show_table   = input.bool(true, "Show Levels Summary Table", group=G_DASH)
table_pos    = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_DASH)
table_size_in = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal", "Large"], group=G_DASH)

// =========================================================================
// DATA RETRIEVAL (PREV DAY, FIRST 5M, FIRST 30M)
// =========================================================================
spot_sym = use_chart_sym ? syminfo.tickerid : (exchange_input + ":" + underlying_ticker)

// Mode 1: Previous Day VIX Close & Previous Day Spot Values
vix_pd_close = request.security(vix_ticker_input, "1D", close[1], lookahead=barmerge.lookahead_on)
[spot_pd_open, spot_pd_high, spot_pd_low, spot_pd_close] = request.security(spot_sym, "1D", [open[1], high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

// Mode 2: First 5 Mins VIX Close & First 5 Mins Spot Values of the Day
vix_5m_close = request.security(vix_ticker_input, "5", ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, close, 0), lookahead=barmerge.lookahead_on)
[spot_5m_open, spot_5m_high, spot_5m_low, spot_5m_close] = request.security(spot_sym, "5", [ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0), ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, high, 0), ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, low, 0), ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, close, 0)], lookahead=barmerge.lookahead_on)

// Mode 3: First 30 Mins VIX Close & First 30 Mins Spot Values of the Day
vix_30m_close = request.security(vix_ticker_input, "30", ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, close, 0), lookahead=barmerge.lookahead_on)
[spot_30m_open, spot_30m_high, spot_30m_low, spot_30m_close] = request.security(spot_sym, "30", [ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0), ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, high, 0), ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, low, 0), ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, close, 0)], lookahead=barmerge.lookahead_on)

// Select Reference Values based on chosen Calculation Mode
float vix_used       = calc_mode == "Previous Day (VIX Close & Spot High/Low)" ? vix_pd_close : (calc_mode == "First 30 Minutes (VIX 30m & Spot 30m)" ? vix_30m_close : vix_5m_close)
float vix_clean      = nz(vix_used, 15.0)
if vix_clean <= 0
    vix_clean := 15.0

float spot_open_used = calc_mode == "Previous Day (VIX Close & Spot High/Low)" ? spot_pd_open : (calc_mode == "First 30 Minutes (VIX 30m & Spot 30m)" ? spot_30m_open : spot_5m_open)
float spot_high_used = calc_mode == "Previous Day (VIX Close & Spot High/Low)" ? spot_pd_high : (calc_mode == "First 30 Minutes (VIX 30m & Spot 30m)" ? spot_30m_high : spot_5m_high)
float spot_low_used  = calc_mode == "Previous Day (VIX Close & Spot High/Low)" ? spot_pd_low  : (calc_mode == "First 30 Minutes (VIX 30m & Spot 30m)" ? spot_30m_low  : spot_5m_low)
float spot_close_used= calc_mode == "Previous Day (VIX Close & Spot High/Low)" ? spot_pd_close: (calc_mode == "First 30 Minutes (VIX 30m & Spot 30m)" ? spot_30m_close: spot_5m_close)

// =========================================================================
// FORMULA CALCULATIONS (X, Y, BUY, SELL, S1-S6, R1-R7, MEDIAN LINES)
// =========================================================================
// Determine Spot Reference Price for X formula
float ref_price = spot_close_used
if spot_calc_ref == "Spot Low"
    ref_price := spot_low_used
else if spot_calc_ref == "Spot High"
    ref_price := spot_high_used
else if spot_calc_ref == "Spot Open"
    ref_price := spot_open_used

// X = SpotClose * (VIX_Close / 100.0)% * sqrt(TimeFactor)
float X_val = ref_price * (vix_clean / 10000.0) * math.sqrt(time_factor_val)
float Y_val = X_val / 4.0

// Buy & Sell Level Calculations
float buy_level = spot_low_used + Y_val
float sell_level = spot_high_used - Y_val
if sell_ref_mode == "Spot Low - Y"
    sell_level := spot_low_used - Y_val
else if sell_ref_mode == "Spot High + Y"
    sell_level := spot_high_used + Y_val

// Support Levels (S1 to S6)
float s1_val = buy_level + Y_val
float s2_val = s1_val + Y_val
float s3_val = s2_val + Y_val
float s4_val = s3_val + Y_val
float s5_val = s4_val + Y_val
float s6_val = s5_val + Y_val

// Resistance Levels (R1 to R7)
float r1_val = sell_level - Y_val
float r2_val = r1_val - Y_val
float r3_val = r2_val - Y_val
float r4_val = r3_val - Y_val
float r5_val = r4_val - Y_val
float r6_val = r5_val - Y_val
float r7_val = r6_val - Y_val

// Median (Midpoint) Levels between Adjacent Lines
float m_sell_buy = (sell_level + buy_level) / 2.0

float m_buy_s1 = (buy_level + s1_val) / 2.0
float m_s1_s2  = (s1_val + s2_val) / 2.0
float m_s2_s3  = (s2_val + s3_val) / 2.0
float m_s3_s4  = (s3_val + s4_val) / 2.0
float m_s4_s5  = (s4_val + s5_val) / 2.0
float m_s5_s6  = (s5_val + s6_val) / 2.0

float m_sell_r1 = (sell_level + r1_val) / 2.0
float m_r1_r2   = (r1_val + r2_val) / 2.0
float m_r2_r3   = (r2_val + r3_val) / 2.0
float m_r3_r4   = (r3_val + r4_val) / 2.0
float m_r4_r5   = (r4_val + r5_val) / 2.0
float m_r5_r6   = (r5_val + r6_val) / 2.0
float m_r6_r7   = (r6_val + r7_val) / 2.0

// =========================================================================
// 5-DAY TRADING SESSION WINDOW TRACKER
// =========================================================================
is_new_day = ta.change(time("D")) != 0

var int[] session_start_times = array.new_int(0)
if is_new_day or bar_index == 0
    if array.size(session_start_times) == 0 or time != array.get(session_start_times, array.size(session_start_times) - 1)
        array.push(session_start_times, time)
        if array.size(session_start_times) > 100
            array.shift(session_start_times)

int cutoff_time = 0
int total_sessions = array.size(session_start_times)
if total_sessions >= days_to_show
    cutoff_time := array.get(session_start_times, total_sessions - days_to_show)
else if total_sessions > 0
    cutoff_time := array.get(session_start_times, 0)

bool is_in_plot_window = time >= cutoff_time

float buy_plot  = is_in_plot_window and show_buy_sell_lines ? buy_level : na
float sell_plot = is_in_plot_window and show_buy_sell_lines ? sell_level : na

float s1_plot = is_in_plot_window and show_support_lines ? s1_val : na
float s2_plot = is_in_plot_window and show_support_lines ? s2_val : na
float s3_plot = is_in_plot_window and show_support_lines ? s3_val : na
float s4_plot = is_in_plot_window and show_support_lines ? s4_val : na
float s5_plot = is_in_plot_window and show_support_lines ? s5_val : na
float s6_plot = is_in_plot_window and show_support_lines ? s6_val : na

float r1_plot = is_in_plot_window and show_resist_lines ? r1_val : na
float r2_plot = is_in_plot_window and show_resist_lines ? r2_val : na
float r3_plot = is_in_plot_window and show_resist_lines ? r3_val : na
float r4_plot = is_in_plot_window and show_resist_lines ? r4_val : na
float r5_plot = is_in_plot_window and show_resist_lines ? r5_val : na
float r6_plot = is_in_plot_window and show_resist_lines ? r6_val : na
float r7_plot = is_in_plot_window and show_resist_lines ? r7_val : na

float m_sb_plot  = is_in_plot_window and show_median_lines ? m_sell_buy : na
float m_bs1_plot = is_in_plot_window and show_median_lines and show_support_lines ? m_buy_s1 : na
float m_s12_plot = is_in_plot_window and show_median_lines and show_support_lines ? m_s1_s2 : na
float m_s23_plot = is_in_plot_window and show_median_lines and show_support_lines ? m_s2_s3 : na
float m_s34_plot = is_in_plot_window and show_median_lines and show_support_lines ? m_s3_s4 : na
float m_s45_plot = is_in_plot_window and show_median_lines and show_support_lines ? m_s4_s5 : na
float m_s56_plot = is_in_plot_window and show_median_lines and show_support_lines ? m_s5_s6 : na

float m_sr1_plot = is_in_plot_window and show_median_lines and show_resist_lines ? m_sell_r1 : na
float m_r12_plot = is_in_plot_window and show_median_lines and show_resist_lines ? m_r1_r2 : na
float m_r23_plot = is_in_plot_window and show_median_lines and show_resist_lines ? m_r2_r3 : na
float m_r34_plot = is_in_plot_window and show_median_lines and show_resist_lines ? m_r3_r4 : na
float m_r45_plot = is_in_plot_window and show_median_lines and show_resist_lines ? m_r4_r5 : na
float m_r56_plot = is_in_plot_window and show_median_lines and show_resist_lines ? m_r5_r6 : na
float m_r67_plot = is_in_plot_window and show_median_lines and show_resist_lines ? m_r6_r7 : na

if is_new_day
    buy_plot := na, sell_plot := na
    s1_plot := na, s2_plot := na, s3_plot := na, s4_plot := na, s5_plot := na, s6_plot := na
    r1_plot := na, r2_plot := na, r3_plot := na, r4_plot := na, r5_plot := na, r6_plot := na, r7_plot := na
    m_sb_plot := na, m_bs1_plot := na, m_s12_plot := na, m_s23_plot := na, m_s34_plot := na, m_s45_plot := na, m_s56_plot := na
    m_sr1_plot := na, m_r12_plot := na, m_r23_plot := na, m_r34_plot := na, m_r45_plot := na, m_r56_plot := na, m_r67_plot := na

// =========================================================================
// PLOTS AND RENDERINGS (STANDARD PLOTS)
// =========================================================================
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? buy_plot : na, title="Buy Level", color=c_buy, linewidth=line_width_val, style=p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? sell_plot : na, title="Sell Level", color=c_sell, linewidth=line_width_val, style=p_style)

plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? s1_plot : na, title="Support 1 (S1)", color=c_sup, linewidth=line_width_val, style=p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? s2_plot : na, title="Support 2 (S2)", color=c_sup, linewidth=line_width_val, style=p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? s3_plot : na, title="Support 3 (S3)", color=c_sup, linewidth=line_width_val, style=p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? s4_plot : na, title="Support 4 (S4)", color=c_sup, linewidth=line_width_val, style=p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? s5_plot : na, title="Support 5 (S5)", color=c_sup, linewidth=line_width_val, style=p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? s6_plot : na, title="Support 6 (S6)", color=c_sup, linewidth=line_width_val, style=p_style)

plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? r1_plot : na, title="Resistance 1 (R1)", color=c_res, linewidth=line_width_val, style=p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? r2_plot : na, title="Resistance 2 (R2)", color=c_res, linewidth=line_width_val, style=p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? r3_plot : na, title="Resistance 3 (R3)", color=c_res, linewidth=line_width_val, style=p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? r4_plot : na, title="Resistance 4 (R4)", color=c_res, linewidth=line_width_val, style=p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? r5_plot : na, title="Resistance 5 (R5)", color=c_res, linewidth=line_width_val, style=p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? r6_plot : na, title="Resistance 6 (R6)", color=c_res, linewidth=line_width_val, style=p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? r7_plot : na, title="Resistance 7 (R7)", color=c_res, linewidth=line_width_val, style=p_style)

// Median Line Plots
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_sb_plot : na, title="Median (Sell/Buy)", color=c_med, linewidth=med_width_val, style=med_p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_bs1_plot : na, title="Median (Buy/S1)", color=c_med, linewidth=med_width_val, style=med_p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_s12_plot : na, title="Median (S1/S2)", color=c_med, linewidth=med_width_val, style=med_p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_s23_plot : na, title="Median (S2/S3)", color=c_med, linewidth=med_width_val, style=med_p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_s34_plot : na, title="Median (S3/S4)", color=c_med, linewidth=med_width_val, style=med_p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_s45_plot : na, title="Median (S4/S5)", color=c_med, linewidth=med_width_val, style=med_p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_s56_plot : na, title="Median (S5/S6)", color=c_med, linewidth=med_width_val, style=med_p_style)

plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_sr1_plot : na, title="Median (Sell/R1)", color=c_med, linewidth=med_width_val, style=med_p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_r12_plot : na, title="Median (R1/R2)", color=c_med, linewidth=med_width_val, style=med_p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_r23_plot : na, title="Median (R2/R3)", color=c_med, linewidth=med_width_val, style=med_p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_r34_plot : na, title="Median (R3/R4)", color=c_med, linewidth=med_width_val, style=med_p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_r45_plot : na, title="Median (R4/R5)", color=c_med, linewidth=med_width_val, style=med_p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_r56_plot : na, title="Median (R5/R6)", color=c_med, linewidth=med_width_val, style=med_p_style)
plot(line_render_mode == "Standard Plots (Style Tab Customizable)" ? m_r67_plot : na, title="Median (R6/R7)", color=c_med, linewidth=med_width_val, style=med_p_style)

// =========================================================================
// PROJECTED HORIZONTAL LINES ENGINE (5-DAY HISTORY POOL)
// =========================================================================
var line[] line_history = array.new_line(0)
var int[] line_time_history = array.new_int(0)

f_add_line(int x1, float y, int x2, color c, int w, string s, int day_t) =>
    line ln = line.new(x1, y, x2, y, color=c, width=w, style=s)
    array.push(line_history, ln)
    array.push(line_time_history, day_t)
    ln

prj_line_style = f_get_line_pattern(line_pattern_str)
med_prj_style  = f_get_line_pattern(med_pattern_str)

if line_render_mode == "Horizontal Lines (Projected to Right)"
    int target_x2 = barstate.islast ? bar_index + 150 : bar_index
    
    if is_new_day
        // Finalize end point x2 for all previous lines
        if array.size(line_history) > 0
            for i = 0 to array.size(line_history) - 1
                line ln_item = array.get(line_history, i)
                if line.get_x2(ln_item) > bar_index - 1
                    line.set_x2(ln_item, bar_index - 1)

        // Prune lines older than cutoff_time
        if array.size(line_history) > 0
            for i = array.size(line_history) - 1 to 0 by 1
                int l_time = array.get(line_time_history, i)
                if l_time < cutoff_time
                    line.delete(array.get(line_history, i))
                    array.remove(line_history, i)
                    array.remove(line_time_history, i)

        if show_buy_sell_lines
            f_add_line(bar_index, buy_level, target_x2, c_buy, line_width_val, prj_line_style, time)
            f_add_line(bar_index, sell_level, target_x2, c_sell, line_width_val, prj_line_style, time)
        if show_support_lines
            f_add_line(bar_index, s1_val, target_x2, c_sup, line_width_val, prj_line_style, time)
            f_add_line(bar_index, s2_val, target_x2, c_sup, line_width_val, prj_line_style, time)
            f_add_line(bar_index, s3_val, target_x2, c_sup, line_width_val, prj_line_style, time)
            f_add_line(bar_index, s4_val, target_x2, c_sup, line_width_val, prj_line_style, time)
            f_add_line(bar_index, s5_val, target_x2, c_sup, line_width_val, prj_line_style, time)
            f_add_line(bar_index, s6_val, target_x2, c_sup, line_width_val, prj_line_style, time)
        if show_resist_lines
            f_add_line(bar_index, r1_val, target_x2, c_res, line_width_val, prj_line_style, time)
            f_add_line(bar_index, r2_val, target_x2, c_res, line_width_val, prj_line_style, time)
            f_add_line(bar_index, r3_val, target_x2, c_res, line_width_val, prj_line_style, time)
            f_add_line(bar_index, r4_val, target_x2, c_res, line_width_val, prj_line_style, time)
            f_add_line(bar_index, r5_val, target_x2, c_res, line_width_val, prj_line_style, time)
            f_add_line(bar_index, r6_val, target_x2, c_res, line_width_val, prj_line_style, time)
            f_add_line(bar_index, r7_val, target_x2, c_res, line_width_val, prj_line_style, time)
        if show_median_lines
            f_add_line(bar_index, m_sell_buy, target_x2, c_med, med_width_val, med_prj_style, time)
            if show_support_lines
                f_add_line(bar_index, m_buy_s1, target_x2, c_med, med_width_val, med_prj_style, time)
                f_add_line(bar_index, m_s1_s2, target_x2, c_med, med_width_val, med_prj_style, time)
                f_add_line(bar_index, m_s2_s3, target_x2, c_med, med_width_val, med_prj_style, time)
                f_add_line(bar_index, m_s3_s4, target_x2, c_med, med_width_val, med_prj_style, time)
                f_add_line(bar_index, m_s4_s5, target_x2, c_med, med_width_val, med_prj_style, time)
                f_add_line(bar_index, m_s5_s6, target_x2, c_med, med_width_val, med_prj_style, time)
            if show_resist_lines
                f_add_line(bar_index, m_sell_r1, target_x2, c_med, med_width_val, med_prj_style, time)
                f_add_line(bar_index, m_r1_r2, target_x2, c_med, med_width_val, med_prj_style, time)
                f_add_line(bar_index, m_r2_r3, target_x2, c_med, med_width_val, med_prj_style, time)
                f_add_line(bar_index, m_r3_r4, target_x2, c_med, med_width_val, med_prj_style, time)
                f_add_line(bar_index, m_r4_r5, target_x2, c_med, med_width_val, med_prj_style, time)
                f_add_line(bar_index, m_r5_r6, target_x2, c_med, med_width_val, med_prj_style, time)
                f_add_line(bar_index, m_r6_r7, target_x2, c_med, med_width_val, med_prj_style, time)
    else
        // Extend today's active lines to right
        if array.size(line_history) > 0
            for i = 0 to array.size(line_history) - 1
                line ln_item = array.get(line_history, i)
                int l_time = array.get(line_time_history, i)
                if l_time >= time - 86400000 // Only extend active lines of the current day
                    line.set_x2(ln_item, target_x2)

// =========================================================================
// REAL-TIME LABELS AT RIGHT EDGE
// =========================================================================
var label lbl_b = na, var label lbl_s = na
var label lbl_s1 = na, var label lbl_s2 = na, var label lbl_s3 = na, var label lbl_s4 = na, var label lbl_s5 = na, var label lbl_s6 = na
var label lbl_r1 = na, var label lbl_r2 = na, var label lbl_r3 = na, var label lbl_r4 = na, var label lbl_r5 = na, var label lbl_r6 = na, var label lbl_r7 = na

var label lbl_m_sb = na
var label lbl_m_bs1 = na, var label lbl_m_s12 = na, var label lbl_m_s23 = na, var label lbl_m_s34 = na, var label lbl_m_s45 = na, var label lbl_m_s56 = na
var label lbl_m_sr1 = na, var label lbl_m_r12 = na, var label lbl_m_r23 = na, var label lbl_m_r34 = na, var label lbl_m_r45 = na, var label lbl_m_r56 = na, var label lbl_m_r67 = na

if barstate.islast
    int lbl_x = bar_index + 5
    if show_buy_sell_lines
        label.delete(lbl_b), label.delete(lbl_s)
        lbl_b := label.new(lbl_x, buy_level, "Buy Level: " + str.tostring(buy_level, "#.##"), color=c_buy, textcolor=color.black, style=label.style_label_left, size=size.small)
        lbl_s := label.new(lbl_x, sell_level, "Sell Level: " + str.tostring(sell_level, "#.##"), color=c_sell, textcolor=color.white, style=label.style_label_left, size=size.small)
    
    if show_support_lines
        label.delete(lbl_s1), label.delete(lbl_s2), label.delete(lbl_s3), label.delete(lbl_s4), label.delete(lbl_s5), label.delete(lbl_s6)
        lbl_s1 := label.new(lbl_x, s1_val, "S1: " + str.tostring(s1_val, "#.##"), color=c_sup, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_s2 := label.new(lbl_x, s2_val, "S2: " + str.tostring(s2_val, "#.##"), color=c_sup, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_s3 := label.new(lbl_x, s3_val, "S3: " + str.tostring(s3_val, "#.##"), color=c_sup, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_s4 := label.new(lbl_x, s4_val, "S4: " + str.tostring(s4_val, "#.##"), color=c_sup, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_s5 := label.new(lbl_x, s5_val, "S5: " + str.tostring(s5_val, "#.##"), color=c_sup, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_s6 := label.new(lbl_x, s6_val, "S6: " + str.tostring(s6_val, "#.##"), color=c_sup, textcolor=color.white, style=label.style_label_left, size=size.small)
        
    if show_resist_lines
        label.delete(lbl_r1), label.delete(lbl_r2), label.delete(lbl_r3), label.delete(lbl_r4), label.delete(lbl_r5), label.delete(lbl_r6), label.delete(lbl_r7)
        lbl_r1 := label.new(lbl_x, r1_val, "R1: " + str.tostring(r1_val, "#.##"), color=c_res, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_r2 := label.new(lbl_x, r2_val, "R2: " + str.tostring(r2_val, "#.##"), color=c_res, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_r3 := label.new(lbl_x, r3_val, "R3: " + str.tostring(r3_val, "#.##"), color=c_res, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_r4 := label.new(lbl_x, r4_val, "R4: " + str.tostring(r4_val, "#.##"), color=c_res, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_r5 := label.new(lbl_x, r5_val, "R5: " + str.tostring(r5_val, "#.##"), color=c_res, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_r6 := label.new(lbl_x, r6_val, "R6: " + str.tostring(r6_val, "#.##"), color=c_res, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_r7 := label.new(lbl_x, r7_val, "R7: " + str.tostring(r7_val, "#.##"), color=c_res, textcolor=color.white, style=label.style_label_left, size=size.small)

    if show_median_lines
        label.delete(lbl_m_sb)
        label.delete(lbl_m_bs1), label.delete(lbl_m_s12), label.delete(lbl_m_s23), label.delete(lbl_m_s34), label.delete(lbl_m_s45), label.delete(lbl_m_s56)
        label.delete(lbl_m_sr1), label.delete(lbl_m_r12), label.delete(lbl_m_r23), label.delete(lbl_m_r34), label.delete(lbl_m_r45), label.delete(lbl_m_r56), label.delete(lbl_m_r67)

        lbl_m_sb := label.new(lbl_x, m_sell_buy, "M (Sell/Buy): " + str.tostring(m_sell_buy, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
        if show_support_lines
            lbl_m_bs1 := label.new(lbl_x, m_buy_s1, "M (Buy/S1): " + str.tostring(m_buy_s1, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
            lbl_m_s12 := label.new(lbl_x, m_s1_s2, "M (S1/S2): " + str.tostring(m_s1_s2, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
            lbl_m_s23 := label.new(lbl_x, m_s2_s3, "M (S2/S3): " + str.tostring(m_s2_s3, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
            lbl_m_s34 := label.new(lbl_x, m_s3_s4, "M (S3/S4): " + str.tostring(m_s3_s4, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
            lbl_m_s45 := label.new(lbl_x, m_s4_s5, "M (S4/S5): " + str.tostring(m_s4_s5, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
            lbl_m_s56 := label.new(lbl_x, m_s5_s6, "M (S5/S6): " + str.tostring(m_s5_s6, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
        if show_resist_lines
            lbl_m_sr1 := label.new(lbl_x, m_sell_r1, "M (Sell/R1): " + str.tostring(m_sell_r1, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
            lbl_m_r12 := label.new(lbl_x, m_r1_r2, "M (R1/R2): " + str.tostring(m_r1_r2, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
            lbl_m_r23 := label.new(lbl_x, m_r2_r3, "M (R2/R3): " + str.tostring(m_r2_r3, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
            lbl_m_r34 := label.new(lbl_x, m_r3_r4, "M (R3/R4): " + str.tostring(m_r3_r4, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
            lbl_m_r45 := label.new(lbl_x, m_r4_r5, "M (R4/R5): " + str.tostring(m_r4_r5, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
            lbl_m_r56 := label.new(lbl_x, m_r5_r6, "M (R5/R6): " + str.tostring(m_r5_r6, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)
            lbl_m_r67 := label.new(lbl_x, m_r6_r7, "M (R6/R7): " + str.tostring(m_r6_r7, "#.##"), color=c_med, textcolor=color.white, style=label.style_label_left, size=size.tiny)

// =========================================================================
// SUMMARY DASHBOARD TABLE RENDERING
// =========================================================================
var string t_pos = position.top_right
if table_pos == "Top Left"
    t_pos := position.top_left
else if table_pos == "Bottom Right"
    t_pos := position.bottom_right
else if table_pos == "Bottom Left"
    t_pos := position.bottom_left

var string t_sz = size.small
if table_size_in == "Tiny"
    t_sz := size.tiny
else if table_size_in == "Normal"
    t_sz := size.normal
else if table_size_in == "Large"
    t_sz := size.large

var table summary_tbl = table.new(t_pos, 2, 25, bgcolor=color.new(color.black, 30), border_color=#2B2E3A, border_width=1)

if show_table and barstate.islast
    table.clear(summary_tbl, 0, 0, 1, 24)
    
    table.cell(summary_tbl, 0, 0, "VIX Volatility Levels Summary", bgcolor=#1E222D, text_color=color.yellow, text_size=t_sz, text_halign=text.align_center)
    table.merge_cells(summary_tbl, 0, 0, 1, 0)
    
    table.cell(summary_tbl, 0, 1, "Metric / Parameter", bgcolor=#1E222D, text_color=color.white, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 1, "Value", bgcolor=#1E222D, text_color=color.white, text_size=t_sz, text_halign=text.align_center)
    
    table.cell(summary_tbl, 0, 2, "Instrument Symbol", text_color=color.white, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 2, spot_sym, text_color=color.yellow, text_size=t_sz, text_halign=text.align_center)

    table.cell(summary_tbl, 0, 3, "Calculation Mode", text_color=color.white, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 3, calc_mode, text_color=color.aqua, text_size=t_sz, text_halign=text.align_center)

    table.cell(summary_tbl, 0, 4, "Spot Price Ref Used for X", text_color=color.white, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 4, spot_calc_ref + " (" + str.tostring(ref_price, "#.##") + ")", text_color=color.yellow, text_size=t_sz, text_halign=text.align_center)

    table.cell(summary_tbl, 0, 5, "VIX Value Used", text_color=color.white, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 5, str.tostring(vix_clean, "#.##"), text_color=color.yellow, text_size=t_sz, text_halign=text.align_center)

    float vix_pct_val = vix_clean / 10000.0
    float sqrt_tf_val = math.sqrt(time_factor_val)
    
    table.cell(summary_tbl, 0, 6, "VIX % Factor [(VIX/100)%]", text_color=color.white, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 6, str.tostring(vix_pct_val, "#.######"), text_color=color.white, text_size=t_sz, text_halign=text.align_center)

    table.cell(summary_tbl, 0, 7, "Sqrt(TimeFactor) [sqrt(" + str.tostring(time_factor_val, "#") + ")]", text_color=color.white, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 7, str.tostring(sqrt_tf_val, "#.##"), text_color=color.white, text_size=t_sz, text_halign=text.align_center)
    
    table.cell(summary_tbl, 0, 8, "Formula Multiplier X", bgcolor=#1A237E, text_color=color.yellow, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 8, str.tostring(X_val, "#.##"), bgcolor=#1A237E, text_color=color.yellow, text_size=t_sz, text_halign=text.align_center)
    
    table.cell(summary_tbl, 0, 9, "Formula Step Y (X/4)", bgcolor=#1A237E, text_color=color.yellow, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 9, str.tostring(Y_val, "#.##"), bgcolor=#1A237E, text_color=color.yellow, text_size=t_sz, text_halign=text.align_center)
    
    table.cell(summary_tbl, 0, 10, "Buy Level (Low + Y)", bgcolor=#131722, text_color=#00E676, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 10, str.tostring(buy_level, "#.##"), bgcolor=#131722, text_color=#00E676, text_size=t_sz, text_halign=text.align_center)
    
    table.cell(summary_tbl, 0, 11, "Sell Level (High - Y)", bgcolor=#1C2030, text_color=#FF5252, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 11, str.tostring(sell_level, "#.##"), bgcolor=#1C2030, text_color=#FF5252, text_size=t_sz, text_halign=text.align_center)
    
    table.cell(summary_tbl, 0, 12, "Support 1 (Buy + Y)", text_color=#00B0FF, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 12, str.tostring(s1_val, "#.##"), text_color=#00B0FF, text_size=t_sz, text_halign=text.align_center)
    
    table.cell(summary_tbl, 0, 13, "Support 2 (S1 + Y)", text_color=#00B0FF, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 13, str.tostring(s2_val, "#.##"), text_color=#00B0FF, text_size=t_sz, text_halign=text.align_center)
    
    table.cell(summary_tbl, 0, 14, "Support 3 (S2 + Y)", text_color=#00B0FF, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 14, str.tostring(s3_val, "#.##"), text_color=#00B0FF, text_size=t_sz, text_halign=text.align_center)
    
    table.cell(summary_tbl, 0, 15, "Resistance 1 (Sell - Y)", text_color=#FF9100, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 15, str.tostring(r1_val, "#.##"), text_color=#FF9100, text_size=t_sz, text_halign=text.align_center)
    
    table.cell(summary_tbl, 0, 16, "Resistance 2 (R1 - Y)", text_color=#FF9100, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 16, str.tostring(r2_val, "#.##"), text_color=#FF9100, text_size=t_sz, text_halign=text.align_center)
    
    table.cell(summary_tbl, 0, 17, "Resistance 3 (R2 - Y)", text_color=#FF9100, text_size=t_sz, text_halign=text.align_left)
    table.cell(summary_tbl, 1, 17, str.tostring(r3_val, "#.##"), text_color=#FF9100, text_size=t_sz, text_halign=text.align_center)
