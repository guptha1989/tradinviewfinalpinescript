//@version=6
indicator("16. Techfrost Combined Intrinsic Time Value, BEP & Multi-Strike ATM Analytics", shorttitle="16.Techfrost Alert Engine", overlay=true, precision=2)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum UnderlyingAsset
    auto      = "Auto-Detect"
    nifty     = "NIFTY"
    banknifty = "BANKNIFTY"
    crudeoil  = "CRUDEOIL"
    gold      = "GOLD"
    stock     = "Stock (Equity)"

enum OptionType
    auto = "Auto-Detect"
    ce   = "Call (CE)"
    pe   = "Put (PE)"

enum StepOverrideChoice
    auto    = "Auto"
    step1   = "1"
    step2_5 = "2.5"
    step5   = "5"
    step10  = "10"
    step20  = "20"
    step25  = "25"
    step50  = "50"
    step100 = "100"
    step200 = "200"
    step500 = "500"

// --- Instrument Settings ---
underlyingInput    = input.enum(UnderlyingAsset.auto, "Underlying Asset", group="Instrument Settings")
optionTypeInput    = input.enum(OptionType.auto, "Option Type", group="Instrument Settings")
manualStrikeInput  = input.int(0, "Manual Strike Selection (0 = Auto)", minval=0, group="Instrument Settings",
  tooltip="Enter strike price manually (e.g. 24000). Leave at 0 to auto-detect from chart symbol.")
spotTickerOverride = input.symbol("", "Spot Symbol Override (e.g. NSE:RELIANCE)", group="Instrument Settings")
strikeOverride     = input.float(0.0, "Strike Price Override", minval=0.0, group="Instrument Settings")
strikeStepInput    = input.enum(StepOverrideChoice.auto, "Strike Step Override", group="Instrument Settings",
  tooltip="Set to Auto for auto-detection based on underlying stock/index (Auto-detects 1, 2.5, 5, 10, 20, 50, 100).")

// --- Offset Points & Basket Settings ---
offsetChoiceInput  = input.string("100 Points", "Strike Offset Points Dropdown", options=["5 Points", "10 Points", "15 Points", "20 Points", "25 Points", "40 Points", "50 Points", "100 Points", "150 Points", "200 Points"], group="Calculation Settings",
  tooltip="Offset points used to determine ITM / OTM strike levels.")
customOffsetInput  = input.float(0.0, "Custom Offset Points Override (0 = Use Dropdown)", minval=0.0, group="Calculation Settings",
  tooltip="Set custom offset points (e.g. 50, 100, 150). If > 0, overrides dropdown selection.")
numStrikesInput    = input.int(4, "Number of ITM/OTM Strikes Each Side for Basket", minval=1, maxval=4, group="Calculation Settings",
  tooltip="1 = 3 Strikes (1 ITM + ATM + 1 OTM), 2 = 5 Strikes (2 ITM + ATM + 2 OTM), 3 = 7 Strikes, 4 = 9 Strikes.")

// ==========================================
// TICKER PARSING & AUTO-DETECTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

// ----- Detect underlying -----
UnderlyingAsset actualUnderlying = na
if underlyingInput == UnderlyingAsset.auto
    if str.contains(cleanTicker, "BANKNIFTY")
        actualUnderlying := UnderlyingAsset.banknifty
    else if str.contains(cleanTicker, "NIFTY")
        actualUnderlying := UnderlyingAsset.nifty
    else if str.contains(cleanTicker, "CRUDEOIL")
        actualUnderlying := UnderlyingAsset.crudeoil
    else if str.contains(cleanTicker, "GOLD") and not str.contains(cleanTicker, "GOLDM") and not str.contains(cleanTicker, "GOLDPETAL")
        actualUnderlying := UnderlyingAsset.gold
    else if str.contains(cleanTicker, "GOLDM")
        actualUnderlying := UnderlyingAsset.gold
    else
        actualUnderlying := UnderlyingAsset.stock
else
    actualUnderlying := underlyingInput

// ----- Detect option type -----
bool isCall = false
bool isPut  = false

if optionTypeInput == OptionType.ce
    isCall := true
else if optionTypeInput == OptionType.pe
    isPut := true
else
    if str.contains(cleanTicker, "CE")
        isCall := true
    else if str.contains(cleanTicker, "PE")
        isPut := true
    else if str.match(cleanTicker, "C\\d+$") != ""
        isCall := true
    else if str.match(cleanTicker, "P\\d+$") != ""
        isPut := true

// ----- Strike extraction from chart symbol -----
float detectedStrike = na
string tickerWithoutCEPE = ""

int tickerLen = str.length(cleanTicker)
if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, tickerLen - 2)

string matchC = str.match(cleanTicker, "C\\d+$")
string matchP = str.match(cleanTicker, "P\\d+$")

if matchC != ""
    detectedStrike := str.tonumber(str.substring(matchC, 1))
else if matchP != ""
    detectedStrike := str.tonumber(str.substring(matchP, 1))
else if tickerWithoutCEPE != ""
    string strikeDigits = str.match(tickerWithoutCEPE, "\\d+$")
    detectedStrike := str.tonumber(strikeDigits)

float chartStrikePrice = strikeOverride > 0.0 ? strikeOverride : (manualStrikeInput > 0 ? float(manualStrikeInput) : detectedStrike)

// ==========================================
// SPOT TICKER RESOLUTION & OFFSET CALCULATION
// ==========================================

string spotTicker = ""
if str.length(spotTickerOverride) > 0
    spotTicker := spotTickerOverride
else
    switch actualUnderlying
        UnderlyingAsset.banknifty => spotTicker := "NSE:BANKNIFTY"
        UnderlyingAsset.nifty     => spotTicker := "NSE:NIFTY"
        UnderlyingAsset.crudeoil  => spotTicker := "MCX:CRUDEOIL1!"
        UnderlyingAsset.gold      => spotTicker := "MCX:GOLD1!"
        UnderlyingAsset.stock     =>
            string rootGuess = str.match(cleanTicker, "^[A-Z&]+")
            if rootGuess != ""
                spotTicker := syminfo.prefix + ":" + rootGuess
            else
                spotTicker := syminfo.prefix + ":" + cleanTicker

// Fetch Day Open Spot Price for the underlying
float spotDayOpen = request.security(spotTicker, "D", open, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Offset points calculation
float offsetPts = 100.0
if customOffsetInput > 0.0
    offsetPts := customOffsetInput
else
    switch offsetChoiceInput
        "5 Points"   => offsetPts := 5.0
        "10 Points"  => offsetPts := 10.0
        "15 Points"  => offsetPts := 15.0
        "20 Points"  => offsetPts := 20.0
        "25 Points"  => offsetPts := 25.0
        "40 Points"  => offsetPts := 40.0
        "50 Points"  => offsetPts := 50.0
        "100 Points" => offsetPts := 100.0
        "150 Points" => offsetPts := 150.0
        "200 Points" => offsetPts := 200.0
        => offsetPts := 100.0

// Dynamic Step Size
f_auto_detect_step(float ref_p) =>
    float s_res = 50.0
    if na(ref_p) or ref_p <= 0
        s_res := 50.0
    else if ref_p < 100
        s_res := 1.0
    else if ref_p < 250
        s_res := 2.5
    else if ref_p < 500
        s_res := 5.0
    else if ref_p < 1200
        s_res := 10.0
    else if ref_p < 2500
        s_res := 20.0
    else
        s_res := 50.0
    s_res

float stepVal = 50.0
switch strikeStepInput
    StepOverrideChoice.step1   => stepVal := 1.0
    StepOverrideChoice.step2_5 => stepVal := 2.5
    StepOverrideChoice.step5   => stepVal := 5.0
    StepOverrideChoice.step10  => stepVal := 10.0
    StepOverrideChoice.step20  => stepVal := 20.0
    StepOverrideChoice.step25  => stepVal := 25.0
    StepOverrideChoice.step50  => stepVal := 50.0
    StepOverrideChoice.step100 => stepVal := 100.0
    StepOverrideChoice.step200 => stepVal := 200.0
    StepOverrideChoice.step500 => stepVal := 500.0
    =>
        switch actualUnderlying
            UnderlyingAsset.banknifty => stepVal := 100.0
            UnderlyingAsset.nifty     => stepVal := 50.0
            UnderlyingAsset.crudeoil  => stepVal := 50.0
            UnderlyingAsset.gold      => stepVal := 100.0
            UnderlyingAsset.stock     => stepVal := f_auto_detect_step(not na(chartStrikePrice) and chartStrikePrice > 0 ? chartStrikePrice : spotDayOpen)

var float baseCenterStrike = na
if barstate.isfirst or na(baseCenterStrike)
    float refPrice = strikeOverride > 0.0 ? strikeOverride : (not na(chartStrikePrice) and chartStrikePrice > 0 ? chartStrikePrice : spotDayOpen)
    baseCenterStrike := math.round(refPrice / stepVal) * stepVal

float baseStrike = baseCenterStrike

// ==========================================
// UNIVERSAL FAIL-SAFE CE & PE TICKER CONSTRUCTION
// ==========================================

f_build_option_symbol(float target_strike, bool target_is_ce) =>
    string target_st_str = target_strike == math.floor(target_strike) ? str.tostring(int(target_strike)) : str.tostring(target_strike)
    
    if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
        int end_trim = 2
        string base_no_suffix = str.substring(cleanTicker, 0, str.length(cleanTicker) - end_trim)
        string strikeDigits = str.match(base_no_suffix, "\\d+$")
        if strikeDigits != ""
            string pfx = str.substring(base_no_suffix, 0, str.length(base_no_suffix) - str.length(strikeDigits))
            string sfx = target_is_ce ? "CE" : "PE"
            pfx + target_st_str + sfx
        else
            cleanTicker
    else if str.match(cleanTicker, "[CP]\\d+$") != ""
        string matchCP = str.match(cleanTicker, "[CP]\\d+$")
        int matchPos = str.pos(cleanTicker, matchCP)
        string pfx = str.substring(cleanTicker, 0, matchPos)
        string cp_letter = target_is_ce ? "C" : "P"
        pfx + cp_letter + target_st_str
    else
        string root = str.match(cleanTicker, "^[A-Z&]+")
        string sfx = target_is_ce ? "CE" : "PE"
        (root != "" ? root : cleanTicker) + target_st_str + sfx

f_build_ce_ticker(float target_strike) => f_build_option_symbol(target_strike, true)
f_build_pe_ticker(float target_strike) => f_build_option_symbol(target_strike, false)

// Strike Calculations based on Offset Points
float ce_strike = chartStrikePrice
float pe_strike = chartStrikePrice

float itm_ce_strike = chartStrikePrice - offsetPts
float itm_pe_strike = chartStrikePrice + offsetPts

float otm_ce_strike = chartStrikePrice + offsetPts
float otm_pe_strike = chartStrikePrice - offsetPts

string ce_ticker = f_build_ce_ticker(ce_strike)
string pe_ticker = f_build_pe_ticker(pe_strike)

string ce_itm_ticker = f_build_ce_ticker(itm_ce_strike)
string pe_itm_ticker = f_build_pe_ticker(itm_pe_strike)

string ce_otm_ticker = f_build_ce_ticker(otm_ce_strike)
string pe_otm_ticker = f_build_pe_ticker(otm_pe_strike)

// Multi-Strike Basket Tickers
float k_0  = baseStrike
float k_p1 = baseStrike + 1.0 * stepVal
float k_p2 = baseStrike + 2.0 * stepVal
float k_p3 = baseStrike + 3.0 * stepVal
float k_p4 = baseStrike + 4.0 * stepVal

float k_m1 = baseStrike - 1.0 * stepVal
float k_m2 = baseStrike - 2.0 * stepVal
float k_m3 = baseStrike - 3.0 * stepVal
float k_m4 = baseStrike - 4.0 * stepVal

// ==========================================
// DATA FETCHING (SECURITY CALLS)
// ==========================================

f_get_strike_open_and_ltp() =>
    float d_op = ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0)
    [d_op, close]

[ce_open, ce_ltp]         = request.security(syminfo.prefix + ":" + ce_ticker, timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_open, pe_ltp]         = request.security(syminfo.prefix + ":" + pe_ticker, timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_itm_open, ce_itm_ltp] = request.security(syminfo.prefix + ":" + ce_itm_ticker, timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_itm_open, pe_itm_ltp] = request.security(syminfo.prefix + ":" + pe_itm_ticker, timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_otm_open, ce_otm_ltp] = request.security(syminfo.prefix + ":" + ce_otm_ticker, timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_otm_open, pe_otm_ltp] = request.security(syminfo.prefix + ":" + pe_otm_ticker, timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Fetch Basket Strikes Data
[ce_o_p4, ce_c_p4] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p4), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p4, pe_c_p4] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p4), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p3, ce_c_p3] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p3), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p3, pe_c_p3] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p3), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p2, ce_c_p2] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p2), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p2, pe_c_p2] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p2), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p1, ce_c_p1] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p1), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p1, pe_c_p1] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p1), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_0,  ce_c_0]  = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_0),  timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_0,  pe_c_0]  = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_0),  timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m1, ce_c_m1] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m1), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m1, pe_c_m1] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m1), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m2, ce_c_m2] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m2), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m2, pe_c_m2] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m2), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m3, ce_c_m3] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m3), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m3, pe_c_m3] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m3), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m4, ce_c_m4] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m4), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m4, pe_c_m4] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m4), timeframe.period, f_get_strike_open_and_ltp(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

float spot_ltp = request.security(spotTicker, timeframe.period, close, ignore_invalid_symbol=true)
spot_ltp := na(spot_ltp) ? chartStrikePrice : spot_ltp

// ==========================================
// CORE CALCULATIONS
// ==========================================

// 1. ITM Intrinsic Value Average
float itm_ce_iv_rt  = math.max(0.0, spot_ltp - itm_ce_strike)
float itm_pe_iv_rt  = math.max(0.0, itm_pe_strike - spot_ltp)
float itm_avg_iv_rt = (itm_ce_iv_rt + itm_pe_iv_rt) / 2.0

// 2. OTM Time Value Average
float otm_ce_iv_rt  = math.max(0.0, spot_ltp - otm_ce_strike)
float otm_pe_iv_rt  = math.max(0.0, otm_pe_strike - spot_ltp)
float otm_ce_tv_rt  = ce_otm_ltp - otm_ce_iv_rt
float otm_pe_tv_rt  = pe_otm_ltp - otm_pe_iv_rt
float otm_avg_tv_rt = (otm_ce_tv_rt + otm_pe_tv_rt) / 2.0

// 3. Selected chart's Realtime Intrinsic Value (CE and PE)
float ce_iv_rt = math.max(0.0, spot_ltp - ce_strike)
float pe_iv_rt = math.max(0.0, pe_strike - spot_ltp)

// 4. Selected strike's Realtime Time Value (CE and PE)
float ce_tv_rt = ce_ltp - ce_iv_rt
float pe_tv_rt = pe_ltp - pe_iv_rt

// 5. Day Open Static BEP Line
float day_open_bep = (ce_open + pe_open) / 2.0

// 6. Realtime Dynamic BEP Value
float realtime_bep = (ce_ltp + pe_ltp) / 2.0

// --- Multi-Strike Basket Averages ---
int total_count = numStrikesInput == 4 ? 9 : (numStrikesInput == 3 ? 7 : (numStrikesInput == 2 ? 5 : 3))

float sum_ce_open = numStrikesInput == 4 ? (nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1) + nz(ce_o_p2) + nz(ce_o_m2) + nz(ce_o_p3) + nz(ce_o_m3) + nz(ce_o_p4) + nz(ce_o_m4)) : (numStrikesInput == 3 ? (nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1) + nz(ce_o_p2) + nz(ce_o_m2) + nz(ce_o_p3) + nz(ce_o_m3)) : (numStrikesInput == 2 ? (nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1) + nz(ce_o_p2) + nz(ce_o_m2)) : (nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1))))
float sum_pe_open = numStrikesInput == 4 ? (nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1) + nz(pe_o_p2) + nz(pe_o_m2) + nz(pe_o_p3) + nz(pe_o_m3) + nz(pe_o_p4) + nz(pe_o_m4)) : (numStrikesInput == 3 ? (nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1) + nz(pe_o_p2) + nz(pe_o_m2) + nz(pe_o_p3) + nz(pe_o_m3)) : (numStrikesInput == 2 ? (nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1) + nz(pe_o_p2) + nz(pe_o_m2)) : (nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1))))

float ceAvgOpen = sum_ce_open / total_count
float peAvgOpen = sum_pe_open / total_count

float sum_ce_cur = numStrikesInput == 4 ? (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1) + nz(ce_c_p2) + nz(ce_c_m2) + nz(ce_c_p3) + nz(ce_c_m3) + nz(ce_c_p4) + nz(ce_c_m4)) : (numStrikesInput == 3 ? (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1) + nz(ce_c_p2) + nz(ce_c_m2) + nz(ce_c_p3) + nz(ce_c_m3)) : (numStrikesInput == 2 ? (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1) + nz(ce_c_p2) + nz(ce_c_m2)) : (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1))))
float sum_pe_cur = numStrikesInput == 4 ? (nz(pe_c_0) + nz(pe_c_p1) + nz(pe_c_m1) + nz(pe_c_p2) + nz(pe_c_m2) + nz(pe_c_p3) + nz(pe_c_m3) + nz(pe_c_p4) + nz(pe_c_m4)) : (numStrikesInput == 3 ? (nz(pe_c_0) + nz(pe_c_p1) + nz(pe_c_m1) + nz(pe_c_p2) + nz(pe_c_m2) + nz(pe_c_p3) + nz(pe_c_m3)) : (numStrikesInput == 2 ? (nz(pe_c_0) + nz(pe_c_p1) + nz(pe_c_m1) + nz(pe_c_p2) + nz(pe_c_m2)) : (nz(pe_c_0) + nz(pe_c_p1) + nz(pe_c_m1))))

float ceAvgCur = sum_ce_cur / total_count
float peAvgCur = sum_pe_cur / total_count

float ceAvgChg = ceAvgCur - ceAvgOpen
float peAvgChg = peAvgCur - peAvgOpen

// ==========================================
// USER BUY & SELL ALERT CONDITIONS ENGINE
// ==========================================

// --- Common Filters ---
// CE Filter: CE current average > CE day open average AND CE avg change > 0 AND CE Realtime Intrinsic > PE Realtime Intrinsic
bool ce_filters_met = (ceAvgCur > ceAvgOpen) and (ceAvgChg > 0) and (ce_iv_rt > pe_iv_rt)

// PE Filter: PE current average > PE day open average AND PE avg change > 0 AND PE Realtime Intrinsic > CE Realtime Intrinsic
bool pe_filters_met = (peAvgCur > peAvgOpen) and (peAvgChg > 0) and (pe_iv_rt > ce_iv_rt)

// --- Trigger 1: Realtime Dynamic BEP ---
// Price close above Realtime BEP
bool ce_close_above_rt_bep = ta.crossover(ce_ltp, realtime_bep) or (ce_ltp > realtime_bep and not (ce_ltp[1] > realtime_bep[1]))
bool pe_close_above_rt_bep = ta.crossover(pe_ltp, realtime_bep) or (pe_ltp > realtime_bep and not (pe_ltp[1] > realtime_bep[1]))

bool t1_buy_alert  = ce_close_above_rt_bep and ce_filters_met
bool t1_sell_alert = pe_close_above_rt_bep and pe_filters_met

// --- Trigger 2: Day Open Static BEP ---
// Price close above Day Open Static BEP
bool ce_close_above_stat_bep = ta.crossover(ce_ltp, day_open_bep) or (ce_ltp > day_open_bep and not (ce_ltp[1] > day_open_bep[1]))
bool pe_close_above_stat_bep = ta.crossover(pe_ltp, day_open_bep) or (pe_ltp > day_open_bep and not (pe_ltp[1] > day_open_bep[1]))

bool t2_buy_alert  = ce_close_above_stat_bep and ce_filters_met
bool t2_sell_alert = pe_close_above_stat_bep and pe_filters_met

// --- Combined Triggers ---
bool overall_buy_alert  = t1_buy_alert or t2_buy_alert
bool overall_sell_alert = t1_sell_alert or t2_sell_alert

// --- Visual Shape Markers ---
show_signal_shapes = input.bool(true, "Show Buy / Sell Signal Shape Markers", group="Visual Signals")

plotshape(show_signal_shapes and overall_buy_alert,  title="Buy Signal Marker",  style=shape.labelup,   location=location.belowbar, color=#00E676, textcolor=color.black, size=size.small, text="BUY")
plotshape(show_signal_shapes and overall_sell_alert, title="Sell Signal Marker", style=shape.labeldown, location=location.abovebar, color=#FF1744, textcolor=color.white, size=size.small, text="SELL")

// --- TradingView Alert Conditions ---
alertcondition(t1_buy_alert,  title="Trigger 1 Buy Alert (Realtime BEP)",  message="TRIGGER 1 BUY ALERT: CE price closed above Realtime BEP with Call filters met on {{ticker}}!")
alertcondition(t1_sell_alert, title="Trigger 1 Sell Alert (Realtime BEP)", message="TRIGGER 1 SELL ALERT: PE price closed above Realtime BEP with Put filters met on {{ticker}}!")

alertcondition(t2_buy_alert,  title="Trigger 2 Buy Alert (Day Open BEP)",  message="TRIGGER 2 BUY ALERT: CE price closed above Day Open Static BEP with Call filters met on {{ticker}}!")
alertcondition(t2_sell_alert, title="Trigger 2 Sell Alert (Day Open BEP)", message="TRIGGER 2 SELL ALERT: PE price closed above Day Open Static BEP with Put filters met on {{ticker}}!")

alertcondition(overall_buy_alert,  title="Combined Buy Alert (Trigger 1 or 2)",  message="BUY ALERT: Price closed above BEP (Realtime or Day Open) with Call filters met on {{ticker}}!")
alertcondition(overall_sell_alert, title="Combined Sell Alert (Trigger 1 or 2)", message="SELL ALERT: Price closed above BEP (Realtime or Day Open) with Put filters met on {{ticker}}!")
