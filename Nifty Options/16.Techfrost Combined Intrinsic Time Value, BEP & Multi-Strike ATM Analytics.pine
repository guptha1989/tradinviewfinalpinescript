//@version=6
indicator("16.Techfrost Alert Engine", shorttitle="16.Techfrost Alert Engine", overlay=true, precision=2, max_labels_count=500, max_lines_count=500)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum UnderlyingAsset
    auto      = "Auto-Detect"
    nifty     = "NIFTY"
    banknifty = "BANKNIFTY"
    crudeoil  = "CRUDEOIL"
    gold      = "GOLD"
    stock     = "Stock (Equity)"

enum OptionType
    auto = "Auto-Detect"
    ce   = "Call (CE)"
    pe   = "Put (PE)"

enum StepOverrideChoice
    auto    = "Auto"
    step1   = "1"
    step2_5 = "2.5"
    step5   = "5"
    step10  = "10"
    step20  = "20"
    step25  = "25"
    step50  = "50"
    step100 = "100"
    step200 = "200"
    step500 = "500"

// --- Instrument Settings ---
underlyingInput    = input.enum(UnderlyingAsset.auto, "Underlying Asset", group="Instrument Settings")
optionTypeInput    = input.enum(OptionType.auto, "Option Type", group="Instrument Settings")
manualStrikeInput  = input.int(0, "Manual Strike Selection (0 = Auto)", minval=0, group="Instrument Settings",
  tooltip="Enter strike price manually (e.g. 24000). Leave at 0 to auto-detect from chart symbol.")
spotTickerOverride = input.symbol("", "Spot Symbol Override (e.g. RELIANCE)", group="Instrument Settings")
strikeOverride     = input.float(0.0, "Strike Price Override", minval=0.0, group="Instrument Settings")
strikeStepInput    = input.enum(StepOverrideChoice.auto, "Strike Step Override", group="Instrument Settings",
  tooltip="Set to Auto for auto-detection based on underlying stock/index (Auto-detects 1, 2.5, 5, 10, 20, 50, 100).")

// --- Offset Points & Calculation Settings ---
offsetChoiceInput  = input.string("100 Points", "Strike Offset Points Dropdown", options=["5 Points", "10 Points", "15 Points", "20 Points", "25 Points", "40 Points", "50 Points", "100 Points", "150 Points", "200 Points"], group="Calculation Settings",
  tooltip="Offset points used to determine ITM / OTM strike levels.")
customOffsetInput  = input.float(0.0, "Custom Offset Points Override (0 = Use Dropdown)", minval=0.0, group="Calculation Settings",
  tooltip="Set custom offset points (e.g. 50, 100, 150). If > 0, overrides dropdown selection.")
numStrikesInput    = input.int(4, "Number of ITM/OTM Strikes Each Side for Basket", minval=1, maxval=4, group="Calculation Settings",
  tooltip="1 = 3 Strikes (1 ITM + ATM + 1 OTM), 2 = 5 Strikes (2 ITM + ATM + 2 OTM), 3 = 7 Strikes, 4 = 9 Strikes.")

// --- Reference Line Plot Controls ---
show_prev_close   = input.bool(true, "Show Previous Day Close (CE & PE)", group="Reference Line Plots")
show_ce_prev_hl   = input.bool(true, "Show CE Previous Day High & Low", group="Reference Line Plots")
show_pe_prev_hl   = input.bool(true, "Show PE Previous Day High & Low", group="Reference Line Plots")
show_vwap         = input.bool(true, "Show VWAP Lines (Chart Option & Opposite Option)", group="Reference Line Plots")

// --- Momentum Blast Filters (RSI, ADX, DI & MACD) ---
use_rsi_filter     = input.bool(true, "Enable RSI Filter for Blast Alert", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")
rsi_len            = input.int(14, "RSI Period Length", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")
rsi_ce_level       = input.float(60.0, "RSI CE Threshold (Buy)", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")
rsi_pe_level       = input.float(40.0, "RSI PE Threshold (Sell)", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")

use_adx_filter     = input.bool(true, "Enable ADX & DI Filter for Blast Alert", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")
adx_len            = input.int(14, "ADX Smoothing Period", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")
di_len             = input.int(14, "DI Period Length", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")
adx_min_val        = input.float(20.0, "ADX Minimum Threshold Level", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")
require_adx_up     = input.bool(true, "Require ADX Slanting Upwards", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")
use_di_cross       = input.bool(false, "Require DI+ > DI- for CE / DI- > DI+ for PE", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")

use_macd_filter    = input.bool(true, "Enable MACD Filter for Blast Alert", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")
macd_fast_len      = input.int(12, "MACD Fast Length", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")
macd_slow_len      = input.int(26, "MACD Slow Length", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")
macd_signal_len    = input.int(9, "MACD Signal Length", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")
use_macd_hist      = input.bool(true, "Require MACD Histogram Positive for CE / Negative for PE", group="Momentum Blast Filters (RSI, ADX, DI & MACD)")

// --- BEP Line Colors & Formatting ---
col_atm_rt    = input.color(color.white, "ATM Realtime BEP (L0)", group="BEP Line Formatting")
col_atm_stat  = input.color(color.yellow, "ATM Static BEP (L0)", group="BEP Line Formatting")

col_itm1_rt   = input.color(color.aqua, "ITM1 Realtime BEP (L-1)", group="BEP Line Formatting")
col_itm1_stat = input.color(color.new(color.aqua, 40), "ITM1 Static BEP (L-1)", group="BEP Line Formatting")

col_itm2_rt   = input.color(color.blue, "ITM2 Realtime BEP (L-2)", group="BEP Line Formatting")
col_itm2_stat = input.color(color.new(color.blue, 40), "ITM2 Static BEP (L-2)", group="BEP Line Formatting")

col_itm3_rt   = input.color(color.purple, "ITM3 Realtime BEP (L-3)", group="BEP Line Formatting")
col_itm3_stat = input.color(color.new(color.purple, 40), "ITM3 Static BEP (L-3)", group="BEP Line Formatting")

col_otm1_rt   = input.color(color.orange, "OTM1 Realtime BEP (L+1)", group="BEP Line Formatting")
col_otm1_stat = input.color(color.new(color.orange, 40), "OTM1 Static BEP (L+1)", group="BEP Line Formatting")

col_otm2_rt   = input.color(color.teal, "OTM2 Realtime BEP (L+2)", group="BEP Line Formatting")
col_otm2_stat = input.color(color.new(color.teal, 40), "OTM2 Static BEP (L+2)", group="BEP Line Formatting")

col_otm3_rt   = input.color(color.lime, "OTM3 Realtime BEP (L+3)", group="BEP Line Formatting")
col_otm3_stat = input.color(color.new(color.lime, 40), "OTM3 Static BEP (L+3)", group="BEP Line Formatting")

col_vwap      = input.color(color.new(#E91E63, 0), "Chart Option VWAP Color", group="BEP Line Formatting")
col_opp_vwap  = input.color(color.new(#9C27B0, 0), "Opposite Option VWAP Color", group="BEP Line Formatting")

width_atm     = input.int(2, "ATM BEP Lines Width", minval=1, maxval=4, group="BEP Line Formatting")
width_others  = input.int(1, "ITM/OTM BEP Lines Width", minval=1, maxval=4, group="BEP Line Formatting")

// --- Alert Engine Controls ---
bep_display_mode            = input.string("Both", "BEP Line Visibility & Trigger Mode", options=["Realtime BEP Lines", "Static BEP Lines", "Both"], group="Alert Engine Controls",
  tooltip="Select whether to display and evaluate Realtime BEP lines, Static BEP lines, or Both.")
enable_blast_alerts         = input.bool(true, "Enable BLAST Alert Badges (CE BLAST / PE BLAST)", group="Alert Engine Controls",
  tooltip="When enabled, signals meeting Momentum Blast conditions display as CE BLAST / PE BLAST. When disabled, normal CE / PE alerts will still trigger.")
use_basket_avg_filter       = input.bool(true, "Require Basket Average > Day Open Average", group="Alert Engine Controls",
  tooltip="Requires CE/PE Current Basket Average to be greater than Day Open Basket Average.")
use_basket_chg_filter       = input.bool(true, "Require Basket Average Change > 0", group="Alert Engine Controls",
  tooltip="Requires CE/PE Basket Average Change from Day Open to be positive (> 0).")
strict_iv_filter            = input.bool(false, "Require Strict Intrinsic Value Filter Condition", group="Alert Engine Controls",
  tooltip="Set to false to keep Intrinsic Value non-strict for alerts. Fresh Intrinsic Value formations will be highlighted with special gold markers.")
use_delta_vol_filter        = input.bool(true, "Require 3-Candle Delta Volume Confluence", group="Alert Engine Controls",
  tooltip="Requires 3-candle cumulative Delta Volume to be positive (> 0) for CE Buy alert and negative (< 0) for PE Sell alert.")

show_status_table           = input.bool(true, "Show Alert Conditions Status Table", group="Alert Engine Controls",
  tooltip="Displays a live status panel in the corner showing the exact pass/fail state of all alert conditions.")
table_pos_input             = input.string("Top Right", "Status Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Alert Engine Controls")

// ==========================================
// TICKER PARSING & AUTO-DETECTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

// ----- Detect underlying -----
UnderlyingAsset actualUnderlying = na
if underlyingInput == UnderlyingAsset.auto
    if str.contains(cleanTicker, "BANKNIFTY")
        actualUnderlying := UnderlyingAsset.banknifty
    else if str.contains(cleanTicker, "NIFTY")
        actualUnderlying := UnderlyingAsset.nifty
    else if str.contains(cleanTicker, "CRUDEOIL")
        actualUnderlying := UnderlyingAsset.crudeoil
    else if str.contains(cleanTicker, "GOLD") and not str.contains(cleanTicker, "GOLDM") and not str.contains(cleanTicker, "GOLDPETAL")
        actualUnderlying := UnderlyingAsset.gold
    else if str.contains(cleanTicker, "GOLDM")
        actualUnderlying := UnderlyingAsset.gold
    else
        actualUnderlying := UnderlyingAsset.stock
else
    actualUnderlying := underlyingInput

// ----- Detect option type -----
bool isCall = false
bool isPut  = false

if optionTypeInput == OptionType.ce
    isCall := true
else if optionTypeInput == OptionType.pe
    isPut := true
else
    if str.contains(cleanTicker, "CE")
        isCall := true
    else if str.contains(cleanTicker, "PE")
        isPut := true
    else if str.match(cleanTicker, "C\\d+$") != ""
        isCall := true
    else if str.match(cleanTicker, "P\\d+$") != ""
        isPut := true

// ----- Strike extraction from chart symbol -----
float detectedStrike = na
string tickerWithoutCEPE = ""

int tickerLen = str.length(cleanTicker)
if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, tickerLen - 2)

string matchC = str.match(cleanTicker, "C\\d+$")
string matchP = str.match(cleanTicker, "P\\d+$")

if matchC != ""
    detectedStrike := str.tonumber(str.substring(matchC, 1))
else if matchP != ""
    detectedStrike := str.tonumber(str.substring(matchP, 1))
else if tickerWithoutCEPE != ""
    string strikeDigits = str.match(tickerWithoutCEPE, "\\d+$")
    detectedStrike := str.tonumber(strikeDigits)

float chartStrikePrice = strikeOverride > 0.0 ? strikeOverride : (manualStrikeInput > 0 ? float(manualStrikeInput) : detectedStrike)

// ==========================================
// SPOT TICKER RESOLUTION & OFFSET CALCULATION
// ==========================================

string spotTicker = ""
if str.length(spotTickerOverride) > 0
    spotTicker := spotTickerOverride
else
    switch actualUnderlying
        UnderlyingAsset.banknifty => spotTicker := "NSE:BANKNIFTY"
        UnderlyingAsset.nifty     => spotTicker := "NSE:NIFTY"
        UnderlyingAsset.crudeoil  => spotTicker := "MCX:CRUDEOIL1!"
        UnderlyingAsset.gold      => spotTicker := "MCX:GOLD1!"
        UnderlyingAsset.stock     =>
            string rootGuess = str.match(cleanTicker, "^[A-Z&]+")
            if rootGuess != ""
                spotTicker := syminfo.prefix + ":" + rootGuess
            else
                spotTicker := syminfo.prefix + ":" + cleanTicker

// Fetch Day Open Spot Price for the underlying
float spotDayOpen = request.security(spotTicker, "D", open, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Offset points calculation
float offsetPts = 100.0
if customOffsetInput > 0.0
    offsetPts := customOffsetInput
else
    switch offsetChoiceInput
        "5 Points"   => offsetPts := 5.0
        "10 Points"  => offsetPts := 10.0
        "15 Points"  => offsetPts := 15.0
        "20 Points"  => offsetPts := 20.0
        "25 Points"  => offsetPts := 25.0
        "40 Points"  => offsetPts := 40.0
        "50 Points"  => offsetPts := 50.0
        "100 Points" => offsetPts := 100.0
        "150 Points" => offsetPts := 150.0
        "200 Points" => offsetPts := 200.0
        => offsetPts := 100.0

// Dynamic Step Size
f_auto_detect_step(float ref_p) =>
    float s_res = 50.0
    if na(ref_p) or ref_p <= 0
        s_res := 50.0
    else if ref_p < 100
        s_res := 1.0
    else if ref_p < 250
        s_res := 2.5
    else if ref_p < 500
        s_res := 5.0
    else if ref_p < 1200
        s_res := 10.0
    else if ref_p < 2500
        s_res := 20.0
    else
        s_res := 50.0
    s_res

float stepVal = 50.0
switch strikeStepInput
    StepOverrideChoice.step1   => stepVal := 1.0
    StepOverrideChoice.step2_5 => stepVal := 2.5
    StepOverrideChoice.step5   => stepVal := 5.0
    StepOverrideChoice.step10  => stepVal := 10.0
    StepOverrideChoice.step20  => stepVal := 20.0
    StepOverrideChoice.step25  => stepVal := 25.0
    StepOverrideChoice.step50  => stepVal := 50.0
    StepOverrideChoice.step100 => stepVal := 100.0
    StepOverrideChoice.step200 => stepVal := 200.0
    StepOverrideChoice.step500 => stepVal := 500.0
    =>
        switch actualUnderlying
            UnderlyingAsset.banknifty => stepVal := 100.0
            UnderlyingAsset.nifty     => stepVal := 50.0
            UnderlyingAsset.crudeoil  => stepVal := 50.0
            UnderlyingAsset.gold      => stepVal := 100.0
            UnderlyingAsset.stock     => stepVal := f_auto_detect_step(not na(chartStrikePrice) and chartStrikePrice > 0 ? chartStrikePrice : spotDayOpen)

var float baseCenterStrike = na
if barstate.isfirst or na(baseCenterStrike)
    float refPrice = strikeOverride > 0.0 ? strikeOverride : (not na(chartStrikePrice) and chartStrikePrice > 0 ? chartStrikePrice : spotDayOpen)
    baseCenterStrike := math.round(refPrice / stepVal) * stepVal

float baseStrike = baseCenterStrike

// ==========================================
// UNIVERSAL FAIL-SAFE CE & PE TICKER CONSTRUCTION
// ==========================================

f_build_option_symbol(float target_strike, bool target_is_ce) =>
    string target_st_str = target_strike == math.floor(target_strike) ? str.tostring(int(target_strike)) : str.tostring(target_strike)
    
    if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
        int end_trim = 2
        string base_no_suffix = str.substring(cleanTicker, 0, str.length(cleanTicker) - end_trim)
        string strikeDigits = str.match(base_no_suffix, "\\d+$")
        if strikeDigits != ""
            string pfx = str.substring(base_no_suffix, 0, str.length(base_no_suffix) - str.length(strikeDigits))
            string sfx = target_is_ce ? "CE" : "PE"
            pfx + target_st_str + sfx
        else
            cleanTicker
    else if str.match(cleanTicker, "[CP]\\d+$") != ""
        string matchCP = str.match(cleanTicker, "[CP]\\d+$")
        int matchPos = str.pos(cleanTicker, matchCP)
        string pfx = str.substring(cleanTicker, 0, matchPos)
        string cp_letter = target_is_ce ? "C" : "P"
        pfx + cp_letter + target_st_str
    else
        string root = str.match(cleanTicker, "^[A-Z&]+")
        string sfx = target_is_ce ? "CE" : "PE"
        (root != "" ? root : cleanTicker) + target_st_str + sfx

f_build_ce_ticker(float target_strike) => f_build_option_symbol(target_strike, true)
f_build_pe_ticker(float target_strike) => f_build_option_symbol(target_strike, false)

// Strike Calculations based on Offset Points
float ce_strike = chartStrikePrice
float pe_strike = chartStrikePrice

string ce_ticker = f_build_ce_ticker(ce_strike)
string pe_ticker = f_build_pe_ticker(pe_strike)

// Multi-Strike Basket Tickers (7 Levels: -3, -2, -1, 0, +1, +2, +3)
float k_0  = baseStrike
float k_p1 = baseStrike + 1.0 * offsetPts
float k_p2 = baseStrike + 2.0 * offsetPts
float k_p3 = baseStrike + 3.0 * offsetPts
float k_p4 = baseStrike + 4.0 * offsetPts

float k_m1 = baseStrike - 1.0 * offsetPts
float k_m2 = baseStrike - 2.0 * offsetPts
float k_m3 = baseStrike - 3.0 * offsetPts
float k_m4 = baseStrike - 4.0 * offsetPts

// ==========================================
// DATA FETCHING & OPPOSITE CANDLES OVERLAY
// ==========================================

f_get_strike_ohlc() =>
    float d_op = ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0)
    [d_op, high, low, close]

f_get_strike_prev_day() =>
    [close[1], high[1], low[1]]

// Fetch Opposite Option Ticker & Candle Data for Overlay
string opp_ticker = f_build_option_symbol(chartStrikePrice, not isCall)
[opp_o, opp_h, opp_l, opp_c, opp_v] = request.security(syminfo.prefix + ":" + opp_ticker, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol=true)

// Plot Opposite Option Candles Overlay (1 plotcandle call = 4 plots)
show_opp_candles = input.bool(true, "Show Opposite Option Candles Overlay", group="Visual Signals")

bool opp_is_bull   = nz(opp_c) >= nz(opp_o)
color opp_body_col = opp_is_bull ? color.new(#2962FF, 40) : color.new(#FF6D00, 40)
color opp_wick_col = opp_is_bull ? color.new(#2962FF, 60) : color.new(#FF6D00, 60)

plotcandle(show_opp_candles ? opp_o : na,
           show_opp_candles ? opp_h : na,
           show_opp_candles ? opp_l : na,
           show_opp_candles ? opp_c : na,
           title="Opposite Option Candle", color=opp_body_col, wickcolor=opp_wick_col, bordercolor=opp_wick_col)

// Explicit Call and Put Chart Candle Values
float chart_ce_open  = isCall ? open  : opp_o
float chart_ce_high  = isCall ? high  : opp_h
float chart_ce_low   = isCall ? low   : opp_l
float chart_ce_close = isCall ? close : opp_c

float chart_pe_open  = isPut  ? open  : opp_o
float chart_pe_high  = isPut  ? high  : opp_h
float chart_pe_low   = isPut  ? low   : opp_l
float chart_pe_close = isPut  ? close : opp_c

// Fetch ATM Option OHLC & Previous Day Data
[ce_open_sec, ce_high_sec, ce_low_sec, ce_ltp_sec] = request.security(syminfo.prefix + ":" + ce_ticker, timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_open_sec, pe_high_sec, pe_low_sec, pe_ltp_sec] = request.security(syminfo.prefix + ":" + pe_ticker, timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_pdc_sec, ce_pdh_sec, ce_pdl_sec] = request.security(syminfo.prefix + ":" + ce_ticker, "D", f_get_strike_prev_day(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_pdc_sec, pe_pdh_sec, pe_pdl_sec] = request.security(syminfo.prefix + ":" + pe_ticker, "D", f_get_strike_prev_day(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Use direct chart candle data if active chart is Call or Put option
float ce_open = isCall ? ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0) : ce_open_sec
float pe_open = isPut  ? ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0) : pe_open_sec

float ce_high = isCall ? high : ce_high_sec
float pe_high = isPut  ? high : pe_high_sec

float ce_low  = isCall ? low : ce_low_sec
float pe_low  = isPut  ? low : pe_low_sec

float ce_ltp  = isCall ? close : ce_ltp_sec
float pe_ltp  = isPut  ? close : pe_ltp_sec

// Previous Day Settlement Price Close, High, Low
float ce_prev_close = isCall ? request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on) : ce_pdc_sec
float pe_prev_close = isPut  ? request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on) : pe_pdc_sec

float ce_prev_high  = isCall ? request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on) : ce_pdh_sec
float ce_prev_low   = isCall ? request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on) : ce_pdl_sec

float pe_prev_high  = isPut  ? request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on) : pe_pdh_sec
float pe_prev_low   = isPut  ? request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on) : pe_pdl_sec

// Fetch All 7 Strike Levels OHLC Data
[ce_o_m3, ce_h_m3, ce_l_m3, ce_c_m3] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m3), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m3, pe_h_m3, pe_l_m3, pe_c_m3] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m3), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m2, ce_h_m2, ce_l_m2, ce_c_m2] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m2), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m2, pe_h_m2, pe_l_m2, pe_c_m2] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m2), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m1, ce_h_m1, ce_l_m1, ce_c_m1] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m1), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m1, pe_h_m1, pe_l_m1, pe_c_m1] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m1), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_0,  ce_h_0,  ce_l_0,  ce_c_0]  = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_0),  timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_0,  pe_h_0,  pe_l_0,  pe_c_0]  = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_0),  timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p1, ce_h_p1, ce_l_p1, ce_c_p1] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p1), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p1, pe_h_p1, pe_l_p1, pe_c_p1] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p1), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p2, ce_h_p2, ce_l_p2, ce_c_p2] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p2), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p2, pe_h_p2, pe_l_p2, pe_c_p2] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p2), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p3, ce_h_p3, ce_l_p3, ce_c_p3] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p3), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p3, pe_h_p3, pe_l_p3, pe_c_p3] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p3), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_p4, ce_h_p4, ce_l_p4, ce_c_p4] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_p4), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_p4, pe_h_p4, pe_l_p4, pe_c_p4] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_p4), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[ce_o_m4, ce_h_m4, ce_l_m4, ce_c_m4] = request.security(syminfo.prefix + ":" + f_build_ce_ticker(k_m4), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_o_m4, pe_h_m4, pe_l_m4, pe_c_m4] = request.security(syminfo.prefix + ":" + f_build_pe_ticker(k_m4), timeframe.period, f_get_strike_ohlc(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

float spot_ltp = request.security(spotTicker, timeframe.period, close, ignore_invalid_symbol=true)
spot_ltp := na(spot_ltp) ? chartStrikePrice : spot_ltp

// ==========================================
// CORE CALCULATIONS, VWAP & MOMENTUM INDICATORS
// ==========================================

// RSI Calculation
float rsi_val = ta.rsi(close, rsi_len)
bool ce_rsi_blast_cond = not use_rsi_filter or (rsi_val > rsi_ce_level)
bool pe_rsi_blast_cond = not use_rsi_filter or (rsi_val < rsi_pe_level)

// ADX & DI Calculations
[plusDI, minusDI, adx_val] = ta.dmi(di_len, adx_len)
bool adx_level_pass = adx_val > adx_min_val
bool adx_up_slant   = not require_adx_up or (adx_val > adx_val[1])
bool ce_di_pass     = not use_di_cross or (plusDI > minusDI)
bool pe_di_pass     = not use_di_cross or (minusDI > plusDI)

bool ce_adx_blast_cond = not use_adx_filter or (adx_level_pass and adx_up_slant and ce_di_pass)
bool pe_adx_blast_cond = not use_adx_filter or (adx_level_pass and adx_up_slant and pe_di_pass)

// MACD Calculation
[macdLine, signalLine, histLine] = ta.macd(close, macd_fast_len, macd_slow_len, macd_signal_len)
bool ce_macd_pass = not use_macd_filter or (use_macd_hist ? histLine > 0 : macdLine > signalLine)
bool pe_macd_pass = not use_macd_filter or (use_macd_hist ? histLine < 0 : macdLine < signalLine)

// VWAP Calculations (Chart Option & Opposite Option)
float chart_vwap = ta.vwap(hlc3)
float opp_vwap   = request.security(syminfo.prefix + ":" + opp_ticker, timeframe.period, ta.vwap(hlc3), ignore_invalid_symbol=true)

// Selected chart's Realtime Intrinsic Value (CE and PE)
float ce_iv_rt = math.max(0.0, spot_ltp - ce_strike)
float pe_iv_rt = math.max(0.0, pe_strike - spot_ltp)

// Detection of FRESH Intrinsic Value Formation (Transitions from 0 to > 0 on current bar)
bool ce_fresh_iv = (ce_iv_rt > 0) and (nz(ce_iv_rt[1]) == 0)
bool pe_fresh_iv = (pe_iv_rt > 0) and (nz(pe_iv_rt[1]) == 0)

// --- 7 Levels of Realtime & Static BEP Lines (Exact Options Synthetic Straddle Pairing) ---
// ITM 3 BEP (CE ITM 3 + PE OTM 3)
float bep_rt_m3   = (ce_c_m3 + pe_c_p3) / 2.0
float bep_stat_m3 = (ce_o_m3 + pe_o_p3) / 2.0

// ITM 2 BEP (CE ITM 2 + PE OTM 2)
float bep_rt_m2   = (ce_c_m2 + pe_c_p2) / 2.0
float bep_stat_m2 = (ce_o_m2 + pe_o_p2) / 2.0

// ITM 1 BEP (CE ITM 1 + PE OTM 1)
float bep_rt_m1   = (ce_c_m1 + pe_c_p1) / 2.0
float bep_stat_m1 = (ce_o_m1 + pe_o_p1) / 2.0

// ATM BEP (CE ATM + PE ATM)
float bep_rt_0    = (ce_c_0 + pe_c_0) / 2.0
float bep_stat_0  = (ce_o_0 + pe_o_0) / 2.0

// OTM 1 BEP (CE OTM 1 + PE ITM 1)
float bep_rt_p1   = (ce_c_p1 + pe_c_m1) / 2.0
float bep_stat_p1 = (ce_o_p1 + pe_o_m1) / 2.0

// OTM 2 BEP (CE OTM 2 + PE ITM 2)
float bep_rt_p2   = (ce_c_p2 + pe_c_m2) / 2.0
float bep_stat_p2 = (ce_o_p2 + pe_o_m2) / 2.0

// OTM 3 BEP (CE OTM 3 + PE ITM 3)
float bep_rt_p3   = (ce_c_p3 + pe_c_m3) / 2.0
float bep_stat_p3 = (ce_o_p3 + pe_o_m3) / 2.0

// --- Plot Reference Lines & VWAP (8 plots) ---
plot(show_prev_close ? ce_prev_close : na, title="CE Prev Day Close", color=color.new(#00E676, 30), linewidth=1, style=plot.style_linebr)
plot(show_prev_close ? pe_prev_close : na, title="PE Prev Day Close", color=color.new(#FF1744, 30), linewidth=1, style=plot.style_linebr)

plot(show_ce_prev_hl ? ce_prev_high : na, title="CE Prev Day High", color=color.new(#00E676, 50), linewidth=1, style=plot.style_linebr)
plot(show_ce_prev_hl ? ce_prev_low  : na, title="CE Prev Day Low",  color=color.new(#00E676, 50), linewidth=1, style=plot.style_linebr)

plot(show_pe_prev_hl ? pe_prev_high : na, title="PE Prev Day High", color=color.new(#FF1744, 50), linewidth=1, style=plot.style_linebr)
plot(show_pe_prev_hl ? pe_prev_low  : na, title="PE Prev Day Low",  color=color.new(#FF1744, 50), linewidth=1, style=plot.style_linebr)

plot(show_vwap ? chart_vwap : na, title="Chart Option VWAP", color=col_vwap, linewidth=2)
plot(show_vwap ? opp_vwap   : na, title="Opposite Option VWAP", color=col_opp_vwap, linewidth=2)

bool show_rt_bep   = (bep_display_mode == "Realtime BEP Lines") or (bep_display_mode == "Both")
bool show_stat_bep = (bep_display_mode == "Static BEP Lines")   or (bep_display_mode == "Both")

// --- Plot 7 Levels of BEP Lines with Custom User Colors & Formatting (14 plots) ---
plot(show_rt_bep ? bep_rt_0 : na,    title="ATM Realtime BEP (L0)", color=col_atm_rt,   linewidth=width_atm)
plot(show_stat_bep ? bep_stat_0 : na,  title="ATM Static BEP (L0)",   color=col_atm_stat, linewidth=width_atm)

plot(show_rt_bep ? bep_rt_m1 : na,   title="ITM1 Realtime BEP (L-1)", color=col_itm1_rt,   linewidth=width_others, style=plot.style_linebr)
plot(show_stat_bep ? bep_stat_m1 : na, title="ITM1 Static BEP (L-1)",   color=col_itm1_stat, linewidth=width_others, style=plot.style_linebr)

plot(show_rt_bep ? bep_rt_m2 : na,   title="ITM2 Realtime BEP (L-2)", color=col_itm2_rt,   linewidth=width_others, style=plot.style_linebr)
plot(show_stat_bep ? bep_stat_m2 : na, title="ITM2 Static BEP (L-2)",   color=col_itm2_stat, linewidth=width_others, style=plot.style_linebr)

plot(show_rt_bep ? bep_rt_m3 : na,   title="ITM3 Realtime BEP (L-3)", color=col_itm3_rt,   linewidth=width_others, style=plot.style_linebr)
plot(show_stat_bep ? bep_stat_m3 : na, title="ITM3 Static BEP (L-3)",   color=col_itm3_stat, linewidth=width_others, style=plot.style_linebr)

plot(show_rt_bep ? bep_rt_p1 : na,   title="OTM1 Realtime BEP (L+1)", color=col_otm1_rt,   linewidth=width_others, style=plot.style_linebr)
plot(show_stat_bep ? bep_stat_p1 : na, title="OTM1 Static BEP (L+1)",   color=col_otm1_stat, linewidth=width_others, style=plot.style_linebr)

plot(show_rt_bep ? bep_rt_p2 : na,   title="OTM2 Realtime BEP (L+2)", color=col_otm2_rt,   linewidth=width_others, style=plot.style_linebr)
plot(show_stat_bep ? bep_stat_p2 : na, title="OTM2 Static BEP (L+2)",   color=col_otm2_stat, linewidth=width_others, style=plot.style_linebr)

plot(show_rt_bep ? bep_rt_p3 : na,   title="OTM3 Realtime BEP (L+3)", color=col_otm3_rt,   linewidth=width_others, style=plot.style_linebr)
plot(show_stat_bep ? bep_stat_p3 : na, title="OTM3 Static BEP (L+3)",   color=col_otm3_stat, linewidth=width_others, style=plot.style_linebr)

// --- Multi-Strike Basket Averages ---
int total_count = numStrikesInput == 4 ? 9 : (numStrikesInput == 3 ? 7 : (numStrikesInput == 2 ? 5 : 3))

float sum_ce_open = numStrikesInput == 4 ? (nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1) + nz(ce_o_p2) + nz(ce_o_m2) + nz(ce_o_p3) + nz(ce_o_m3) + nz(ce_o_p4) + nz(ce_o_m4)) : (numStrikesInput == 3 ? (nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1) + nz(ce_o_p2) + nz(ce_o_m2) + nz(ce_o_p3) + nz(ce_o_m3)) : (numStrikesInput == 2 ? (nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1) + nz(ce_o_p2) + nz(ce_o_m2)) : (nz(ce_o_0) + nz(ce_o_p1) + nz(ce_o_m1))))
float sum_pe_open = numStrikesInput == 4 ? (nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1) + nz(pe_o_p2) + nz(pe_o_m2) + nz(pe_o_p3) + nz(pe_o_m3) + nz(pe_o_p4) + nz(pe_o_m4)) : (numStrikesInput == 3 ? (nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1) + nz(pe_o_p2) + nz(pe_o_m2) + nz(pe_o_p3) + nz(pe_o_m3)) : (numStrikesInput == 2 ? (nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1) + nz(pe_o_p2) + nz(pe_o_m2)) : (nz(pe_o_0) + nz(pe_o_p1) + nz(pe_o_m1))))

float ceAvgOpen = sum_ce_open / total_count
float peAvgOpen = sum_pe_open / total_count

float sum_ce_cur = numStrikesInput == 4 ? (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1) + nz(ce_c_p2) + nz(ce_c_m2) + nz(ce_c_p3) + nz(ce_c_m3) + nz(ce_c_p4) + nz(ce_c_m4)) : (numStrikesInput == 3 ? (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1) + nz(ce_c_p2) + nz(ce_c_m2) + nz(ce_c_p3) + nz(ce_c_m3)) : (numStrikesInput == 2 ? (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1) + nz(ce_c_p2) + nz(ce_c_m2)) : (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1))))
float sum_pe_cur = numStrikesInput == 4 ? (nz(pe_c_0) + nz(pe_c_p1) + nz(pe_c_m1) + nz(pe_c_p2) + nz(pe_c_m2) + nz(pe_c_p3) + nz(pe_c_m3) + nz(pe_c_p4) + nz(pe_c_m4)) : (numStrikesInput == 3 ? (nz(ce_c_0) + nz(ce_c_p1) + nz(ce_c_m1) + nz(ce_c_p2) + nz(ce_c_m2) + nz(ce_c_p3) + nz(ce_c_m3)) : (numStrikesInput == 2 ? (nz(pe_c_0) + nz(pe_c_p1) + nz(pe_c_m1) + nz(pe_c_p2) + nz(pe_c_m2)) : (nz(pe_c_0) + nz(pe_c_p1) + nz(pe_c_m1))))

float ceAvgCur = sum_ce_cur / total_count
float peAvgCur = sum_pe_cur / total_count

float ceAvgChg = ceAvgCur - ceAvgOpen
float peAvgChg = peAvgCur - peAvgOpen

// Signed Intrinsic Values (Distance from Strike)
float ce_iv_signed = spot_ltp - ce_strike
float pe_iv_signed = pe_strike - spot_ltp

// ==========================================
// USER BUY & SELL ALERT CONDITIONS ENGINE
// ==========================================

// --- Basket Average Confluence Evaluations ---
bool both_above_day_open = (ceAvgCur > ceAvgOpen) and (peAvgCur > peAvgOpen)
bool both_below_day_open = (ceAvgCur < ceAvgOpen) and (peAvgCur < peAvgOpen)

// When both averages are below day open, bypass average and change filters so trigger fires on top average line:
bool ce_avg_pass = not use_basket_avg_filter or (ceAvgCur > ceAvgOpen) or both_below_day_open
bool pe_avg_pass = not use_basket_avg_filter or (peAvgCur > peAvgOpen) or both_below_day_open

bool ce_chg_pass = not use_basket_chg_filter or (ceAvgChg > 0) or both_below_day_open
bool pe_chg_pass = not use_basket_chg_filter or (peAvgChg > 0) or both_below_day_open

// TOP POSITION RULE:
// Require current average line on top when both are above day open OR both are below day open
bool ce_top_required = both_above_day_open or both_below_day_open
bool pe_top_required = both_above_day_open or both_below_day_open

bool ce_top_pass = not ce_top_required or (ceAvgCur > peAvgCur)
bool pe_top_pass = not pe_top_required or (peAvgCur > ceAvgCur)

// Non-strict Intrinsic Value Evaluation: Non-blocking for basic alerts unless strict_iv_filter is manually enabled
bool ce_iv_pass  = not strict_iv_filter or (ce_iv_signed > pe_iv_signed) or (ce_iv_rt > pe_iv_rt) or (ce_iv_rt > 0)
bool pe_iv_pass  = not strict_iv_filter or (pe_iv_signed > ce_iv_signed) or (pe_iv_rt > ce_iv_rt) or (pe_iv_rt > 0)

// --- 3-Candle Cumulative CE Delta Volume Calculation ---
// Heavy buying in CE (ce_delta_3bar > 0) -> CE Buy Confluence
// Heavy selling in CE (ce_delta_3bar < 0) -> PE Sell Confluence
float chart_ce_vol  = isCall ? volume : opp_v
float ce_bar_delta  = (chart_ce_close >= chart_ce_open) ? chart_ce_vol : -chart_ce_vol
float ce_delta_3bar = math.sum(ce_bar_delta, 3)

bool ce_delta_pass = not use_delta_vol_filter or (ce_delta_3bar > 0)
bool pe_delta_pass = not use_delta_vol_filter or (ce_delta_3bar < 0)

// Directional Filters with Strict Confluence
bool ce_filters_met = ce_avg_pass and ce_chg_pass and ce_top_pass and ce_iv_pass and ce_delta_pass
bool pe_filters_met = pe_avg_pass and pe_chg_pass and pe_top_pass and pe_iv_pass and pe_delta_pass

// --- Universal BEP Level Pair Trigger Evaluators ---
// Downside Rejection: High touches/surpasses BEP line (h_val >= bep), Close finishes below (c_val < bep)
f_bounce_dn(float h_val, float c_val, float bep_val) =>
    (h_val >= bep_val) and (c_val < bep_val)

// Upside Bounce: Low touches/dips to BEP line (l_val <= bep), Close finishes above (c_val > bep)
// Also triggers on next candle when its close price crosses above bounce candle's close price
f_bounce_up(float l_val, float c_val, float bep_val) =>
    bool bounce_now     = (l_val <= bep_val) and (c_val > bep_val)
    bool bounce_confirm = not na(l_val[1]) and not na(c_val[1]) and not na(bep_val[1]) and (l_val[1] <= bep_val[1]) and (c_val[1] > bep_val[1]) and (c_val > c_val[1])
    bounce_now or bounce_confirm

// Breakdown: Previous close was above or equal to BEP line (prev_c >= bep), Current close finishes below (curr_c < bep)
f_breakdown_dn(float curr_c, float prev_c, float bep_val) =>
    (curr_c < bep_val) and (nz(prev_c) >= bep_val)

// Crossover: Previous close was below or equal to BEP line (prev_c <= bep), Current close finishes above (curr_c > bep)
f_crossover_up(float curr_c, float prev_c, float bep_val) =>
    (curr_c > bep_val) and (nz(prev_c) <= bep_val)

// Call Buy Alert on a specific BEP line level:
// Evaluates Call crossover UP, Call support bounce UP, Put resistance rejection DOWN, or Put breakdown DOWN
f_eval_ce_pair_trig(float bep_val, float c_c, float c_h, float c_l, float p_c, float p_h, float p_l) =>
    // Active Chart Option Candle Triggers
    bool chart_ce_cross     = f_crossover_up(chart_ce_close, chart_ce_close[1], bep_val)
    bool chart_ce_bounce_up = f_bounce_up(chart_ce_low, chart_ce_close, bep_val)
    bool chart_pe_bounce_dn = f_bounce_dn(chart_pe_high, chart_pe_close, bep_val)
    bool chart_pe_breakdown = f_breakdown_dn(chart_pe_close, chart_pe_close[1], bep_val)

    // Level-specific Security Option Candle Triggers
    bool sec_ce_cross       = not na(c_c) and f_crossover_up(c_c, c_c[1], bep_val)
    bool sec_ce_bounce_up   = not na(c_l) and not na(c_c) and f_bounce_up(c_l, c_c, bep_val)
    bool sec_pe_bounce_dn   = not na(p_h) and not na(p_c) and f_bounce_dn(p_h, p_c, bep_val)
    bool sec_pe_breakdown   = not na(p_c) and f_breakdown_dn(p_c, p_c[1], bep_val)

    chart_ce_cross or chart_ce_bounce_up or chart_pe_bounce_dn or chart_pe_breakdown or sec_ce_cross or sec_ce_bounce_up or sec_pe_bounce_dn or sec_pe_breakdown

// Put Sell Alert on a specific BEP line level:
// Evaluates Put crossover UP, Put support bounce UP, Call resistance rejection DOWN, or Call breakdown DOWN
f_eval_pe_pair_trig(float bep_val, float c_c, float c_h, float c_l, float p_c, float p_h, float p_l) =>
    // Active Chart Option Candle Triggers
    bool chart_pe_cross     = f_crossover_up(chart_pe_close, chart_pe_close[1], bep_val)
    bool chart_pe_bounce_up = f_bounce_up(chart_pe_low, chart_pe_close, bep_val)
    bool chart_ce_bounce_dn = f_bounce_dn(chart_ce_high, chart_ce_close, bep_val)
    bool chart_ce_breakdown = f_breakdown_dn(chart_ce_close, chart_ce_close[1], bep_val)

    // Level-specific Security Option Candle Triggers
    bool sec_pe_cross       = not na(p_c) and f_crossover_up(p_c, p_c[1], bep_val)
    bool sec_pe_bounce_up   = not na(p_l) and not na(p_c) and f_bounce_up(p_l, p_c, bep_val)
    bool sec_ce_bounce_dn   = not na(c_h) and not na(c_c) and f_bounce_dn(c_h, c_c, bep_val)
    bool sec_ce_breakdown   = not na(c_c) and f_breakdown_dn(c_c, c_c[1], bep_val)

    chart_pe_cross or chart_pe_bounce_up or chart_ce_bounce_dn or chart_ce_breakdown or sec_pe_cross or sec_pe_bounce_up or sec_ce_bounce_dn or sec_ce_breakdown

// Evaluate Triggers Across All 14 BEP Lines with Exact Matching Option Strike Pairs
bool ce_trig_m3_rt   = f_eval_ce_pair_trig(bep_rt_m3,   ce_c_m3, ce_h_m3, ce_l_m3, pe_c_p3, pe_h_p3, pe_l_p3)
bool ce_trig_m3_stat = f_eval_ce_pair_trig(bep_stat_m3, ce_c_m3, ce_h_m3, ce_l_m3, pe_c_p3, pe_h_p3, pe_l_p3)

bool pe_trig_m3_rt   = f_eval_pe_pair_trig(bep_rt_m3,   ce_c_m3, ce_h_m3, ce_l_m3, pe_c_p3, pe_h_p3, pe_l_p3)
bool pe_trig_m3_stat = f_eval_pe_pair_trig(bep_stat_m3, ce_c_m3, ce_h_m3, ce_l_m3, pe_c_p3, pe_h_p3, pe_l_p3)

bool ce_trig_m2_rt   = f_eval_ce_pair_trig(bep_rt_m2,   ce_c_m2, ce_h_m2, ce_l_m2, pe_c_p2, pe_h_p2, pe_l_p2)
bool ce_trig_m2_stat = f_eval_ce_pair_trig(bep_stat_m2, ce_c_m2, ce_h_m2, ce_l_m2, pe_c_p2, pe_h_p2, pe_l_p2)

bool pe_trig_m2_rt   = f_eval_pe_pair_trig(bep_rt_m2,   ce_c_m2, ce_h_m2, ce_l_m2, pe_c_p2, pe_h_p2, pe_l_p2)
bool pe_trig_m2_stat = f_eval_pe_pair_trig(bep_stat_m2, ce_c_m2, ce_h_m2, ce_l_m2, pe_c_p2, pe_h_p2, pe_l_p2)

bool ce_trig_m1_rt   = f_eval_ce_pair_trig(bep_rt_m1,   ce_c_m1, ce_h_m1, ce_l_m1, pe_c_p1, pe_h_p1, pe_l_p1)
bool ce_trig_m1_stat = f_eval_ce_pair_trig(bep_stat_m1, ce_c_m1, ce_h_m1, ce_l_m1, pe_c_p1, pe_h_p1, pe_l_p1)

bool pe_trig_m1_rt   = f_eval_pe_pair_trig(bep_rt_m1,   ce_c_m1, ce_h_m1, ce_l_m1, pe_c_p1, pe_h_p1, pe_l_p1)
bool pe_trig_m1_stat = f_eval_pe_pair_trig(bep_stat_m1, ce_c_m1, ce_h_m1, ce_l_m1, pe_c_p1, pe_h_p1, pe_l_p1)

bool ce_trig_0_rt    = f_eval_ce_pair_trig(bep_rt_0,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool ce_trig_0_stat  = f_eval_ce_pair_trig(bep_stat_0, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool pe_trig_0_rt    = f_eval_pe_pair_trig(bep_rt_0,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool pe_trig_0_stat  = f_eval_pe_pair_trig(bep_stat_0, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool ce_trig_p1_rt   = f_eval_ce_pair_trig(bep_rt_p1,   ce_c_p1, ce_h_p1, ce_l_p1, pe_c_m1, pe_h_m1, pe_l_m1)
bool ce_trig_p1_stat = f_eval_ce_pair_trig(bep_stat_p1, ce_c_p1, ce_h_p1, ce_l_p1, pe_c_m1, pe_h_m1, pe_l_m1)

bool pe_trig_p1_rt   = f_eval_pe_pair_trig(bep_rt_p1,   ce_c_p1, ce_h_p1, ce_l_p1, pe_c_m1, pe_h_m1, pe_l_m1)
bool pe_trig_p1_stat = f_eval_pe_pair_trig(bep_stat_p1, ce_c_p1, ce_h_p1, ce_l_p1, pe_c_m1, pe_h_m1, pe_l_m1)

bool ce_trig_p2_rt   = f_eval_ce_pair_trig(bep_rt_p2,   ce_c_p2, ce_h_p2, ce_l_p2, pe_c_m2, pe_h_m2, pe_l_m2)
bool ce_trig_p2_stat = f_eval_ce_pair_trig(bep_stat_p2, ce_c_p2, ce_h_p2, ce_l_p2, pe_c_m2, pe_h_m2, pe_l_m2)

bool pe_trig_p2_rt   = f_eval_pe_pair_trig(bep_rt_p2,   ce_c_p2, ce_h_p2, ce_l_p2, pe_c_m2, pe_h_m2, pe_l_m2)
bool pe_trig_p2_stat = f_eval_pe_pair_trig(bep_stat_p2, ce_c_p2, ce_h_p2, ce_l_p2, pe_c_m2, pe_h_m2, pe_l_m2)

bool ce_trig_p3_rt   = f_eval_ce_pair_trig(bep_rt_p3,   ce_c_p3, ce_h_p3, ce_l_p3, pe_c_m3, pe_h_m3, pe_l_m3)
bool ce_trig_p3_stat = f_eval_ce_pair_trig(bep_stat_p3, ce_c_p3, ce_h_p3, ce_l_p3, pe_c_m3, pe_h_m3, pe_l_m3)

bool pe_trig_p3_rt   = f_eval_pe_pair_trig(bep_rt_p3,   ce_c_p3, ce_h_p3, ce_l_p3, pe_c_m3, pe_h_m3, pe_l_m3)
bool pe_trig_p3_stat = f_eval_pe_pair_trig(bep_stat_p3, ce_c_p3, ce_h_p3, ce_l_p3, pe_c_m3, pe_h_m3, pe_l_m3)

// Combined Crossovers & Downside Bounces Across Active BEP Lines (Respecting bep_display_mode)
bool ce_rt_any   = ce_trig_m3_rt or ce_trig_m2_rt or ce_trig_m1_rt or ce_trig_0_rt or ce_trig_p1_rt or ce_trig_p2_rt or ce_trig_p3_rt
bool ce_stat_any = ce_trig_m3_stat or ce_trig_m2_stat or ce_trig_m1_stat or ce_trig_0_stat or ce_trig_p1_stat or ce_trig_p2_stat or ce_trig_p3_stat

bool pe_rt_any   = pe_trig_m3_rt or pe_trig_m2_rt or pe_trig_m1_rt or pe_trig_0_rt or pe_trig_p1_rt or pe_trig_p2_rt or pe_trig_p3_rt
bool pe_stat_any = pe_trig_m3_stat or pe_trig_m2_stat or pe_trig_m1_stat or pe_trig_0_stat or pe_trig_p1_stat or pe_trig_p2_stat or pe_trig_p3_stat

bool ce_any_bep_trig = (show_rt_bep and ce_rt_any) or (show_stat_bep and ce_stat_any)
bool pe_any_bep_trig = (show_rt_bep and pe_rt_any) or (show_stat_bep and pe_stat_any)

// --- Combined Raw Buy & Sell Triggers Across All 14 BEP Lines ---
bool raw_buy_alert  = ce_any_bep_trig and ce_filters_met and not (pe_any_bep_trig and pe_filters_met)
bool raw_sell_alert = pe_any_bep_trig and pe_filters_met and not (ce_any_bep_trig and ce_filters_met)

// --- Strict Alternating Swing Lock State Machine ---
var int activeSwing = 0 // 0 = Neutral, 1 = In BUY Swing, -1 = In SELL Swing

// Reset swing lock on new day opening so every day starts fresh irrespective of yesterday's last alert
if ta.change(time("D")) != 0
    activeSwing := 0

bool overall_buy_alert  = false
bool overall_sell_alert = false

if raw_buy_alert and activeSwing != 1
    overall_buy_alert := true
    activeSwing       := 1
else if raw_sell_alert and activeSwing != -1
    overall_sell_alert := true
    activeSwing        := -1

// --- Momentum BLAST Signals (Evaluated ONLY during regular triggers when enabled) ---
bool ce_blast_active = enable_blast_alerts and overall_buy_alert  and ce_rsi_blast_cond and ce_adx_blast_cond and ce_macd_pass
bool pe_blast_active = enable_blast_alerts and overall_sell_alert and pe_rsi_blast_cond and pe_adx_blast_cond and pe_macd_pass

// Special Fresh Intrinsic Value Signals
bool fresh_iv_buy_signal  = overall_buy_alert and ce_fresh_iv
bool fresh_iv_sell_signal = overall_sell_alert and pe_fresh_iv

// --- Dynamic Label & Shape Drawing using label.new (0 plot slots consumed!) ---
show_signal_shapes = input.bool(true, "Show CE / PE Signal Markers", group="Visual Signals")

if show_signal_shapes
    if overall_buy_alert
        string ce_lbl = ce_blast_active ? "CE BLAST 🔥" : (ce_fresh_iv ? "FRESH IV CE ★" : "CE")
        color  ce_col = ce_blast_active ? #00FF66 : (ce_fresh_iv ? #FFD700 : #00E676)
        color  ce_txt = (ce_blast_active or ce_fresh_iv) ? color.black : color.white
        label.new(bar_index, low, text=ce_lbl, style=label.style_label_up, color=ce_col, textcolor=ce_txt, size=ce_blast_active ? size.normal : size.small)
    else if overall_sell_alert
        string pe_lbl = pe_blast_active ? "PE BLAST 🔥" : (pe_fresh_iv ? "FRESH IV PE ★" : "PE")
        color  pe_col = pe_blast_active ? #FF0055 : (pe_fresh_iv ? #FFD700 : #FF1744)
        color  pe_txt = color.white
        label.new(bar_index, high, text=pe_lbl, style=label.style_label_down, color=pe_col, textcolor=pe_txt, size=pe_blast_active ? size.normal : size.small)
    
    if ce_fresh_iv and not overall_buy_alert
        label.new(bar_index, low, text="CE IV★", style=label.style_diamond, color=#FFD700, textcolor=color.black, size=size.tiny)
    if pe_fresh_iv and not overall_sell_alert
        label.new(bar_index, high, text="PE IV★", style=label.style_diamond, color=#FFD700, textcolor=color.black, size=size.tiny)

// ==========================================
// LIVE ALERT CONDITIONS STATUS TABLE
// ==========================================

f_get_table_pos(string pos_str) =>
    switch pos_str
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

var table statusTable = table.new(f_get_table_pos(table_pos_input), 2, 10, bgcolor=color.black, border_width=1, border_color=color.gray, force_overlay=true)

if barstate.islast and show_status_table
    table.cell(statusTable, 0, 0, "Alert Condition Rule", bgcolor=#1565C0, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 0, "Current Status", bgcolor=#1565C0, text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 1, "7 BEP Levels Realtime & Static", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 1, (ce_any_bep_trig or pe_any_bep_trig) ? "PASS (TRUE)" : "FAIL (FALSE)", bgcolor=(ce_any_bep_trig or pe_any_bep_trig) ? #1B5E20 : #880E4F, text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 2, "Basket Top Position Rule", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 2, (ceAvgCur > peAvgCur) ? "CE ON TOP (CE OK)" : "PE ON TOP (PE OK)", bgcolor=(ceAvgCur > peAvgCur) ? #1B5E20 : #880E4F, text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 3, "CE 3-Candle Delta Winner", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 3, (ce_delta_3bar > 0) ? ("CE BUY WINNER (+" + str.tostring(ce_delta_3bar, "#") + ")") : ("PE WINNER / CE SELL (" + str.tostring(ce_delta_3bar, "#") + ")"), bgcolor=(ce_delta_3bar > 0) ? #1B5E20 : #880E4F, text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 4, "RSI Filter (" + (use_rsi_filter ? "ENABLED" : "OFF") + ")", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 4, not use_rsi_filter ? "OFF (" + str.tostring(rsi_val, "#.1") + ")" : (ce_rsi_blast_cond ? "CE BLAST (RSI " + str.tostring(rsi_val, "#.1") + ")" : (pe_rsi_blast_cond ? "PE BLAST (RSI " + str.tostring(rsi_val, "#.1") + ")" : "NEUTRAL (" + str.tostring(rsi_val, "#.1") + ")")), bgcolor=not use_rsi_filter ? #424242 : (ce_rsi_blast_cond ? #00FF66 : (pe_rsi_blast_cond ? #FF0055 : #212121)), text_color=ce_rsi_blast_cond and use_rsi_filter ? color.black : color.white, text_size=size.small)

    table.cell(statusTable, 0, 5, "ADX Filter (" + (use_adx_filter ? "ENABLED" : "OFF") + ")", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 5, not use_adx_filter ? "OFF (" + str.tostring(adx_val, "#.1") + ")" : (adx_level_pass and adx_up_slant ? "PASS (" + str.tostring(adx_val, "#.1") + ")" : "FAIL (" + str.tostring(adx_val, "#.1") + ")"), bgcolor=not use_adx_filter ? #424242 : (adx_level_pass and adx_up_slant ? #1B5E20 : #880E4F), text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 6, "DI+ / DI- Cross Filter (" + (use_di_cross ? "ON" : "OFF") + ")", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 6, not use_di_cross ? "OFF" : (plusDI > minusDI ? "CE (DI+ > DI-)" : "PE (DI- > DI+)"), bgcolor=not use_di_cross ? #424242 : (plusDI > minusDI ? #1B5E20 : #880E4F), text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 7, "MACD Filter (" + (use_macd_filter ? "ENABLED" : "OFF") + ")", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 7, not use_macd_filter ? "OFF" : (ce_macd_pass ? "CE MACD OK" : (pe_macd_pass ? "PE MACD OK" : "NEUTRAL")), bgcolor=not use_macd_filter ? #424242 : (ce_macd_pass ? #1B5E20 : (pe_macd_pass ? #880E4F : #212121)), text_color=color.white, text_size=size.small)

    table.cell(statusTable, 0, 8, "Fresh Intrinsic Value State", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 8, ce_fresh_iv ? "CE FRESH IV ★" : (pe_fresh_iv ? "PE FRESH IV ★" : "NONE"), bgcolor=(ce_fresh_iv or pe_fresh_iv) ? #FFD700 : #212121, text_color=(ce_fresh_iv or pe_fresh_iv) ? color.black : color.white, text_size=size.small)

    table.cell(statusTable, 0, 9, "Overall Alert Status", bgcolor=#37474F, text_color=color.white, text_size=size.small)
    table.cell(statusTable, 1, 9, ce_blast_active ? "CE BLAST 🔥" : (pe_blast_active ? "PE BLAST 🔥" : (overall_buy_alert ? (ce_fresh_iv ? "FRESH IV CE ★" : "CE ALERT ACTIVE") : (overall_sell_alert ? (pe_fresh_iv ? "FRESH IV PE ★" : "PE ALERT ACTIVE") : "WAITING"))), bgcolor=ce_blast_active ? #00FF66 : (pe_blast_active ? #FF0055 : (overall_buy_alert ? #00E676 : (overall_sell_alert ? #FF1744 : color.black))), text_color=(ce_blast_active or overall_buy_alert) ? color.black : color.white, text_size=size.small)

// --- TradingView Alert Conditions ---
alertcondition(overall_buy_alert,  title="CE Signal Alert (Call Buy)", message="CE ALERT: Call signal triggered on BEP line on {{ticker}}!")
alertcondition(overall_sell_alert, title="PE Signal Alert (Put Sell)", message="PE ALERT: Put signal triggered on BEP line on {{ticker}}!")
