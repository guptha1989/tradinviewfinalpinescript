//@version=6
indicator("19.Techfrost Multi-Strike BEP & Dynamic Step-Up Extension Analytics", shorttitle="19.BEP Master", overlay=true, precision=2, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum UnderlyingAsset
    auto      = "Auto-Detect"
    nifty     = "NIFTY"
    banknifty = "BANKNIFTY"
    crudeoil  = "CRUDEOIL"
    gold      = "GOLD"
    stock     = "Stock (Equity)"

enum OptionType
    auto = "Auto-Detect"
    ce   = "Call (CE)"
    pe   = "Put (PE)"

enum StaticBasisMode
    day_open   = "Day Open LTP"
    prev_close = "Previous Day Settlement LTP"
    first_5min = "First 5 Min Close LTP"

enum StepOverrideChoice
    auto    = "Auto"
    step1   = "1"
    step2_5 = "2.5"
    step5   = "5"
    step10  = "10"
    step20  = "20"
    step25  = "25"
    step50  = "50"
    step100 = "100"
    step200 = "200"
    step500 = "500"

// --- Instrument Settings ---
underlyingInput    = input.enum(UnderlyingAsset.auto, "Underlying Asset", group="Instrument Settings")
optionTypeInput    = input.enum(OptionType.auto, "Option Type", group="Instrument Settings")
manualStrikeInput  = input.int(0, "Manual Strike Selection (0 = Auto)", minval=0, group="Instrument Settings",
  tooltip="Enter strike price manually (e.g. 24000). Leave at 0 to auto-detect from chart symbol.")
spotTickerOverride = input.symbol("", "Spot Symbol Override (e.g. NSE:NIFTY)", group="Instrument Settings")
strikeOverride     = input.float(0.0, "Strike Price Override", minval=0.0, group="Instrument Settings")
strikeStepInput    = input.enum(StepOverrideChoice.auto, "Strike Step Override", group="Instrument Settings",
  tooltip="Set to Auto for auto-detection based on underlying stock/index.")

// --- BEP Calculation Settings ---
bepOffsetChoice    = input.string("50 Points", "Strike Offset Points", options=["Auto (Strike Step)", "5 Points", "10 Points", "15 Points", "20 Points", "25 Points", "40 Points", "50 Points", "100 Points", "150 Points", "200 Points"], group="BEP CALCULATION SETTINGS",
  tooltip="Offset interval step used for calculating ITM 1..3 and OTM 1..3 BEP Lines.")
staticBasisInput   = input.enum(StaticBasisMode.day_open, "Static BEP Calculation Basis", group="BEP CALCULATION SETTINGS",
  tooltip="Select reference price basis for Static BEP calculations.")

// --- Feature Enable / Disable Switches ---
show_rt_bep_lines   = input.bool(true, "Show Realtime BEP Lines", group="Feature Enable / Disable Switches")
show_stat_bep_lines = input.bool(true, "Show Static BEP Lines", group="Feature Enable / Disable Switches")
show_atm_bep        = input.bool(true, "Show ATM Level (L0)", group="Feature Enable / Disable Switches")
show_itm_bep        = input.bool(true, "Show ITM Levels (L-1, L-2, L-3)", group="Feature Enable / Disable Switches")
show_otm_bep        = input.bool(true, "Show OTM Levels (L+1, L+2, L+3)", group="Feature Enable / Disable Switches")
show_extension_line = input.bool(true, "Show Dynamic Realtime Step-Up Extension Line", group="Feature Enable / Disable Switches")
show_opp_candles    = input.bool(true, "Show Opposite Option Candles Overlay", group="Feature Enable / Disable Switches")
show_signal_shapes  = input.bool(true, "Show Signal Labels on Chart", group="Feature Enable / Disable Switches")
show_dashboard      = input.bool(true, "Show Analytics Dashboard Table", group="Feature Enable / Disable Switches")
enable_alert_engine = input.bool(true, "Enable Buy / Sell Alert Engine", group="Feature Enable / Disable Switches")

// --- Plot Formatting & Styling (Colors & Plot Types) ---
rt_bep_style_str   = input.string("Line with Breaks", "Realtime BEP Line Style", options=["Solid", "Line with Breaks", "Dashed/Dotted", "Circles", "Step Line"], group="Plot Formatting & Styling")
stat_bep_style_str = input.string("Line with Breaks", "Static BEP Line Style", options=["Solid", "Line with Breaks", "Dashed/Dotted", "Circles", "Step Line"], group="Plot Formatting & Styling")
ext_line_style_str = input.string("Solid", "Dynamic Extension Line Style", options=["Solid", "Line with Breaks", "Dashed/Dotted", "Circles", "Step Line"], group="Plot Formatting & Styling")

atm_bep_width      = input.int(2, "ATM BEP Line Width", minval=1, maxval=4, group="Plot Formatting & Styling")
other_bep_width    = input.int(1, "ITM / OTM BEP Line Width", minval=1, maxval=4, group="Plot Formatting & Styling")
ext_line_width     = input.int(2, "Dynamic Extension Line Width", minval=1, maxval=4, group="Plot Formatting & Styling")

col_atm_rt         = input.color(#FFFFFF, "ATM Realtime Color", group="Plot Formatting & Styling")
col_atm_stat       = input.color(#FFEA00, "ATM Static Color", group="Plot Formatting & Styling")
col_itm1           = input.color(#00E5FF, "ITM 1 Color", group="Plot Formatting & Styling")
col_itm2           = input.color(#2979FF, "ITM 2 Color", group="Plot Formatting & Styling")
col_itm3           = input.color(#AA00FF, "ITM 3 Color", group="Plot Formatting & Styling")
col_otm1           = input.color(#FF9100, "OTM 1 Color", group="Plot Formatting & Styling")
col_otm2           = input.color(#00BFA5, "OTM 2 Color", group="Plot Formatting & Styling")
col_otm3           = input.color(#76FF03, "OTM 3 Color", group="Plot Formatting & Styling")
col_extension_line = input.color(#FFEA00, "Dynamic Extension Line Color", group="Plot Formatting & Styling")
c_opp_bull         = input.color(color.new(#2962FF, 40), "Opposite Bullish Body", group="Plot Formatting & Styling")
c_opp_bear         = input.color(color.new(#FF6D00, 40), "Opposite Bearish Body", group="Plot Formatting & Styling")
c_opp_bull_wick    = input.color(color.new(#2962FF, 60), "Opposite Bullish Wick", group="Plot Formatting & Styling")
c_opp_bear_wick    = input.color(color.new(#FF6D00, 60), "Opposite Bearish Wick", group="Plot Formatting & Styling")

// --- Signal Label & Alert Styling ---
ce_label_color     = input.color(#00E676, "Call (CE) Label Color", group="Signal Label & Alert Styling")
pe_label_color     = input.color(#FF1744, "Put (PE) Label Color", group="Signal Label & Alert Styling")
ce_label_textcolor = input.color(color.black, "Call (CE) Text Color", group="Signal Label & Alert Styling")
pe_label_textcolor = input.color(color.white, "Put (PE) Text Color", group="Signal Label & Alert Styling")
ce_label_pos_str   = input.string("Below Bar (Up Arrow)", "Call (CE) Label Position", options=["Below Bar (Up Arrow)", "Above Bar (Down Arrow)"], group="Signal Label & Alert Styling")
pe_label_pos_str   = input.string("Above Bar (Down Arrow)", "Put (PE) Label Position", options=["Above Bar (Down Arrow)", "Below Bar (Up Arrow)"], group="Signal Label & Alert Styling")
label_size_str     = input.string("Small", "Signal Label Size", options=["Tiny", "Small", "Normal", "Large"], group="Signal Label & Alert Styling")

// --- Trigger Points & Level Selection ---
eval_rt_bep        = input.bool(true, "Evaluate Realtime BEP Lines for Alerts", group="Trigger Points & Levels")
eval_stat_bep      = input.bool(true, "Evaluate Static BEP Lines for Alerts", group="Trigger Points & Levels")

// --- MACD Confluence & Indicator Settings ---
use_macd_confluence    = input.bool(true, "Require MACD Confluence Filter", group="MACD Settings")
macd_eval_mode_str     = input.string("Zero Line (> 0 CE / < 0 PE)", "MACD Evaluation Mode", options=["Zero Line (> 0 CE / < 0 PE)", "Signal Line Cross (MACD > Signal CE)", "Both Zero Line & Signal Cross"], group="MACD Settings")
macd_favourable_window = input.int(3, "MACD Favourable Window (Candles)", minval=1, maxval=5, group="MACD Settings",
  tooltip="Triggers alert immediately or up to N candles after BEP crossover if MACD turns favourable (> 0 CE / < 0 PE) within this candle window.")
macd_fast_len          = input.int(12, "MACD Fast Length", minval=1, group="MACD Settings")
macd_slow_len          = input.int(26, "MACD Slow Length", minval=1, group="MACD Settings")
macd_signal_len        = input.int(9, "MACD Signal Length", minval=1, group="MACD Settings")
macd_src               = input.source(close, "MACD Price Source", group="MACD Settings")

// --- RSI Confluence Settings ---
use_rsi_confluence  = input.bool(true, "Require RSI Confluence (> 50 CE / < 50 PE)", group="RSI Settings")
rsi_length          = input.int(14, "RSI Period Length", group="RSI Settings")
rsi_ce_thresh       = input.float(50.0, "CE RSI Threshold", group="RSI Settings")
rsi_pe_thresh       = input.float(50.0, "PE RSI Threshold", group="RSI Settings")

require_bar_close   = input.bool(true, "Require Candle Close Confirmation", group="Confirmation Settings",
  tooltip="When enabled, entry signals trigger strictly on confirmed candle close (barstate.isconfirmed).")

show_dashboard_pos  = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Visual & Plot Controls")

// ==========================================
// TICKER PARSING & AUTO-DETECTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

// ----- Detect underlying -----
UnderlyingAsset actualUnderlying = na
if underlyingInput == UnderlyingAsset.auto
    if str.contains(cleanTicker, "BANKNIFTY")
        actualUnderlying := UnderlyingAsset.banknifty
    else if str.contains(cleanTicker, "NIFTY")
        actualUnderlying := UnderlyingAsset.nifty
    else if str.contains(cleanTicker, "CRUDEOIL")
        actualUnderlying := UnderlyingAsset.crudeoil
    else if str.contains(cleanTicker, "GOLD") and not str.contains(cleanTicker, "GOLDM") and not str.contains(cleanTicker, "GOLDPETAL")
        actualUnderlying := UnderlyingAsset.gold
    else
        actualUnderlying := UnderlyingAsset.stock
else
    actualUnderlying := underlyingInput

// ----- Detect option type -----
bool isCall = false
bool isPut  = false

if optionTypeInput == OptionType.ce
    isCall := true
else if optionTypeInput == OptionType.pe
    isPut := true
else
    if str.contains(cleanTicker, "CE")
        isCall := true
    else if str.contains(cleanTicker, "PE")
        isPut := true
    else if str.match(cleanTicker, "C\\d+$") != ""
        isCall := true
    else if str.match(cleanTicker, "P\\d+$") != ""
        isPut := true

// ==========================================
// SPOT TICKER & STEP RESOLUTION
// ==========================================

string spotTicker = ""
if str.length(spotTickerOverride) > 0
    spotTicker := spotTickerOverride
else
    switch actualUnderlying
        UnderlyingAsset.banknifty => spotTicker := "NSE:BANKNIFTY"
        UnderlyingAsset.nifty     => spotTicker := "NSE:NIFTY"
        UnderlyingAsset.crudeoil  => spotTicker := "MCX:CRUDEOIL1!"
        UnderlyingAsset.gold      => spotTicker := "MCX:GOLD1!"
        UnderlyingAsset.stock     =>
            string rootGuess = str.match(cleanTicker, "^[A-Z&]+")
            if rootGuess != ""
                spotTicker := syminfo.prefix + ":" + rootGuess
            else
                spotTicker := syminfo.prefix + ":" + cleanTicker

f_auto_detect_step(float ref_p) =>
    float s_res = 50.0
    if na(ref_p) or ref_p <= 0
        s_res := 50.0
    else if ref_p < 100
        s_res := 1.0
    else if ref_p < 250
        s_res := 2.5
    else if ref_p < 500
        s_res := 5.0
    else if ref_p < 1200
        s_res := 10.0
    else if ref_p < 2500
        s_res := 20.0
    else
        s_res := 50.0
    s_res

float stepVal = switch actualUnderlying
    UnderlyingAsset.banknifty => 100.0
    UnderlyingAsset.nifty     => 50.0
    UnderlyingAsset.crudeoil  => 50.0
    UnderlyingAsset.gold      => 100.0
    UnderlyingAsset.stock     => 50.0

if strikeStepInput != StepOverrideChoice.auto
    stepVal := switch strikeStepInput
        StepOverrideChoice.step1   => 1.0
        StepOverrideChoice.step2_5 => 2.5
        StepOverrideChoice.step5   => 5.0
        StepOverrideChoice.step10  => 10.0
        StepOverrideChoice.step20  => 20.0
        StepOverrideChoice.step25  => 25.0
        StepOverrideChoice.step50  => 50.0
        StepOverrideChoice.step100 => 100.0
        StepOverrideChoice.step200 => 200.0
        StepOverrideChoice.step500 => 500.0
        => stepVal

// ----- Robust Strike extraction from chart symbol -----
float detectedStrike = na
string tickerWithoutCEPE = ""

int tickerLen = str.length(cleanTicker)
if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, tickerLen - 2)

string matchC = str.match(cleanTicker, "C\\d+$")
string matchP = str.match(cleanTicker, "P\\d+$")

if matchC != ""
    detectedStrike := str.tonumber(str.substring(matchC, 1))
else if matchP != ""
    detectedStrike := str.tonumber(str.substring(matchP, 1))
else if tickerWithoutCEPE != ""
    string strikeDigits = str.match(tickerWithoutCEPE, "\\d+$")
    detectedStrike := str.tonumber(strikeDigits)

// Fetch spot price for strike auto-rounding fallback
float spot_close_temp = request.security(spotTicker, timeframe.period, close, ignore_invalid_symbol=true)

if na(detectedStrike) or detectedStrike <= 0
    if not na(spot_close_temp) and stepVal > 0
        detectedStrike := math.round(spot_close_temp / stepVal) * stepVal

float chartStrikePrice = strikeOverride > 0.0 ? strikeOverride : (manualStrikeInput > 0 ? float(manualStrikeInput) : detectedStrike)

if actualUnderlying == UnderlyingAsset.stock and strikeStepInput == StepOverrideChoice.auto
    stepVal := f_auto_detect_step(chartStrikePrice)

// Parse Separate Offset Interval Steps for BEP Lines and IV/TV Analytics
f_parse_offset(string optStr, float defaultStep) =>
    switch optStr
        "5 Points"   => 5.0
        "10 Points"  => 10.0
        "15 Points"  => 15.0
        "20 Points"  => 20.0
        "25 Points"  => 25.0
        "40 Points"  => 40.0
        "50 Points"  => 50.0
        "100 Points" => 100.0
        "150 Points" => 150.0
        "200 Points" => 200.0
        => defaultStep

float bepOffsetPts = f_parse_offset(bepOffsetChoice, stepVal)

// ==========================================
// FAIL-SAFE TICKER CONSTRUCTORS
// ==========================================

f_build_option_symbol(float target_strike, bool target_is_ce) =>
    string target_st_str = target_strike == math.floor(target_strike) ? str.tostring(int(target_strike)) : str.tostring(target_strike)
    
    if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
        int end_trim = 2
        string base_no_suffix = str.substring(cleanTicker, 0, str.length(cleanTicker) - end_trim)
        string strikeDigits = str.match(base_no_suffix, "\\d+$")
        if strikeDigits != ""
            string pfx = str.substring(base_no_suffix, 0, str.length(base_no_suffix) - str.length(strikeDigits))
            string sfx = target_is_ce ? "CE" : "PE"
            pfx + target_st_str + sfx
        else
            cleanTicker
    else if str.match(cleanTicker, "[CP]\\d+$") != ""
        string matchCP = str.match(cleanTicker, "[CP]\\d+$")
        int matchPos = str.pos(cleanTicker, matchCP)
        string pfx = str.substring(cleanTicker, 0, matchPos)
        string cp_letter = target_is_ce ? "C" : "P"
        pfx + cp_letter + target_st_str
    else
        string root = str.match(cleanTicker, "^[A-Z&]+")
        string sfx = target_is_ce ? "CE" : "PE"
        (root != "" ? root : cleanTicker) + target_st_str + sfx

// BEP Strike Definitions (ATM, 3 ITM, 3 OTM) using bepOffsetPts
float k_0  = chartStrikePrice
float k_m1 = chartStrikePrice - bepOffsetPts
float k_m2 = chartStrikePrice - (2.0 * bepOffsetPts)
float k_m3 = chartStrikePrice - (3.0 * bepOffsetPts)
float k_p1 = chartStrikePrice + bepOffsetPts
float k_p2 = chartStrikePrice + (2.0 * bepOffsetPts)
float k_p3 = chartStrikePrice + (3.0 * bepOffsetPts)

// Tickers
string ce_tkr_0  = f_build_option_symbol(k_0, true)
string pe_tkr_0  = f_build_option_symbol(k_0, false)

string ce_tkr_m1 = f_build_option_symbol(k_m1, true)
string pe_tkr_m1 = f_build_option_symbol(k_m1, false)

string ce_tkr_m2 = f_build_option_symbol(k_m2, true)
string pe_tkr_m2 = f_build_option_symbol(k_m2, false)

string ce_tkr_m3 = f_build_option_symbol(k_m3, true)
string pe_tkr_m3 = f_build_option_symbol(k_m3, false)

string ce_tkr_p1 = f_build_option_symbol(k_p1, true)
string pe_tkr_p1 = f_build_option_symbol(k_p1, false)

string ce_tkr_p2 = f_build_option_symbol(k_p2, true)
string pe_tkr_p2 = f_build_option_symbol(k_p2, false)

string ce_tkr_p3 = f_build_option_symbol(k_p3, true)
string pe_tkr_p3 = f_build_option_symbol(k_p3, false)

// ==========================================
// TUPLE SECURITY DATA FETCHING
// ==========================================

f_get_strike_ohlc(string tkr) =>
    [c, h, l, op, cl1] = request.security(tkr, timeframe.period, [close, high, low, open, close[1]], ignore_invalid_symbol=true)
    float static_p = staticBasisInput == StaticBasisMode.prev_close ? cl1 : (staticBasisInput == StaticBasisMode.first_5min ? ta.valuewhen((hour == 9 and minute >= 19) or hour > 9, c, 0) : ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, op, 0))
    [c, h, l, op, static_p]

[ce_c_0, ce_h_0, ce_l_0, ce_open_0, ce_o_0]   = f_get_strike_ohlc(ce_tkr_0)
[pe_c_0, pe_h_0, pe_l_0, pe_open_0, pe_o_0]   = f_get_strike_ohlc(pe_tkr_0)

[ce_c_m1, ce_h_m1, ce_l_m1, ce_open_m1, ce_o_m1] = f_get_strike_ohlc(ce_tkr_m1)
[pe_c_m1, pe_h_m1, pe_l_m1, pe_open_m1, pe_o_m1] = f_get_strike_ohlc(pe_tkr_m1)

[ce_c_m2, ce_h_m2, ce_l_m2, ce_open_m2, ce_o_m2] = f_get_strike_ohlc(ce_tkr_m2)
[pe_c_m2, pe_h_m2, pe_l_m2, pe_open_m2, pe_o_m2] = f_get_strike_ohlc(pe_tkr_m2)

[ce_c_m3, ce_h_m3, ce_l_m3, ce_open_m3, ce_o_m3] = f_get_strike_ohlc(ce_tkr_m3)
[pe_c_m3, pe_h_m3, pe_l_m3, pe_open_m3, pe_o_m3] = f_get_strike_ohlc(pe_tkr_m3)

[ce_c_p1, ce_h_p1, ce_l_p1, ce_open_p1, ce_o_p1] = f_get_strike_ohlc(ce_tkr_p1)
[pe_c_p1, pe_h_p1, pe_l_p1, pe_open_p1, pe_o_p1] = f_get_strike_ohlc(pe_tkr_p1)

[ce_c_p2, ce_h_p2, ce_l_p2, ce_open_p2, ce_o_p2] = f_get_strike_ohlc(ce_tkr_p2)
[pe_c_p2, pe_h_p2, pe_l_p2, pe_open_p2, pe_o_p2] = f_get_strike_ohlc(pe_tkr_p2)

[ce_c_p3, ce_h_p3, ce_l_p3, ce_open_p3, ce_o_p3] = f_get_strike_ohlc(ce_tkr_p3)
[pe_c_p3, pe_h_p3, pe_l_p3, pe_open_p3, pe_o_p3] = f_get_strike_ohlc(pe_tkr_p3)

float spot_c = spot_close_temp
float spot_o = staticBasisInput == StaticBasisMode.prev_close ? ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, spot_close_temp[1], 0) : ta.valuewhen(ta.change(time("D")) != 0 or bar_index == 0, open, 0)
spot_c := na(spot_c) ? chartStrikePrice : spot_c
spot_o := na(spot_o) ? spot_c : spot_o

// Chart Symbol Close (for Confluence Filter calculations)
float chart_ce_close = isCall ? close : ce_c_0
float chart_pe_close = isPut  ? close : pe_c_0

// ==========================================
// STANDARD STRIKE STEP DATA FOR EXTENSION LINES
// ==========================================
bool is_same_step = (bepOffsetPts == stepVal)

float ext_k_m1 = chartStrikePrice - stepVal
float ext_k_m2 = chartStrikePrice - (2.0 * stepVal)
float ext_k_m3 = chartStrikePrice - (3.0 * stepVal)
float ext_k_p1 = chartStrikePrice + stepVal
float ext_k_p2 = chartStrikePrice + (2.0 * stepVal)
float ext_k_p3 = chartStrikePrice + (3.0 * stepVal)

string ext_ce_tkr_m1 = f_build_option_symbol(ext_k_m1, true)
string ext_pe_tkr_m1 = f_build_option_symbol(ext_k_m1, false)
string ext_ce_tkr_m2 = f_build_option_symbol(ext_k_m2, true)
string ext_pe_tkr_m2 = f_build_option_symbol(ext_k_m2, false)
string ext_ce_tkr_p1 = f_build_option_symbol(ext_k_p1, true)
string ext_pe_tkr_p1 = f_build_option_symbol(ext_k_p1, false)
string ext_ce_tkr_p2 = f_build_option_symbol(ext_k_p2, true)
string ext_pe_tkr_p2 = f_build_option_symbol(ext_k_p2, false)
string ext_ce_tkr_p3 = f_build_option_symbol(ext_k_p3, true)
string ext_pe_tkr_p3 = f_build_option_symbol(ext_k_p3, false)

float ext_ce_c_0  = ce_c_0
float ext_pe_c_0  = pe_c_0

float ext_ce_c_m1 = is_same_step ? ce_c_m1 : request.security(ext_ce_tkr_m1, timeframe.period, close, ignore_invalid_symbol=true)
float ext_pe_c_m1 = is_same_step ? pe_c_m1 : request.security(ext_pe_tkr_m1, timeframe.period, close, ignore_invalid_symbol=true)

float ext_ce_c_m2 = is_same_step ? ce_c_m2 : request.security(ext_ce_tkr_m2, timeframe.period, close, ignore_invalid_symbol=true)
float ext_pe_c_m2 = is_same_step ? pe_c_m2 : request.security(ext_pe_tkr_m2, timeframe.period, close, ignore_invalid_symbol=true)

float ext_ce_c_p1 = is_same_step ? ce_c_p1 : request.security(ext_ce_tkr_p1, timeframe.period, close, ignore_invalid_symbol=true)
float ext_pe_c_p1 = is_same_step ? pe_c_p1 : request.security(ext_pe_tkr_p1, timeframe.period, close, ignore_invalid_symbol=true)

float ext_ce_c_p2 = is_same_step ? ce_c_p2 : request.security(ext_ce_tkr_p2, timeframe.period, close, ignore_invalid_symbol=true)
float ext_pe_c_p2 = is_same_step ? pe_c_p2 : request.security(ext_pe_tkr_p2, timeframe.period, close, ignore_invalid_symbol=true)

float ext_ce_c_p3 = is_same_step ? ce_c_p3 : request.security(ext_ce_tkr_p3, timeframe.period, close, ignore_invalid_symbol=true)
float ext_pe_c_p3 = is_same_step ? pe_c_p3 : request.security(ext_pe_tkr_p3, timeframe.period, close, ignore_invalid_symbol=true)

// ==========================================
// MULTI-STRIKE BEP LINES (7 LEVELS)
// ==========================================

// ATM BEP
float bep_rt_0   = (ce_c_0 + pe_c_0) / 2.0
float bep_stat_0 = (ce_o_0 + pe_o_0) / 2.0

// ITM 1 BEP (CE ITM 1 + PE OTM 1)
float bep_rt_m1   = (ce_c_m1 + pe_c_p1) / 2.0
float bep_stat_m1 = (ce_o_m1 + pe_o_p1) / 2.0

// ITM 2 BEP (CE ITM 2 + PE OTM 2)
float bep_rt_m2   = (ce_c_m2 + pe_c_p2) / 2.0
float bep_stat_m2 = (ce_o_m2 + pe_o_p2) / 2.0

// ITM 3 BEP (CE ITM 3 + PE OTM 3)
float bep_rt_m3   = (ce_c_m3 + pe_c_p3) / 2.0
float bep_stat_m3 = (ce_o_m3 + pe_o_p3) / 2.0

// OTM 1 BEP (CE OTM 1 + PE ITM 1)
float bep_rt_p1   = (ce_c_p1 + pe_c_m1) / 2.0
float bep_stat_p1 = (ce_o_p1 + pe_o_m1) / 2.0

// OTM 2 BEP (CE OTM 2 + PE ITM 2)
float bep_rt_p2   = (ce_c_p2 + pe_c_m2) / 2.0
float bep_stat_p2 = (ce_o_p2 + pe_o_m2) / 2.0

// OTM 3 BEP (CE OTM 3 + PE ITM 3)
float bep_rt_p3   = (ce_c_p3 + pe_c_m3) / 2.0
float bep_stat_p3 = (ce_o_p3 + pe_o_m3) / 2.0

// Direct Constant Plot Style Evaluation
plot_style_rt   = rt_bep_style_str == "Solid" ? plot.style_line : (rt_bep_style_str == "Circles" ? plot.style_circles : (rt_bep_style_str == "Step Line" ? plot.style_stepline : plot.style_linebr))
plot_style_stat = stat_bep_style_str == "Solid" ? plot.style_line : (stat_bep_style_str == "Circles" ? plot.style_circles : (stat_bep_style_str == "Step Line" ? plot.style_stepline : plot.style_linebr))
plot_style_ext  = ext_line_style_str == "Solid" ? plot.style_line : (ext_line_style_str == "Circles" ? plot.style_circles : (ext_line_style_str == "Step Line" ? plot.style_stepline : plot.style_linebr))

// --- Plot 7 Levels of BEP Lines ---
plot(show_rt_bep_lines and show_atm_bep ? bep_rt_0 : na,      title="ATM Realtime BEP (L0)", color=col_atm_rt, linewidth=atm_bep_width, style=plot_style_rt)
plot(show_stat_bep_lines and show_atm_bep ? bep_stat_0 : na,  title="ATM Static BEP (L0)",   color=col_atm_stat, linewidth=atm_bep_width, style=plot_style_stat)

plot(show_rt_bep_lines and show_itm_bep ? bep_rt_m1 : na,     title="ITM1 Realtime BEP (L-1)", color=col_itm1, linewidth=other_bep_width, style=plot_style_rt)
plot(show_stat_bep_lines and show_itm_bep ? bep_stat_m1 : na, title="ITM1 Static BEP (L-1)",   color=color.new(col_itm1, 40), linewidth=other_bep_width, style=plot_style_stat)

plot(show_rt_bep_lines and show_itm_bep ? bep_rt_m2 : na,     title="ITM2 Realtime BEP (L-2)", color=col_itm2, linewidth=other_bep_width, style=plot_style_rt)
plot(show_stat_bep_lines and show_itm_bep ? bep_stat_m2 : na, title="ITM2 Static BEP (L-2)",   color=color.new(col_itm2, 40), linewidth=other_bep_width, style=plot_style_stat)

plot(show_rt_bep_lines and show_itm_bep ? bep_rt_m3 : na,     title="ITM3 Realtime BEP (L-3)", color=col_itm3, linewidth=other_bep_width, style=plot_style_rt)
plot(show_stat_bep_lines and show_itm_bep ? bep_stat_m3 : na, title="ITM3 Static BEP (L-3)",   color=color.new(col_itm3, 40), linewidth=other_bep_width, style=plot_style_stat)

plot(show_rt_bep_lines and show_otm_bep ? bep_rt_p1 : na,     title="OTM1 Realtime BEP (L+1)", color=col_otm1, linewidth=other_bep_width, style=plot_style_rt)
plot(show_stat_bep_lines and show_otm_bep ? bep_stat_p1 : na, title="OTM1 Static BEP (L+1)",   color=color.new(col_otm1, 40), linewidth=other_bep_width, style=plot_style_stat)

plot(show_rt_bep_lines and show_otm_bep ? bep_rt_p2 : na,     title="OTM2 Realtime BEP (L+2)", color=col_otm2, linewidth=other_bep_width, style=plot_style_rt)
plot(show_stat_bep_lines and show_otm_bep ? bep_stat_p2 : na, title="OTM2 Static BEP (L+2)",   color=color.new(col_otm2, 40), linewidth=other_bep_width, style=plot_style_stat)

plot(show_rt_bep_lines and show_otm_bep ? bep_rt_p3 : na,     title="OTM3 Realtime BEP (L+3)", color=col_otm3, linewidth=other_bep_width, style=plot_style_rt)
plot(show_stat_bep_lines and show_otm_bep ? bep_stat_p3 : na, title="OTM3 Static BEP (L+3)",   color=color.new(col_otm3, 40), linewidth=other_bep_width, style=plot_style_stat)

// ==========================================
// CONFLUENCE INDICATORS (MACD & RSI)
// ==========================================


// ==========================================
// BUY / SELL TRIGGER ENGINE
// ==========================================

f_bounce_dn(float h_val, float c_val, float bep_val) =>
    (h_val >= bep_val) and (c_val < bep_val)

f_bounce_up(float l_val, float c_val, float bep_val, float prev_l, float prev_c, float prev_bep) =>
    bool bounce_now     = (l_val <= bep_val) and (c_val > bep_val)
    bool bounce_confirm = not na(prev_l) and not na(prev_c) and not na(prev_bep) and (prev_l <= prev_bep) and (prev_c > prev_bep) and (c_val > prev_c)
    bounce_now or bounce_confirm

f_breakdown_dn(float curr_c, float prev_c, float bep_val) =>
    (curr_c < bep_val) and (nz(prev_c) >= bep_val)

f_crossover_up(float curr_c, float prev_c, float bep_val) =>
    (curr_c > bep_val) and (nz(prev_c) <= bep_val)

f_eval_ce_pair_trig(float bep_val, float c_c, float c_h, float c_l, float p_c, float p_h, float p_l) =>
    float prev_c_l   = nz(c_l[1])
    float prev_c_c   = nz(c_c[1])
    float prev_bep   = nz(bep_val[1])
    bool ce_cross     = not na(c_c) and f_crossover_up(c_c, prev_c_c, bep_val)
    bool ce_bounce_up = not na(c_l) and not na(c_c) and f_bounce_up(c_l, c_c, bep_val, prev_c_l, prev_c_c, prev_bep)
    bool pe_bounce_dn = not na(p_h) and not na(p_c) and f_bounce_dn(p_h, p_c, bep_val)
    bool pe_breakdown = not na(p_c) and f_breakdown_dn(p_c, p_c[1], bep_val)

    bool ce_cross_confirmed  = ce_cross and (pe_breakdown or (not na(p_c) and p_c < bep_val))
    bool ce_bounce_confirmed = ce_bounce_up and (pe_bounce_dn or (not na(p_c) and p_c < bep_val))

    ce_cross_confirmed or ce_bounce_confirmed or ce_cross or ce_bounce_up

f_eval_pe_pair_trig(float bep_val, float c_c, float c_h, float c_l, float p_c, float p_h, float p_l) =>
    float prev_p_l   = nz(p_l[1])
    float prev_p_c   = nz(p_c[1])
    float prev_bep   = nz(bep_val[1])
    bool pe_cross     = not na(p_c) and f_crossover_up(p_c, prev_p_c, bep_val)
    bool pe_bounce_up = not na(p_l) and not na(p_c) and f_bounce_up(p_l, p_c, bep_val, prev_p_l, prev_p_c, prev_bep)
    bool ce_bounce_dn = not na(c_h) and not na(c_c) and f_bounce_dn(c_h, c_c, bep_val)
    bool ce_breakdown = not na(c_c) and f_breakdown_dn(c_c, c_c[1], bep_val)

    bool pe_cross_confirmed  = pe_cross and (ce_breakdown or (not na(c_c) and c_c < bep_val))
    bool pe_bounce_confirmed = pe_bounce_up and (ce_bounce_dn or (not na(c_c) and c_c < bep_val))

    pe_cross_confirmed or pe_bounce_confirmed or pe_cross or pe_bounce_up

// Evaluate Triggers Across All 14 BEP Lines (Strictly using ATM LTP)
bool ce_trig_m3_rt   = f_eval_ce_pair_trig(bep_rt_m3,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool ce_trig_m3_stat = f_eval_ce_pair_trig(bep_stat_m3, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool pe_trig_m3_rt   = f_eval_pe_pair_trig(bep_rt_m3,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool pe_trig_m3_stat = f_eval_pe_pair_trig(bep_stat_m3, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool ce_trig_m2_rt   = f_eval_ce_pair_trig(bep_rt_m2,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool ce_trig_m2_stat = f_eval_ce_pair_trig(bep_stat_m2, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool pe_trig_m2_rt   = f_eval_pe_pair_trig(bep_rt_m2,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool pe_trig_m2_stat = f_eval_pe_pair_trig(bep_stat_m2, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool ce_trig_m1_rt   = f_eval_ce_pair_trig(bep_rt_m1,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool ce_trig_m1_stat = f_eval_ce_pair_trig(bep_stat_m1, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool pe_trig_m1_rt   = f_eval_pe_pair_trig(bep_rt_m1,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool pe_trig_m1_stat = f_eval_pe_pair_trig(bep_stat_m1, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool ce_trig_0_rt    = f_eval_ce_pair_trig(bep_rt_0,    ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool ce_trig_0_stat  = f_eval_ce_pair_trig(bep_stat_0,  ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool pe_trig_0_rt    = f_eval_pe_pair_trig(bep_rt_0,    ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool pe_trig_0_stat  = f_eval_pe_pair_trig(bep_stat_0,  ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool ce_trig_p1_rt   = f_eval_ce_pair_trig(bep_rt_p1,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool ce_trig_p1_stat = f_eval_ce_pair_trig(bep_stat_p1, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool pe_trig_p1_rt   = f_eval_pe_pair_trig(bep_rt_p1,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool pe_trig_p1_stat = f_eval_pe_pair_trig(bep_stat_p1, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool ce_trig_p2_rt   = f_eval_ce_pair_trig(bep_rt_p2,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool ce_trig_p2_stat = f_eval_ce_pair_trig(bep_stat_p2, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool pe_trig_p2_rt   = f_eval_pe_pair_trig(bep_rt_p2,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool pe_trig_p2_stat = f_eval_pe_pair_trig(bep_stat_p2, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool ce_trig_p3_rt   = f_eval_ce_pair_trig(bep_rt_p3,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool ce_trig_p3_stat = f_eval_ce_pair_trig(bep_stat_p3, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

bool pe_trig_p3_rt   = f_eval_pe_pair_trig(bep_rt_p3,   ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)
bool pe_trig_p3_stat = f_eval_pe_pair_trig(bep_stat_p3, ce_c_0, ce_h_0, ce_l_0, pe_c_0, pe_h_0, pe_l_0)

// Combine Level Triggers (All BEP lines evaluated when enabled)
bool ce_trig_0  = (eval_rt_bep and ce_trig_0_rt)  or (eval_stat_bep and ce_trig_0_stat)
bool ce_trig_m1 = (eval_rt_bep and ce_trig_m1_rt) or (eval_stat_bep and ce_trig_m1_stat)
bool ce_trig_m2 = (eval_rt_bep and ce_trig_m2_rt) or (eval_stat_bep and ce_trig_m2_stat)
bool ce_trig_m3 = (eval_rt_bep and ce_trig_m3_rt) or (eval_stat_bep and ce_trig_m3_stat)
bool ce_trig_p1 = (eval_rt_bep and ce_trig_p1_rt) or (eval_stat_bep and ce_trig_p1_stat)
bool ce_trig_p2 = (eval_rt_bep and ce_trig_p2_rt) or (eval_stat_bep and ce_trig_p2_stat)
bool ce_trig_p3 = (eval_rt_bep and ce_trig_p3_rt) or (eval_stat_bep and ce_trig_p3_stat)

bool pe_trig_0  = (eval_rt_bep and pe_trig_0_rt)  or (eval_stat_bep and pe_trig_0_stat)
bool pe_trig_m1 = (eval_rt_bep and pe_trig_m1_rt) or (eval_stat_bep and pe_trig_m1_stat)
bool pe_trig_m2 = (eval_rt_bep and pe_trig_m2_rt) or (eval_stat_bep and pe_trig_m2_stat)
bool pe_trig_m3 = (eval_rt_bep and pe_trig_m3_rt) or (eval_stat_bep and pe_trig_m3_stat)
bool pe_trig_p1 = (eval_rt_bep and pe_trig_p1_rt) or (eval_stat_bep and pe_trig_p1_stat)
bool pe_trig_p2 = (eval_rt_bep and pe_trig_p2_rt) or (eval_stat_bep and pe_trig_p2_stat)
bool pe_trig_p3 = (eval_rt_bep and pe_trig_p3_rt) or (eval_stat_bep and pe_trig_p3_stat)

bool ce_any_bep_trig = enable_alert_engine and (ce_trig_0 or ce_trig_m1 or ce_trig_m2 or ce_trig_m3 or ce_trig_p1 or ce_trig_p2 or ce_trig_p3)
bool pe_any_bep_trig = enable_alert_engine and (pe_trig_0 or pe_trig_m1 or pe_trig_m2 or pe_trig_m3 or pe_trig_p1 or pe_trig_p2 or pe_trig_p3)

var string ce_trig_level_name = "ATM"
if ce_trig_0
    ce_trig_level_name := "ATM"
else if ce_trig_m1
    ce_trig_level_name := "ITM 1"
else if ce_trig_m2
    ce_trig_level_name := "ITM 2"
else if ce_trig_m3
    ce_trig_level_name := "ITM 3"
else if ce_trig_p1
    ce_trig_level_name := "OTM 1"
else if ce_trig_p2
    ce_trig_level_name := "OTM 2"
else if ce_trig_p3
    ce_trig_level_name := "OTM 3"

var string pe_trig_level_name = "ATM"
if pe_trig_0
    pe_trig_level_name := "ATM"
else if pe_trig_m1
    pe_trig_level_name := "ITM 1"
else if pe_trig_m2
    pe_trig_level_name := "ITM 2"
else if pe_trig_m3
    pe_trig_level_name := "ITM 3"
else if pe_trig_p1
    pe_trig_level_name := "OTM 1"
else if pe_trig_p2
    pe_trig_level_name := "OTM 2"
else if pe_trig_p3
    pe_trig_level_name := "OTM 3"

// Track Candles Since BEP Crossover/Bounce Trigger (3-Candle Window)
int ce_bars_since_trig = ta.barssince(ce_any_bep_trig)
int pe_bars_since_trig = ta.barssince(pe_any_bep_trig)

bool ce_trig_in_window = not na(ce_bars_since_trig) and ce_bars_since_trig < macd_favourable_window
bool pe_trig_in_window = not na(pe_bars_since_trig) and pe_bars_since_trig < macd_favourable_window

// Spot / Underlying MACD & RSI Confluence Calculations
[spot_macdLine, spot_signalLine, _] = request.security(spotTicker, timeframe.period, ta.macd(macd_src, macd_fast_len, macd_slow_len, macd_signal_len), ignore_invalid_symbol=true)
[chart_macdLine, chart_signalLine, _] = ta.macd(macd_src, macd_fast_len, macd_slow_len, macd_signal_len)

float active_macdLine   = not na(spot_macdLine)   ? spot_macdLine   : chart_macdLine
float active_signalLine = not na(spot_signalLine) ? spot_signalLine : chart_signalLine

float spot_rsi   = request.security(spotTicker, timeframe.period, ta.rsi(close, rsi_length), ignore_invalid_symbol=true)
float chart_rsi  = ta.rsi(close, rsi_length)
float active_rsi = not na(spot_rsi) ? spot_rsi : chart_rsi

// MACD Favourable Conditions (> 0 CE / < 0 PE or Signal Line Cross)
bool ce_zero_pass   = active_macdLine > 0
bool pe_zero_pass   = active_macdLine < 0

bool ce_signal_pass = active_macdLine > active_signalLine
bool pe_signal_pass = active_macdLine < active_signalLine

bool ce_macd_favourable = macd_eval_mode_str == "Signal Line Cross (MACD > Signal CE)" ? ce_signal_pass : (macd_eval_mode_str == "Both Zero Line & Signal Cross" ? (ce_zero_pass and ce_signal_pass) : ce_zero_pass)
bool pe_macd_favourable = macd_eval_mode_str == "Signal Line Cross (MACD > Signal CE)" ? pe_signal_pass : (macd_eval_mode_str == "Both Zero Line & Signal Cross" ? (pe_zero_pass and pe_signal_pass) : pe_zero_pass)

bool ce_macd_pass = not use_macd_confluence or (ce_macd_favourable and ce_trig_in_window)
bool pe_macd_pass = not use_macd_confluence or (pe_macd_favourable and pe_trig_in_window)

bool ce_rsi_pass  = not use_rsi_confluence or (active_rsi > rsi_ce_thresh)
bool pe_rsi_pass  = not use_rsi_confluence or (active_rsi < rsi_pe_thresh)

bool ce_confluence_met = false
if not use_macd_confluence and not use_rsi_confluence
    ce_confluence_met := true
else if use_macd_confluence and use_rsi_confluence
    ce_confluence_met := (ce_macd_favourable and ce_trig_in_window) or (active_rsi > rsi_ce_thresh)
else if use_macd_confluence
    ce_confluence_met := ce_macd_favourable and ce_trig_in_window
else if use_rsi_confluence
    ce_confluence_met := active_rsi > rsi_ce_thresh

bool pe_confluence_met = false
if not use_macd_confluence and not use_rsi_confluence
    pe_confluence_met := true
else if use_macd_confluence and use_rsi_confluence
    pe_confluence_met := (pe_macd_favourable and pe_trig_in_window) or (active_rsi < rsi_pe_thresh)
else if use_macd_confluence
    pe_confluence_met := pe_macd_favourable and pe_trig_in_window
else if use_rsi_confluence
    pe_confluence_met := active_rsi < rsi_pe_thresh

bool raw_buy_alert  = ce_trig_in_window and ce_confluence_met
bool raw_sell_alert = pe_trig_in_window and pe_confluence_met

bool is_candle_closed = not require_bar_close or barstate.isconfirmed

var int last_buy_alert_bar  = -1
var int last_sell_alert_bar = -1

bool confirmed_buy  = raw_buy_alert  and is_candle_closed and (last_buy_alert_bar  != bar_index)
bool confirmed_sell = raw_sell_alert and is_candle_closed and (last_sell_alert_bar != bar_index)

// Alternating Swing State Machine
var int activeSwing = 0
if ta.change(time("D")) != 0
    activeSwing := 0

bool overall_buy_alert  = false
bool overall_sell_alert = false

if confirmed_buy and activeSwing != 1
    overall_buy_alert  := true
    activeSwing        := 1
    last_buy_alert_bar := bar_index
else if confirmed_sell and activeSwing != -1
    overall_sell_alert  := true
    activeSwing         := -1
    last_sell_alert_bar := bar_index

// ==========================================
// DYNAMIC REALTIME STEP-UP EXTENSION ENGINE
// ==========================================

// Track escalation stages:
// Stage 0: Initial / Neutral
// Stage 1: Post ATM Crossover -> (PE_OTM1 + CE_ATM) / 2
// Stage 2: Post ITM 1 Crossover -> (PE_OTM2 + CE_ITM1) / 2
// Stage 3: Post ITM 2 Crossover -> (PE_OTM3 + CE_ITM2) / 2
var int ext_stage_ce = 0
var int ext_stage_pe = 0

// Reset extension line stages every day at market open (no carryover from previous day)
if ta.change(time("D")) != 0
    ext_stage_ce := 0
    ext_stage_pe := 0

// Active Extension Line Formula Calculations (returns na when stage == 0)
float ce_ext_line = ext_stage_ce == 3 ? (ext_pe_c_p3 + ext_ce_c_m2) / 2.0 : (ext_stage_ce == 2 ? (ext_pe_c_p2 + ext_ce_c_m1) / 2.0 : (ext_stage_ce == 1 ? (ext_pe_c_p1 + ext_ce_c_0) / 2.0 : na))
float pe_ext_line = ext_stage_pe == 3 ? (ext_ce_c_p3 + ext_pe_c_m2) / 2.0 : (ext_stage_pe == 2 ? (ext_ce_c_p2 + ext_pe_c_m1) / 2.0 : (ext_stage_pe == 1 ? (ext_ce_c_p1 + ext_pe_c_0) / 2.0 : na))

// Reset when extension line level is broken (price drops below active extension line)
bool ce_ext_broken = (ext_stage_ce > 0) and not na(ce_ext_line) and (ce_c_0 < ce_ext_line)
bool pe_ext_broken = (ext_stage_pe > 0) and not na(pe_ext_line) and (pe_c_0 < pe_ext_line)

if ce_ext_broken
    ext_stage_ce := 0

if pe_ext_broken
    ext_stage_pe := 0

// Stage Escalation & Re-Formation Triggers (Cross or Bounce across any of the 7 BEP lines)
bool ce_has_bounced_or_crossed = ce_any_bep_trig or (ce_h_0 >= bep_rt_0) or (ce_c_0 >= bep_rt_0) or (ce_h_0 >= bep_stat_0) or (ce_c_0 >= bep_stat_0)
bool pe_has_bounced_or_crossed = pe_any_bep_trig or (pe_h_0 >= bep_rt_0) or (pe_c_0 >= bep_rt_0) or (pe_h_0 >= bep_stat_0) or (pe_c_0 >= bep_stat_0)

bool ce_at_or_above_itm1 = not na(ce_c_0) and (ce_trig_m1 or (ce_h_0 >= bep_rt_m1) or (ce_c_0 >= bep_rt_m1) or (ce_h_0 >= bep_stat_m1) or (ce_c_0 >= bep_stat_m1))
bool ce_at_or_above_itm2 = not na(ce_c_0) and (ce_trig_m2 or (ce_h_0 >= bep_rt_m2) or (ce_c_0 >= bep_rt_m2) or (ce_h_0 >= bep_stat_m2) or (ce_c_0 >= bep_stat_m2))

bool pe_at_or_above_itm1 = not na(pe_c_0) and (pe_trig_m1 or (pe_h_0 >= bep_rt_m1) or (pe_c_0 >= bep_rt_m1) or (pe_h_0 >= bep_stat_m1) or (pe_c_0 >= bep_stat_m1))
bool pe_at_or_above_itm2 = not na(pe_c_0) and (pe_trig_m2 or (pe_h_0 >= bep_rt_m2) or (pe_c_0 >= bep_rt_m2) or (pe_h_0 >= bep_stat_m2) or (pe_c_0 >= bep_stat_m2))

if ce_at_or_above_itm2
    ext_stage_ce := 3
else if ce_at_or_above_itm1 and (ext_stage_ce < 2 or ce_trig_m1)
    ext_stage_ce := 2
else if ce_has_bounced_or_crossed and (ext_stage_ce < 1 or ce_any_bep_trig)
    ext_stage_ce := 1

if pe_at_or_above_itm2
    ext_stage_pe := 3
else if pe_at_or_above_itm1 and (ext_stage_pe < 2 or pe_trig_m1)
    ext_stage_pe := 2
else if pe_has_bounced_or_crossed and (ext_stage_pe < 1 or pe_any_bep_trig)
    ext_stage_pe := 1

// Re-evaluate extension line plots after formation/escalation/reset
ce_ext_line := ext_stage_ce == 3 ? (ext_pe_c_p3 + ext_ce_c_m2) / 2.0 : (ext_stage_ce == 2 ? (ext_pe_c_p2 + ext_ce_c_m1) / 2.0 : (ext_stage_ce == 1 ? (ext_pe_c_p1 + ext_ce_c_0) / 2.0 : na))
pe_ext_line := ext_stage_pe == 3 ? (ext_ce_c_p3 + ext_pe_c_m2) / 2.0 : (ext_stage_pe == 2 ? (ext_ce_c_p2 + ext_pe_c_m1) / 2.0 : (ext_stage_pe == 1 ? (ext_ce_c_p1 + ext_pe_c_0) / 2.0 : na))

// Plot Dynamic Realtime Step-Up Extension Lines on BOTH sides
plot(show_extension_line ? ce_ext_line : na, title="CE Dynamic Step-Up Extension Line", color=col_extension_line, linewidth=ext_line_width, style=plot_style_ext)
plot(show_extension_line ? pe_ext_line : na, title="PE Dynamic Step-Up Extension Line", color=color.new(col_extension_line, 35), linewidth=ext_line_width, style=plot_style_ext)

// Opposite Option Candle Overlay (ATM Option of opposite side - real-time tick-by-tick)
float opp_o = isCall ? pe_open_0 : ce_open_0
float opp_h = isCall ? pe_h_0    : ce_h_0
float opp_l = isCall ? pe_l_0    : ce_l_0
float opp_c = isCall ? pe_c_0    : ce_c_0

bool opp_is_bull   = nz(opp_c) >= nz(opp_o)
color opp_body_col = opp_is_bull ? c_opp_bull : c_opp_bear
color opp_wick_col = opp_is_bull ? c_opp_bull_wick : c_opp_bear_wick

plotcandle(show_opp_candles ? opp_o : na,
           show_opp_candles ? opp_h : na,
           show_opp_candles ? opp_l : na,
           show_opp_candles ? opp_c : na,
           title="Opposite Option Candle", color=opp_body_col, wickcolor=opp_wick_col, bordercolor=opp_wick_col)

// Helper Functions for Customizable Signal Labels
f_get_label_style(string pos_str, bool is_ce) =>
    pos_str == "Below Bar (Up Arrow)" ? label.style_label_up : label.style_label_down

f_get_label_size(string sz_str) =>
    switch sz_str
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

// Signal Labels
if show_signal_shapes
    if overall_buy_alert
        float y_pos = ce_label_pos_str == "Below Bar (Up Arrow)" ? low : high
        label.new(bar_index, y_pos, text="CE", style=f_get_label_style(ce_label_pos_str, true), color=ce_label_color, textcolor=ce_label_textcolor, size=f_get_label_size(label_size_str))
    else if overall_sell_alert
        float y_pos = pe_label_pos_str == "Above Bar (Down Arrow)" ? high : low
        label.new(bar_index, y_pos, text="PE", style=f_get_label_style(pe_label_pos_str, false), color=pe_label_color, textcolor=pe_label_textcolor, size=f_get_label_size(label_size_str))

// ==========================================
// ANALYTICS DASHBOARD TABLE
// ==========================================

f_get_table_pos(string pos_str) =>
    switch pos_str
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

var table dashTable = table.new(f_get_table_pos(show_dashboard_pos), 5, 9, bgcolor=color.black, border_width=1, border_color=color.gray, force_overlay=true)

if barstate.islast and show_dashboard
    // Header
    table.cell(dashTable, 0, 0, "Strike Level", bgcolor=#1565C0, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 0, "Call LTP", bgcolor=#1565C0, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 2, 0, "Put LTP", bgcolor=#1565C0, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 3, 0, "Static BEP", bgcolor=#1565C0, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 4, 0, "Realtime BEP", bgcolor=#1565C0, text_color=color.white, text_size=size.small)

    // ATM Row
    table.cell(dashTable, 0, 1, "ATM (" + str.tostring(k_0, "#") + ")", bgcolor=#37474F, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 1, str.tostring(ce_c_0, "#.1"), bgcolor=color.black, text_color=#00E676, text_size=size.small)
    table.cell(dashTable, 2, 1, str.tostring(pe_c_0, "#.1"), bgcolor=color.black, text_color=#FF5252, text_size=size.small)
    table.cell(dashTable, 3, 1, str.tostring(bep_stat_0, "#.1"), bgcolor=#006064, text_color=color.aqua, text_size=size.small)
    table.cell(dashTable, 4, 1, str.tostring(bep_rt_0, "#.1"), bgcolor=#F57F17, text_color=color.yellow, text_size=size.small)

    // ITM 1 Row
    table.cell(dashTable, 0, 2, "ITM 1 (" + str.tostring(k_m1, "#") + ")", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 2, str.tostring(ce_c_m1, "#.1"), bgcolor=color.black, text_color=#00E676, text_size=size.small)
    table.cell(dashTable, 2, 2, str.tostring(pe_c_p1, "#.1"), bgcolor=color.black, text_color=#FF5252, text_size=size.small)
    table.cell(dashTable, 3, 2, str.tostring(bep_stat_m1, "#.1"), bgcolor=#006064, text_color=color.aqua, text_size=size.small)
    table.cell(dashTable, 4, 2, str.tostring(bep_rt_m1, "#.1"), bgcolor=#212121, text_color=color.aqua, text_size=size.small)

    // ITM 2 Row
    table.cell(dashTable, 0, 3, "ITM 2 (" + str.tostring(k_m2, "#") + ")", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 3, str.tostring(ce_c_m2, "#.1"), bgcolor=color.black, text_color=#00E676, text_size=size.small)
    table.cell(dashTable, 2, 3, str.tostring(pe_c_p2, "#.1"), bgcolor=color.black, text_color=#FF5252, text_size=size.small)
    table.cell(dashTable, 3, 3, str.tostring(bep_stat_m2, "#.1"), bgcolor=#006064, text_color=color.aqua, text_size=size.small)
    table.cell(dashTable, 4, 3, str.tostring(bep_rt_m2, "#.1"), bgcolor=#212121, text_color=color.blue, text_size=size.small)

    // ITM 3 Row
    table.cell(dashTable, 0, 4, "ITM 3 (" + str.tostring(k_m3, "#") + ")", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 4, str.tostring(ce_c_m3, "#.1"), bgcolor=color.black, text_color=#00E676, text_size=size.small)
    table.cell(dashTable, 2, 4, str.tostring(pe_c_p3, "#.1"), bgcolor=color.black, text_color=#FF5252, text_size=size.small)
    table.cell(dashTable, 3, 4, str.tostring(bep_stat_m3, "#.1"), bgcolor=#006064, text_color=color.aqua, text_size=size.small)
    table.cell(dashTable, 4, 4, str.tostring(bep_rt_m3, "#.1"), bgcolor=#212121, text_color=color.purple, text_size=size.small)

    // OTM 1 Row
    table.cell(dashTable, 0, 5, "OTM 1 (" + str.tostring(k_p1, "#") + ")", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 5, str.tostring(ce_c_p1, "#.1"), bgcolor=color.black, text_color=#00E676, text_size=size.small)
    table.cell(dashTable, 2, 5, str.tostring(pe_c_m1, "#.1"), bgcolor=color.black, text_color=#FF5252, text_size=size.small)
    table.cell(dashTable, 3, 5, str.tostring(bep_stat_p1, "#.1"), bgcolor=#006064, text_color=color.aqua, text_size=size.small)
    table.cell(dashTable, 4, 5, str.tostring(bep_rt_p1, "#.1"), bgcolor=#212121, text_color=color.orange, text_size=size.small)

    // OTM 2 Row
    table.cell(dashTable, 0, 6, "OTM 2 (" + str.tostring(k_p2, "#") + ")", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 6, str.tostring(ce_c_p2, "#.1"), bgcolor=color.black, text_color=#00E676, text_size=size.small)
    table.cell(dashTable, 2, 6, str.tostring(pe_c_m2, "#.1"), bgcolor=color.black, text_color=#FF5252, text_size=size.small)
    table.cell(dashTable, 3, 6, str.tostring(bep_stat_p2, "#.1"), bgcolor=#006064, text_color=color.aqua, text_size=size.small)
    table.cell(dashTable, 4, 6, str.tostring(bep_rt_p2, "#.1"), bgcolor=#212121, text_color=color.teal, text_size=size.small)

    // OTM 3 Row
    table.cell(dashTable, 0, 7, "OTM 3 (" + str.tostring(k_p3, "#") + ")", bgcolor=#212121, text_color=color.white, text_size=size.small)
    table.cell(dashTable, 1, 7, str.tostring(ce_c_p3, "#.1"), bgcolor=color.black, text_color=#00E676, text_size=size.small)
    table.cell(dashTable, 2, 7, str.tostring(pe_c_m3, "#.1"), bgcolor=color.black, text_color=#FF5252, text_size=size.small)
    table.cell(dashTable, 3, 7, str.tostring(bep_stat_p3, "#.1"), bgcolor=#006064, text_color=color.aqua, text_size=size.small)
    table.cell(dashTable, 4, 7, str.tostring(bep_rt_p3, "#.1"), bgcolor=#212121, text_color=color.lime, text_size=size.small)

    // Extension Line & Signal Status Row
    table.cell(dashTable, 0, 8, "Extension Line", bgcolor=#F57F17, text_color=color.black, text_size=size.small)
    table.cell(dashTable, 1, 8, "CE:S" + str.tostring(ext_stage_ce) + " | PE:S" + str.tostring(ext_stage_pe), bgcolor=#F57F17, text_color=color.black, text_size=size.small)
    table.cell(dashTable, 2, 8, str.tostring(ce_ext_line, "#.1") + " / " + str.tostring(pe_ext_line, "#.1"), bgcolor=#4A148C, text_color=color.yellow, text_size=size.small)
    table.cell(dashTable, 3, 8, overall_buy_alert ? "BUY CE" : (overall_sell_alert ? "BUY PE" : "WAIT"), bgcolor=overall_buy_alert ? #00E676 : (overall_sell_alert ? #FF1744 : #212121), text_color=overall_buy_alert ? color.black : color.white, text_size=size.small)
    table.cell(dashTable, 4, 8, (ce_confluence_met or pe_confluence_met) ? "MACD OK" : "MACD FAIL", bgcolor=(ce_confluence_met or pe_confluence_met) ? #1B5E20 : #880E4F, text_color=color.white, text_size=size.small)

// TradingView Alert Conditions
alertcondition(overall_buy_alert,  title="CE Signal Alert (Call Buy)", message="CE BUY ALERT: Call signal triggered on BEP line on {{ticker}}!")
alertcondition(overall_sell_alert, title="PE Signal Alert (Put Sell)", message="PE SELL ALERT: Put signal triggered on BEP line on {{ticker}}!")
