//@version=6
indicator("14.Techfrost Nifty_V6_SR", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500)

// =========================================================================
// INPUTS & USER SETTINGS
// =========================================================================
var string G_PARSER   = "Symbol & Strike Parsing"
var string G_CALC     = "Base Calculation Preferences"
var string G_PLOTS    = "Plot & Style Settings"
var string G_DASHBOARD = "Dashboard Table Settings"

// 1. Parser & Underlying Settings
strike_step = input.int(50, "Strike Step Size", minval=1, group=G_PARSER,
  tooltip="Strike step interval. Typically 50 for Nifty, 100 for BankNifty, and stock-specific values.")
exchange = input.string("NSE", "Exchange Prefix", group=G_PARSER,
  tooltip="Exchange prefix used for requesting security data (usually NSE for Indian markets).")

underlying_ticker = input.string("NIFTY", "Underlying Ticker", group=G_PARSER,
  tooltip="Underlying ticker symbol (e.g. NIFTY, BANKNIFTY).")
expiry_input = input.string("260804", "Expiry String (YYMMDD/Code)", group=G_PARSER,
  tooltip="Expiry date string format like 260804 (YYMMDD) or 24JUN.")

atm_select_mode = input.string("Automatic", "ATM Strike Selection Mode", options=["Automatic", "Manual"], group=G_PARSER,
  tooltip="Choose whether ATM Strike is calculated automatically from Day Open price or set manually.")
manual_strike_val = input.int(24150, "Selected Strike (Manual)", group=G_PARSER,
  tooltip="Specified strike price used when ATM Strike Selection Mode is set to Manual.")
selected_opt_type = input.string("CE", "Option Type", options=["CE", "PE"], group=G_PARSER,
  tooltip="Option contract type (CE or PE).")

// 2. Calculation Settings
calc_basis = input.string("Day Open Price", "Calculation Basis", 
  options=["Day Open Price", "Previous Day Settlement/Close", "First 5 Min Close"], group=G_CALC,
  tooltip="Select the base price reference for support/resistance levels and table open statistics.")

// 3. Display & Plots
show_intrinsic_plots = input.bool(true, "Show Intrinsic/Extrinsic Plots", group=G_PLOTS,
  tooltip="Draw the CE and PE Intrinsic and Extrinsic (Time) value plots on the chart.")
show_sr_plots = input.bool(true, "Show Support/Resistance (S/R) Plots", group=G_PLOTS,
  tooltip="Draw Pivot (BEP), R1-R4, and S1-S4 levels on the chart.")
show_opp_candles = input.bool(true, "Show Opposite Option Candles", group=G_PLOTS,
  tooltip="Draw the opposite option contract's historical price chart as candles on the main window.")
show_vwap_plots = input.bool(true, "Show Option VWAP Plots", group=G_PLOTS,
  tooltip="Toggle plotting of CE and PE selected strike VWAPs on the chart.")

plot_ie_on_spot = input.string("Overlay (Strike +/- Premium)", "Intrinsic/Extrinsic Plot Mode on Spot",
  options=["Overlay (Strike +/- Premium)", "Do Not Plot"], group=G_PLOTS,
  tooltip="Adjusts how intrinsic and extrinsic values are plotted on a spot chart to prevent scale distortion.")

plot_sr_on_spot = input.string("Options-Chain Level Projections (Spot Formula)", "S/R Plot Mode on Spot",
  options=["Symmetric Channels (Strike +/- Premium)", "Absolute Values", "Options-Chain Level Projections (Spot Formula)", "Do Not Plot"], group=G_PLOTS,
  tooltip="Adjusts how S/R levels are plotted on a spot chart to prevent scale distortion.")

sr_draw_mode = input.string("Horizontal Lines (Projected to Right)", "S/R Level Rendering Mode",
  options=["Standard Plots (Style Tab Customizable)", "Horizontal Lines (Projected to Right)"], group=G_PLOTS,
  tooltip="Choose whether S/R levels are plotted standard or drawn as projected lines extending to day end.")

use_dynamic_colors = input.bool(false, "Dynamic Volume Delta Colors for S/R", group=G_PLOTS,
  tooltip="Color S/R lines dynamically based on net volume delta (Bullish green, Bearish red).")

show_pdhl = input.bool(true, "Show Previous Day High/Low (PDH/PDL)", group=G_PLOTS, tooltip="Toggle Previous Day High and Low lines on the chart.")
show_running_bep = input.bool(false, "Show Running BEP Line", group=G_PLOTS, tooltip="Toggle real-time Running BEP on the chart.")
show_orb_lines = input.bool(false, "Show ORB High/Low Lines", group=G_PLOTS, tooltip="Toggle Opening Range Breakout lines.")

orb_timeframe = input.timeframe("15", "ORB Timeframe", group=G_PLOTS, tooltip="Select ORB range calculation timeframe.")
orb_strike_mode = input.string("ATM", "ORB Strike Selection", options=["ATM", "ITM", "OTM"], group=G_PLOTS, tooltip="Select strike mode for ORB calculation.")
orb_strike_offset = input.int(50, "ORB Strike Offset", group=G_PLOTS, tooltip="Offset from ATM for ITM/OTM ORB calculation.")
orb_opt_type = input.string("CE", "ORB Option Type", options=["CE", "PE"], group=G_PLOTS, tooltip="Option type for ORB calculation.")

show_swings = input.bool(true, "Show Swing Reversal Signals & Labels", group=G_PLOTS, tooltip="Toggle Swing High and Low pivot signals on the chart.")
swing_len_left = input.int(2, "Swing Strength (Left Bars)", minval=1, group=G_PLOTS, tooltip="Left bar strength for swing pivot detection.")
swing_len_right = input.int(2, "Swing Strength (Right Bars)", minval=1, group=G_PLOTS, tooltip="Right bar strength for swing pivot detection.")
swing_select_mode = input.string("Automatic", "Swing Pivot Mode", options=["Automatic", "Manual"], group=G_PLOTS, tooltip="Select Automatic or Manual pivot calculation mode.")
swing_tf_str = input.string("Chart Timeframe", "Swing Delta Volume Timeframe", options=["Chart Timeframe", "1 Min", "3 Min", "5 Min", "10 Min", "15 Min", "30 Min"], group=G_PLOTS, tooltip="Select timeframe for volume delta calculation.")
sig_tf_str = input.string("Chart Timeframe", "CVD Timeframe", options=["Chart Timeframe", "1 Min", "3 Min", "5 Min", "10 Min", "15 Min", "30 Min"], group=G_PLOTS, tooltip="Select timeframe for CVD metrics calculation.")

show_calc_box = input.bool(true, "Show Calculation Explanatory Table", group=G_DASHBOARD, tooltip="Display calculation breakdown table on chart.")
show_calc_details = input.bool(true, "Show Full Breakdown Table", group=G_DASHBOARD, tooltip="Toggle detailed vs compact calculation box view.")
table_pos_calc_str = input.string("Bottom Left", "Explanatory Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_DASHBOARD, tooltip="Position of calculation breakdown table.")

show_tbl = input.bool(true, "Show Dashboard Table", group=G_DASHBOARD, tooltip="Display options dashboard table on chart.")
table_pos_str = input.string("Top Right", "Dashboard Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_DASHBOARD, tooltip="Position of options dashboard table.")
table_size_str = input.string("Small", "Dashboard Text Size", options=["Tiny", "Small", "Normal", "Large"], group=G_DASHBOARD, tooltip="Text size for dashboard table.")

// Colors
c_p_in = input.color(#FFEA00, "Pivot Line Color", group=G_PLOTS)
c_r1_in = input.color(#00E676, "R1 Line Color", group=G_PLOTS)
c_r2_in = input.color(#00C853, "R2 Line Color", group=G_PLOTS)
c_r3_in = input.color(#00B0FF, "R3 Line Color", group=G_PLOTS)
c_r4_in = input.color(#2979FF, "R4 Line Color", group=G_PLOTS)
c_r5_in = input.color(#AA00FF, "R5 Line Color", group=G_PLOTS)
c_s1_in = input.color(#FF1744, "S1 Line Color", group=G_PLOTS)
c_s2_in = input.color(#D50000, "S2 Line Color", group=G_PLOTS)
c_s3_in = input.color(#FF9100, "S3 Line Color", group=G_PLOTS)
c_s4_in = input.color(#FF6D00, "S4 Line Color", group=G_PLOTS)
c_s5_in = input.color(#FFD600, "S5 Line Color", group=G_PLOTS)

c_ce_int = input.color(#00E676, "CE Intrinsic Color", group=G_PLOTS)
c_pe_int = input.color(#FF1744, "PE Intrinsic Color", group=G_PLOTS)
c_avg_int = input.color(#00B0FF, "Avg Intrinsic Color", group=G_PLOTS)
c_ce_ext = input.color(#FF9100, "CE Extrinsic Color", group=G_PLOTS)
c_pe_ext = input.color(#AA00FF, "PE Extrinsic Color", group=G_PLOTS)
c_avg_ext = input.color(#2979FF, "Avg Extrinsic Color", group=G_PLOTS)

c_opp_bull = input.color(#26A69A, "Opposite Candle Bull Color", group=G_PLOTS)
c_opp_bear = input.color(#EF5350, "Opposite Candle Bear Color", group=G_PLOTS)
c_opp_bull_wick = input.color(#26A69A, "Opposite Candle Bull Wick", group=G_PLOTS)
c_opp_bear_wick = input.color(#EF5350, "Opposite Candle Bear Wick", group=G_PLOTS)

c_pdh_in = input.color(#00E676, "PDH Line Color", group=G_PLOTS)
c_pdl_in = input.color(#FF1744, "PDL Line Color", group=G_PLOTS)
c_running_bep = input.color(#FFFFFF, "Running BEP Color", group=G_PLOTS)
c_orb_in = input.color(#2979FF, "ORB Line Color", group=G_PLOTS)
c_ce_vwap = input.color(#009688, "CE VWAP Color", group=G_PLOTS)
c_pe_vwap = input.color(#E91E63, "PE VWAP Color", group=G_PLOTS)

show_line_labels = input.bool(true, "Show Line Value Labels", group=G_PLOTS, tooltip="Display floating price labels at line ends.")
show_orb_labels = input.bool(true, "Show ORB Line Labels", group=G_PLOTS, tooltip="Display price labels for ORB High and Low.")

// =========================================================================
// HELPER FUNCTIONS (GLOBAL SCOPE)
// =========================================================================
f_is_digit(string c) =>
    str.contains("0123456789", c)

// =========================================================================
// TICKER PARSER & CONTRACT RESOLUTION
// =========================================================================
string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

int tickerLen = str.length(cleanTicker)

var string root = underlying_ticker
var string expiry = expiry_input
var string opt_type = selected_opt_type
var int strike_val = manual_strike_val
var bool is_option = false

if tickerLen > 7
    int idx = tickerLen - 1
    string strike_str = ""
    while idx >= 0 and f_is_digit(str.substring(cleanTicker, idx, idx + 1))
        strike_str := str.substring(cleanTicker, idx, idx + 1) + strike_str
        idx := idx - 1
        
    if idx > 2 and str.length(strike_str) > 0
        string opt_char = str.substring(cleanTicker, idx, idx + 1)
        if opt_char == "C" or opt_char == "P" or opt_char == "E"
            opt_type := opt_char == "P" ? "P" : "C"
            strike_val := int(str.tonumber(strike_str))
            int exp_len = 5
            if idx >= 3 and f_is_digit(str.substring(cleanTicker, idx - 3, idx - 2))
                exp_len := 6
            if idx >= exp_len
                expiry := str.substring(cleanTicker, idx - exp_len, idx)
                root := str.substring(cleanTicker, 0, idx - exp_len)
                is_option := true

final_root   = is_option ? root : underlying_ticker
final_expiry = is_option ? expiry : expiry_input
final_type   = is_option ? opt_type : selected_opt_type

// Request Spot / Futures underlying daily reference prices
spot_sym = exchange + ":" + final_root
[spot_open, spot_prev_close, pd_high_val, pd_low_val, spot_close_today] = request.security(spot_sym, "1D", [open[0], close[1], high[1], low[1], close[0]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Calculate ATM strike based on selected mode
var int base_center_strike = na
if barstate.isfirst or na(base_center_strike)
    int calc_strike = 24150
    if atm_select_mode == "Automatic"
        float ref_price = is_option ? nz(spot_close_today, spot_open) : spot_open
        calc_strike := int(math.round(ref_price / strike_step) * strike_step)
    else
        calc_strike := manual_strike_val
    if calc_strike <= 0
        calc_strike := 24150
    base_center_strike := calc_strike

final_strike = base_center_strike

// Build opposite option contract symbol
opp_type = final_type == "C" ? "P" : "C"
opp_sym = exchange + ":" + final_root + final_expiry + opp_type + str.tostring(final_strike)

// Track Spot First 5 Min Close
var float spot_f5m = na
if ta.change(time("D")) != 0
    spot_f5m := na
if (hour == 9 and minute >= 19) or hour > 9
    if na(spot_f5m)
        spot_f5m := close

// Define Calculation Basis Price for Spot
spot_base = calc_basis == "Day Open Price" ? spot_open : (calc_basis == "First 5 Min Close" ? (na(spot_f5m) ? spot_open : spot_f5m) : spot_prev_close)

// Resolve levels timeframe
tf_to_use = sig_tf_str == "Chart Timeframe" ? timeframe.period : (sig_tf_str == "1 Min" ? "1" : (sig_tf_str == "3 Min" ? "3" : (sig_tf_str == "5 Min" ? "5" : (sig_tf_str == "10 Min" ? "10" : (sig_tf_str == "15 Min" ? "15" : "30")))))

// Arrays to hold data for 11 strikes centered around the selected strike (index 5)
var float[] ce_opens = array.new_float(11)
var float[] ce_prevs = array.new_float(11)
var float[] ce_f5ms  = array.new_float(11)
var float[] ce_ltps  = array.new_float(11)
var float[] ce_highs = array.new_float(11, na)
var float[] ce_lows  = array.new_float(11, na)
var float[] ce_vols  = array.new_float(11, na)
var float[] ce_vwaps = array.new_float(11, na)

var float[] pe_opens = array.new_float(11)
var float[] pe_prevs = array.new_float(11)
var float[] pe_f5ms  = array.new_float(11)
var float[] pe_ltps  = array.new_float(11)
var float[] pe_highs = array.new_float(11, na)
var float[] pe_lows  = array.new_float(11, na)
var float[] pe_vols  = array.new_float(11, na)
var float[] pe_vwaps = array.new_float(11, na)

var int[] strikes = array.new_int(11)

// Helper function to extract Day Open, Previous Day Close, First 5 Min Close, and real-time tick-by-tick LTP
f_get_contract_tuple() =>
    var float day_open   = na
    var float prev_close = na
    var float f5m_close  = na
    if ta.change(time("D")) != 0
        prev_close := close[1]
        day_open   := open
        f5m_close  := na
    if (hour == 9 and minute >= 19) or hour > 9
        if na(f5m_close)
            f5m_close := close
    [nz(day_open, open), nz(prev_close, close[1]), na(f5m_close) ? nz(day_open, open) : f5m_close, close]

// Populating arrays. Security calls in loop are resolved using constant iteration boundaries
for i = 0 to 10
    int strike = base_center_strike + (i - 5) * strike_step
    array.set(strikes, i, strike)
    
    string ce_contract = exchange + ":" + final_root + final_expiry + "C" + str.tostring(strike)
    string pe_contract = exchange + ":" + final_root + final_expiry + "P" + str.tostring(strike)
    
    // Real-time tick-by-tick query on chart timeframe (timeframe.period)
    // Returns [Day Open, Previous Day Close, First 5 Min Close, Real-time LTP] on every tick
    [ce_o, ce_p, ce_f5m, ce_c] = request.security(ce_contract, timeframe.period, f_get_contract_tuple())
    [pe_o, pe_p, pe_f5m, pe_c] = request.security(pe_contract, timeframe.period, f_get_contract_tuple())
    
    array.set(ce_opens, i, ce_o)
    array.set(ce_prevs, i, ce_p)
    array.set(ce_f5ms,  i, ce_f5m)
    array.set(ce_ltps,  i, ce_c)
    
    array.set(pe_opens, i, pe_o)
    array.set(pe_prevs, i, pe_p)
    array.set(pe_f5ms,  i, pe_f5m)
    array.set(pe_ltps,  i, pe_c)

// =========================================================================
// INTRADAY CVD / VOLUME QUERIES (Explicit calls for ATM-1, ATM, ATM+1 only)
// Kept outside loop to prevent Pine from counting loop-body calls × 11 iterations.
// This costs only 6 unique request.security calls (3 strikes × CE+PE).
// =========================================================================
string cvd_ce4 = exchange + ":" + final_root + final_expiry + "C" + str.tostring(final_strike - 1 * strike_step)
string cvd_pe4 = exchange + ":" + final_root + final_expiry + "P" + str.tostring(final_strike - 1 * strike_step)
string cvd_ce5 = exchange + ":" + final_root + final_expiry + "C" + str.tostring(final_strike)
string cvd_pe5 = exchange + ":" + final_root + final_expiry + "P" + str.tostring(final_strike)
string cvd_ce6 = exchange + ":" + final_root + final_expiry + "C" + str.tostring(final_strike + 1 * strike_step)
string cvd_pe6 = exchange + ":" + final_root + final_expiry + "P" + str.tostring(final_strike + 1 * strike_step)

[cvd4_ce_h, cvd4_ce_l, cvd4_ce_v, cvd4_ce_vw] = request.security(cvd_ce4, tf_to_use, [high, low, volume, ta.vwap])
[cvd4_pe_h, cvd4_pe_l, cvd4_pe_v, cvd4_pe_vw] = request.security(cvd_pe4, tf_to_use, [high, low, volume, ta.vwap])
[cvd5_ce_h, cvd5_ce_l, cvd5_ce_v, cvd5_ce_vw] = request.security(cvd_ce5, tf_to_use, [high, low, volume, ta.vwap])
[cvd5_pe_h, cvd5_pe_l, cvd5_pe_v, cvd5_pe_vw] = request.security(cvd_pe5, tf_to_use, [high, low, volume, ta.vwap])
[cvd6_ce_h, cvd6_ce_l, cvd6_ce_v, cvd6_ce_vw] = request.security(cvd_ce6, tf_to_use, [high, low, volume, ta.vwap])
[cvd6_pe_h, cvd6_pe_l, cvd6_pe_v, cvd6_pe_vw] = request.security(cvd_pe6, tf_to_use, [high, low, volume, ta.vwap])

// Populate the arrays at indices 4, 5, 6
array.set(ce_highs, 4, cvd4_ce_h), array.set(ce_lows, 4, cvd4_ce_l), array.set(ce_vols, 4, cvd4_ce_v), array.set(ce_vwaps, 4, cvd4_ce_vw)
array.set(pe_highs, 4, cvd4_pe_h), array.set(pe_lows, 4, cvd4_pe_l), array.set(pe_vols, 4, cvd4_pe_v), array.set(pe_vwaps, 4, cvd4_pe_vw)
array.set(ce_highs, 5, cvd5_ce_h), array.set(ce_lows, 5, cvd5_ce_l), array.set(ce_vols, 5, cvd5_ce_v), array.set(ce_vwaps, 5, cvd5_ce_vw)
array.set(pe_highs, 5, cvd5_pe_h), array.set(pe_lows, 5, cvd5_pe_l), array.set(pe_vols, 5, cvd5_pe_v), array.set(pe_vwaps, 5, cvd5_pe_vw)
array.set(ce_highs, 6, cvd6_ce_h), array.set(ce_lows, 6, cvd6_ce_l), array.set(ce_vols, 6, cvd6_ce_v), array.set(ce_vwaps, 6, cvd6_ce_vw)
array.set(pe_highs, 6, cvd6_pe_h), array.set(pe_lows, 6, cvd6_pe_l), array.set(pe_vols, 6, cvd6_pe_v), array.set(pe_vwaps, 6, cvd6_pe_vw)

// =========================================================================
// INTRINSIC & EXTRINSIC VALUE CALCULATIONS
// =========================================================================
// Extract selected strike's CE and PE base premiums from arrays (Index 5)
ce_premium_sel = calc_basis == "Day Open Price" ? array.get(ce_opens, 5) : (calc_basis == "First 5 Min Close" ? array.get(ce_f5ms, 5) : array.get(ce_prevs, 5))
pe_premium_sel = calc_basis == "Day Open Price" ? array.get(pe_opens, 5) : (calc_basis == "First 5 Min Close" ? array.get(pe_f5ms, 5) : array.get(pe_prevs, 5))

// Intrinsic Value (Calculated based on Base Spot Price)
ce_intrinsic = math.max(0.0, spot_base - final_strike)
pe_intrinsic = math.max(0.0, final_strike - spot_base)
avg_intrinsic = (ce_intrinsic + pe_intrinsic) / 2.0

// Extrinsic (Time) Value (Calculated based on Base Option Premium and Base Spot Price)
ce_extrinsic = math.max(0.0, nz(ce_premium_sel) - ce_intrinsic)
pe_extrinsic = math.max(0.0, nz(pe_premium_sel) - pe_intrinsic)
avg_extrinsic = (ce_extrinsic + pe_extrinsic) / 2.0

// Adapt plots for Spot vs Option charts to prevent distortion
float ce_int_plot = na
float pe_int_plot = na
float avg_int_plot = na

float ce_ext_plot = na
float pe_ext_plot = na
float avg_ext_plot = na

if is_option
    // Plot directly as intrinsic/extrinsic values on Option chart
    ce_int_plot  := ce_intrinsic
    pe_int_plot  := pe_intrinsic
    avg_int_plot := avg_intrinsic
    
    ce_ext_plot  := ce_extrinsic
    pe_ext_plot  := pe_extrinsic
    avg_ext_plot := avg_extrinsic
else
    // Adaptation for Spot Chart
    if plot_ie_on_spot == "Overlay (Strike +/- Premium)"
        ce_int_plot  := final_strike + ce_intrinsic
        pe_int_plot  := final_strike - pe_intrinsic
        avg_int_plot := final_strike + avg_intrinsic
        
        ce_ext_plot  := final_strike + ce_extrinsic
        pe_ext_plot  := final_strike - pe_extrinsic
        avg_ext_plot := final_strike + avg_extrinsic

// =========================================================================
// SUPPORT & RESISTANCE (S/R) CALCULATIONS
// =========================================================================
// Helper function to extract base premium of a strike
f_get_base_premium(int idx, string basis, float[] opens, float[] prevs, float[] f5ms) =>
    basis == "Day Open Price" ? array.get(opens, idx) : (basis == "First 5 Min Close" ? array.get(f5ms, idx) : array.get(prevs, idx))

// Helper function to calculate ORB Range on daily basis
f_orb_range() =>
    var float orb_high = na
    var float orb_low = na
    is_new = ta.change(time("D")) != 0
    if is_new
        orb_high := high
        orb_low := low
    [orb_high, orb_low]

// =========================================================================
// ATM STRIKE CALCULATION (LOCKED DAY BASE vs REAL-TIME LTP)
// =========================================================================
// 1. Base ATM Strike (Locked at Day Base Price)
int atm_strike_base = base_center_strike
int atm_idx_base = 5

if atm_select_mode == "Automatic"
    float min_diff_base = 1e9
    for i = 0 to 10
        float ce_o_val = calc_basis == "Day Open Price" ? array.get(ce_opens, i) : (calc_basis == "First 5 Min Close" ? array.get(ce_f5ms, i) : array.get(ce_prevs, i))
        float pe_o_val = calc_basis == "Day Open Price" ? array.get(pe_opens, i) : (calc_basis == "First 5 Min Close" ? array.get(pe_f5ms, i) : array.get(pe_prevs, i))
        int strike = array.get(strikes, i)
        
        if not na(ce_o_val) and not na(pe_o_val)
            float diff = math.abs(ce_o_val - pe_o_val)
            if diff < min_diff_base
                min_diff_base := diff
                atm_strike_base := strike
                atm_idx_base := i
else
    // Manual mode: lock to manual_strike_val directly
    atm_strike_base := manual_strike_val
    for i = 0 to 10
        if array.get(strikes, i) == manual_strike_val
            atm_idx_base := i
            break

// Base ATM premiums
float ce_atm_base = calc_basis == "Day Open Price" ? array.get(ce_opens, atm_idx_base) : (calc_basis == "First 5 Min Close" ? array.get(ce_f5ms, atm_idx_base) : array.get(ce_prevs, atm_idx_base))
float pe_atm_base = calc_basis == "Day Open Price" ? array.get(pe_opens, atm_idx_base) : (calc_basis == "First 5 Min Close" ? array.get(pe_f5ms, atm_idx_base) : array.get(pe_prevs, atm_idx_base))

// Locked Synthetic Future Formula
float Spot_Pivot = atm_strike_base
if not na(ce_atm_base) and not na(pe_atm_base)
    if ce_atm_base > pe_atm_base
        Spot_Pivot := atm_strike_base + (ce_atm_base - pe_atm_base)
    else
        Spot_Pivot := atm_strike_base - (pe_atm_base - ce_atm_base)

// Spot R1-R4 Option Base Premiums
float r1_ce_base = calc_basis == "Day Open Price" ? array.get(ce_opens, math.min(10, atm_idx_base + 1)) : (calc_basis == "First 5 Min Close" ? array.get(ce_f5ms, math.min(10, atm_idx_base + 1)) : array.get(ce_prevs, math.min(10, atm_idx_base + 1)))
float r2_ce_base = calc_basis == "Day Open Price" ? array.get(ce_opens, math.min(10, atm_idx_base + 2)) : (calc_basis == "First 5 Min Close" ? array.get(ce_f5ms, math.min(10, atm_idx_base + 2)) : array.get(ce_prevs, math.min(10, atm_idx_base + 2)))
float r3_ce_base = calc_basis == "Day Open Price" ? array.get(ce_opens, math.min(10, atm_idx_base + 3)) : (calc_basis == "First 5 Min Close" ? array.get(ce_f5ms, math.min(10, atm_idx_base + 3)) : array.get(ce_prevs, math.min(10, atm_idx_base + 3)))
float r4_ce_base = calc_basis == "Day Open Price" ? array.get(ce_opens, math.min(10, atm_idx_base + 4)) : (calc_basis == "First 5 Min Close" ? array.get(ce_f5ms, math.min(10, atm_idx_base + 4)) : array.get(ce_prevs, math.min(10, atm_idx_base + 4)))

// Spot S1-S4 Option Base Premiums
float s1_pe_base = calc_basis == "Day Open Price" ? array.get(pe_opens, math.max(0, atm_idx_base - 1)) : (calc_basis == "First 5 Min Close" ? array.get(pe_f5ms, math.max(0, atm_idx_base - 1)) : array.get(pe_prevs, math.max(0, atm_idx_base - 1)))
float s2_pe_base = calc_basis == "Day Open Price" ? array.get(pe_opens, math.max(0, atm_idx_base - 2)) : (calc_basis == "First 5 Min Close" ? array.get(pe_f5ms, math.max(0, atm_idx_base - 2)) : array.get(pe_prevs, math.max(0, atm_idx_base - 2)))
float s3_pe_base = calc_basis == "Day Open Price" ? array.get(pe_opens, math.max(0, atm_idx_base - 3)) : (calc_basis == "First 5 Min Close" ? array.get(pe_f5ms, math.max(0, atm_idx_base - 3)) : array.get(pe_prevs, math.max(0, atm_idx_base - 3)))
float s4_pe_base = calc_basis == "Day Open Price" ? array.get(pe_opens, math.max(0, atm_idx_base - 4)) : (calc_basis == "First 5 Min Close" ? array.get(pe_f5ms, math.max(0, atm_idx_base - 4)) : array.get(pe_prevs, math.max(0, atm_idx_base - 4)))

// Compute locked spot level projections
float Spot_R1 = atm_strike_base + ce_atm_base
float Spot_R2 = (atm_strike_base + 1 * strike_step) + r1_ce_base
float Spot_R3 = (atm_strike_base + 2 * strike_step) + r2_ce_base
float Spot_R4 = (atm_strike_base + 3 * strike_step) + r3_ce_base
float Spot_R5 = (atm_strike_base + 4 * strike_step) + r4_ce_base

float Spot_S1 = atm_strike_base - pe_atm_base
float Spot_S2 = (atm_strike_base - 1 * strike_step) - s1_pe_base
float Spot_S3 = (atm_strike_base - 2 * strike_step) - s2_pe_base
float Spot_S4 = (atm_strike_base - 3 * strike_step) - s3_pe_base
float Spot_S5 = (atm_strike_base - 4 * strike_step) - s4_pe_base

// 2. Real-Time ATM Strike Calculation (LTP Premium Difference based)
float min_diff_rt = 1e9
int atm_strike_rt = final_strike
int atm_idx_rt = 5

for i = 0 to 10
    float ce_l_val = array.get(ce_ltps, i)
    float pe_l_val = array.get(pe_ltps, i)
    int strike = array.get(strikes, i)
    
    if not na(ce_l_val) and not na(pe_l_val)
        float diff = math.abs(ce_l_val - pe_l_val)
        if diff < min_diff_rt
            min_diff_rt := diff
            atm_strike_rt := strike
            atm_idx_rt := i

float ce_atm_rt_ltp = array.get(ce_ltps, atm_idx_rt)
float pe_atm_rt_ltp = array.get(pe_ltps, atm_idx_rt)

// Alias for global references expecting atm_strike / atm_idx
int atm_strike = atm_strike_base
int atm_idx = atm_idx_base

// Get base premiums for selected strike (index 5)
ce_base_sel = f_get_base_premium(5, calc_basis, ce_opens, ce_prevs, ce_f5ms)
pe_base_sel = f_get_base_premium(5, calc_basis, pe_opens, pe_prevs, pe_f5ms)

// Pivot / BEP of Selected Strike
pivot_val = (ce_base_sel + pe_base_sel) / 2.0

// R1-R5 and S1-S5 calculations (based on base premiums)
r1_val = ce_base_sel
r2_val = (f_get_base_premium(4, calc_basis, ce_opens, ce_prevs, ce_f5ms) + f_get_base_premium(6, calc_basis, pe_opens, pe_prevs, pe_f5ms)) / 2.0
r3_val = (f_get_base_premium(3, calc_basis, ce_opens, ce_prevs, ce_f5ms) + f_get_base_premium(7, calc_basis, pe_opens, pe_prevs, pe_f5ms)) / 2.0
r4_val = (f_get_base_premium(2, calc_basis, ce_opens, ce_prevs, ce_f5ms) + f_get_base_premium(8, calc_basis, pe_opens, pe_prevs, pe_f5ms)) / 2.0
r5_val = (f_get_base_premium(1, calc_basis, ce_opens, ce_prevs, ce_f5ms) + f_get_base_premium(9, calc_basis, pe_opens, pe_prevs, pe_f5ms)) / 2.0

s1_val = pe_base_sel
s2_val = (f_get_base_premium(6, calc_basis, ce_opens, ce_prevs, ce_f5ms) + f_get_base_premium(4, calc_basis, pe_opens, pe_prevs, pe_f5ms)) / 2.0
s3_val = (f_get_base_premium(7, calc_basis, ce_opens, ce_prevs, ce_f5ms) + f_get_base_premium(3, calc_basis, pe_opens, pe_prevs, pe_f5ms)) / 2.0
s4_val = (f_get_base_premium(8, calc_basis, ce_opens, ce_prevs, ce_f5ms) + f_get_base_premium(2, calc_basis, pe_opens, pe_prevs, pe_f5ms)) / 2.0
s5_val = (f_get_base_premium(9, calc_basis, ce_opens, ce_prevs, ce_f5ms) + f_get_base_premium(1, calc_basis, pe_opens, pe_prevs, pe_f5ms)) / 2.0

// Adapt S/R levels for plotting on Spot vs Option chart
float p_plot = na
float r1_plot = na, float r2_plot = na, float r3_plot = na, float r4_plot = na, float r5_plot = na
float s1_plot = na, float s2_plot = na, float s3_plot = na, float s4_plot = na, float s5_plot = na

if is_option
    // Plot directly as premium values on Option chart to match the table exactly
    p_plot  := pivot_val
    r1_plot := r1_val
    r2_plot := r2_val
    r3_plot := r3_val
    r4_plot := r4_val
    r5_plot := r5_val
    s1_plot := s1_val
    s2_plot := s2_val
    s3_plot := s3_val
    s4_plot := s4_val
    s5_plot := s5_val
else
    // Adaptation for Spot Chart
    if plot_sr_on_spot == "Symmetric Channels (Strike +/- Premium)"
        p_plot  := final_strike
        r1_plot := final_strike + r1_val
        r2_plot := final_strike + r2_val
        r3_plot := final_strike + r3_val
        r4_plot := final_strike + r4_val
        r5_plot := final_strike + r5_val
        s1_plot := final_strike - s1_val
        s2_plot := final_strike - s2_val
        s3_plot := final_strike - s3_val
        s4_plot := final_strike - s4_val
        s5_plot := final_strike - s5_val
    else if plot_sr_on_spot == "Absolute Values"
        p_plot  := pivot_val
        r1_plot := r1_val
        r2_plot := r2_val
        r3_plot := r3_val
        r4_plot := r4_val
        r5_plot := r5_val
        s1_plot := s1_val
        s2_plot := s2_val
        s3_plot := s3_val
        s4_plot := s4_val
        s5_plot := s5_val
    else if plot_sr_on_spot == "Options-Chain Level Projections (Spot Formula)"
        p_plot  := Spot_Pivot
        r1_plot := Spot_R1
        r2_plot := Spot_R2
        r3_plot := Spot_R3
        r4_plot := Spot_R4
        r5_plot := Spot_R5
        s1_plot := Spot_S1
        s2_plot := Spot_S2
        s3_plot := Spot_S3
        s4_plot := Spot_S4
        s5_plot := Spot_S5

// Prevent continuation lines connecting to next day by inserting 'na' on the first bar of each new day
is_new_day = ta.change(time("D")) != 0
if is_new_day
    p_plot  := na
    r1_plot := na, r2_plot := na, r3_plot := na, r4_plot := na
    s1_plot := na, s2_plot := na, s3_plot := na, s4_plot := na

// Resolve ORB Strike Price relative to selected strike
int orb_strike = final_strike
if orb_strike_mode == "ITM"
    if orb_opt_type == "CE"
        orb_strike := final_strike - orb_strike_offset
    else // PE
        orb_strike := final_strike + orb_strike_offset
else if orb_strike_mode == "OTM"
    if orb_opt_type == "CE"
        orb_strike := final_strike + orb_strike_offset
    else // PE
        orb_strike := final_strike - orb_strike_offset

// Construct ORB contract symbol
string orb_sym = exchange + ":" + final_root + final_expiry + (orb_opt_type == "CE" ? "C" : "P") + str.tostring(orb_strike)

// Fetch ORB High and Low
[orb_h_raw, orb_l_raw] = request.security(orb_sym, orb_timeframe, f_orb_range())

float orb_high_plot = show_orb_lines ? orb_h_raw : na
float orb_low_plot = show_orb_lines ? orb_l_raw : na

if is_new_day
    orb_high_plot := na
    orb_low_plot := na

// Calculate Running BEP for the selected strike
ce_ltp_sel = array.get(ce_ltps, 5)
pe_ltp_sel = array.get(pe_ltps, 5)

float running_bep_val = na
if is_option
    running_bep_val := (ce_ltp_sel + pe_ltp_sel) / 2.0
else
    running_bep_val := final_strike + (ce_ltp_sel - pe_ltp_sel) / 2.0

float running_bep_plot = show_running_bep ? running_bep_val : na
if is_new_day
    running_bep_plot := na

// Extract CVD strike values from arrays
c3_h = array.get(ce_highs, 4), c3_l = array.get(ce_lows, 4), c3_c = array.get(ce_ltps, 4), c3_v = array.get(ce_vols, 4)
c4_h = array.get(ce_highs, 4), c4_l = array.get(ce_lows, 4), c4_c = array.get(ce_ltps, 4), c4_v = array.get(ce_vols, 4)
c5_h = array.get(ce_highs, 5), c5_l = array.get(ce_lows, 5), c5_c = array.get(ce_ltps, 5), c5_v = array.get(ce_vols, 5)
c6_h = array.get(ce_highs, 6), c6_l = array.get(ce_lows, 6), c6_c = array.get(ce_ltps, 6), c6_v = array.get(ce_vols, 6)
c7_h = array.get(ce_highs, 6), c7_l = array.get(ce_lows, 6), c7_c = array.get(ce_ltps, 6), c7_v = array.get(ce_vols, 6)

p3_h = array.get(pe_highs, 4), p3_l = array.get(pe_lows, 4), p3_c = array.get(pe_ltps, 4), p3_v = array.get(pe_vols, 4)
p4_h = array.get(pe_highs, 4), p4_l = array.get(pe_lows, 4), p4_c = array.get(pe_ltps, 4), p4_v = array.get(pe_vols, 4)
p5_h = array.get(pe_highs, 5), p5_l = array.get(pe_lows, 5), p5_c = array.get(pe_ltps, 5), p5_v = array.get(pe_vols, 5)
p6_h = array.get(pe_highs, 6), p6_l = array.get(pe_lows, 6), p6_c = array.get(pe_ltps, 6), p6_v = array.get(pe_vols, 6)
p7_h = array.get(pe_highs, 6), p7_l = array.get(pe_lows, 6), p7_c = array.get(pe_ltps, 6), p7_v = array.get(pe_vols, 6)

f_calc_buy_sell(float h, float l, float c, float v) =>
    buy_v = nz(v) * (nz(c) - nz(l)) / math.max(nz(h) - nz(l), 0.001)
    sell_v = nz(v) * (nz(h) - nz(c)) / math.max(nz(h) - nz(l), 0.001)
    [buy_v, sell_v]

[c3_buy, c3_sell] = f_calc_buy_sell(c3_h, c3_l, c3_c, c3_v)
[c4_buy, c4_sell] = f_calc_buy_sell(c4_h, c4_l, c4_c, c4_v)
[c5_buy, c5_sell] = f_calc_buy_sell(c5_h, c5_l, c5_c, c5_v)
[c6_buy, c6_sell] = f_calc_buy_sell(c6_h, c6_l, c6_c, c6_v)
[c7_buy, c7_sell] = f_calc_buy_sell(c7_h, c7_l, c7_c, c7_v)

[p3_buy, p3_sell] = f_calc_buy_sell(p3_h, p3_l, p3_c, p3_v)
[p4_buy, p4_sell] = f_calc_buy_sell(p4_h, p4_l, p4_c, p4_v)
[p5_buy, p5_sell] = f_calc_buy_sell(p5_h, p5_l, p5_c, p5_v)
[p6_buy, p6_sell] = f_calc_buy_sell(p6_h, p6_l, p6_c, p6_v)
[p7_buy, p7_sell] = f_calc_buy_sell(p7_h, p7_l, p7_c, p7_v)

// Extract ATM values (index 5)
ce_buy_vol = c5_buy
ce_sell_vol = c5_sell
ce_v = nz(c5_v)
ce_c = nz(c5_c)
ce_tot_vol = ce_buy_vol + ce_sell_vol
float ce_buy_pct = ce_tot_vol > 0 ? (ce_buy_vol * 100.0 / ce_tot_vol) : 50.0

pe_buy_vol = p5_buy
pe_sell_vol = p5_sell
pe_v = nz(p5_v)
pe_c = nz(p5_c)
pe_tot_vol = pe_buy_vol + pe_sell_vol
float pe_buy_pct = pe_tot_vol > 0 ? (pe_buy_vol * 100.0 / pe_tot_vol) : 50.0

// Fetch VWAP for selected contracts (read from loaded arrays)
ce_vwap_val = array.get(ce_vwaps, 5)
pe_vwap_val = array.get(pe_vwaps, 5)

// Cumulative Volume Delta (CVD) tracking for ATM strike
var float ce_cvd = 0.0
var float pe_cvd = 0.0

if is_new_day
    ce_cvd := 0.0
    pe_cvd := 0.0

ce_delta = ce_buy_vol - ce_sell_vol
pe_delta = pe_buy_vol - pe_sell_vol

ce_cvd := ce_cvd + ce_delta
pe_cvd := pe_cvd + pe_delta

// Volume Change Percentage
ce_v_ema = ta.ema(ce_v, 20)
pe_v_ema = ta.ema(pe_v, 20)

float ce_v_chg_pct = ce_v_ema > 0 ? ((ce_v - ce_v_ema) / ce_v_ema) * 100.0 : 0.0
float pe_v_chg_pct = pe_v_ema > 0 ? ((pe_v - pe_v_ema) / pe_v_ema) * 100.0 : 0.0

// Helper function to format volume to clean string
f_format_vol(float val) =>
    abs_val = math.abs(val)
    abs_val >= 1000000.0 ? str.tostring(abs_val / 1000000.0, "#.#") + "M" :
     abs_val >= 1000.0 ? str.tostring(abs_val / 1000.0, "#.#") + "K" :
     str.tostring(abs_val, "0")

// Define a global helper to resolve volume delta details for each specific S/R strike level
f_get_vol_suffix(int c_idx, int p_idx) =>
    float buy_v = na
    float sell_v = na
    string suffix = ""
    
    if is_option
        int idx = final_type == "C" ? c_idx : p_idx
        if idx == 5
            buy_v := final_type == "C" ? c5_buy : p5_buy
            sell_v := final_type == "C" ? c5_sell : p5_sell
        else if idx == 4
            buy_v := final_type == "C" ? c4_buy : p6_buy
            sell_v := final_type == "C" ? c4_sell : p6_sell
        else if idx == 6
            buy_v := final_type == "C" ? c6_buy : p4_buy
            sell_v := final_type == "C" ? c6_sell : p4_sell
        else if idx == 3 or idx == 2 or idx == 1
            buy_v := final_type == "C" ? c3_buy : p7_buy
            sell_v := final_type == "C" ? c3_sell : p7_sell
        else if idx == 7 or idx == 8 or idx == 9
            buy_v := final_type == "C" ? c7_buy : p3_buy
            sell_v := final_type == "C" ? c7_sell : p3_sell
            
        float delta_v = nz(buy_v) - nz(sell_v)
        string delta_sign = delta_v >= 0 ? "+" : "-"
        suffix := " (B: " + f_format_vol(buy_v) + " | S: " + f_format_vol(sell_v) + " | CVD: " + delta_sign + f_format_vol(delta_v) + ")"
    else
        float cb = na, float cs = na
        float pb = na, float ps = na
        
        if c_idx == 5
            cb := c5_buy, cs := c5_sell
        else if c_idx == 4
            cb := c4_buy, cs := c4_sell
        else if c_idx == 6
            cb := c6_buy, cs := c6_sell
        else if c_idx == 3 or c_idx == 2 or c_idx == 1
            cb := c3_buy, cs := c3_sell
        else if c_idx == 7 or c_idx == 8 or c_idx == 9
            cb := c7_buy, cs := c7_sell
            
        if p_idx == 5
            pb := p5_buy, ps := p5_sell
        else if p_idx == 4
            pb := p4_buy, ps := p4_sell
        else if p_idx == 6
            pb := p6_buy, ps := p6_sell
        else if p_idx == 3 or p_idx == 2 or p_idx == 1
            pb := p3_buy, ps := p3_sell
        else if p_idx == 7 or p_idx == 8 or p_idx == 9
            pb := p7_buy, ps := p7_sell
            
        float ce_delta_v = nz(cb) - nz(cs)
        float pe_delta_v = nz(pb) - nz(ps)
        string ce_sign = ce_delta_v >= 0 ? "+" : "-"
        string pe_sign = pe_delta_v >= 0 ? "+" : "-"
        
        suffix := " (CE B:" + f_format_vol(cb) + " S:" + f_format_vol(cs) + " CVD:" + ce_sign + f_format_vol(ce_delta_v) + " | PE B:" + f_format_vol(pb) + " S:" + f_format_vol(ps) + " CVD:" + pe_sign + f_format_vol(pe_delta_v) + ")"

    suffix

// Extract selected strike's VWAP based on Option Type
float vwap_sel = final_type == "C" ? ce_vwap_val : pe_vwap_val
float ce_vwap_plot_final = is_option ? ce_vwap_val : (plot_sr_on_spot != "Do Not Plot" ? final_strike + ce_vwap_val : na)
float pe_vwap_plot_final = is_option ? pe_vwap_val : (plot_sr_on_spot != "Do Not Plot" ? final_strike - pe_vwap_val : na)

// =========================================================================
// PLOTS AND RENDERINGS (ON CHART)
// =========================================================================
// Fetch opposite option historical candles for overlay
[opp_o, opp_h, opp_l, opp_c] = request.security(opp_sym, timeframe.period, [open, high, low, close])

candle_o = is_option and show_opp_candles ? opp_o : na
candle_h = is_option and show_opp_candles ? opp_h : na
candle_l = is_option and show_opp_candles ? opp_l : na
candle_c = is_option and show_opp_candles ? opp_c : na

opp_body_col = (candle_c >= candle_o) ? c_opp_bull : c_opp_bear
opp_wick_col = (candle_c >= candle_o) ? c_opp_bull_wick : c_opp_bear_wick

plotcandle(candle_o, candle_h, candle_l, candle_c, title="Opposite Option Candles", 
  color=opp_body_col, 
  wickcolor=opp_wick_col, 
  bordercolor=opp_wick_col)

plot(show_intrinsic_plots ? ce_int_plot : na, title="CE Intrinsic Value", color=c_ce_int, linewidth=2)
plot(show_intrinsic_plots ? pe_int_plot : na, title="PE Intrinsic Value", color=c_pe_int, linewidth=2)
plot(show_intrinsic_plots ? avg_int_plot : na, title="Average Intrinsic Value", color=c_avg_int, linewidth=1)

plot(show_intrinsic_plots ? ce_ext_plot : na, title="CE Extrinsic Value", color=c_ce_ext, linewidth=2)
plot(show_intrinsic_plots ? pe_ext_plot : na, title="PE Extrinsic Value", color=c_pe_ext, linewidth=2)
plot(show_intrinsic_plots ? avg_ext_plot : na, title="Average Extrinsic Value", color=c_avg_ext, linewidth=1)

f_get_level_color(int c_idx, int p_idx) =>
    float cb = na, float cs = na, float pb = na, float ps = na
    if c_idx == 5
        cb := c5_buy, cs := c5_sell
    else if c_idx == 4
        cb := c4_buy, cs := c4_sell
    else if c_idx == 6
        cb := c6_buy, cs := c6_sell
    else if c_idx == 3 or c_idx == 2 or c_idx == 1
        cb := c3_buy, cs := c3_sell
    else if c_idx == 7 or c_idx == 8 or c_idx == 9
        cb := c7_buy, cs := c7_sell
        
    if p_idx == 5
        pb := p5_buy, ps := p5_sell
    else if p_idx == 4
        pb := p4_buy, ps := p4_sell
    else if p_idx == 6
        pb := p6_buy, ps := p6_sell
    else if p_idx == 3 or p_idx == 2 or p_idx == 1
        pb := p3_buy, ps := p3_sell
    else if p_idx == 7 or p_idx == 8 or p_idx == 9
        pb := p7_buy, ps := p7_sell
        
    float ce_delta_v = nz(cb) - nz(cs)
    float pe_delta_v = nz(pb) - nz(ps)
    (ce_delta_v + pe_delta_v >= 0) ? #26A69A : #EF5350

col_p  = use_dynamic_colors ? f_get_level_color(5, 5) : c_p_in
col_r1 = use_dynamic_colors ? f_get_level_color(5, 5) : c_r1_in
col_r2 = use_dynamic_colors ? f_get_level_color(4, 6) : c_r2_in
col_r3 = use_dynamic_colors ? f_get_level_color(3, 7) : c_r3_in
col_r4 = use_dynamic_colors ? f_get_level_color(2, 8) : c_r4_in
col_r5 = use_dynamic_colors ? f_get_level_color(1, 9) : c_r5_in
col_s1 = use_dynamic_colors ? f_get_level_color(5, 5) : c_s1_in
col_s2 = use_dynamic_colors ? f_get_level_color(6, 4) : c_s2_in
col_s3 = use_dynamic_colors ? f_get_level_color(7, 3) : c_s3_in
col_s4 = use_dynamic_colors ? f_get_level_color(8, 2) : c_s4_in
col_s5 = use_dynamic_colors ? f_get_level_color(9, 1) : c_s5_in

plot(show_sr_plots ? p_plot : na, title="Pivot (Selected Strike BEP)", color=col_p, linewidth=2)
plot(show_sr_plots ? r1_plot : na, title="R1 (ATM CE)", color=col_r1, linewidth=2)
plot(show_sr_plots ? r2_plot : na, title="R2 (ITM Avg 1)", color=col_r2, linewidth=2)
plot(show_sr_plots ? r3_plot : na, title="R3 (ITM Avg 2)", color=col_r3, linewidth=2)
plot(show_sr_plots ? r4_plot : na, title="R4 (ITM Avg 3)", color=col_r4, linewidth=2)
plot(show_sr_plots ? r5_plot : na, title="R5 (ITM Avg 4)", color=col_r5, linewidth=2)
plot(show_sr_plots ? s1_plot : na, title="S1 (ATM PE)", color=col_s1, linewidth=2)
plot(show_sr_plots ? s2_plot : na, title="S2 (OTM Avg 1)", color=col_s2, linewidth=2)
plot(show_sr_plots ? s3_plot : na, title="S3 (OTM Avg 2)", color=col_s3, linewidth=2)
plot(show_sr_plots ? s4_plot : na, title="S4 (OTM Avg 3)", color=col_s4, linewidth=2)
plot(show_sr_plots ? s5_plot : na, title="S5 (OTM Avg 4)", color=col_s5, linewidth=2)

plot(show_orb_lines ? orb_high_plot : na, title="ORB Range High", color=c_orb_in, linewidth=1)
plot(show_orb_lines ? orb_low_plot : na, title="ORB Range Low", color=c_orb_in, linewidth=1)

plot(show_running_bep ? running_bep_plot : na, title="Running BEP", color=c_running_bep, linewidth=2)

plot(show_pdhl ? pd_high_val : na, title="PD High (PDH)", color=c_pdh_in, linewidth=1)
plot(show_pdhl ? pd_low_val : na, title="PD Low (PDL)", color=c_pdl_in, linewidth=1)

plot(show_vwap_plots ? ce_vwap_plot_final : na, title="CE VWAP", color=c_ce_vwap, linewidth=2)
plot(show_vwap_plots ? pe_vwap_plot_final : na, title="PE VWAP", color=c_pe_vwap, linewidth=2)

// =========================================================================
// PROJECTED HORIZONTAL LINES ENGINE (FOR EXTENSION INTO FUTURE SPACE)
// =========================================================================
f_get_line_style(string style_str) =>
    style_str == "Dashed" ? line.style_dashed :
     style_str == "Dotted" ? line.style_dotted :
     line.style_solid

var line ln_p = na
var line ln_r1 = na, var line ln_r2 = na, var line ln_r3 = na, var line ln_r4 = na, var line ln_r5 = na
var line ln_s1 = na, var line ln_s2 = na, var line ln_s3 = na, var line ln_s4 = na, var line ln_s5 = na
var line ln_orb_h = na, var line ln_orb_l = na
var line ln_pdh = na, var line ln_pdl = na

if sr_draw_mode == "Horizontal Lines (Projected to Right)"
    if is_new_day
        line.delete(ln_p)
        line.delete(ln_r1), line.delete(ln_r2), line.delete(ln_r3), line.delete(ln_r4), line.delete(ln_r5)
        line.delete(ln_s1), line.delete(ln_s2), line.delete(ln_s3), line.delete(ln_s4), line.delete(ln_s5)
        
        int x1 = bar_index
        int x2 = bar_index + 10
        
        if show_sr_plots
            if not na(p_plot)
                ln_p  := line.new(x1, p_plot, x2, p_plot, color=col_p, width=2, style=line.style_solid)
            if not na(r1_plot)
                ln_r1 := line.new(x1, r1_plot, x2, r1_plot, color=col_r1, width=2, style=line.style_solid)
            if not na(r2_plot)
                ln_r2 := line.new(x1, r2_plot, x2, r2_plot, color=col_r2, width=2, style=line.style_solid)
            if not na(r3_plot)
                ln_r3 := line.new(x1, r3_plot, x2, r3_plot, color=col_r3, width=2, style=line.style_solid)
            if not na(r4_plot)
                ln_r4 := line.new(x1, r4_plot, x2, r4_plot, color=col_r4, width=2, style=line.style_solid)
            if not na(r5_plot)
                ln_r5 := line.new(x1, r5_plot, x2, r5_plot, color=col_r5, width=2, style=line.style_solid)
                
            if not na(s1_plot)
                ln_s1 := line.new(x1, s1_plot, x2, s1_plot, color=col_s1, width=2, style=line.style_solid)
            if not na(s2_plot)
                ln_s2 := line.new(x1, s2_plot, x2, s2_plot, color=col_s2, width=2, style=line.style_solid)
            if not na(s3_plot)
                ln_s3 := line.new(x1, s3_plot, x2, s3_plot, color=col_s3, width=2, style=line.style_solid)
            if not na(s4_plot)
                ln_s4 := line.new(x1, s4_plot, x2, s4_plot, color=col_s4, width=2, style=line.style_solid)
            if not na(s5_plot)
                ln_s5 := line.new(x1, s5_plot, x2, s5_plot, color=col_s5, width=2, style=line.style_solid)

        if show_orb_lines
            line.delete(ln_orb_h), line.delete(ln_orb_l)
            if not na(orb_high_plot)
                ln_orb_h := line.new(x1, orb_high_plot, x2, orb_high_plot, color=c_orb_in, width=1, style=line.style_solid)
            if not na(orb_low_plot)
                ln_orb_l := line.new(x1, orb_low_plot, x2, orb_low_plot, color=c_orb_in, width=1, style=line.style_solid)
                
        if show_pdhl
            line.delete(ln_pdh), line.delete(ln_pdl)
            if not na(pd_high_val)
                ln_pdh := line.new(x1, pd_high_val, x2, pd_high_val, color=c_pdh_in, width=1, style=line.style_solid)
            if not na(pd_low_val)
                ln_pdl := line.new(x1, pd_low_val, x2, pd_low_val, color=c_pdl_in, width=1, style=line.style_solid)

    else
        // Extend line endpoints on every bar
        int ext_x = bar_index + 10
        if not na(ln_p)
            line.set_x2(ln_p, ext_x)
        if not na(ln_r1)
            line.set_x2(ln_r1, ext_x)
        if not na(ln_r2)
            line.set_x2(ln_r2, ext_x)
        if not na(ln_r3)
            line.set_x2(ln_r3, ext_x)
        if not na(ln_r4)
            line.set_x2(ln_r4, ext_x)
        if not na(ln_r5)
            line.set_x2(ln_r5, ext_x)
            
        if not na(ln_s1)
            line.set_x2(ln_s1, ext_x)
        if not na(ln_s2)
            line.set_x2(ln_s2, ext_x)
        if not na(ln_s3)
            line.set_x2(ln_s3, ext_x)
        if not na(ln_s4)
            line.set_x2(ln_s4, ext_x)
        if not na(ln_s5)
            line.set_x2(ln_s5, ext_x)
            
        if not na(ln_orb_h)
            line.set_x2(ln_orb_h, ext_x)
        if not na(ln_orb_l)
            line.set_x2(ln_orb_l, ext_x)
            
        if not na(ln_pdh)
            line.set_x2(ln_pdh, ext_x)
        if not na(ln_pdl)
            line.set_x2(ln_pdl, ext_x)

// =========================================================================
// FLOATING RIGHT-SIDE VALUE LABELS
// =========================================================================
var label lbl_p = na
var label lbl_r1 = na, var label lbl_r2 = na, var label lbl_r3 = na, var label lbl_r4 = na, var label lbl_r5 = na
var label lbl_s1 = na, var label lbl_s2 = na, var label lbl_s3 = na, var label lbl_s4 = na, var label lbl_s5 = na
var label lbl_ce_int = na, var label lbl_pe_int = na, var label lbl_avg_int = na
var label lbl_ce_ext = na, var label lbl_pe_ext = na, var label lbl_avg_ext = na
var label lbl_orb_h = na, var label lbl_orb_l = na
var label lbl_pdh = na, var label lbl_pdl = na
var label lbl_running_bep = na
var label lbl_ce_vwap = na, var label lbl_pe_vwap = na

if barstate.islast
    if show_line_labels
        label.delete(lbl_p)
        label.delete(lbl_r1), label.delete(lbl_r2), label.delete(lbl_r3), label.delete(lbl_r4), label.delete(lbl_r5)
        label.delete(lbl_s1), label.delete(lbl_s2), label.delete(lbl_s3), label.delete(lbl_s4), label.delete(lbl_s5)
        label.delete(lbl_pdh), label.delete(lbl_pdl)
        
        int label_x = bar_index + 12
        if show_sr_plots
            if not na(p_plot)
                lbl_p  := label.new(label_x, p_plot,  "P: "  + str.tostring(p_plot,  "#.##") + f_get_vol_suffix(5, 5), color=col_p,  textcolor=color.black, style=label.style_label_left, size=size.small)
            if not na(r1_plot)
                lbl_r1 := label.new(label_x, r1_plot, "R1: " + str.tostring(r1_plot, "#.##") + f_get_vol_suffix(5, 5), color=col_r1, textcolor=color.black, style=label.style_label_left, size=size.small)
            if not na(r2_plot)
                lbl_r2 := label.new(label_x, r2_plot, "R2: " + str.tostring(r2_plot, "#.##") + f_get_vol_suffix(4, 6), color=col_r2, textcolor=color.white, style=label.style_label_left, size=size.small)
            if not na(r3_plot)
                lbl_r3 := label.new(label_x, r3_plot, "R3: " + str.tostring(r3_plot, "#.##") + f_get_vol_suffix(3, 7), color=col_r3, textcolor=color.white, style=label.style_label_left, size=size.small)
            if not na(r4_plot)
                lbl_r4 := label.new(label_x, r4_plot, "R4: " + str.tostring(r4_plot, "#.##") + f_get_vol_suffix(2, 8), color=col_r4, textcolor=color.white, style=label.style_label_left, size=size.small)
            if not na(r5_plot)
                lbl_r5 := label.new(label_x, r5_plot, "R5: " + str.tostring(r5_plot, "#.##") + f_get_vol_suffix(1, 9), color=col_r5, textcolor=color.white, style=label.style_label_left, size=size.small)
                
            if not na(s1_plot)
                lbl_s1 := label.new(label_x, s1_plot, "S1: " + str.tostring(s1_plot, "#.##") + f_get_vol_suffix(5, 5), color=col_s1, textcolor=color.white, style=label.style_label_left, size=size.small)
            if not na(s2_plot)
                lbl_s2 := label.new(label_x, s2_plot, "S2: " + str.tostring(s2_plot, "#.##") + f_get_vol_suffix(6, 4), color=col_s2, textcolor=color.white, style=label.style_label_left, size=size.small)
            if not na(s3_plot)
                lbl_s3 := label.new(label_x, s3_plot, "S3: " + str.tostring(s3_plot, "#.##") + f_get_vol_suffix(7, 3), color=col_s3, textcolor=color.black, style=label.style_label_left, size=size.small)
            if not na(s4_plot)
                lbl_s4 := label.new(label_x, s4_plot, "S4: " + str.tostring(s4_plot, "#.##") + f_get_vol_suffix(8, 2), color=col_s4, textcolor=color.black, style=label.style_label_left, size=size.small)
            if not na(s5_plot)
                lbl_s5 := label.new(label_x, s5_plot, "S5: " + str.tostring(s5_plot, "#.##") + f_get_vol_suffix(9, 1), color=col_s5, textcolor=color.black, style=label.style_label_left, size=size.small)

        if show_pdhl
            if not na(pd_high_val)
                lbl_pdh := label.new(label_x, pd_high_val, "PDH: " + str.tostring(pd_high_val, "#.##"), color=c_pdh_in, textcolor=color.black, style=label.style_label_left, size=size.small)
            if not na(pd_low_val)
                lbl_pdl := label.new(label_x, pd_low_val, "PDL: " + str.tostring(pd_low_val, "#.##"), color=c_pdl_in, textcolor=color.white, style=label.style_label_left, size=size.small)

    if show_intrinsic_plots
        label.delete(lbl_ce_int), label.delete(lbl_pe_int), label.delete(lbl_avg_int)
        label.delete(lbl_ce_ext), label.delete(lbl_pe_ext), label.delete(lbl_avg_ext)
        
        int label_x_val = bar_index + 16
        if not na(ce_int_plot) and ce_int_plot > 0
            lbl_ce_int  := label.new(label_x_val, ce_int_plot,  "CE Int: " + str.tostring(ce_int_plot, "#.##"),  color=#00E676, textcolor=color.black, style=label.style_label_left, size=size.small)
        if not na(pe_int_plot) and pe_int_plot > 0
            lbl_pe_int  := label.new(label_x_val, pe_int_plot,  "PE Int: " + str.tostring(pe_int_plot, "#.##"),  color=#FF1744, textcolor=color.white, style=label.style_label_left, size=size.small)
        if not na(avg_int_plot) and avg_int_plot > 0
            lbl_avg_int := label.new(label_x_val, avg_int_plot, "Avg Int: " + str.tostring(avg_int_plot, "#.##"), color=#00B0FF, textcolor=color.black, style=label.style_label_left, size=size.small)
            
        if not na(ce_ext_plot) and ce_ext_plot > 0
            lbl_ce_ext  := label.new(label_x_val, ce_ext_plot,  "CE Ext: " + str.tostring(ce_ext_plot, "#.##"),  color=#FF9100, textcolor=color.black, style=label.style_label_left, size=size.small)
        if not na(pe_ext_plot) and pe_ext_plot > 0
            lbl_pe_ext  := label.new(label_x_val, pe_ext_plot,  "PE Ext: " + str.tostring(pe_ext_plot, "#.##"),  color=#D500F9, textcolor=color.white, style=label.style_label_left, size=size.small)
        if not na(avg_ext_plot) and avg_ext_plot > 0
            lbl_avg_ext := label.new(label_x_val, avg_ext_plot, "Avg Ext: " + str.tostring(avg_ext_plot, "#.##"), color=#2979FF, textcolor=color.white, style=label.style_label_left, size=size.small)

    if show_orb_lines and show_orb_labels
        label.delete(lbl_orb_h), label.delete(lbl_orb_l)
        
        int label_x_orb = bar_index + 19
        if not na(orb_high_plot)
            lbl_orb_h := label.new(label_x_orb, orb_high_plot, "ORB High: " + str.tostring(orb_high_plot, "#.##"), color=color.blue, textcolor=color.white, style=label.style_label_left, size=size.small)
        if not na(orb_low_plot)
            lbl_orb_l := label.new(label_x_orb, orb_low_plot, "ORB Low: " + str.tostring(orb_low_plot, "#.##"), color=color.blue, textcolor=color.white, style=label.style_label_left, size=size.small)

    if show_running_bep
        label.delete(lbl_running_bep)
        
        int label_x_bep = bar_index + 5
        if not na(running_bep_plot)
            lbl_running_bep := label.new(label_x_bep, running_bep_plot, "Running BEP: " + str.tostring(running_bep_plot, "#.##"), color=color.white, textcolor=color.black, style=label.style_label_left, size=size.small)

    if show_vwap_plots
        label.delete(lbl_ce_vwap), label.delete(lbl_pe_vwap)
        
        int label_x_vwap = bar_index + 26
        if not na(ce_vwap_plot_final)
            lbl_ce_vwap := label.new(label_x_vwap, ce_vwap_plot_final, "CE VWAP: " + str.tostring(ce_vwap_plot_final, "#.##"), color=#009688, textcolor=color.white, style=label.style_label_left, size=size.small)
        if not na(pe_vwap_plot_final)
            lbl_pe_vwap := label.new(label_x_vwap, pe_vwap_plot_final, "PE VWAP: " + str.tostring(pe_vwap_plot_final, "#.##"), color=#E91E63, textcolor=color.white, style=label.style_label_left, size=size.small)

// Explanatory Calculation Table
var string t_pos_calc = position.bottom_left
if table_pos_calc_str == "Top Right"
    t_pos_calc := position.top_right
else if table_pos_calc_str == "Top Left"
    t_pos_calc := position.top_left
else if table_pos_calc_str == "Bottom Right"
    t_pos_calc := position.bottom_right

t_size = table_size_str == "Tiny" ? size.tiny : (table_size_str == "Small" ? size.small : (table_size_str == "Normal" ? size.normal : size.large))

var table calc_box = table.new(t_pos_calc, 4, 13, bgcolor=color.new(color.black, 30), border_color=color.gray, border_width=1)
if barstate.islast and show_calc_box
    table.clear(calc_box, 0, 0, 3, 12)
    
    if show_calc_details
        // Detailed 4-column view showing Chosen Strike, Option LTP (Base Open), and Spot Target Level
        table.cell(calc_box, 0, 0, "Metric / Level", text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 1, 0, "Chosen Strike", text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 0, "Option Base (" + calc_basis + ")", text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 0, "Spot S/R Value", text_color=color.yellow, text_size=t_size, text_halign=text.align_center)
        
        // ATM Strike
        table.cell(calc_box, 0, 1, "ATM Strike (" + calc_basis + ")", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 1, str.tostring(atm_strike_base), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 1, "CE:" + str.tostring(ce_atm_base, "#.##") + " | PE:" + str.tostring(pe_atm_base, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 1, str.tostring(atm_strike_base), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        
        // Synthetic Future (Pivot)
        string synth_diff_str = (ce_atm_base >= pe_atm_base) ? ("+ (" + str.tostring(ce_atm_base - pe_atm_base, "#.##") + ")") : ("- (" + str.tostring(pe_atm_base - ce_atm_base, "#.##") + ")")
        table.cell(calc_box, 0, 2, "Synthetic Future (Pivot)", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 2, str.tostring(atm_strike_base) + " (ATM)", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 2, "Diff: " + synth_diff_str, text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 2, str.tostring(Spot_Pivot, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        
        // R1
        table.cell(calc_box, 0, 3, "Resistance 1 (R1)", text_color=#EF5350, text_size=t_size)
        table.cell(calc_box, 1, 3, str.tostring(atm_strike_base) + " CE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 3, str.tostring(ce_atm_base, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 3, str.tostring(Spot_R1, "#.##"), text_color=#EF5350, text_size=t_size, text_halign=text.align_center)
        
        // R2
        table.cell(calc_box, 0, 4, "Resistance 2 (R2)", text_color=#EF5350, text_size=t_size)
        table.cell(calc_box, 1, 4, str.tostring(atm_strike_base + 1 * strike_step) + " CE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 4, str.tostring(r1_ce_base, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 4, str.tostring(Spot_R2, "#.##"), text_color=#EF5350, text_size=t_size, text_halign=text.align_center)
        
        // R3
        table.cell(calc_box, 0, 5, "Resistance 3 (R3)", text_color=#EF5350, text_size=t_size)
        table.cell(calc_box, 1, 5, str.tostring(atm_strike_base + 2 * strike_step) + " CE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 5, str.tostring(r2_ce_base, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 5, str.tostring(Spot_R3, "#.##"), text_color=#EF5350, text_size=t_size, text_halign=text.align_center)
        
        // R4
        table.cell(calc_box, 0, 6, "Resistance 4 (R4)", text_color=#EF5350, text_size=t_size)
        table.cell(calc_box, 1, 6, str.tostring(atm_strike_base + 3 * strike_step) + " CE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 6, str.tostring(r3_ce_base, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 6, str.tostring(Spot_R4, "#.##"), text_color=#EF5350, text_size=t_size, text_halign=text.align_center)
        
        // R5
        table.cell(calc_box, 0, 7, "Resistance 5 (R5)", text_color=#EF5350, text_size=t_size)
        table.cell(calc_box, 1, 7, str.tostring(atm_strike_base + 4 * strike_step) + " CE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 7, str.tostring(r4_ce_base, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 7, str.tostring(Spot_R5, "#.##"), text_color=#EF5350, text_size=t_size, text_halign=text.align_center)

        // S1
        table.cell(calc_box, 0, 8, "Support 1 (S1)", text_color=#26A69A, text_size=t_size)
        table.cell(calc_box, 1, 8, str.tostring(atm_strike_base) + " PE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 8, str.tostring(pe_atm_base, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 8, str.tostring(Spot_S1, "#.##"), text_color=#26A69A, text_size=t_size, text_halign=text.align_center)
        
        // S2
        table.cell(calc_box, 0, 9, "Support 2 (S2)", text_color=#26A69A, text_size=t_size)
        table.cell(calc_box, 1, 9, str.tostring(atm_strike_base - 1 * strike_step) + " PE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 9, str.tostring(s1_pe_base, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 9, str.tostring(Spot_S2, "#.##"), text_color=#26A69A, text_size=t_size, text_halign=text.align_center)
        
        // S3
        table.cell(calc_box, 0, 10, "Support 3 (S3)", text_color=#26A69A, text_size=t_size)
        table.cell(calc_box, 1, 10, str.tostring(atm_strike_base - 2 * strike_step) + " PE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 10, str.tostring(s2_pe_base, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 10, str.tostring(Spot_S3, "#.##"), text_color=#26A69A, text_size=t_size, text_halign=text.align_center)
        
        // S4
        table.cell(calc_box, 0, 11, "Support 4 (S4)", text_color=#26A69A, text_size=t_size)
        table.cell(calc_box, 1, 11, str.tostring(atm_strike_base - 3 * strike_step) + " PE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 11, str.tostring(s3_pe_base, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 11, str.tostring(Spot_S4, "#.##"), text_color=#26A69A, text_size=t_size, text_halign=text.align_center)

        // S5
        table.cell(calc_box, 0, 12, "Support 5 (S5)", text_color=#26A69A, text_size=t_size)
        table.cell(calc_box, 1, 12, str.tostring(atm_strike_base - 4 * strike_step) + " PE", text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 2, 12, str.tostring(s4_pe_base, "#.##"), text_color=color.white, text_size=t_size, text_halign=text.align_center)
        table.cell(calc_box, 3, 12, str.tostring(Spot_S5, "#.##"), text_color=#26A69A, text_size=t_size, text_halign=text.align_center)
    else
        // Compact 2-column view
        table.cell(calc_box, 0, 0, "Metric / Formula", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 0, "Current Value", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 0, 1, "ATM Strike (" + calc_basis + ")", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 1, str.tostring(atm_strike_base), text_color=color.white, text_size=t_size)
        table.cell(calc_box, 0, 2, "Synthetic Future (Pivot)", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 2, str.tostring(Spot_Pivot, "#.##"), text_color=color.white, text_size=t_size)
        table.cell(calc_box, 0, 3, "R1 ((ATM+1*Step) + CE)", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 3, str.tostring(Spot_R1, "#.##"), text_color=color.white, text_size=t_size)
        table.cell(calc_box, 0, 4, "R2 ((ATM+2*Step) + CE)", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 4, str.tostring(Spot_R2, "#.##"), text_color=color.white, text_size=t_size)
        table.cell(calc_box, 0, 5, "R3 ((ATM+3*Step) + CE)", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 5, str.tostring(Spot_R3, "#.##"), text_color=color.white, text_size=t_size)
        table.cell(calc_box, 0, 6, "R4 ((ATM+4*Step) + CE)", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 6, str.tostring(Spot_R4, "#.##"), text_color=color.white, text_size=t_size)
        table.cell(calc_box, 0, 7, "S1 ((ATM-1*Step) - PE)", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 7, str.tostring(Spot_S1, "#.##"), text_color=color.white, text_size=t_size)
        table.cell(calc_box, 0, 8, "S2 ((ATM-2*Step) - PE)", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 8, str.tostring(Spot_S2, "#.##"), text_color=color.white, text_size=t_size)
        table.cell(calc_box, 0, 9, "S3 ((ATM-3*Step) - PE)", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 9, str.tostring(Spot_S3, "#.##"), text_color=color.white, text_size=t_size)
        table.cell(calc_box, 0, 10, "S4 ((ATM-4*Step) - PE)", text_color=color.white, text_size=t_size)
        table.cell(calc_box, 1, 10, str.tostring(Spot_S4, "#.##"), text_color=color.white, text_size=t_size)

// =========================================================================
// SWING REVERSALS & VOLUME ANALYTICS ENGINE
// =========================================================================
swing_tf = swing_tf_str == "Chart Timeframe" ? timeframe.period : (swing_tf_str == "1 Min" ? "1" : (swing_tf_str == "3 Min" ? "3" : (swing_tf_str == "5 Min" ? "5" : (swing_tf_str == "10 Min" ? "10" : (swing_tf_str == "15 Min" ? "15" : "30")))))

// Fetch volume from spot/futures symbol as primary, and current chart as fallback for option premium charts
[fut_sh, fut_sl, fut_sc, fut_sv] = request.security(spot_sym, swing_tf, [high, low, close, volume])
[chart_sh, chart_sl, chart_sc, chart_sv] = request.security(syminfo.tickerid, swing_tf, [high, low, close, volume])

float use_sh = (not na(fut_sv) and fut_sv > 0) ? fut_sh : (not na(chart_sh) ? chart_sh : high)
float use_sl = (not na(fut_sv) and fut_sv > 0) ? fut_sl : (not na(chart_sl) ? chart_sl : low)
float use_sc = (not na(fut_sv) and fut_sv > 0) ? fut_sc : (not na(chart_sc) ? chart_sc : close)
float use_sv = (not na(fut_sv) and fut_sv > 0) ? fut_sv : (not na(chart_sv) and chart_sv > 0 ? chart_sv : nz(volume))

[use_sbuy, use_ssell] = f_calc_buy_sell(use_sh, use_sl, use_sc, use_sv)
float use_sdelta = use_sbuy - use_ssell

p_high = ta.pivothigh(high, swing_len_left, swing_len_right)
p_low  = ta.pivotlow(low, swing_len_left, swing_len_right)

var label manual_sh_lbl = na
var label manual_sl_lbl = na

if show_swings
    if swing_select_mode == "Automatic"
        // --- AUTOMATIC PIVOTS ---
        if not na(p_high)
            float min_diff_ph = 1e9
            if not na(Spot_R1) and math.abs(p_high - Spot_R1) < min_diff_ph
                min_diff_ph := math.abs(p_high - Spot_R1)
            if not na(Spot_R2) and math.abs(p_high - Spot_R2) < min_diff_ph
                min_diff_ph := math.abs(p_high - Spot_R2)
            if not na(Spot_R3) and math.abs(p_high - Spot_R3) < min_diff_ph
                min_diff_ph := math.abs(p_high - Spot_R3)
            if not na(Spot_R4) and math.abs(p_high - Spot_R4) < min_diff_ph
                min_diff_ph := math.abs(p_high - Spot_R4)
            if not na(r1_val) and math.abs(p_high - r1_val) < min_diff_ph
                min_diff_ph := math.abs(p_high - r1_val)
            if not na(r2_val) and math.abs(p_high - r2_val) < min_diff_ph
                min_diff_ph := math.abs(p_high - r2_val)
            if not na(atm_strike) and math.abs(p_high - atm_strike) < min_diff_ph
                min_diff_ph := math.abs(p_high - atm_strike)

            float tolerance = 0.005 * close
            if min_diff_ph < tolerance or true
                float cur_sv = nz(use_sv[swing_len_right])
                float cur_sdelta = nz(use_sdelta[swing_len_right])
                if cur_sv == 0
                    cur_sv := nz(volume[swing_len_right])
                    [b_v, s_v] = f_calc_buy_sell(high[swing_len_right], low[swing_len_right], close[swing_len_right], cur_sv)
                    cur_sdelta := b_v - s_v
                    
                float r = cur_sv > 0 ? (cur_sdelta / cur_sv) : 0.0
                color col = r > 0.05 ? #00E676 : (r < -0.05 ? #FF1744 : color.gray)
                string delta_str = cur_sdelta >= 0 ? "+" + f_format_vol(cur_sdelta) : f_format_vol(cur_sdelta)
                label.new(bar_index[swing_len_right], p_high, "SH (" + delta_str + ")", style=label.style_label_down, color=col, textcolor=color.black, size=size.small)

        if not na(p_low)
            float min_diff_pl = 1e9
            if not na(Spot_S1) and math.abs(p_low - Spot_S1) < min_diff_pl
                min_diff_pl := math.abs(p_low - Spot_S1)
            if not na(Spot_S2) and math.abs(p_low - Spot_S2) < min_diff_pl
                min_diff_pl := math.abs(p_low - Spot_S2)
            if not na(Spot_S3) and math.abs(p_low - Spot_S3) < min_diff_pl
                min_diff_pl := math.abs(p_low - Spot_S3)
            if not na(Spot_S4) and math.abs(p_low - Spot_S4) < min_diff_pl
                min_diff_pl := math.abs(p_low - Spot_S4)
            if not na(s1_val) and math.abs(p_low - s1_val) < min_diff_pl
                min_diff_pl := math.abs(p_low - s1_val)
            if not na(s2_val) and math.abs(p_low - s2_val) < min_diff_pl
                min_diff_pl := math.abs(p_low - s2_val)
            if not na(atm_strike) and math.abs(p_low - atm_strike) < min_diff_pl
                min_diff_pl := math.abs(p_low - atm_strike)

            float tolerance = 0.005 * close
            if min_diff_pl < tolerance or true
                float cur_sv = nz(use_sv[swing_len_right])
                float cur_sdelta = nz(use_sdelta[swing_len_right])
                if cur_sv == 0
                    cur_sv := nz(volume[swing_len_right])
                    [b_v, s_v] = f_calc_buy_sell(high[swing_len_right], low[swing_len_right], close[swing_len_right], cur_sv)
                    cur_sdelta := b_v - s_v

                float r = cur_sv > 0 ? (cur_sdelta / cur_sv) : 0.0
                color col = r > 0.05 ? #00E676 : (r < -0.05 ? #FF1744 : color.gray)
                string delta_str = cur_sdelta >= 0 ? "+" + f_format_vol(cur_sdelta) : f_format_vol(cur_sdelta)
                label.new(bar_index[swing_len_right], p_low, "SL (" + delta_str + ")", style=label.style_label_up, color=col, textcolor=color.black, size=size.small)

    else
        // --- MANUAL REAL-TIME LAST PIVOT UPDATER ---
        if barstate.islast
            float ph_last = na, int ph_idx = na
            float pl_last = na, int pl_idx = na
            
            for k = 0 to 300
                if not na(p_high[k]) and na(ph_last)
                    ph_last := p_high[k]
                    ph_idx := k + swing_len_right
                if not na(p_low[k]) and na(pl_last)
                    pl_last := p_low[k]
                    pl_idx := k + swing_len_right
                if not na(ph_last) and not na(pl_last)
                    break
                    
            label.delete(manual_sh_lbl)
            label.delete(manual_sl_lbl)
            
            if not na(ph_last) and not na(ph_idx)
                float cur_sv = nz(use_sv[ph_idx])
                float cur_sdelta = nz(use_sdelta[ph_idx])
                if cur_sv == 0
                    cur_sv := nz(volume[ph_idx])
                    [b_v, s_v] = f_calc_buy_sell(high[ph_idx], low[ph_idx], close[ph_idx], cur_sv)
                    cur_sdelta := b_v - s_v
                float r = cur_sv > 0 ? (cur_sdelta / cur_sv) : 0.0
                color col = r > 0.05 ? #00E676 : (r < -0.05 ? #FF1744 : color.gray)
                string delta_str = cur_sdelta >= 0 ? "+" + f_format_vol(cur_sdelta) : f_format_vol(cur_sdelta)
                manual_sh_lbl := label.new(bar_index[ph_idx], ph_last, "SH (" + delta_str + ")", style=label.style_label_down, color=col, textcolor=color.black, size=size.small)

            if not na(pl_last) and not na(pl_idx)
                float cur_sv = nz(use_sv[pl_idx])
                float cur_sdelta = nz(use_sdelta[pl_idx])
                if cur_sv == 0
                    cur_sv := nz(volume[pl_idx])
                    [b_v, s_v] = f_calc_buy_sell(high[pl_idx], low[pl_idx], close[pl_idx], cur_sv)
                    cur_sdelta := b_v - s_v
                float r = cur_sv > 0 ? (cur_sdelta / cur_sv) : 0.0
                color col = r > 0.05 ? #00E676 : (r < -0.05 ? #FF1744 : color.gray)
                string delta_str = cur_sdelta >= 0 ? "+" + f_format_vol(cur_sdelta) : f_format_vol(cur_sdelta)
                manual_sl_lbl := label.new(bar_index[pl_idx], pl_last, "SL (" + delta_str + ")", style=label.style_label_up, color=col, textcolor=color.black, size=size.small)

// =========================================================================
// DASHBOARD TABLE ENGINE
// =========================================================================
var string t_pos = position.top_right
if table_pos_str == "Top Left"
    t_pos := position.top_left
else if table_pos_str == "Bottom Right"
    t_pos := position.bottom_right
else if table_pos_str == "Bottom Left"
    t_pos := position.bottom_left

t_size_dash = table_size_str == "Tiny" ? size.tiny : (table_size_str == "Small" ? size.small : (table_size_str == "Normal" ? size.normal : size.large))

var table dash = table.new(t_pos, 7, 15, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)

if barstate.islast and show_tbl
    table.clear(dash, 0, 0, 6, 14)
    
    // Header Row 0
    table.cell(dash, 0, 0, "Strike", bgcolor=#37474F, text_color=color.white, text_size=t_size_dash)
    table.cell(dash, 1, 0, "CE Open/PDC", bgcolor=#37474F, text_color=color.white, text_size=t_size_dash)
    table.cell(dash, 2, 0, "CE LTP", bgcolor=#37474F, text_color=color.white, text_size=t_size_dash)
    table.cell(dash, 3, 0, "PE Open/PDC", bgcolor=#37474F, text_color=color.white, text_size=t_size_dash)
    table.cell(dash, 4, 0, "PE LTP", bgcolor=#37474F, text_color=color.white, text_size=t_size_dash)
    table.cell(dash, 5, 0, "Pivot (BEP)", bgcolor=#37474F, text_color=color.white, text_size=t_size_dash)
    table.cell(dash, 6, 0, "CVD Delta", bgcolor=#37474F, text_color=color.white, text_size=t_size_dash)

    for idx = 0 to 10
        int st_val = array.get(strikes, idx)
        float c_base = f_get_base_premium(idx, calc_basis, ce_opens, ce_prevs, ce_f5ms)
        float p_base = f_get_base_premium(idx, calc_basis, pe_opens, pe_prevs, pe_f5ms)
        float c_ltp  = array.get(ce_ltps, idx)
        float p_ltp  = array.get(pe_ltps, idx)
        float pivot_row = (c_base + p_base) / 2.0
        
        bool is_atm_row = (idx == atm_idx)
        color row_bg = is_atm_row ? color.new(#FFEA00, 70) : color.black
        color txt_col = is_atm_row ? color.yellow : color.white
        
        int r = idx + 1
        table.cell(dash, 0, r, str.tostring(st_val) + (is_atm_row ? " (ATM)" : ""), bgcolor=row_bg, text_color=txt_col, text_size=t_size_dash)
        table.cell(dash, 1, r, str.tostring(c_base, "#.##"), bgcolor=row_bg, text_color=txt_col, text_size=t_size_dash)
        table.cell(dash, 2, r, str.tostring(c_ltp, "#.##"), bgcolor=row_bg, text_color=c_ltp >= c_base ? #00E676 : #FF1744, text_size=t_size_dash)
        table.cell(dash, 3, r, str.tostring(p_base, "#.##"), bgcolor=row_bg, text_color=txt_col, text_size=t_size_dash)
        table.cell(dash, 4, r, str.tostring(p_ltp, "#.##"), bgcolor=row_bg, text_color=p_ltp >= p_base ? #00E676 : #FF1744, text_size=t_size_dash)
        table.cell(dash, 5, r, str.tostring(pivot_row, "#.##"), bgcolor=row_bg, text_color=#FFEA00, text_size=t_size_dash)
        
        string cvd_info = "-"
        if idx == 5
            cvd_info := "CE:" + f_format_vol(ce_delta) + " | PE:" + f_format_vol(pe_delta)
        table.cell(dash, 6, r, cvd_info, bgcolor=row_bg, text_color=color.aqua, text_size=t_size_dash)
