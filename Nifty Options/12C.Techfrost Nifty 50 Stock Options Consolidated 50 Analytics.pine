//@version=6
indicator("Techfrost Nifty 50 Stock Options Consolidated 50 Analytics", shorttitle="TF Nifty50 Consolidated", overlay=false, precision=2)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum TablePos
    topRight   = "Top Right"
    topLeft    = "Top Left"
    bottomRight= "Bottom Right"
    bottomLeft = "Bottom Left"

enum TableSize
    auto   = "Auto"
    tiny   = "Tiny"
    small  = "Small"
    normal = "Normal"
    large  = "Large"

// --- Inputs to Connect Plots from Indicator 12A & 12B ---
b1_ce_real_bep_src  = input.source(close, "Batch 1 CEs Above Real BEP (From 12A)",  group="Consolidated Data Link (Indicator 12A)")
b1_pe_real_bep_src  = input.source(close, "Batch 1 PEs Above Real BEP (From 12A)",  group="Consolidated Data Link (Indicator 12A)")
b1_ce_open_bep_src  = input.source(close, "Batch 1 CEs Above Open BEP (From 12A)",  group="Consolidated Data Link (Indicator 12A)")
b1_pe_open_bep_src  = input.source(close, "Batch 1 PEs Above Open BEP (From 12A)",  group="Consolidated Data Link (Indicator 12A)")
b1_neut_open_bep_src= input.source(close, "Batch 1 Neutral Open BEP (From 12A)",    group="Consolidated Data Link (Indicator 12A)")

b2_ce_real_bep_src  = input.source(close, "Batch 2 CEs Above Real BEP (From 12B)",  group="Consolidated Data Link (Indicator 12B)")
b2_pe_real_bep_src  = input.source(close, "Batch 2 PEs Above Real BEP (From 12B)",  group="Consolidated Data Link (Indicator 12B)")
b2_ce_open_bep_src  = input.source(close, "Batch 2 CEs Above Open BEP (From 12B)",  group="Consolidated Data Link (Indicator 12B)")
b2_pe_open_bep_src  = input.source(close, "Batch 2 PEs Above Open BEP (From 12B)",  group="Consolidated Data Link (Indicator 12B)")
b2_neut_open_bep_src= input.source(close, "Batch 2 Neutral Open BEP (From 12B)",    group="Consolidated Data Link (Indicator 12B)")

useOffHoursPrevClose = input.bool(true, "Use Previous Day Close When Market Is Closed", group="Data Source Settings",
  tooltip="When checked, automatically uses Previous Day Close price outside market hours so the table displays valid analytics 24/7.")

// --- Display Controls ---
showSummaryTable   = input.bool(true, "Show Dashboard Summary Table", group="Display Controls")
tablePosInput      = input.enum(TablePos.topRight, "Table Position", group="Display Controls")
tableTextSizeInput = input.enum(TableSize.small, "Table Text Size", group="Display Controls")

// --- Styling & Colors ---
colorHeaderBg      = input.color(#1A237E, "Header Banner Background", group="Styling & Colors")
colorSectionBg     = input.color(#263238, "Section Banner Background", group="Styling & Colors")
colorCEColor       = input.color(#00E676, "CE / Bullish Accent Color", group="Styling & Colors")
colorPEColor       = input.color(#FF1744, "PE / Bearish Accent Color", group="Styling & Colors")
colorNeutralColor  = input.color(#FFD600, "Neutral Accent Color", group="Styling & Colors")
colorTotalColor    = input.color(#00E5FF, "Total / Consolidated Accent Color", group="Styling & Colors")

// ==========================================
// HELPER FUNCTIONS & STRIKE AUTO-DETECTION
// ==========================================

f_get_strike_step(float spot_price) =>
    float s = 50.0
    if na(spot_price) or spot_price <= 0
        s := 50.0
    else if spot_price < 100
        s := 1.0
    else if spot_price < 250
        s := 2.5
    else if spot_price < 500
        s := 5.0
    else if spot_price < 1200
        s := 10.0
    else if spot_price < 2500
        s := 20.0
    else if spot_price < 5000
        s := 50.0
    else
        s := 100.0
    s

f_calc_atm_strike(float spot_price) =>
    float step = f_get_strike_step(spot_price)
    math.round(spot_price / step) * step

type StockAnalytics
    string symbol
    bool enabled
    float spot_c
    float spot_o
    float spot_prev_c
    float atm_strike
    float open_atm_strike
    bool ce_above_real_bep
    bool pe_above_real_bep
    bool ce_above_open_bep
    bool pe_above_open_bep
    bool neutral_open_bep
    bool ce_cross_above_real_bep
    bool ce_cross_below_real_bep
    bool pe_cross_above_real_bep
    bool pe_cross_below_real_bep
    float ce_iv
    float pe_iv
    bool is_pe_iv_only
    bool is_ce_iv_only
    bool is_neutral_iv
    bool pe_iv_just_formed
    bool ce_iv_just_formed

f_eval_nifty_stock_single(string root_sym, bool is_enabled) =>
    StockAnalytics res = StockAnalytics.new()
    res.symbol := root_sym
    res.enabled := is_enabled
    
    if is_enabled
        [spot_close, spot_prev_close, spot_open] = request.security("NSE:" + root_sym, timeframe.period, [close, close[1], open], ignore_invalid_symbol=true)
        
        float eval_spot = spot_close
        if useOffHoursPrevClose and (na(spot_close) or spot_close <= 0 or not barstate.isrealtime)
            eval_spot := not na(spot_prev_close) and spot_prev_close > 0 ? spot_prev_close : spot_close
            
        if not na(eval_spot) and eval_spot > 0
            res.spot_c      := eval_spot
            res.spot_o      := spot_open
            res.spot_prev_c := spot_prev_close
            
            float atm_st  = f_calc_atm_strike(eval_spot)
            float open_st = f_calc_atm_strike(spot_open)
            res.atm_strike      := atm_st
            res.open_atm_strike := open_st
            
            res.ce_above_real_bep := eval_spot > atm_st
            res.pe_above_real_bep := eval_spot < atm_st
            
            res.ce_above_open_bep := eval_spot > open_st
            res.pe_above_open_bep := eval_spot < open_st
            res.neutral_open_bep  := (eval_spot == open_st)
            
            float prev_spot = not na(spot_prev_close) and spot_prev_close > 0 ? spot_prev_close : eval_spot
            float prev_atm  = f_calc_atm_strike(prev_spot)
            
            res.ce_cross_above_real_bep := (prev_spot <= prev_atm) and (eval_spot > atm_st)
            res.ce_cross_below_real_bep := (prev_spot >= prev_atm) and (eval_spot < atm_st)
            
            res.pe_cross_above_real_bep := (prev_spot >= prev_atm) and (eval_spot < atm_st)
            res.pe_cross_below_real_bep := (prev_spot <= prev_atm) and (eval_spot > atm_st)
            
            res.ce_iv := math.max(0.0, eval_spot - atm_st)
            res.pe_iv := math.max(0.0, atm_st - eval_spot)
            
            res.is_pe_iv_only := (res.pe_iv > 0.0) and (res.ce_iv <= 0.0)
            res.is_ce_iv_only := (res.ce_iv > 0.0) and (res.pe_iv <= 0.0)
            res.is_neutral_iv := ((res.ce_iv > 0.0) and (res.pe_iv > 0.0)) or ((res.ce_iv <= 0.0) and (res.pe_iv <= 0.0))
            
            float prev_ce_iv = math.max(0.0, prev_spot - prev_atm)
            float prev_pe_iv = math.max(0.0, prev_atm - prev_spot)
            
            res.pe_iv_just_formed := (res.pe_iv > 0.0) and (prev_pe_iv <= 0.0)
            res.ce_iv_just_formed := (res.ce_iv > 0.0) and (prev_ce_iv <= 0.0)
    res

// --- BATCH 1 EVALUATION (STOCKS 1-25) ---
StockAnalytics b1_1  = f_eval_nifty_stock_single("RELIANCE",   true)
StockAnalytics b1_2  = f_eval_nifty_stock_single("HDFCBANK",   true)
StockAnalytics b1_3  = f_eval_nifty_stock_single("ICICIBANK",  true)
StockAnalytics b1_4  = f_eval_nifty_stock_single("INFY",       true)
StockAnalytics b1_5  = f_eval_nifty_stock_single("TCS",        true)
