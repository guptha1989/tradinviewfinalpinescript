// --- BATCH 2 EVALUATION (STOCKS 26-45) ---
StockAnalytics b2_1  = f_eval_nifty_stock_single("ULTRACEMCO", true)
StockAnalytics b2_2  = f_eval_nifty_stock_single("TITAN",      true)
StockAnalytics b2_3  = f_eval_nifty_stock_single("ASIANPAINT", true)
StockAnalytics b2_4  = f_eval_nifty_stock_single("TATASTEEL",  true)
StockAnalytics b2_5  = f_eval_nifty_stock_single("COALINDIA",  true)
StockAnalytics b2_6  = f_eval_nifty_stock_single("ADANIENT",   true)
StockAnalytics b2_7  = f_eval_nifty_stock_single("ADANIPORTS", true)
StockAnalytics b2_8  = f_eval_nifty_stock_single("BAJAJFINSV", true)
StockAnalytics b2_9  = f_eval_nifty_stock_single("BAJAJ-AUTO", true)
StockAnalytics b2_10 = f_eval_nifty_stock_single("TRENT",      true)
StockAnalytics b2_11 = f_eval_nifty_stock_single("ONGC",       true)
StockAnalytics b2_12 = f_eval_nifty_stock_single("HINDALCO",   true)
StockAnalytics b2_13 = f_eval_nifty_stock_single("GRASIM",     true)
StockAnalytics b2_14 = f_eval_nifty_stock_single("JSWSTEEL",   true)
StockAnalytics b2_15 = f_eval_nifty_stock_single("BEL",        true)

array<StockAnalytics> listB1 = array.new<StockAnalytics>()
array<StockAnalytics> listB2 = array.new<StockAnalytics>()

f_push_valid_stock(array<StockAnalytics> arr, StockAnalytics item) =>
    if item.enabled and not na(item.spot_c)
        array.push(arr, item)

f_push_valid_stock(listB1, b1_1)
f_push_valid_stock(listB1, b1_2)
f_push_valid_stock(listB1, b1_3)
f_push_valid_stock(listB1, b1_4)
f_push_valid_stock(listB1, b1_5)
f_push_valid_stock(listB1, b1_6)
f_push_valid_stock(listB1, b1_7)
f_push_valid_stock(listB1, b1_8)
f_push_valid_stock(listB1, b1_9)
f_push_valid_stock(listB1, b1_10)
f_push_valid_stock(listB1, b1_11)
f_push_valid_stock(listB1, b1_12)
f_push_valid_stock(listB1, b1_13)
f_push_valid_stock(listB1, b1_14)
