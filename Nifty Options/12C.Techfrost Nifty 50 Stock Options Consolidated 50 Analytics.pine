f_push_valid_stock(listB2, b2_5)
f_push_valid_stock(listB2, b2_6)
f_push_valid_stock(listB2, b2_7)
f_push_valid_stock(listB2, b2_8)
f_push_valid_stock(listB2, b2_9)
f_push_valid_stock(listB2, b2_10)
f_push_valid_stock(listB2, b2_11)
f_push_valid_stock(listB2, b2_12)
f_push_valid_stock(listB2, b2_13)
f_push_valid_stock(listB2, b2_14)
f_push_valid_stock(listB2, b2_15)

// Aggregate Metrics
int b1_count_ce_real_bep = 0, int b1_count_pe_real_bep = 0
int b1_count_ce_open_bep = 0, int b1_count_pe_open_bep = 0, int b1_count_neut_open_bep = 0
int b1_count_ce_cross_up = 0, int b1_count_ce_cross_dn = 0
int b1_count_pe_cross_up = 0, int b1_count_pe_cross_dn = 0
int b1_count_pe_iv_only  = 0, int b1_count_ce_iv_only  = 0, int b1_count_neut_iv = 0
int b1_count_pe_iv_fmt   = 0, int b1_count_ce_iv_fmt   = 0

for i = 0 to array.size(listB1) - 1
    StockAnalytics item = array.get(listB1, i)
    if item.ce_above_real_bep => b1_count_ce_real_bep += 1
    if item.pe_above_real_bep => b1_count_pe_real_bep += 1
    if item.ce_above_open_bep => b1_count_ce_open_bep += 1
    if item.pe_above_open_bep => b1_count_pe_open_bep += 1
    if item.neutral_open_bep  => b1_count_neut_open_bep += 1
    if item.ce_cross_above_real_bep => b1_count_ce_cross_up += 1
    if item.ce_cross_below_real_bep => b1_count_ce_cross_dn += 1
    if item.pe_cross_above_real_bep => b1_count_pe_cross_up += 1
    if item.pe_cross_below_real_bep => b1_count_pe_cross_dn += 1
    if item.is_pe_iv_only => b1_count_pe_iv_only += 1
    if item.is_ce_iv_only => b1_count_ce_iv_only += 1
    if item.is_neutral_iv => b1_count_neut_iv += 1
    if item.pe_iv_just_formed => b1_count_pe_iv_fmt += 1
    if item.ce_iv_just_formed => b1_count_ce_iv_fmt += 1

int b2_count_ce_real_bep = 0, int b2_count_pe_real_bep = 0
int b2_count_ce_open_bep = 0, int b2_count_pe_open_bep = 0, int b2_count_neut_open_bep = 0
int b2_count_ce_cross_up = 0, int b2_count_ce_cross_dn = 0
int b2_count_pe_cross_up = 0, int b2_count_pe_cross_dn = 0
int b2_count_pe_iv_only  = 0, int b2_count_ce_iv_only  = 0, int b2_count_neut_iv = 0
int b2_count_pe_iv_fmt   = 0, int b2_count_ce_iv_fmt   = 0

for i = 0 to array.size(listB2) - 1
    StockAnalytics item = array.get(listB2, i)
    if item.ce_above_real_bep => b2_count_ce_real_bep += 1
    if item.pe_above_real_bep => b2_count_pe_real_bep += 1
    if item.ce_above_open_bep => b2_count_ce_open_bep += 1
    if item.pe_above_open_bep => b2_count_pe_open_bep += 1
    if item.neutral_open_bep  => b2_count_neut_open_bep += 1
    if item.ce_cross_above_real_bep => b2_count_ce_cross_up += 1
    if item.ce_cross_below_real_bep => b2_count_ce_cross_dn += 1
    if item.pe_cross_above_real_bep => b2_count_pe_cross_up += 1
    if item.pe_cross_below_real_bep => b2_count_pe_cross_dn += 1
    if item.is_pe_iv_only => b2_count_pe_iv_only += 1
    if item.is_ce_iv_only => b2_count_ce_iv_only += 1
    if item.is_neutral_iv => b2_count_neut_iv += 1
    if item.pe_iv_just_formed => b2_count_pe_iv_fmt += 1
    if item.ce_iv_just_formed => b2_count_ce_iv_fmt += 1

// CONSOLIDATED TOTALS
int tot_ce_real_bep  = b1_count_ce_real_bep + b2_count_ce_real_bep
int tot_pe_real_bep  = b1_count_pe_real_bep + b2_count_pe_real_bep
int tot_ce_open_bep  = b1_count_ce_open_bep + b2_count_ce_open_bep
int tot_pe_open_bep  = b1_count_pe_open_bep + b2_count_pe_open_bep
int tot_neut_open_bep= b1_count_neut_open_bep + b2_count_neut_open_bep

int tot_ce_cross_up = b1_count_ce_cross_up + b2_count_ce_cross_up
int tot_ce_cross_dn = b1_count_ce_cross_dn + b2_count_ce_cross_dn
int tot_pe_cross_up = b1_count_pe_cross_up + b2_count_pe_cross_up
int tot_pe_cross_dn = b1_count_pe_cross_dn + b2_count_pe_cross_dn

int tot_pe_iv_only  = b1_count_pe_iv_only + b2_count_pe_iv_only
int tot_ce_iv_only  = b1_count_ce_iv_only + b2_count_ce_iv_only
int tot_neut_iv     = b1_count_neut_iv + b2_count_neut_iv
int tot_pe_iv_fmt   = b1_count_pe_iv_fmt + b2_count_pe_iv_fmt
int tot_ce_iv_fmt   = b1_count_ce_iv_fmt + b2_count_ce_iv_fmt

// ==========================================
// RENDER CONSOLIDATED MASTER DASHBOARD TABLE
// ==========================================

f_get_table_pos(TablePos pos) =>
    switch pos
        TablePos.topRight    => position.top_right
        TablePos.topLeft     => position.top_left
        TablePos.bottomRight => position.bottom_right
        TablePos.bottomLeft  => position.bottom_left

f_get_table_text_size(TableSize sz) =>
    switch sz
        TableSize.auto   => size.auto
        TableSize.tiny   => size.tiny
        TableSize.small  => size.small
        TableSize.normal => size.normal
        TableSize.large  => size.large

var table summaryTbl = table.new(f_get_table_pos(tablePosInput), 4, 15, bgcolor=color.black, border_color=color.gray, border_width=1, force_overlay=true)
string curTextSize = f_get_table_text_size(tableTextSizeInput)

if barstate.islast
    if not showSummaryTable
        table.delete(summaryTbl)
    else
        // Header
        table.cell(summaryTbl, 0, 0, "Nifty 50 ATM Options CONSOLIDATED Master Analytics", bgcolor=colorHeaderBg, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 0, "Batch 1 (1-25)", bgcolor=colorHeaderBg, text_color=color.yellow, text_size=curTextSize)
        table.cell(summaryTbl, 2, 0, "Batch 2 (26-50)", bgcolor=colorHeaderBg, text_color=color.yellow, text_size=curTextSize)
        table.cell(summaryTbl, 3, 0, "TOTAL (ALL STOCKS)", bgcolor=colorHeaderBg, text_color=colorTotalColor, text_size=curTextSize)
        
        // BEP Banner
        table.cell(summaryTbl, 0, 1, "--- REALTIME & DAY OPEN BEP ANALYTICS ---", bgcolor=colorSectionBg, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 1, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 2, 1, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 3, 1, "", bgcolor=colorSectionBg)
        
        // Realtime BEP
        table.cell(summaryTbl, 0, 2, "ATM CEs Above Realtime BEP", bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 2, str.tostring(b1_count_ce_real_bep), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 2, str.tostring(b2_count_ce_real_bep), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 2, str.tostring(tot_ce_real_bep), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        
        table.cell(summaryTbl, 0, 3, "ATM PEs Above Realtime BEP", bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 3, str.tostring(b1_count_pe_real_bep), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 3, str.tostring(b2_count_pe_real_bep), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 3, str.tostring(tot_pe_real_bep), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        
        // Day Open BEP
        table.cell(summaryTbl, 0, 4, "CEs Above Day Open BEP", bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 4, str.tostring(b1_count_ce_open_bep), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 4, str.tostring(b2_count_ce_open_bep), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 4, str.tostring(tot_ce_open_bep), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        
        table.cell(summaryTbl, 0, 5, "PEs Above Day Open BEP", bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 5, str.tostring(b1_count_pe_open_bep), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 5, str.tostring(b2_count_pe_open_bep), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 5, str.tostring(tot_pe_open_bep), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        
        table.cell(summaryTbl, 0, 6, "Neutral (Both Below Day Open BEP)", bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 6, str.tostring(b1_count_neut_open_bep), bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 6, str.tostring(b2_count_neut_open_bep), bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 6, str.tostring(tot_neut_open_bep), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        
        // Crossovers
        table.cell(summaryTbl, 0, 7, "CE Just Crossed Realtime BEP", bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 7, "+" + str.tostring(b1_count_ce_cross_up) + " / -" + str.tostring(b1_count_ce_cross_dn), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 7, "+" + str.tostring(b2_count_ce_cross_up) + " / -" + str.tostring(b2_count_ce_cross_dn), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 7, "+" + str.tostring(tot_ce_cross_up) + " / -" + str.tostring(tot_ce_cross_dn), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        
        table.cell(summaryTbl, 0, 8, "PE Just Crossed Realtime BEP", bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 8, "+" + str.tostring(b1_count_pe_cross_up) + " / -" + str.tostring(b1_count_pe_cross_dn), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 8, "+" + str.tostring(b2_count_pe_cross_up) + " / -" + str.tostring(b2_count_pe_cross_dn), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 8, "+" + str.tostring(tot_pe_cross_up) + " / -" + str.tostring(tot_pe_cross_dn), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        
        // IV Banner
        table.cell(summaryTbl, 0, 9, "--- REALTIME INTRINSIC VALUE (IV) ANALYTICS ---", bgcolor=colorSectionBg, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 9, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 2, 9, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 3, 9, "", bgcolor=colorSectionBg)
        
        // IV Segregation
        table.cell(summaryTbl, 0, 10, "PE IV Only (PE IV > 0)", bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 10, str.tostring(b1_count_pe_iv_only), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 10, str.tostring(b2_count_pe_iv_only), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 10, str.tostring(tot_pe_iv_only), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        
        table.cell(summaryTbl, 0, 11, "CE IV Only (CE IV > 0)", bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 11, str.tostring(b1_count_ce_iv_only), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 11, str.tostring(b2_count_ce_iv_only), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 11, str.tostring(tot_ce_iv_only), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        
        table.cell(summaryTbl, 0, 12, "Neutral IV (Both IVs Exist or Zero)", bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 12, str.tostring(b1_count_neut_iv), bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 12, str.tostring(b2_count_neut_iv), bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 12, str.tostring(tot_neut_iv), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        
        table.cell(summaryTbl, 0, 13, "PE IV Just Formed (Prev Candle)", bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 13, str.tostring(b1_count_pe_iv_fmt), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 13, str.tostring(b2_count_pe_iv_fmt), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 13, str.tostring(tot_pe_iv_fmt), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        
        table.cell(summaryTbl, 0, 14, "CE IV Just Formed (Prev Candle)", bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 14, str.tostring(b1_count_ce_iv_fmt), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 14, str.tostring(b2_count_ce_iv_fmt), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 14, str.tostring(tot_ce_iv_fmt), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
