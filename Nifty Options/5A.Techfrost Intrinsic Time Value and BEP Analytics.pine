//@version=6
indicator("5A.Techfrost Intrinsic Time Value and BEP Analytics", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500, precision=2)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum UnderlyingAsset
    auto      = "Auto-Detect"
    nifty     = "NIFTY"
    banknifty = "BANKNIFTY"
    crudeoil  = "CRUDEOIL"
    gold      = "GOLD"
    stock     = "Stock (Equity)"

enum OptionType
    auto = "Auto-Detect"
    ce   = "Call (CE)"
    pe   = "Put (PE)"

enum StrikeMode
    atm  = "ATM (At The Money)"
    itm  = "ITM (In The Money)"
    otm  = "OTM (Out of The Money)"
    both = "Both ITM & OTM"

enum StaticBasis
    dayOpen   = "Day Open Price (9:15 AM Open)"
    prevClose = "Previous Day Close / Settlement Price"
    first5Min = "First 5 Min Candle Close"

enum TimeValueFormula
    standard = "Option Price - Intrinsic Value"
    custom   = "Strike Price - Intrinsic Value"

// --- Instrument Settings ---
underlyingInput    = input.enum(UnderlyingAsset.auto, "Underlying Asset", group="Instrument Settings")
optionTypeInput    = input.enum(OptionType.auto, "Option Type", group="Instrument Settings")
manualStrikeInput  = input.int(0, "Manual Strike Selection (0 = Auto)", minval=0, group="Instrument Settings",
  tooltip="Enter strike price manually (e.g. 24000). Leave at 0 to auto-detect from chart symbol.")
spotTickerOverride = input.symbol("", "Spot Symbol Override (e.g. NSE:RELIANCE)", group="Instrument Settings")
strikeOverride     = input.float(0.0, "Strike Price Override", minval=0.0, group="Instrument Settings")

// --- Strike & Calculation Basis Settings ---
strikeModeInput       = input.enum(StrikeMode.atm, "Strike Selection Mode", group="Calculation Settings",
  tooltip="Choose whether to calculate metrics for ATM, ITM, OTM, or Both ITM & OTM strikes relative to selected chart option.")
offsetChoiceInput     = input.string("100 Points", "Strike Offset Points", options=["5 Points", "10 Points", "15 Points", "20 Points", "25 Points", "40 Points", "50 Points", "100 Points", "150 Points", "200 Points"], group="Calculation Settings",
  tooltip="Offset points used to determine ITM / OTM strike levels (e.g. 50, 100, 150, 200).")
staticBasisInput      = input.enum(StaticBasis.dayOpen, "Static Calculation Basis", group="Calculation Settings")
timeValueFormulaInput = input.enum(TimeValueFormula.standard, "Time Value Calculation Formula", group="Calculation Settings")

// --- ITM Avg Intrinsic & OTM Avg Time Value Plot Controls ---
show_itm1_avg_iv_rt    = input.bool(true, "Show ITM 1 Realtime Avg Intrinsic", group="ITM Intrinsic & OTM Time Value Settings")
color_itm1_avg_iv_rt   = input.color(#00E676, "ITM 1 Realtime Avg Intrinsic Color", group="ITM Intrinsic & OTM Time Value Settings")
width_itm1_avg_iv_rt   = input.int(2, "ITM 1 Realtime Avg Intrinsic Width", minval=1, maxval=4, group="ITM Intrinsic & OTM Time Value Settings")

show_itm2_avg_iv_rt    = input.bool(true, "Show ITM 2 Realtime Avg Intrinsic", group="ITM Intrinsic & OTM Time Value Settings")
color_itm2_avg_iv_rt   = input.color(#00C853, "ITM 2 Realtime Avg Intrinsic Color", group="ITM Intrinsic & OTM Time Value Settings")
width_itm2_avg_iv_rt   = input.int(2, "ITM 2 Realtime Avg Intrinsic Width", minval=1, maxval=4, group="ITM Intrinsic & OTM Time Value Settings")

show_itm1_avg_iv_stat  = input.bool(false, "Show ITM 1 Static Avg Intrinsic", group="ITM Intrinsic & OTM Time Value Settings")
color_itm1_avg_iv_stat = input.color(#69F0AE, "ITM 1 Static Avg Intrinsic Color", group="ITM Intrinsic & OTM Time Value Settings")

show_itm2_avg_iv_stat  = input.bool(false, "Show ITM 2 Static Avg Intrinsic", group="ITM Intrinsic & OTM Time Value Settings")
color_itm2_avg_iv_stat = input.color(#B9F6CA, "ITM 2 Static Avg Intrinsic Color", group="ITM Intrinsic & OTM Time Value Settings")

show_otm1_avg_tv_rt    = input.bool(true, "Show OTM 1 Realtime Avg Time Value", group="ITM Intrinsic & OTM Time Value Settings")
color_otm1_avg_tv_rt   = input.color(#FFD700, "OTM 1 Realtime Avg Time Value Color", group="ITM Intrinsic & OTM Time Value Settings")
width_otm1_avg_tv_rt   = input.int(2, "OTM 1 Realtime Avg Time Value Width", minval=1, maxval=4, group="ITM Intrinsic & OTM Time Value Settings")

show_otm2_avg_tv_rt    = input.bool(true, "Show OTM 2 Realtime Avg Time Value", group="ITM Intrinsic & OTM Time Value Settings")
color_otm2_avg_tv_rt   = input.color(#FFAB00, "OTM 2 Realtime Avg Time Value Color", group="ITM Intrinsic & OTM Time Value Settings")
width_otm2_avg_tv_rt   = input.int(2, "OTM 2 Realtime Avg Time Value Width", minval=1, maxval=4, group="ITM Intrinsic & OTM Time Value Settings")

show_otm1_avg_tv_stat  = input.bool(false, "Show OTM 1 Static Avg Time Value", group="ITM Intrinsic & OTM Time Value Settings")
color_otm1_avg_tv_stat = input.color(#FFE57F, "OTM 1 Static Avg Time Value Color", group="ITM Intrinsic & OTM Time Value Settings")

show_otm2_avg_tv_stat  = input.bool(false, "Show OTM 2 Static Avg Time Value", group="ITM Intrinsic & OTM Time Value Settings")
color_otm2_avg_tv_stat = input.color(#FFD54F, "OTM 2 Static Avg Time Value Color", group="ITM Intrinsic & OTM Time Value Settings")

show5D_Static_BEPInput = input.bool(false, "Show 5-Day Static BEP Line", group="BEP & Prev Close Settings")
showPD_CE_CloseInput   = input.bool(false, "Show Prev Day CE Close", group="BEP & Prev Close Settings")
showPD_PE_CloseInput   = input.bool(false, "Show Prev Day PE Close", group="BEP & Prev Close Settings")

// --- Signal & Visual Options ---
showSignalPlotsInput  = input.bool(true, "Show Signal Shape Labels (BC / BP)", group="Signals & Visuals")
signalFilterInput     = input.string("Alternate Signals Only (Wait for Opposite)", "Signal Filter Mode", options=["All Candles (Raw)", "Initial Trigger Only", "Alternate Signals Only (Wait for Opposite)"], group="Signals & Visuals")
colorSB_CE            = input.color(#00E676, "Buy CE Signal Color", group="Signals & Visuals")
colorSB_PE            = input.color(#FF1744, "Buy PE Signal Color", group="Signals & Visuals")
colorSignalTextColor  = input.color(color.white, "Signal Text Color", group="Signals & Visuals")

// --- Option Candle Overlay Settings ---
show_itm_ce_candle = input.bool(true, "Show ITM CE Candle Overlay", group="Option Candle Settings")
color_itm_ce_up    = input.color(#00E676, "ITM CE Candle Up Color", group="Option Candle Settings")
color_itm_ce_dn    = input.color(#00B0FF, "ITM CE Candle Down Color", group="Option Candle Settings")

show_itm_pe_candle = input.bool(true, "Show ITM PE Candle Overlay", group="Option Candle Settings")
color_itm_pe_up    = input.color(#FF1744, "ITM PE Candle Up Color", group="Option Candle Settings")
color_itm_pe_dn    = input.color(#FF9100, "ITM PE Candle Down Color", group="Option Candle Settings")

show_otm_ce_candle = input.bool(true, "Show OTM CE Candle Overlay", group="Option Candle Settings")
color_otm_ce_up    = input.color(#76FF03, "OTM CE Candle Up Color", group="Option Candle Settings")
color_otm_ce_dn    = input.color(#1DE9B6, "OTM CE Candle Down Color", group="Option Candle Settings")

show_otm_pe_candle = input.bool(true, "Show OTM 1 PE Candle Overlay", group="Option Candle Settings")
color_otm_pe_up    = input.color(#FF5252, "OTM 1 PE Candle Up Color", group="Option Candle Settings")
color_otm_pe_dn    = input.color(#D50000, "OTM 1 PE Candle Down Color", group="Option Candle Settings")

show_itm2_ce_candle = input.bool(true, "Show ITM 2 CE Candle Overlay", group="Option Candle Settings")
color_itm2_ce_up    = input.color(#00C853, "ITM 2 CE Candle Up Color", group="Option Candle Settings")
color_itm2_ce_dn    = input.color(#0091EA, "ITM 2 CE Candle Down Color", group="Option Candle Settings")

show_itm2_pe_candle = input.bool(true, "Show ITM 2 PE Candle Overlay", group="Option Candle Settings")
color_itm2_pe_up    = input.color(#D50000, "ITM 2 PE Candle Up Color", group="Option Candle Settings")
color_itm2_pe_dn    = input.color(#FF6D00, "ITM 2 PE Candle Down Color", group="Option Candle Settings")

show_otm2_ce_candle = input.bool(true, "Show OTM 2 CE Candle Overlay", group="Option Candle Settings")
color_otm2_ce_up    = input.color(#64DD17, "OTM 2 CE Candle Up Color", group="Option Candle Settings")
color_otm2_ce_dn    = input.color(#00BFA5, "OTM 2 CE Candle Down Color", group="Option Candle Settings")

show_otm2_pe_candle = input.bool(true, "Show OTM 2 PE Candle Overlay", group="Option Candle Settings")
color_otm2_pe_up    = input.color(#FF1744, "OTM 2 PE Candle Up Color", group="Option Candle Settings")
color_otm2_pe_dn    = input.color(#B71C1C, "OTM 2 PE Candle Down Color", group="Option Candle Settings")

show_strike_labels  = input.bool(true, "Show Strike Name Labels on Candles", group="Option Candle Settings")

// --- Dynamic Touch Line Settings ---
show_line_atm_pe_top  = input.bool(true, "Show ATM PE Top Line", group="Dynamic Touch Line Settings")
color_line_atm_pe_top = input.color(#00B0FF, "ATM PE Top Color", group="Dynamic Touch Line Settings")
style_line_atm_pe_top = input.string("Dashed", "ATM PE Top Style", options=["Solid", "Dashed", "Dotted"], group="Dynamic Touch Line Settings")
width_line_atm_pe_top = input.int(1, "ATM PE Top Width", minval=1, maxval=4, group="Dynamic Touch Line Settings")

show_line_atm_ce_top  = input.bool(true, "Show ATM CE Top Line", group="Dynamic Touch Line Settings")
color_line_atm_ce_top = input.color(#FF9100, "ATM CE Top Color", group="Dynamic Touch Line Settings")
style_line_atm_ce_top = input.string("Dashed", "ATM CE Top Style", options=["Solid", "Dashed", "Dotted"], group="Dynamic Touch Line Settings")
width_line_atm_ce_top = input.int(1, "ATM CE Top Width", minval=1, maxval=4, group="Dynamic Touch Line Settings")

show_line_itm1_ce_top  = input.bool(true, "Show ITM 1 CE Top Line", group="Dynamic Touch Line Settings")
color_line_itm1_ce_top = input.color(#00E676, "ITM 1 CE Top Color", group="Dynamic Touch Line Settings")
style_line_itm1_ce_top = input.string("Dashed", "ITM 1 CE Top Style", options=["Solid", "Dashed", "Dotted"], group="Dynamic Touch Line Settings")
width_line_itm1_ce_top = input.int(1, "ITM 1 CE Top Width", minval=1, maxval=4, group="Dynamic Touch Line Settings")

show_line_itm1_pe_top  = input.bool(true, "Show ITM 1 PE Top Line", group="Dynamic Touch Line Settings")
color_line_itm1_pe_top = input.color(#FF5252, "ITM 1 PE Top Color", group="Dynamic Touch Line Settings")
style_line_itm1_pe_top = input.string("Dashed", "ITM 1 PE Top Style", options=["Solid", "Dashed", "Dotted"], group="Dynamic Touch Line Settings")
width_line_itm1_pe_top = input.int(1, "ITM 1 PE Top Width", minval=1, maxval=4, group="Dynamic Touch Line Settings")

show_line_itm2_ce_top  = input.bool(true, "Show ITM 2 CE Top Line", group="Dynamic Touch Line Settings")
color_line_itm2_ce_top = input.color(#00C853, "ITM 2 CE Top Color", group="Dynamic Touch Line Settings")
style_line_itm2_ce_top = input.string("Dashed", "ITM 2 CE Top Style", options=["Solid", "Dashed", "Dotted"], group="Dynamic Touch Line Settings")
width_line_itm2_ce_top = input.int(1, "ITM 2 CE Top Width", minval=1, maxval=4, group="Dynamic Touch Line Settings")

show_line_itm2_pe_top  = input.bool(true, "Show ITM 2 PE Top Line", group="Dynamic Touch Line Settings")
color_line_itm2_pe_top = input.color(#D50000, "ITM 2 PE Top Color", group="Dynamic Touch Line Settings")
style_line_itm2_pe_top = input.string("Dashed", "ITM 2 PE Top Style", options=["Solid", "Dashed", "Dotted"], group="Dynamic Touch Line Settings")
width_line_itm2_pe_top = input.int(1, "ITM 2 PE Top Width", minval=1, maxval=4, group="Dynamic Touch Line Settings")

show_line_otm1_ce_top  = input.bool(true, "Show OTM 1 CE Top Line", group="Dynamic Touch Line Settings")
color_line_otm1_ce_top = input.color(#FFD700, "OTM 1 CE Top Color", group="Dynamic Touch Line Settings")
style_line_otm1_ce_top = input.string("Dashed", "OTM 1 CE Top Style", options=["Solid", "Dashed", "Dotted"], group="Dynamic Touch Line Settings")
width_line_otm1_ce_top = input.int(1, "OTM 1 CE Top Width", minval=1, maxval=4, group="Dynamic Touch Line Settings")

show_line_otm1_pe_top  = input.bool(true, "Show OTM 1 PE Top Line", group="Dynamic Touch Line Settings")
color_line_otm1_pe_top = input.color(#FF1744, "OTM 1 PE Top Color", group="Dynamic Touch Line Settings")
style_line_otm1_pe_top = input.string("Dashed", "OTM 1 PE Top Style", options=["Solid", "Dashed", "Dotted"], group="Dynamic Touch Line Settings")
width_line_otm1_pe_top = input.int(1, "OTM 1 PE Top Width", minval=1, maxval=4, group="Dynamic Touch Line Settings")

show_line_otm2_ce_top  = input.bool(true, "Show OTM 2 CE Top Line", group="Dynamic Touch Line Settings")
color_line_otm2_ce_top = input.color(#64DD17, "OTM 2 CE Top Color", group="Dynamic Touch Line Settings")
style_line_otm2_ce_top = input.string("Dashed", "OTM 2 CE Top Style", options=["Solid", "Dashed", "Dotted"], group="Dynamic Touch Line Settings")
width_line_otm2_ce_top = input.int(1, "OTM 2 CE Top Width", minval=1, maxval=4, group="Dynamic Touch Line Settings")

show_line_otm2_pe_top  = input.bool(true, "Show OTM 2 PE Top Line", group="Dynamic Touch Line Settings")
color_line_otm2_pe_top = input.color(#C62828, "OTM 2 PE Top Color", group="Dynamic Touch Line Settings")
style_line_otm2_pe_top = input.string("Dashed", "OTM 2 PE Top Style", options=["Solid", "Dashed", "Dotted"], group="Dynamic Touch Line Settings")
width_line_otm2_pe_top = input.int(1, "OTM 2 PE Top Width", minval=1, maxval=4, group="Dynamic Touch Line Settings")

// --- Dashboard Table Controls ---
showTableInput = input.bool(true, "Show Analytics Dashboard Table", group="Dashboard Settings")
tablePosInput  = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Dashboard Settings")
tableSizeInput = input.string("Small", "Table Size", options=["Auto", "Tiny", "Small", "Normal", "Large"], group="Dashboard Settings")

// ==========================================
// TICKER PARSING & AUTO-DETECTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

// ----- Detect underlying -----
UnderlyingAsset actualUnderlying = na
if underlyingInput == UnderlyingAsset.auto
    if str.contains(cleanTicker, "BANKNIFTY")
        actualUnderlying := UnderlyingAsset.banknifty
    else if str.contains(cleanTicker, "NIFTY")
        actualUnderlying := UnderlyingAsset.nifty
    else if str.contains(cleanTicker, "CRUDEOIL")
        actualUnderlying := UnderlyingAsset.crudeoil
    else if str.contains(cleanTicker, "GOLD") and not str.contains(cleanTicker, "GOLDM") and not str.contains(cleanTicker, "GOLDPETAL")
        actualUnderlying := UnderlyingAsset.gold
    else if str.contains(cleanTicker, "GOLDM")
        actualUnderlying := UnderlyingAsset.gold
    else
        actualUnderlying := UnderlyingAsset.stock
else
    actualUnderlying := underlyingInput

// ----- Detect option type -----
bool isCall = false
bool isPut  = false

if optionTypeInput == OptionType.ce
    isCall := true
else if optionTypeInput == OptionType.pe
    isPut := true
else
    if str.contains(cleanTicker, "CE")
        isCall := true
    else if str.contains(cleanTicker, "PE")
        isPut := true
    else if str.match(cleanTicker, "C\\d+$") != ""
        isCall := true
    else if str.match(cleanTicker, "P\\d+$") != ""
        isPut := true

// ----- Strike extraction from chart symbol -----
float detectedStrike = na
string tickerWithoutCEPE = ""

int tickerLen = str.length(cleanTicker)
if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, tickerLen - 2)

string matchC = str.match(cleanTicker, "C\\d+$")
string matchP = str.match(cleanTicker, "P\\d+$")

if matchC != ""
    detectedStrike := str.tonumber(str.substring(matchC, 1))
else if matchP != ""
    detectedStrike := str.tonumber(str.substring(matchP, 1))
else if tickerWithoutCEPE != ""
    string strikeDigits = str.match(tickerWithoutCEPE, "\\d+$")
    detectedStrike := str.tonumber(strikeDigits)

float chartStrikePrice = strikeOverride > 0.0 ? strikeOverride : (manualStrikeInput > 0 ? float(manualStrikeInput) : detectedStrike)

// ==========================================
// SPOT TICKER RESOLUTION
// ==========================================

string spotTicker = ""
if str.length(spotTickerOverride) > 0
    spotTicker := spotTickerOverride
else
    switch actualUnderlying
        UnderlyingAsset.banknifty => spotTicker := "NSE:BANKNIFTY"
        UnderlyingAsset.nifty     => spotTicker := "NSE:NIFTY"
        UnderlyingAsset.crudeoil  => spotTicker := "MCX:CRUDEOIL1!"
        UnderlyingAsset.gold      => spotTicker := "MCX:GOLD1!"
        UnderlyingAsset.stock     =>
            string rootGuess = str.match(cleanTicker, "^[A-Z&]+")
            if rootGuess != ""
                spotTicker := syminfo.prefix + ":" + rootGuess
            else
                spotTicker := syminfo.prefix + ":" + cleanTicker

// Auto-detect step size
f_auto_detect_step(float ref_p) =>
    float s_res = 50.0
    if na(ref_p) or ref_p <= 0
        s_res := 50.0
    else if ref_p < 100
        s_res := 1.0
    else if ref_p < 250
        s_res := 2.5
    else if ref_p < 500
        s_res := 5.0
    else if ref_p < 1200
        s_res := 10.0
    else if ref_p < 2500
        s_res := 20.0
    else
        s_res := 50.0
    s_res

float stepVal = switch actualUnderlying
    UnderlyingAsset.banknifty => 100.0
    UnderlyingAsset.nifty     => 50.0
    UnderlyingAsset.crudeoil  => 50.0
    UnderlyingAsset.gold      => 100.0
    UnderlyingAsset.stock     => f_auto_detect_step(chartStrikePrice)

float offsetPts = switch offsetChoiceInput
    "5 Points"   => 5.0
    "10 Points"  => 10.0
    "15 Points"  => 15.0
    "20 Points"  => 20.0
    "25 Points"  => 25.0
    "40 Points"  => 40.0
    "50 Points"  => 50.0
    "100 Points" => 100.0
    "150 Points" => 150.0
    "200 Points" => 200.0
    => 100.0

// ==========================================
// FAIL-SAFE TICKER CONSTRUCTORS
// ==========================================

f_build_option_symbol(float target_strike, bool target_is_ce) =>
    string st_digits = not na(chartStrikePrice) and chartStrikePrice > 0 ? (chartStrikePrice == math.floor(chartStrikePrice) ? str.tostring(int(chartStrikePrice)) : str.tostring(chartStrikePrice)) : (target_strike == math.floor(target_strike) ? str.tostring(int(target_strike)) : str.tostring(target_strike))
    int st_len = str.length(st_digits)
    string target_st_str = target_strike == math.floor(target_strike) ? str.tostring(int(target_strike)) : str.tostring(target_strike)
    
    if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
        int end_trim = 2
        string base_no_suffix = str.substring(cleanTicker, 0, str.length(cleanTicker) - end_trim)
        string pfx = str.substring(base_no_suffix, 0, str.length(base_no_suffix) - st_len)
        string sfx = target_is_ce ? "CE" : "PE"
        pfx + target_st_str + sfx
    else if str.match(cleanTicker, "[CP]\\d+$") != ""
        string matchCP = str.match(cleanTicker, "[CP]\\d+$")
        int matchPos = str.pos(cleanTicker, matchCP)
        string pfx = str.substring(cleanTicker, 0, matchPos)
        string cp_letter = target_is_ce ? "C" : "P"
        pfx + cp_letter + target_st_str
    else
        string rep_ticker = str.replace(cleanTicker, st_digits, target_st_str)
        rep_ticker

// Target Strike Calculations
float ce_strike = chartStrikePrice
float pe_strike = chartStrikePrice

float itm_ce_strike = chartStrikePrice - offsetPts
float itm_pe_strike = chartStrikePrice + offsetPts

float otm_ce_strike = chartStrikePrice + offsetPts
float otm_pe_strike = chartStrikePrice - offsetPts

float itm2_ce_strike = chartStrikePrice - (2.0 * offsetPts)
float itm2_pe_strike = chartStrikePrice + (2.0 * offsetPts)

float otm2_ce_strike = chartStrikePrice + (2.0 * offsetPts)
float otm2_pe_strike = chartStrikePrice - (2.0 * offsetPts)

string ce_ticker = f_build_option_symbol(ce_strike, true)
string pe_ticker = f_build_option_symbol(pe_strike, false)

string ce_itm_ticker = f_build_option_symbol(itm_ce_strike, true)
string pe_itm_ticker = f_build_option_symbol(itm_pe_strike, false)

string ce_otm_ticker = f_build_option_symbol(otm_ce_strike, true)
string pe_otm_ticker = f_build_option_symbol(otm_pe_strike, false)

string ce_itm2_ticker = f_build_option_symbol(itm2_ce_strike, true)
string pe_itm2_ticker = f_build_option_symbol(itm2_pe_strike, false)

string ce_otm2_ticker = f_build_option_symbol(otm2_ce_strike, true)
string pe_otm2_ticker = f_build_option_symbol(otm2_pe_strike, false)

// ==========================================
// 5-DAY HISTORICAL DATA FETCHING
// ==========================================

f_fetch_5d(string tkr) =>
    float d0 = request.security(tkr, "D", open[0], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
    float d1 = request.security(tkr, "D", open[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
    float d2 = request.security(tkr, "D", open[2], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
    float d3 = request.security(tkr, "D", open[3], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
    float d4 = request.security(tkr, "D", open[4], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
    [d0, d1, d2, d3, d4]

[spot_r0, spot_r1, spot_r2, spot_r3, spot_r4] = f_fetch_5d(spotTicker)
[ce_r0, ce_r1, ce_r2, ce_r3, ce_r4]           = f_fetch_5d(ce_ticker)
[pe_r0, pe_r1, pe_r2, pe_r3, pe_r4]           = f_fetch_5d(pe_ticker)

[ce_itm_r0, ce_itm_r1, ce_itm_r2, ce_itm_r3, ce_itm_r4] = f_fetch_5d(ce_itm_ticker)
[pe_itm_r0, pe_itm_r1, pe_itm_r2, pe_itm_r3, pe_itm_r4] = f_fetch_5d(pe_itm_ticker)

[ce_otm_r0, ce_otm_r1, ce_otm_r2, ce_otm_r3, ce_otm_r4] = f_fetch_5d(ce_otm_ticker)
[pe_otm_r0, pe_otm_r1, pe_otm_r2, pe_otm_r3, pe_otm_r4] = f_fetch_5d(pe_otm_ticker)

// Realtime OHLC & LTP fetching
float spot_ltp = request.security(spotTicker, timeframe.period, close, ignore_invalid_symbol=true)

[ce_o, ce_h, ce_l, ce_c]             = request.security(ce_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)
[pe_o, pe_h, pe_l, pe_c]             = request.security(pe_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)

[ce_itm_o, ce_itm_h, ce_itm_l, ce_itm_c] = request.security(ce_itm_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)
[pe_itm_o, pe_itm_h, pe_itm_l, pe_itm_c] = request.security(pe_itm_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)

[ce_otm_o, ce_otm_h, ce_otm_l, ce_otm_c] = request.security(ce_otm_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)
[pe_otm_o, pe_otm_h, pe_otm_l, pe_otm_c] = request.security(pe_otm_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)

[ce_itm2_o, ce_itm2_h, ce_itm2_l, ce_itm2_c] = request.security(ce_itm2_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)
[pe_itm2_o, pe_itm2_h, pe_itm2_l, pe_itm2_c] = request.security(pe_itm2_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)

[ce_otm2_o, ce_otm2_h, ce_otm2_l, ce_otm2_c] = request.security(ce_otm2_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)
[pe_otm2_o, pe_otm2_h, pe_otm2_l, pe_otm2_c] = request.security(pe_otm2_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)

float ce_ltp     = ce_c
float pe_ltp     = pe_c
float ce_itm_ltp = ce_itm_c
float pe_itm_ltp = pe_itm_c
float ce_otm_ltp = ce_otm_c
float pe_otm_ltp = pe_otm_c

spot_ltp := na(spot_ltp) ? chartStrikePrice : spot_ltp

// ==========================================
// 1. INTRINSIC & TIME VALUE CALCULATIONS (ITM 1, ITM 2, OTM 1, OTM 2)
// ==========================================

// Realtime Intrinsic Values (ITM 1 & ITM 2)
float ce_itm1_iv_rt  = math.max(0.0, spot_ltp - itm_ce_strike)
float pe_itm1_iv_rt  = math.max(0.0, itm_pe_strike - spot_ltp)
float itm1_avg_iv_rt = (ce_itm1_iv_rt + pe_itm1_iv_rt) / 2.0

float ce_itm2_iv_rt  = math.max(0.0, spot_ltp - itm2_ce_strike)
float pe_itm2_iv_rt  = math.max(0.0, itm2_pe_strike - spot_ltp)
float itm2_avg_iv_rt = (ce_itm2_iv_rt + pe_itm2_iv_rt) / 2.0

// Realtime Time Values (OTM 1 & OTM 2)
float ce_otm1_iv_rt  = math.max(0.0, spot_ltp - otm_ce_strike)
float pe_otm1_iv_rt  = math.max(0.0, otm_pe_strike - spot_ltp)
float ce_otm1_tv_rt  = math.max(0.0, ce_otm_c - ce_otm1_iv_rt)
float pe_otm1_tv_rt  = math.max(0.0, pe_otm_c - pe_otm1_iv_rt)
float otm1_avg_tv_rt = (ce_otm1_tv_rt + pe_otm1_tv_rt) / 2.0

float ce_otm2_iv_rt  = math.max(0.0, spot_ltp - otm2_ce_strike)
float pe_otm2_iv_rt  = math.max(0.0, otm2_pe_strike - spot_ltp)
float ce_otm2_tv_rt  = math.max(0.0, ce_otm2_c - ce_otm2_iv_rt)
float pe_otm2_tv_rt  = math.max(0.0, pe_otm2_c - pe_otm2_iv_rt)
float otm2_avg_tv_rt = (ce_otm2_tv_rt + pe_otm2_tv_rt) / 2.0

// Aliases for compatibility
float otm_avg_tv_rt  = otm1_avg_tv_rt
float itm_avg_iv_rt  = itm1_avg_iv_rt
float ce_iv_rt       = ce_itm1_iv_rt
float pe_iv_rt       = pe_itm1_iv_rt
float avg_iv_rt      = itm1_avg_iv_rt
float ce_tv_rt       = ce_otm1_tv_rt
float pe_tv_rt       = pe_otm1_tv_rt
float avg_tv_rt      = otm1_avg_tv_rt
float ce_itm_iv_rt   = ce_itm1_iv_rt
float pe_itm_iv_rt   = pe_itm1_iv_rt
float ce_otm_tv_rt   = ce_otm1_tv_rt
float pe_otm_tv_rt   = pe_otm1_tv_rt
float itm_avg_tv_rt  = otm1_avg_tv_rt
float otm_avg_iv_rt  = otm1_avg_tv_rt

// Static Daily References & Static Calculations
float bar_spot_ref   = staticBasisInput == StaticBasis.prevClose ? request.security(spotTicker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true) : request.security(spotTicker, "D", open[0], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
float bar_ce_ref     = staticBasisInput == StaticBasis.prevClose ? request.security(ce_ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true) : request.security(ce_ticker, "D", open[0], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
float bar_pe_ref     = staticBasisInput == StaticBasis.prevClose ? request.security(pe_ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true) : request.security(pe_ticker, "D", open[0], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Static ITM 1 & ITM 2 Average Intrinsic Values
float bar_ce_itm1_iv_stat  = math.max(0.0, bar_spot_ref - itm_ce_strike)
float bar_pe_itm1_iv_stat  = math.max(0.0, itm_pe_strike - bar_spot_ref)
float bar_itm1_avg_iv_stat = (bar_ce_itm1_iv_stat + bar_pe_itm1_iv_stat) / 2.0

float bar_ce_itm2_iv_stat  = math.max(0.0, bar_spot_ref - itm2_ce_strike)
float bar_pe_itm2_iv_stat  = math.max(0.0, itm2_pe_strike - bar_spot_ref)
float bar_itm2_avg_iv_stat = (bar_ce_itm2_iv_stat + bar_pe_itm2_iv_stat) / 2.0

// Static OTM 1 & OTM 2 Average Time Values
float bar_ce_otm1_ref       = staticBasisInput == StaticBasis.prevClose ? request.security(ce_otm_ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true) : request.security(ce_otm_ticker, "D", open[0], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
float bar_pe_otm1_ref       = staticBasisInput == StaticBasis.prevClose ? request.security(pe_otm_ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true) : request.security(pe_otm_ticker, "D", open[0], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
float bar_ce_otm1_iv_stat   = math.max(0.0, bar_spot_ref - otm_ce_strike)
float bar_pe_otm1_iv_stat   = math.max(0.0, otm_pe_strike - bar_spot_ref)
float bar_ce_otm1_tv_stat   = timeValueFormulaInput == TimeValueFormula.standard ? (bar_ce_otm1_ref - bar_ce_otm1_iv_stat) : (otm_ce_strike - bar_ce_otm1_iv_stat)
float bar_pe_otm1_tv_stat   = timeValueFormulaInput == TimeValueFormula.standard ? (bar_pe_otm1_ref - bar_pe_otm1_iv_stat) : (otm_pe_strike - bar_pe_otm1_iv_stat)
float bar_otm1_avg_tv_stat  = (bar_ce_otm1_tv_stat + bar_pe_otm1_tv_stat) / 2.0

float bar_ce_otm2_ref       = staticBasisInput == StaticBasis.prevClose ? request.security(ce_otm2_ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true) : request.security(ce_otm2_ticker, "D", open[0], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
float bar_pe_otm2_ref       = staticBasisInput == StaticBasis.prevClose ? request.security(pe_otm2_ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true) : request.security(pe_otm2_ticker, "D", open[0], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
float bar_ce_otm2_iv_stat   = math.max(0.0, bar_spot_ref - otm2_ce_strike)
float bar_pe_otm2_iv_stat   = math.max(0.0, otm2_pe_strike - bar_spot_ref)
float bar_ce_otm2_tv_stat   = timeValueFormulaInput == TimeValueFormula.standard ? (bar_ce_otm2_ref - bar_ce_otm2_iv_stat) : (otm2_ce_strike - bar_ce_otm2_iv_stat)
float bar_pe_otm2_tv_stat   = timeValueFormulaInput == TimeValueFormula.standard ? (bar_pe_otm2_ref - bar_pe_otm2_iv_stat) : (otm2_pe_strike - bar_pe_otm2_iv_stat)
float bar_otm2_avg_tv_stat  = (bar_ce_otm2_tv_stat + bar_pe_otm2_tv_stat) / 2.0

float bar_avg_iv_stat       = bar_itm1_avg_iv_stat
float bar_avg_tv_stat       = bar_otm1_avg_tv_stat
float bar_ce_iv_stat        = bar_ce_itm1_iv_stat
float bar_pe_iv_stat        = bar_pe_itm1_iv_stat
float bar_ce_tv_stat        = bar_ce_otm1_tv_stat
float bar_pe_tv_stat        = bar_pe_otm1_tv_stat
float bar_bep_stat          = (bar_ce_ref + bar_pe_ref) / 2.0
float bar_ce_pdc            = request.security(ce_ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
float bar_pe_pdc            = request.security(pe_ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// ==========================================
// DYNAMIC TOUCH LINES CALCULATIONS
// ==========================================

// 1. ATM PE Top = (ATM PE LTP + ITM 1 CE LTP)/2  [When ATM PE is on top: pe_c > ce_c]
float line_val_atm_pe_top = (pe_c > ce_c and nz(pe_c) > 0 and nz(ce_itm_c) > 0) ? (pe_c + ce_itm_c) / 2.0 : na

// 2. ATM CE Top = (ATM CE LTP + ITM 1 PE LTP)/2  [When ATM CE is on top: ce_c > pe_c]
float line_val_atm_ce_top = (ce_c > pe_c and nz(ce_c) > 0 and nz(pe_itm_c) > 0) ? (ce_c + pe_itm_c) / 2.0 : na

// 3. ITM 1 CE Top = (ITM 1 CE LTP + ITM 2 PE LTP)/2  [When ITM 1 CE is on top: ce_itm_c > pe_itm_c]
float line_val_itm1_ce_top = (ce_itm_c > pe_itm_c and nz(ce_itm_c) > 0 and nz(pe_itm2_c) > 0) ? (ce_itm_c + pe_itm2_c) / 2.0 : na

// 4. ITM 1 PE Top = (ITM 1 PE LTP + ITM 2 CE LTP)/2  [When ITM 1 PE is on top: pe_itm_c > ce_itm_c]
float line_val_itm1_pe_top = (pe_itm_c > ce_itm_c and nz(pe_itm_c) > 0 and nz(ce_itm2_c) > 0) ? (pe_itm_c + ce_itm2_c) / 2.0 : na

// 5. ITM 2 CE Top = (ITM 2 CE LTP + ITM 2 PE LTP)/2  [When ITM 2 CE is on top: ce_itm2_c > pe_itm2_c]
float line_val_itm2_ce_top = (ce_itm2_c > pe_itm2_c and nz(ce_itm2_c) > 0 and nz(pe_itm2_c) > 0) ? (ce_itm2_c + pe_itm2_c) / 2.0 : na

// 6. ITM 2 PE Top = (ITM 2 PE LTP + ITM 2 CE LTP)/2  [When ITM 2 PE is on top: pe_itm2_c > ce_itm2_c]
float line_val_itm2_pe_top = (pe_itm2_c > ce_itm2_c and nz(pe_itm2_c) > 0 and nz(ce_itm2_c) > 0) ? (pe_itm2_c + ce_itm2_c) / 2.0 : na

// 7. OTM 1 CE Top = (OTM 1 CE LTP + ATM PE LTP)/2  [When OTM 1 CE is on top: ce_otm_c > pe_otm_c]
float line_val_otm1_ce_top = (ce_otm_c > pe_otm_c and nz(ce_otm_c) > 0 and nz(pe_c) > 0) ? (ce_otm_c + pe_c) / 2.0 : na

// 8. OTM 1 PE Top = (OTM 1 PE LTP + ATM CE LTP)/2  [When OTM 1 PE is on top: pe_otm_c > ce_otm_c]
float line_val_otm1_pe_top = (pe_otm_c > ce_otm_c and nz(pe_otm_c) > 0 and nz(ce_c) > 0) ? (pe_otm_c + ce_c) / 2.0 : na

// 9. OTM 2 CE Top = (OTM 2 CE LTP + OTM 1 PE LTP)/2  [When OTM 2 CE is on top: ce_otm2_c > pe_otm2_c]
float line_val_otm2_ce_top = (ce_otm2_c > pe_otm2_c and nz(ce_otm2_c) > 0 and nz(pe_otm_c) > 0) ? (ce_otm2_c + pe_otm_c) / 2.0 : na

// 10. OTM 2 PE Top = (OTM 2 PE LTP + OTM 1 CE LTP)/2  [When OTM 2 PE is on top: pe_otm2_c > ce_otm2_c]
float line_val_otm2_pe_top = (pe_otm2_c > ce_otm2_c and nz(pe_otm2_c) > 0 and nz(ce_otm_c) > 0) ? (pe_otm2_c + ce_otm_c) / 2.0 : na

// --- Helper Dynamic Line Drawer (Drawn via line.new to preserve total plot count <= 64 limit) ---
f_draw_dyn_line(bool is_enabled, float val, color line_col, int l_width, string l_style) =>
    if is_enabled and not na(val) and not na(val[1]) and val > 0 and val[1] > 0
        string st = str.lower(l_style) == "solid" ? line.style_solid : (str.lower(l_style) == "dotted" ? line.style_dotted : line.style_dashed)
        line.new(bar_index - 1, val[1], bar_index, val, color=line_col, width=l_width, style=st)

// Draw Only Active & Enabled Dynamic Touch Lines on Chart
f_draw_dyn_line(show_line_atm_pe_top,  line_val_atm_pe_top,  color_line_atm_pe_top,  width_line_atm_pe_top,  style_line_atm_pe_top)
f_draw_dyn_line(show_line_atm_ce_top,  line_val_atm_ce_top,  color_line_atm_ce_top,  width_line_atm_ce_top,  style_line_atm_ce_top)
f_draw_dyn_line(show_line_itm1_ce_top, line_val_itm1_ce_top, color_line_itm1_ce_top, width_line_itm1_ce_top, style_line_itm1_ce_top)
f_draw_dyn_line(show_line_itm1_pe_top, line_val_itm1_pe_top, color_line_itm1_pe_top, width_line_itm1_pe_top, style_line_itm1_pe_top)
f_draw_dyn_line(show_line_itm2_ce_top, line_val_itm2_ce_top, color_line_itm2_ce_top, width_line_itm2_ce_top, style_line_itm2_ce_top)
f_draw_dyn_line(show_line_itm2_pe_top, line_val_itm2_pe_top, color_line_itm2_pe_top, width_line_itm2_pe_top, style_line_itm2_pe_top)
f_draw_dyn_line(show_line_otm1_ce_top, line_val_otm1_ce_top, color_line_otm1_ce_top, width_line_otm1_ce_top, style_line_otm1_ce_top)
f_draw_dyn_line(show_line_otm1_pe_top, line_val_otm1_pe_top, color_line_otm1_pe_top, width_line_otm1_pe_top, style_line_otm1_pe_top)
f_draw_dyn_line(show_line_otm2_ce_top, line_val_otm2_ce_top, color_line_otm2_ce_top, width_line_otm2_ce_top, style_line_otm2_ce_top)
f_draw_dyn_line(show_line_otm2_pe_top, line_val_otm2_pe_top, color_line_otm2_pe_top, width_line_otm2_pe_top, style_line_otm2_pe_top)

// ==========================================
// PLOTTING METRICS (ITM AVG IV, OTM AVG TV & STATIC METRICS)
// ==========================================

// --- Zero Middle Line ---
hline(0, "Zero Middle Line", color=color.white, linestyle=hline.style_solid, linewidth=1)

// --- Realtime ITM Average Intrinsic Plots ---
plot(show_itm1_avg_iv_rt ? itm1_avg_iv_rt : na, "ITM 1 Realtime Avg Intrinsic", color=color_itm1_avg_iv_rt, linewidth=width_itm1_avg_iv_rt, style=plot.style_linebr)
plot(show_itm2_avg_iv_rt ? itm2_avg_iv_rt : na, "ITM 2 Realtime Avg Intrinsic", color=color_itm2_avg_iv_rt, linewidth=width_itm2_avg_iv_rt, style=plot.style_linebr)

// --- Realtime OTM Average Time Value Plots ---
plot(show_otm1_avg_tv_rt ? otm1_avg_tv_rt : na, "OTM 1 Realtime Avg Time Value", color=color_otm1_avg_tv_rt, linewidth=width_otm1_avg_tv_rt, style=plot.style_linebr)
plot(show_otm2_avg_tv_rt ? otm2_avg_tv_rt : na, "OTM 2 Realtime Avg Time Value", color=color_otm2_avg_tv_rt, linewidth=width_otm2_avg_tv_rt, style=plot.style_linebr)

// --- 5-Day Static ITM Avg Intrinsic Plots ---
plot(show_itm1_avg_iv_stat ? bar_itm1_avg_iv_stat : na, "ITM 1 Static Avg Intrinsic", color=color_itm1_avg_iv_stat, style=plot.style_linebr)
plot(show_itm2_avg_iv_stat ? bar_itm2_avg_iv_stat : na, "ITM 2 Static Avg Intrinsic", color=color_itm2_avg_iv_stat, style=plot.style_linebr)

// --- 5-Day Static OTM Avg Time Value Plots ---
plot(show_otm1_avg_tv_stat ? bar_otm1_avg_tv_stat : na, "OTM 1 Static Avg Time Value", color=color_otm1_avg_tv_stat, style=plot.style_linebr)
plot(show_otm2_avg_tv_stat ? bar_otm2_avg_tv_stat : na, "OTM 2 Static Avg Time Value", color=color_otm2_avg_tv_stat, style=plot.style_linebr)

// --- Static BEP / Prev Close Line ---
plot(show5D_Static_BEPInput ? bar_bep_stat : (showPD_CE_CloseInput ? bar_ce_pdc : (showPD_PE_CloseInput ? bar_pe_pdc : na)), "Static BEP / Prev Close Line", color=color.aqua, style=plot.style_linebr)

// ==========================================
// OPTION CANDLES OVERLAY PLOTS
// ==========================================

f_valid_candle(float o, float h, float l, float c) =>
    bool ok = not na(o) and not na(h) and not na(l) and not na(c) and o > 0 and h > 0 and l > 0 and c > 0 and h >= l and h >= o and h >= c and l <= o and l <= c
    float vo = ok ? o : na
    float vh = ok ? h : na
    float vl = ok ? l : na
    float vc = ok ? c : na
    [vo, vh, vl, vc]

// ITM 1 CE Candle
[itm1_ce_o, itm1_ce_h, itm1_ce_l, itm1_ce_c] = f_valid_candle(ce_itm_o, ce_itm_h, ce_itm_l, ce_itm_c)
bool is_itm_ce_bull = nz(itm1_ce_c) >= nz(itm1_ce_o)
color col_itm_ce    = is_itm_ce_bull ? color_itm_ce_up : color_itm_ce_dn
plotcandle(show_itm_ce_candle ? itm1_ce_o : na,
           show_itm_ce_candle ? itm1_ce_h : na,
           show_itm_ce_candle ? itm1_ce_l : na,
           show_itm_ce_candle ? itm1_ce_c : na,
           title="ITM 1 CE Candle", color=col_itm_ce)

// ITM 1 PE Candle
[itm1_pe_o, itm1_pe_h, itm1_pe_l, itm1_pe_c] = f_valid_candle(pe_itm_o, pe_itm_h, pe_itm_l, pe_itm_c)
bool is_itm_pe_bull = nz(itm1_pe_c) >= nz(itm1_pe_o)
color col_itm_pe    = is_itm_pe_bull ? color_itm_pe_up : color_itm_pe_dn
plotcandle(show_itm_pe_candle ? itm1_pe_o : na,
           show_itm_pe_candle ? itm1_pe_h : na,
           show_itm_pe_candle ? itm1_pe_l : na,
           show_itm_pe_candle ? itm1_pe_c : na,
           title="ITM 1 PE Candle", color=col_itm_pe)

// OTM 1 CE Candle
[otm1_ce_o, otm1_ce_h, otm1_ce_l, otm1_ce_c] = f_valid_candle(ce_otm_o, ce_otm_h, ce_otm_l, ce_otm_c)
bool is_otm_ce_bull = nz(otm1_ce_c) >= nz(otm1_ce_o)
color col_otm_ce    = is_otm_ce_bull ? color_otm_ce_up : color_otm_ce_dn
plotcandle(show_otm_ce_candle ? otm1_ce_o : na,
           show_otm_ce_candle ? otm1_ce_h : na,
           show_otm_ce_candle ? otm1_ce_l : na,
           show_otm_ce_candle ? otm1_ce_c : na,
           title="OTM 1 CE Candle", color=col_otm_ce)

// OTM 1 PE Candle
[otm1_pe_o, otm1_pe_h, otm1_pe_l, otm1_pe_c] = f_valid_candle(pe_otm_o, pe_otm_h, pe_otm_l, pe_otm_c)
bool is_otm_pe_bull = nz(otm1_pe_c) >= nz(otm1_pe_o)
color col_otm_pe    = is_otm_pe_bull ? color_otm_pe_up : color_otm_pe_dn
plotcandle(show_otm_pe_candle ? otm1_pe_o : na,
           show_otm_pe_candle ? otm1_pe_h : na,
           show_otm_pe_candle ? otm1_pe_l : na,
           show_otm_pe_candle ? otm1_pe_c : na,
           title="OTM 1 PE Candle", color=col_otm_pe)

// ITM 2 CE Candle
[itm2_ce_o, itm2_ce_h, itm2_ce_l, itm2_ce_c] = f_valid_candle(ce_itm2_o, ce_itm2_h, ce_itm2_l, ce_itm2_c)
bool is_itm2_ce_bull = nz(itm2_ce_c) >= nz(itm2_ce_o)
color col_itm2_ce    = is_itm2_ce_bull ? color_itm2_ce_up : color_itm2_ce_dn
plotcandle(show_itm2_ce_candle ? itm2_ce_o : na,
           show_itm2_ce_candle ? itm2_ce_h : na,
           show_itm2_ce_candle ? itm2_ce_l : na,
           show_itm2_ce_candle ? itm2_ce_c : na,
           title="ITM 2 CE Candle", color=col_itm2_ce)

// ITM 2 PE Candle
[itm2_pe_o, itm2_pe_h, itm2_pe_l, itm2_pe_c] = f_valid_candle(pe_itm2_o, pe_itm2_h, pe_itm2_l, pe_itm2_c)
bool is_itm2_pe_bull = nz(itm2_pe_c) >= nz(itm2_pe_o)
color col_itm2_pe    = is_itm2_pe_bull ? color_itm2_pe_up : color_itm2_pe_dn
plotcandle(show_itm2_pe_candle ? itm2_pe_o : na,
           show_itm2_pe_candle ? itm2_pe_h : na,
           show_itm2_pe_candle ? itm2_pe_l : na,
           show_itm2_pe_candle ? itm2_pe_c : na,
           title="ITM 2 PE Candle", color=col_itm2_pe)

// OTM 2 CE Candle
[otm2_ce_o, otm2_ce_h, otm2_ce_l, otm2_ce_c] = f_valid_candle(ce_otm2_o, ce_otm2_h, ce_otm2_l, ce_otm2_c)
bool is_otm2_ce_bull = nz(otm2_ce_c) >= nz(otm2_ce_o)
color col_otm2_ce    = is_otm2_ce_bull ? color_otm2_ce_up : color_otm2_ce_dn
plotcandle(show_otm2_ce_candle ? otm2_ce_o : na,
           show_otm2_ce_candle ? otm2_ce_h : na,
           show_otm2_ce_candle ? otm2_ce_l : na,
           show_otm2_ce_candle ? otm2_ce_c : na,
           title="OTM 2 CE Candle", color=col_otm2_ce)

// OTM 2 PE Candle
[otm2_pe_o, otm2_pe_h, otm2_pe_l, otm2_pe_c] = f_valid_candle(pe_otm2_o, pe_otm2_h, pe_otm2_l, pe_otm2_c)
bool is_otm2_pe_bull = nz(otm2_pe_c) >= nz(otm2_pe_o)
color col_otm2_pe    = is_otm2_pe_bull ? color_otm2_pe_up : color_otm2_pe_dn
plotcandle(show_otm2_pe_candle ? otm2_pe_o : na,
           show_otm2_pe_candle ? otm2_pe_h : na,
           show_otm2_pe_candle ? otm2_pe_l : na,
           show_otm2_pe_candle ? otm2_pe_c : na,
           title="OTM 2 PE Candle", color=col_otm2_pe)

// ==========================================
// STRIKE NAME LABELS FOR CANDLES
// ==========================================
var label lbl_itm1_ce = na
var label lbl_itm1_pe = na
var label lbl_otm1_ce = na
var label lbl_otm1_pe = na

var label lbl_itm2_ce = na
var label lbl_itm2_pe = na
var label lbl_otm2_ce = na
var label lbl_otm2_pe = na

f_update_strike_label(label existing_lbl, bool show_flag, float price_val, string label_text, color lbl_col) =>
    if barstate.islast and show_strike_labels and show_flag and not na(price_val)
        label.delete(existing_lbl)
        label.new(bar_index, price_val, text=label_text, color=lbl_col, textcolor=color.white, style=label.style_label_left, size=size.small)
    else
        label.delete(existing_lbl)
        na

if barstate.islast
    lbl_itm1_ce := f_update_strike_label(lbl_itm1_ce, show_itm_ce_candle, ce_itm_c, ce_itm_ticker + " (ITM 1)", color_itm_ce_up)
    lbl_itm1_pe := f_update_strike_label(lbl_itm1_pe, show_itm_pe_candle, pe_itm_c, pe_itm_ticker + " (ITM 1)", color_itm_pe_up)
    lbl_otm1_ce := f_update_strike_label(lbl_otm1_ce, show_otm_ce_candle, ce_otm_c, ce_otm_ticker + " (OTM 1)", color_otm_ce_up)
    lbl_otm1_pe := f_update_strike_label(lbl_otm1_pe, show_otm_pe_candle, pe_otm_c, pe_otm_ticker + " (OTM 1)", color_otm_pe_up)

    lbl_itm2_ce := f_update_strike_label(lbl_itm2_ce, show_itm2_ce_candle, ce_itm2_c, ce_itm2_ticker + " (ITM 2)", color_itm2_ce_up)
    lbl_itm2_pe := f_update_strike_label(lbl_itm2_pe, show_itm2_pe_candle, pe_itm2_c, pe_itm2_ticker + " (ITM 2)", color_itm2_pe_up)
    lbl_otm2_ce := f_update_strike_label(lbl_otm2_ce, show_otm2_ce_candle, ce_otm2_c, ce_otm2_ticker + " (OTM 2)", color_otm2_ce_up)
    lbl_otm2_pe := f_update_strike_label(lbl_otm2_pe, show_otm2_pe_candle, pe_otm2_c, pe_otm2_ticker + " (OTM 2)", color_otm2_pe_up)

// ==========================================
// BUY / SELL SIGNALS & ALERTS LOGIC (BC & BP)
// ==========================================

// --- Universal Helper Crossover & Bounce Evaluators ---
// Bounce Back: Low touches/dips to reference line (l_val <= ref_val) and finishes/closes above reference line (c_val > ref_val) once the candle closes
f_bounce_back(float l_val, float c_val, float ref_val) =>
    not na(l_val) and not na(c_val) and not na(ref_val) and (l_val <= ref_val) and (c_val > ref_val)

f_crossover_up(float curr_c, float prev_c, float ref_val) =>
    not na(curr_c) and not na(ref_val) and (curr_c > ref_val) and (nz(prev_c) <= ref_val)

// Crossover: Candle closes above the opposite candle close
f_crossover_opp(float my_c, float prev_my_c, float opp_c, float prev_opp_c) =>
    not na(my_c) and not na(opp_c) and (my_c > opp_c) and (nz(prev_my_c) <= nz(prev_opp_c))

// --- 1. OTM 1 & OTM 2 Buy CE & Buy PE Conditions (Crossover & Bounce Back) ---
// OTM 1 CE Triggers: Candle closes above opposite PE candle on crossover OR bounce back candle closes above reference line
bool otm1_ce_cross_up  = f_crossover_opp(ce_otm_c, ce_otm_c[1], pe_otm_c, pe_otm_c[1]) or (f_crossover_up(ce_otm_c, ce_otm_c[1], otm_avg_tv_rt) and ce_otm_c > pe_otm_c)
bool otm1_ce_bounce_up = f_bounce_back(ce_otm_l, ce_otm_c, otm_avg_tv_rt)

// OTM 1 PE Triggers: Candle closes above opposite CE candle on crossover OR bounce back candle closes above reference line
bool otm1_pe_cross_up  = f_crossover_opp(pe_otm_c, pe_otm_c[1], ce_otm_c, ce_otm_c[1]) or (f_crossover_up(pe_otm_c, pe_otm_c[1], otm_avg_tv_rt) and pe_otm_c > ce_otm_c)
bool otm1_pe_bounce_up = f_bounce_back(pe_otm_l, pe_otm_c, otm_avg_tv_rt)

// OTM 2 CE Triggers: Candle closes above opposite PE candle on crossover OR bounce back candle closes above reference line
bool otm2_ce_cross_up  = f_crossover_opp(ce_otm2_c, ce_otm2_c[1], pe_otm2_c, pe_otm2_c[1]) or (f_crossover_up(ce_otm2_c, ce_otm2_c[1], otm_avg_tv_rt) and ce_otm2_c > pe_otm2_c)
bool otm2_ce_bounce_up = f_bounce_back(ce_otm2_l, ce_otm2_c, otm_avg_tv_rt)

// OTM 2 PE Triggers: Candle closes above opposite CE candle on crossover OR bounce back candle closes above reference line
bool otm2_pe_cross_up  = f_crossover_opp(pe_otm2_c, pe_otm2_c[1], ce_otm2_c, ce_otm2_c[1]) or (f_crossover_up(pe_otm2_c, pe_otm2_c[1], otm_avg_tv_rt) and pe_otm2_c > ce_otm2_c)
bool otm2_pe_bounce_up = f_bounce_back(pe_otm2_l, pe_otm2_c, otm_avg_tv_rt)

// Pure OTM 1 or OTM 2 Buy CE Signal (Green BC)
bool otm_bc_signal = otm1_ce_cross_up or otm1_ce_bounce_up or otm2_ce_cross_up or otm2_ce_bounce_up

// Pure OTM 1 or OTM 2 Buy PE Signal (Red BP)
bool otm_bp_signal = otm1_pe_cross_up or otm1_pe_bounce_up or otm2_pe_cross_up or otm2_pe_bounce_up

// --- Combined Signal Engine (STRICTLY OTM 1 & OTM 2 ONLY - No ATM / ITM) ---
bool raw_bc_signal = otm_bc_signal
bool raw_bp_signal = otm_bp_signal

bool init_bc_signal = raw_bc_signal and not raw_bc_signal[1]
bool init_bp_signal = raw_bp_signal and not raw_bp_signal[1]

var int signal_state = 0 // 0 = None, 1 = Buy CE Active, -1 = Buy PE Active

bool bc_signal = false
bool bp_signal = false

if signalFilterInput == "All Candles (Raw)"
    bc_signal := raw_bc_signal
    bp_signal := raw_bp_signal
else if signalFilterInput == "Initial Trigger Only"
    bc_signal := init_bc_signal
    bp_signal := init_bp_signal
else // "Alternate Signals Only (Wait for Opposite)"
    if raw_bc_signal and signal_state != 1
        bc_signal := true
        signal_state := 1
    else if raw_bp_signal and signal_state != -1
        bp_signal := true
        signal_state := -1

// Visual Signal Plotshapes
plotshape(showSignalPlotsInput and bc_signal, title="Buy CE (BC)", style=shape.labelup, location=location.belowbar, color=colorSB_CE, textcolor=colorSignalTextColor, size=size.small, text="BC")
plotshape(showSignalPlotsInput and bp_signal, title="Buy PE (BP)", style=shape.labeldown, location=location.abovebar, color=colorSB_PE, textcolor=colorSignalTextColor, size=size.small, text="BP")

// TradingView Alert Conditions
alertcondition(bc_signal, title="Buy CE (BC) Alert", message="BC ALERT: OTM 1 or OTM 2 CE Crossover/Bounce triggered on {{ticker}}!")
alertcondition(bp_signal, title="Buy PE (BP) Alert", message="BP ALERT: OTM 1 or OTM 2 PE Crossover/Bounce triggered on {{ticker}}!")
alertcondition(otm_bc_signal, title="OTM CE Crossover / Bounce Alert", message="OTM CE ALERT: OTM 1 or OTM 2 CE candle crossover or bounce triggered on {{ticker}}!")
alertcondition(otm_bp_signal, title="OTM PE Crossover / Bounce Alert", message="OTM PE ALERT: OTM 1 or OTM 2 PE candle crossover or bounce triggered on {{ticker}}!")

// ==========================================
// SUMMARY DASHBOARD TABLE
// ==========================================

f_get_table_pos(string pos_str) =>
    switch pos_str
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

f_get_table_text_size(string sz_str) =>
    switch sz_str
        "Auto"   => size.auto
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

var table summaryTable = table.new(f_get_table_pos(tablePosInput), 6, 8, bgcolor=color.black, border_width=1, border_color=color.gray, force_overlay=true)

if barstate.islast
    if not showTableInput
        table.delete(summaryTable)
    else
        string sz = f_get_table_text_size(tableSizeInput)
        table.cell(summaryTable, 0, 0, "Metric / Strike", bgcolor=#1565C0, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 1, 0, "CE Realtime", bgcolor=#1565C0, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 2, 0, "PE Realtime", bgcolor=#1565C0, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 3, 0, "Avg Realtime", bgcolor=#1565C0, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 4, 0, "5-Day Static", bgcolor=#1565C0, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 5, 0, "Signal Status", bgcolor=#1565C0, text_color=color.white, text_size=sz)

        // Row 1: Selected Strike IV
        table.cell(summaryTable, 0, 1, "Selected Strike IV", bgcolor=#212121, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 1, 1, str.tostring(ce_iv_rt, "#.##"), bgcolor=color.black, text_color=#00E676, text_size=sz)
        table.cell(summaryTable, 2, 1, str.tostring(pe_iv_rt, "#.##"), bgcolor=color.black, text_color=#FF1744, text_size=sz)
        table.cell(summaryTable, 3, 1, str.tostring(avg_iv_rt, "#.##"), bgcolor=color.black, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 4, 1, str.tostring(bar_avg_iv_stat, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=sz)
        table.cell(summaryTable, 5, 1, ce_iv_rt > 0 ? "CE IN THE MONEY" : (pe_iv_rt > 0 ? "PE IN THE MONEY" : "ATM"), bgcolor=ce_iv_rt > 0 ? #1B5E20 : (pe_iv_rt > 0 ? #880E4F : color.black), text_color=color.white, text_size=sz)

        // Row 2: Selected Strike TV
        table.cell(summaryTable, 0, 2, "Selected Strike TV", bgcolor=#212121, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 1, 2, str.tostring(ce_tv_rt, "#.##"), bgcolor=color.black, text_color=#76FF03, text_size=sz)
        table.cell(summaryTable, 2, 2, str.tostring(pe_tv_rt, "#.##"), bgcolor=color.black, text_color=#FF6E40, text_size=sz)
        table.cell(summaryTable, 3, 2, str.tostring(avg_tv_rt, "#.##"), bgcolor=color.black, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 4, 2, str.tostring(bar_avg_tv_stat, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=sz)
        table.cell(summaryTable, 5, 2, "ACTIVE", bgcolor=color.black, text_color=color.white, text_size=sz)

        // Row 3: ITM Strike Metrics
        table.cell(summaryTable, 0, 3, "ITM Strike Metrics", bgcolor=#212121, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 1, 3, "CE IV: " + str.tostring(ce_itm_iv_rt, "#.##"), bgcolor=color.black, text_color=#00E676, text_size=sz)
        table.cell(summaryTable, 2, 3, "PE IV: " + str.tostring(pe_itm_iv_rt, "#.##"), bgcolor=color.black, text_color=#FF1744, text_size=sz)
        table.cell(summaryTable, 3, 3, "Avg IV: " + str.tostring(itm_avg_iv_rt, "#.##"), bgcolor=color.black, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 4, 3, "Avg TV: " + str.tostring(itm_avg_tv_rt, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=sz)
        table.cell(summaryTable, 5, 3, "NEUTRAL", bgcolor=color.black, text_color=color.white, text_size=sz)

        // Row 4: OTM Strike Metrics
        table.cell(summaryTable, 0, 4, "OTM Strike Metrics", bgcolor=#212121, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 1, 4, "CE TV: " + str.tostring(ce_otm_tv_rt, "#.##"), bgcolor=color.black, text_color=#76FF03, text_size=sz)
        table.cell(summaryTable, 2, 4, "PE TV: " + str.tostring(pe_otm_tv_rt, "#.##"), bgcolor=color.black, text_color=#FF6E40, text_size=sz)
        table.cell(summaryTable, 3, 4, "Avg TV: " + str.tostring(otm_avg_tv_rt, "#.##"), bgcolor=color.black, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 4, 4, "Avg IV: " + str.tostring(otm_avg_iv_rt, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=sz)
        table.cell(summaryTable, 5, 4, otm_bc_signal ? "OTM BUY CE" : (otm_bp_signal ? "OTM BUY PE" : "NEUTRAL"), bgcolor=otm_bc_signal ? #1B5E20 : (otm_bp_signal ? #880E4F : color.black), text_color=color.white, text_size=sz)

        // Row 5: Combined Overall Signal
        table.cell(summaryTable, 0, 5, "Overall Signal Engine", bgcolor=#37474F, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 1, 5, "Filter Mode", bgcolor=#37474F, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 2, 5, signalFilterInput, bgcolor=#37474F, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 3, 5, "State: " + (signal_state == 1 ? "CE Active" : (signal_state == -1 ? "PE Active" : "None")), bgcolor=#37474F, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 4, 5, "Static BEP", bgcolor=#37474F, text_color=color.white, text_size=sz)
        table.cell(summaryTable, 5, 5, bc_signal ? "BUY CE (BC)" : (bp_signal ? "BUY PE (BP)" : "WAIT / HOLD"), bgcolor=bc_signal ? #00E676 : (bp_signal ? #FF1744 : color.black), text_color=bc_signal ? color.black : color.white, text_size=sz)
