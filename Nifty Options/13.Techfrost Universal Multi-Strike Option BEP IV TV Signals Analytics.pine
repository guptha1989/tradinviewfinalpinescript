//@version=6
indicator("13.Techfrost Universal Multi-Strike Option BEP IV TV Signals Analytics", shorttitle="TF Universal Options Analytics", overlay=true, precision=2)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum TablePos
    topRight   = "Top Right"
    topLeft    = "Top Left"
    bottomRight= "Bottom Right"
    bottomLeft = "Bottom Left"

enum TableSize
    auto   = "Auto"
    tiny   = "Tiny"
    small  = "Small"
    normal = "Normal"
    large  = "Large"

enum StaticAnchor
    dayOpen   = "Day Open Price (09:15 AM)"
    prevClose = "Previous Day Close Price"
    first5m   = "First 5 Mins Close Price"

enum HighLowSource
    min5     = "5-Min High & Low"
    prevDay  = "Previous Day High & Low"

// --- Calculation Settings ---
staticAnchorInput  = input.enum(StaticAnchor.dayOpen, "Static BEP / IV / TV Anchor", group="Baseline Calculation Settings",
  tooltip="Select baseline reference price used to calculate Static BEP, Static IV, and Static TV.")

highLowSrcInput    = input.enum(HighLowSource.min5, "Option High & Low Reference Source", group="Baseline Calculation Settings")

offsetValInput     = input.int(1, "ITM / OTM Strike Offset Steps", minval=1, maxval=10, group="Baseline Calculation Settings",
  tooltip="Offset step multiplier from ATM strike. e.g. Offset 1 for Nifty (Step 50) sets ITM=ATM-50 & OTM=ATM+50.")

useAutoStrikeStep  = input.bool(true, "Auto-Detect Instrument Strike Step", group="Instrument Strike Settings")
manualStrikeStep   = input.float(50.0, "Manual Strike Step Size", minval=0.1, group="Instrument Strike Settings")

useOffHoursPrevClose = input.bool(true, "Use Previous Day Close When Market Is Closed", group="Data Source Settings")

// --- Display Controls ---
showSummaryTable     = input.bool(true, "Show Top Analytics Dashboard Table", group="Display Controls")
showStrikeInHeader   = input.bool(true, "Show Strike Prices in Column Headers", group="Display Controls")
showDetailedValues   = input.bool(true, "Show Exact Numeric Values (vs Just 'Above / Below')", group="Display Controls",
  tooltip="When checked, shows numeric values e.g. '24250.00 (Above)'. When unchecked, shows concise status e.g. 'Above'.")
showSignalsOnChart   = input.bool(true, "Plot Buy / Sell Signal Markers on Chart", group="Display Controls")
signalLookbackDays   = input.int(5, "Signal Marker Chart Lookback Days", minval=1, maxval=30, group="Display Controls",
  tooltip="Number of recent trading days to plot Buy/Sell signal markers on the chart.")
tablePosInput        = input.enum(TablePos.topRight, "Top Dashboard Position", group="Display Controls")

// --- Performance Table Controls ---
showPerfTable         = input.bool(true, "Show 5-Day Breakdown Performance Table", group="Last 5 Days Performance Table")
perfTablePosInput     = input.enum(TablePos.bottomRight, "Performance Table Position", group="Last 5 Days Performance Table")
tableTextSizeInput    = input.enum(TableSize.small, "Table Text Size", group="Display Controls")

// --- Styling & Colors ---
colorHeaderBg      = input.color(#1A237E, "Header Banner Background", group="Styling & Colors")
colorSectionBg     = input.color(#263238, "Section Banner Background", group="Styling & Colors")
colorCEColor       = input.color(#00E676, "CE / Bullish Accent Color", group="Styling & Colors")
colorPEColor       = input.color(#FF1744, "PE / Bearish Accent Color", group="Styling & Colors")
colorNeutralColor  = input.color(#FFD600, "Neutral Accent Color", group="Styling & Colors")
colorTotalColor    = input.color(#00E5FF, "Total / Consolidated Accent Color", group="Styling & Colors")

// ==========================================
// INSTRUMENT STRIKE STEP AUTO-DETECTION
// ==========================================

f_get_strike_step(float spot_price) =>
    float s = 50.0
    if na(spot_price) or spot_price <= 0
        s := 50.0
    else if spot_price < 100
        s := 1.0
    else if spot_price < 250
        s := 2.5
    else if spot_price < 500
        s := 5.0
    else if spot_price < 1200
        s := 10.0
    else if spot_price < 2500
        s := 20.0
    else if spot_price < 5000
        s := 50.0
    else
        s := 100.0
    s

f_calc_atm_strike(float spot_price, float step) =>
    math.round(spot_price / step) * step

f_is_digit(string c) =>
    str.contains("0123456789", c)

// Universal Option Ticker Parser to extract actual underlying & strike price from Option Symbols
f_parse_ticker() =>
    string cleanTicker = syminfo.ticker
    int colonPos = str.pos(cleanTicker, ":")
    if colonPos != -1
        cleanTicker := str.substring(cleanTicker, colonPos + 1)
    cleanTicker := str.replace_all(cleanTicker, " ", "")
    
    int tickerLen = str.length(cleanTicker)
    string parsed_root = syminfo.tickerid
    float parsed_strk = 0.0
    bool is_opt = false
    
    if tickerLen > 7
        int idx = tickerLen - 1
        string strike_str = ""
        while idx >= 0 and f_is_digit(str.substring(cleanTicker, idx, idx + 1))
            strike_str := str.substring(cleanTicker, idx, idx + 1) + strike_str
            idx := idx - 1
            
        if idx > 2 and str.length(strike_str) > 0
            string opt_char = str.substring(cleanTicker, idx, idx + 1)
            if opt_char == "C" or opt_char == "P" or opt_char == "E"
                parsed_strk := str.tonumber(strike_str)
                int exp_len = 5
                if idx >= 3 and f_is_digit(str.substring(cleanTicker, idx - 3, idx - 2))
                    exp_len := 6
                if idx >= exp_len
                    string root_name = str.substring(cleanTicker, 0, idx - exp_len)
                    parsed_root := syminfo.prefix + ":" + root_name
                    is_opt := true
    [is_opt, parsed_root, parsed_strk]

// ==========================================
// ANCHOR PRICES & MULTI-TIMEFRAME DATA
// ==========================================

[is_option_chart, underlying_spot_ticker, chart_parsed_strike] = f_parse_ticker()

// Live Underlying Spot Price Resolution
float chart_spot = close
if is_option_chart
    float fetched_spot = request.security(underlying_spot_ticker, timeframe.period, close, ignore_invalid_symbol=true)
    if not na(fetched_spot) and fetched_spot > 0
        chart_spot := fetched_spot

float eval_spot = chart_spot

// Intraday Day Open Anchor
var float day_open_spot = na
if session.isfirstbar and timeframe.isintraday
    day_open_spot := open
if na(day_open_spot)
    day_open_spot := request.security(is_option_chart ? underlying_spot_ticker : syminfo.tickerid, "D", open, ignore_invalid_symbol=true)

// Previous Day Close, High, Low
float prev_day_close = request.security(is_option_chart ? underlying_spot_ticker : syminfo.tickerid, "D", close[1], ignore_invalid_symbol=true)
float prev_day_high  = request.security(is_option_chart ? underlying_spot_ticker : syminfo.tickerid, "D", high[1],  ignore_invalid_symbol=true)
float prev_day_low   = request.security(is_option_chart ? underlying_spot_ticker : syminfo.tickerid, "D", low[1],   ignore_invalid_symbol=true)

if useOffHoursPrevClose and (na(eval_spot) or eval_spot <= 0 or not barstate.isrealtime)
    if not na(prev_day_close) and prev_day_close > 0
        eval_spot := prev_day_close

// First 5-Minute Candle Close of the day
var float first_5m_close_val = na
[f5_c, f5_is_first] = request.security(is_option_chart ? underlying_spot_ticker : syminfo.tickerid, "5", [close, session.isfirstbar], ignore_invalid_symbol=true)
if f5_is_first
    first_5m_close_val := f5_c
if na(first_5m_close_val)
    first_5m_close_val := day_open_spot

// 5-Min High & Low
[high_5m, low_5m] = request.security(is_option_chart ? underlying_spot_ticker : syminfo.tickerid, "5", [high, low], ignore_invalid_symbol=true)

// Fetch start timestamp of N days ago for chart signal gating
int lookback_idx = math.max(0, signalLookbackDays - 1)
float start_lookback_time = request.security(is_option_chart ? underlying_spot_ticker : syminfo.tickerid, "D", time[lookback_idx], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
bool is_within_last_5d = na(start_lookback_time) or time >= start_lookback_time

// Determine Static Reference Spot Price (Anchor: Day Open, Prev Close, or First 5m Close)
float ref_static_spot = switch staticAnchorInput
    StaticAnchor.dayOpen   => not na(day_open_spot) ? day_open_spot : eval_spot
    StaticAnchor.prevClose => not na(prev_day_close) ? prev_day_close : eval_spot
    StaticAnchor.first5m   => not na(first_5m_close_val) ? first_5m_close_val : eval_spot

// Strike Step Resolution
float strike_step = useAutoStrikeStep ? f_get_strike_step(eval_spot) : manualStrikeStep

// Actual Option Strike Calculations
float atm_strike = (is_option_chart and chart_parsed_strike > 0) ? chart_parsed_strike : f_calc_atm_strike(eval_spot, strike_step)
float itm_ce_strike = atm_strike - (offsetValInput * strike_step)
float otm_ce_strike = atm_strike + (offsetValInput * strike_step)

float itm_pe_strike = atm_strike + (offsetValInput * strike_step)
float otm_pe_strike = atm_strike - (offsetValInput * strike_step)

// ==========================================
// EXACT FORMULA IMPLEMENTATION (NON-NEGATIVE CLAMPED)
// ==========================================

// Baseline Time Value estimation derived from 14-period ATR
float base_tv_atm = ta.atr(14) * 0.5
if na(base_tv_atm) or base_tv_atm <= 0
    base_tv_atm := eval_spot * 0.005

// Calculation Helper for single option leg with strict non-negative clamping (math.max(0.0, ...))
f_calc_leg(float spot_p, float K, bool is_ce, float step_val, float base_tv) =>
    // Intrinsic Value (IV) - Clamped to 0 if negative
    float raw_iv = is_ce ? (spot_p - K) : (K - spot_p)
    float iv     = math.max(0.0, raw_iv)
    
    // Time Value (TV) decay distance from ATM - Clamped to 0 if negative
    float dist_steps = math.abs(K - f_calc_atm_strike(spot_p, step_val)) / step_val
    float tv         = math.max(0.0, base_tv * math.max(0.2, 1.0 - 0.25 * dist_steps))
    
    // Option Premium = Intrinsic Value + Time Value - Clamped to 0 if negative
    float opt_premium = math.max(0.0, iv + tv)
    
    // Time Value = Option Premium - Intrinsic Value (Clamped to 0 if negative)
    float tv_verified = math.max(0.0, opt_premium - iv)
    
    bool is_above = spot_p > K
    
    [opt_premium, iv, tv_verified, is_above]

// --- Calculate Realtime Leg Values ---
[atm_ce_premium_rt, atm_ce_iv_rt, atm_ce_tv_rt, atm_ce_above] = f_calc_leg(eval_spot, atm_strike, true, strike_step, base_tv_atm)
[atm_pe_premium_rt, atm_pe_iv_rt, atm_pe_tv_rt, atm_pe_above] = f_calc_leg(eval_spot, atm_strike, false, strike_step, base_tv_atm)

[itm_ce_premium_rt, itm_ce_iv_rt, itm_ce_tv_rt, itm_ce_above] = f_calc_leg(eval_spot, itm_ce_strike, true, strike_step, base_tv_atm)
[itm_pe_premium_rt, itm_pe_iv_rt, itm_pe_tv_rt, itm_pe_above] = f_calc_leg(eval_spot, itm_pe_strike, false, strike_step, base_tv_atm)

[otm_ce_premium_rt, otm_ce_iv_rt, otm_ce_tv_rt, otm_ce_above] = f_calc_leg(eval_spot, otm_ce_strike, true, strike_step, base_tv_atm)
[otm_pe_premium_rt, otm_pe_iv_rt, otm_pe_tv_rt, otm_pe_above] = f_calc_leg(eval_spot, otm_pe_strike, false, strike_step, base_tv_atm)

// --- Calculate Static Anchor Leg Values ---
[atm_ce_premium_st, atm_ce_iv_st, atm_ce_tv_st, atm_ce_above_st] = f_calc_leg(ref_static_spot, atm_strike, true, strike_step, base_tv_atm)
[atm_pe_premium_st, atm_pe_iv_st, atm_pe_tv_st, atm_pe_above_st] = f_calc_leg(ref_static_spot, atm_strike, false, strike_step, base_tv_atm)

[itm_ce_premium_st, itm_ce_iv_st, itm_ce_tv_st, itm_ce_above_st] = f_calc_leg(ref_static_spot, itm_ce_strike, true, strike_step, base_tv_atm)
[itm_pe_premium_st, itm_pe_iv_st, itm_pe_tv_st, itm_pe_above_st] = f_calc_leg(ref_static_spot, itm_pe_strike, false, strike_step, base_tv_atm)

[otm_ce_premium_st, otm_ce_iv_st, otm_ce_tv_st, otm_ce_above_st] = f_calc_leg(ref_static_spot, otm_ce_strike, true, strike_step, base_tv_atm)
[otm_pe_premium_st, otm_pe_iv_st, otm_pe_tv_st, otm_pe_above_st] = f_calc_leg(ref_static_spot, otm_pe_strike, false, strike_step, base_tv_atm)

// --- Real Break-Even Prices (BEP) on Price Scale ---
// For Call (CE): BEP = Strike + CE Premium
// For Put (PE): BEP = Strike - PE Premium
float atm_ce_bep_rt = math.max(0.0, atm_strike + atm_ce_premium_rt)
float atm_pe_bep_rt = math.max(0.0, atm_strike - atm_pe_premium_rt)

float itm_ce_bep_rt = math.max(0.0, itm_ce_strike + itm_ce_premium_rt)
float itm_pe_bep_rt = math.max(0.0, itm_pe_strike - itm_pe_premium_rt)

float otm_ce_bep_rt = math.max(0.0, otm_ce_strike + otm_ce_premium_rt)
float otm_pe_bep_rt = math.max(0.0, otm_pe_strike - otm_pe_premium_rt)

float atm_ce_bep_st = math.max(0.0, atm_strike + atm_ce_premium_st)
float atm_pe_bep_st = math.max(0.0, atm_strike - atm_pe_premium_st)

float itm_ce_bep_st = math.max(0.0, itm_ce_strike + itm_ce_premium_st)
float itm_pe_bep_st = math.max(0.0, itm_pe_strike - itm_pe_premium_st)

float otm_ce_bep_st = math.max(0.0, otm_ce_strike + otm_ce_premium_st)
float otm_pe_bep_st = math.max(0.0, otm_pe_strike - otm_pe_premium_st)

// Paired Average BEP levels for Signal cross evaluation
float atm_bep_rt  = math.max(0.0, (atm_ce_premium_rt + atm_pe_premium_rt) / 2.0)
float itm1_bep_rt = math.max(0.0, (itm_ce_premium_rt + otm_pe_premium_rt) / 2.0)
float otm1_bep_rt = math.max(0.0, (otm_ce_premium_rt + itm_pe_premium_rt) / 2.0)

// High & Low Reference Values
float ref_high = math.max(0.0, highLowSrcInput == HighLowSource.min5 ? (not na(high_5m) ? high_5m : high) : (not na(prev_day_high) ? prev_day_high : high))
float ref_low  = math.max(0.0, highLowSrcInput == HighLowSource.min5 ? (not na(low_5m) ? low_5m : low) : (not na(prev_day_low) ? prev_day_low : low))

// ==========================================
// CONSOLIDATED BUY / SELL SIGNAL ENGINE
// ==========================================

// Top-Level Unconditional Crossover & Crossunder Series Calculations
bool ce_cross_bep_raw    = ta.crossover(eval_spot, atm_bep_rt)
bool ce_cross_strike_raw = ta.crossover(eval_spot, atm_strike)
bool pe_cross_bep_raw    = ta.crossunder(eval_spot, atm_bep_rt)
bool pe_cross_strike_raw = ta.crossunder(eval_spot, atm_strike)

bool atm_ce_cross_bep = ce_cross_bep_raw or ce_cross_strike_raw
bool atm_pe_cross_bep = pe_cross_bep_raw or pe_cross_strike_raw

// 2. Standard Buy CE Conditions:
bool buy_ce_cond = atm_ce_cross_bep and (itm_ce_premium_rt > itm_ce_iv_rt) and (itm_pe_premium_rt < itm_pe_iv_rt) and (otm_ce_premium_rt < otm_ce_tv_rt) and (otm_pe_premium_rt > otm_pe_tv_rt)

// 3. Standard Buy PE Conditions:
bool buy_pe_cond = atm_pe_cross_bep and (itm_pe_premium_rt > itm_pe_iv_rt) and (itm_ce_premium_rt < itm_ce_iv_rt) and (otm_ce_premium_rt < otm_ce_tv_rt) and (otm_pe_premium_rt > otm_pe_tv_rt)

// 4. Strong Buy CE Conditions:
bool spot_strong_ce = (eval_spot > prev_day_low) and (eval_spot > day_open_spot)
bool ce_atm_strong  = (atm_ce_premium_rt > day_open_spot) and (atm_ce_premium_rt > prev_day_low)
bool pe_atm_strong  = (atm_pe_premium_rt < prev_day_high) and (atm_pe_premium_rt < day_open_spot)

bool strong_buy_ce_cond = buy_ce_cond and spot_strong_ce and ce_atm_strong and pe_atm_strong

// 5. Strong Buy PE Conditions:
bool spot_strong_pe = (eval_spot < prev_day_high) and (eval_spot < day_open_spot)
bool ce_atm_strong_pe = (atm_ce_premium_rt < day_open_spot) and (atm_ce_premium_rt < prev_day_high)
bool pe_atm_strong_pe = (atm_pe_premium_rt > prev_day_low) and (atm_pe_premium_rt > day_open_spot)

bool strong_buy_pe_cond = buy_pe_cond and spot_strong_pe and ce_atm_strong_pe and pe_atm_strong_pe

// Separate Standard vs Strong Signals
bool signal_std_buy_ce    = buy_ce_cond and not strong_buy_ce_cond
bool signal_std_buy_pe    = buy_pe_cond and not strong_buy_pe_cond
bool signal_strong_buy_ce = strong_buy_ce_cond
bool signal_strong_buy_pe = strong_buy_pe_cond

// Final Signal Classification
string signalText    = "NEUTRAL 🟡"
color  signalBg      = color.black
color  signalTxtColor= colorNeutralColor

if strong_buy_ce_cond
    signalText    := "STRONG BUY CE 🚀"
    signalBg      := #00C853
    signalTxtColor:= color.white
else if buy_ce_cond
    signalText    := "BUY CE 🟢"
    signalBg      := #00E676
    signalTxtColor:= color.black
else if strong_buy_pe_cond
    signalText    := "STRONG BUY PE 💥"
    signalBg      := #D50000
    signalTxtColor:= color.white
else if buy_pe_cond
    signalText    := "BUY PE 🔴"
    signalBg      := #FF1744
    signalTxtColor:= color.white

// Chart Signal Plot Shapes (Gated to Last 5 Days & Display Controls)
bool plot_signal_gate = showSignalsOnChart and is_within_last_5d

plotshape(plot_signal_gate and signal_strong_buy_ce, title="Strong Buy CE Signal", style=shape.arrowup, location=location.belowbar, color=#00C853, text="STRONG CE 🚀", textcolor=color.white, size=size.normal)
plotshape(plot_signal_gate and signal_std_buy_ce,    title="Buy CE Signal",        style=shape.triangleup, location=location.belowbar, color=#00E676, text="BUY CE 🟢", textcolor=color.white, size=size.small)

plotshape(plot_signal_gate and signal_strong_buy_pe, title="Strong Buy PE Signal", style=shape.arrowdown, location=location.abovebar, color=#D50000, text="STRONG PE 💥", textcolor=color.white, size=size.normal)
plotshape(plot_signal_gate and signal_std_buy_pe,    title="Buy PE Signal",        style=shape.triangledown, location=location.abovebar, color=#FF1744, text="BUY PE 🔴", textcolor=color.white, size=size.small)

// ==========================================
// LAST 5 DAYS SWING PERFORMANCE TRACKER
// ==========================================

bool is_new_day = ta.change(time("D")) != 0

// Daily Performance Buckets for Last 5 Days (D0 = Today, D1 = Prev, D2, D3, D4)
var int[] std_alerts_5d    = array.new_int(5, 0)
var int[] strong_alerts_5d = array.new_int(5, 0)
var float[] pts_5d         = array.new_float(5, 0.0)
var int[] profit_5d        = array.new_int(5, 0)
var int[] loss_5d          = array.new_int(5, 0)

// Active Trade Swing State Variables
var int active_signal_type = 0 // 0=None, 1=Std CE, 2=Std PE, 3=Strong CE, 4=Strong PE
var float entry_price      = 0.0
var float swing_max_fav    = 0.0

// Day Change Array Bucket Shifting
if is_new_day
    for i = 4 to 1
        array.set(std_alerts_5d, i, array.get(std_alerts_5d, i - 1))
        array.set(strong_alerts_5d, i, array.get(strong_alerts_5d, i - 1))
        array.set(pts_5d, i, array.get(pts_5d, i - 1))
        array.set(profit_5d, i, array.get(profit_5d, i - 1))
        array.set(loss_5d, i, array.get(loss_5d, i - 1))
        
    array.set(std_alerts_5d, 0, 0)
    array.set(strong_alerts_5d, 0, 0)
    array.set(pts_5d, 0, 0.0)
    array.set(profit_5d, 0, 0)
    array.set(loss_5d, 0, 0)

// Trigger Detection
bool has_new_signal = signal_std_buy_ce or signal_std_buy_pe or signal_strong_buy_ce or signal_strong_buy_pe

// Finalize Active Swing & Record Metrics into Today's Bucket (Index 0)
if has_new_signal or (is_new_day and active_signal_type != 0)
    if active_signal_type != 0
        float pts_gained = 0.0
        if active_signal_type == 1 or active_signal_type == 3 // Bullish CE
            pts_gained := math.max(0.0, swing_max_fav - entry_price)
        else if active_signal_type == 2 or active_signal_type == 4 // Bearish PE
            pts_gained := math.max(0.0, entry_price - swing_max_fav)
            
        bool is_profit = pts_gained > 0.0
        
        array.set(pts_5d, 0, array.get(pts_5d, 0) + math.max(0.0, pts_gained))
        
        if active_signal_type == 1 or active_signal_type == 2 // Standard Buy
            array.set(std_alerts_5d, 0, array.get(std_alerts_5d, 0) + 1)
        else if active_signal_type == 3 or active_signal_type == 4 // Strong Buy
            array.set(strong_alerts_5d, 0, array.get(strong_alerts_5d, 0) + 1)

        if is_profit
            array.set(profit_5d, 0, array.get(profit_5d, 0) + 1)
        else
            array.set(loss_5d, 0, array.get(loss_5d, 0) + 1)

    // Initialize New Swing Trade State
    if signal_strong_buy_ce
        active_signal_type := 3
        entry_price        := eval_spot
        swing_max_fav      := high
    else if signal_strong_buy_pe
        active_signal_type := 4
        entry_price        := eval_spot
        swing_max_fav      := low
    else if signal_std_buy_ce
        active_signal_type := 1
        entry_price        := eval_spot
        swing_max_fav      := high
    else if signal_std_buy_pe
        active_signal_type := 2
        entry_price        := eval_spot
        swing_max_fav      := low
    else
        active_signal_type := 0

// Track Maximum Price Expansion during Active Swing
if active_signal_type == 1 or active_signal_type == 3 // Bullish CE
    swing_max_fav := math.max(swing_max_fav, high)
else if active_signal_type == 2 or active_signal_type == 4 // Bearish PE
    swing_max_fav := math.min(swing_max_fav, low)

// ==========================================
// RENDER TABLES (ULTRA COMPACT DESIGN)
// ==========================================

f_get_table_pos(TablePos pos) =>
    switch pos
        TablePos.topRight    => position.top_right
        TablePos.topLeft     => position.top_left
        TablePos.bottomRight => position.bottom_right
        TablePos.bottomLeft  => position.bottom_left

f_get_table_text_size(TableSize sz) =>
    switch sz
        TableSize.auto   => size.auto
        TableSize.tiny   => size.tiny
        TableSize.small  => size.small
        TableSize.normal => size.normal
        TableSize.large  => size.large

var table summaryTbl = table.new(f_get_table_pos(tablePosInput), 7, 11, bgcolor=color.black, border_color=color.gray, border_width=1, force_overlay=true)
var table perfTbl    = table.new(f_get_table_pos(perfTablePosInput), 7, 7, bgcolor=color.black, border_color=color.gray, border_width=1, force_overlay=true)

string curTextSize = f_get_table_text_size(tableTextSizeInput)

// Helper formatting function for top table cells based on showDetailedValues mode (Clamped to >= 0)
f_fmt_val_cell(float numVal, bool condition, string trueTxt, string falseTxt) =>
    float safeVal = math.max(0.0, numVal)
    if showDetailedValues
        str.tostring(safeVal, "#.##") + " (" + (condition ? trueTxt : falseTxt) + ")"
    else
        condition ? trueTxt : falseTxt

if barstate.islast
    // --- Render Top Analytics Dashboard Table ---
    if not showSummaryTable
        table.delete(summaryTbl)
    else
        // Row 0: Column Headers displaying Selected Actual Strike Prices
        string atm_ce_hdr = showStrikeInHeader ? "ATM CE (" + str.tostring(atm_strike, "#.##") + ")" : "ATM CE"
        string atm_pe_hdr = showStrikeInHeader ? "ATM PE (" + str.tostring(atm_strike, "#.##") + ")" : "ATM PE"
        string itm_ce_hdr = showStrikeInHeader ? "ITM CE (" + str.tostring(itm_ce_strike, "#.##") + ")" : "ITM CE"
        string itm_pe_hdr = showStrikeInHeader ? "ITM PE (" + str.tostring(itm_pe_strike, "#.##") + ")" : "ITM PE"
        string otm_ce_hdr = showStrikeInHeader ? "OTM CE (" + str.tostring(otm_ce_strike, "#.##") + ")" : "OTM CE"
        string otm_pe_hdr = showStrikeInHeader ? "OTM PE (" + str.tostring(otm_pe_strike, "#.##") + ")" : "OTM PE"

        table.cell(summaryTbl, 0, 0, "TF Options Analytics", bgcolor=colorHeaderBg, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 0, atm_ce_hdr, bgcolor=colorHeaderBg, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 0, atm_pe_hdr, bgcolor=colorHeaderBg, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 0, itm_ce_hdr, bgcolor=colorHeaderBg, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 4, 0, itm_pe_hdr, bgcolor=colorHeaderBg, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 5, 0, otm_ce_hdr, bgcolor=colorHeaderBg, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 6, 0, otm_pe_hdr, bgcolor=colorHeaderBg, text_color=colorPEColor, text_size=curTextSize)

        // Row 1: Price vs Strike
        table.cell(summaryTbl, 0, 1, "Price vs Strike", bgcolor=colorSectionBg, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 1, atm_ce_above ? "Above" : "Below", bgcolor=color.black, text_color=atm_ce_above ? colorCEColor : colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 1, atm_pe_above ? "Above" : "Below", bgcolor=color.black, text_color=atm_pe_above ? colorCEColor : colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 1, itm_ce_above ? "Above" : "Below", bgcolor=color.black, text_color=itm_ce_above ? colorCEColor : colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 4, 1, itm_pe_above ? "Above" : "Below", bgcolor=color.black, text_color=itm_pe_above ? colorCEColor : colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 5, 1, otm_ce_above ? "Above" : "Below", bgcolor=color.black, text_color=otm_ce_above ? colorCEColor : colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 6, 1, otm_pe_above ? "Above" : "Below", bgcolor=color.black, text_color=otm_pe_above ? colorCEColor : colorPEColor, text_size=curTextSize)

        // Row 2: Realtime BEP (RT BEP) - Real Break-Even Price Level (CE: Strike + Premium, PE: Strike - Premium)
        table.cell(summaryTbl, 0, 2, "RT BEP", bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 2, f_fmt_val_cell(atm_ce_bep_rt, eval_spot > atm_ce_bep_rt, "Above", "Below"), bgcolor=color.black, text_color=eval_spot > atm_ce_bep_rt ? colorCEColor : colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 2, f_fmt_val_cell(atm_pe_bep_rt, eval_spot < atm_pe_bep_rt, "Below", "Above"), bgcolor=color.black, text_color=eval_spot < atm_pe_bep_rt ? colorPEColor : colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 2, f_fmt_val_cell(itm_ce_bep_rt, eval_spot > itm_ce_bep_rt, "Above", "Below"), bgcolor=color.black, text_color=eval_spot > itm_ce_bep_rt ? colorCEColor : colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 4, 2, f_fmt_val_cell(itm_pe_bep_rt, eval_spot < itm_pe_bep_rt, "Below", "Above"), bgcolor=color.black, text_color=eval_spot < itm_pe_bep_rt ? colorPEColor : colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 5, 2, f_fmt_val_cell(otm_ce_bep_rt, eval_spot > otm_ce_bep_rt, "Above", "Below"), bgcolor=color.black, text_color=eval_spot > otm_ce_bep_rt ? colorCEColor : colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 6, 2, f_fmt_val_cell(otm_pe_bep_rt, eval_spot < otm_pe_bep_rt, "Below", "Above"), bgcolor=color.black, text_color=eval_spot < otm_pe_bep_rt ? colorPEColor : colorCEColor, text_size=curTextSize)

        // Row 3: Static BEP (ST BEP) - Real Static Break-Even Price Level (CE: Strike + Premium, PE: Strike - Premium)
        table.cell(summaryTbl, 0, 3, "ST BEP", bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 3, f_fmt_val_cell(atm_ce_bep_st, eval_spot > atm_ce_bep_st, "Above", "Below"), bgcolor=color.black, text_color=eval_spot > atm_ce_bep_st ? colorCEColor : colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 3, f_fmt_val_cell(atm_pe_bep_st, eval_spot < atm_pe_bep_st, "Below", "Above"), bgcolor=color.black, text_color=eval_spot < atm_pe_bep_st ? colorPEColor : colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 3, f_fmt_val_cell(itm_ce_bep_st, eval_spot > itm_ce_bep_st, "Above", "Below"), bgcolor=color.black, text_color=eval_spot > itm_ce_bep_st ? colorCEColor : colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 4, 3, f_fmt_val_cell(itm_pe_bep_st, eval_spot < itm_pe_bep_st, "Below", "Above"), bgcolor=color.black, text_color=eval_spot < itm_pe_bep_st ? colorPEColor : colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 5, 3, f_fmt_val_cell(otm_ce_bep_st, eval_spot > otm_ce_bep_st, "Above", "Below"), bgcolor=color.black, text_color=eval_spot > otm_ce_bep_st ? colorCEColor : colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 6, 3, f_fmt_val_cell(otm_pe_bep_st, eval_spot < otm_pe_bep_st, "Below", "Above"), bgcolor=color.black, text_color=eval_spot < otm_pe_bep_st ? colorPEColor : colorCEColor, text_size=curTextSize)

        // Row 4: Static IV (ST IV) - CE = max(0, Spot - K), PE = max(0, K - Spot)
        table.cell(summaryTbl, 0, 4, "ST IV", bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 4, str.tostring(math.max(0.0, atm_ce_iv_st), "#.##"), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 4, str.tostring(math.max(0.0, atm_pe_iv_st), "#.##"), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 4, str.tostring(math.max(0.0, itm_ce_iv_st), "#.##"), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 4, 4, str.tostring(math.max(0.0, itm_pe_iv_st), "#.##"), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 5, 4, str.tostring(math.max(0.0, otm_ce_iv_st), "#.##"), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 6, 4, str.tostring(math.max(0.0, otm_pe_iv_st), "#.##"), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)

        // Row 5: Static TV (ST TV) = Option Premium - Intrinsic Value
        table.cell(summaryTbl, 0, 5, "ST TV", bgcolor=color.black, text_color=colorNeutralColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 5, str.tostring(math.max(0.0, atm_ce_tv_st), "#.##"), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 5, str.tostring(math.max(0.0, atm_pe_tv_st), "#.##"), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 5, str.tostring(math.max(0.0, itm_ce_tv_st), "#.##"), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 4, 5, str.tostring(math.max(0.0, itm_pe_tv_st), "#.##"), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 5, 5, str.tostring(math.max(0.0, otm_ce_tv_st), "#.##"), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 6, 5, str.tostring(math.max(0.0, otm_pe_tv_st), "#.##"), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)

        // Row 6: Realtime IV (RT IV) = CE max(0, Spot - K) / PE max(0, K - Spot)
        table.cell(summaryTbl, 0, 6, "RT IV", bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 6, str.tostring(math.max(0.0, atm_ce_iv_rt), "#.##"), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 6, str.tostring(math.max(0.0, atm_pe_iv_rt), "#.##"), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 6, str.tostring(math.max(0.0, itm_ce_iv_rt), "#.##"), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 4, 6, str.tostring(math.max(0.0, itm_pe_iv_rt), "#.##"), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 5, 6, str.tostring(math.max(0.0, otm_ce_iv_rt), "#.##"), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 6, 6, str.tostring(math.max(0.0, otm_pe_iv_rt), "#.##"), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)

        // Row 7: Realtime TV (RT TV) = Option Premium - Intrinsic Value
        table.cell(summaryTbl, 0, 7, "RT TV", bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        table.cell(summaryTbl, 1, 7, str.tostring(math.max(0.0, atm_ce_tv_rt), "#.##"), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 7, str.tostring(math.max(0.0, atm_pe_tv_rt), "#.##"), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 3, 7, str.tostring(math.max(0.0, itm_ce_tv_rt), "#.##"), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 4, 7, str.tostring(math.max(0.0, itm_pe_tv_rt), "#.##"), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)
        table.cell(summaryTbl, 5, 7, str.tostring(math.max(0.0, otm_ce_tv_rt), "#.##"), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(summaryTbl, 6, 7, str.tostring(math.max(0.0, otm_pe_tv_rt), "#.##"), bgcolor=color.black, text_color=colorPEColor, text_size=curTextSize)

        // Row 8: Option High & Low Reference (Ref H/L)
        table.cell(summaryTbl, 0, 8, "Ref H/L", bgcolor=colorSectionBg, text_color=color.white, text_size=curTextSize)
        string hl_val = str.tostring(math.max(0.0, ref_high), "#.##") + " / " + str.tostring(math.max(0.0, ref_low), "#.##")
        table.cell(summaryTbl, 1, 8, hl_val, bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTbl, 2, 8, hl_val, bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTbl, 3, 8, hl_val, bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTbl, 4, 8, hl_val, bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTbl, 5, 8, hl_val, bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(summaryTbl, 6, 8, hl_val, bgcolor=color.black, text_color=color.silver, text_size=curTextSize)

        // Row 9 & 10: Signal Status Row
        table.cell(summaryTbl, 0, 9, "--- BUY / SELL SIGNAL ---", bgcolor=colorSectionBg, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 9, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 2, 9, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 3, 9, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 4, 9, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 5, 9, "", bgcolor=colorSectionBg)
        table.cell(summaryTbl, 6, 9, "", bgcolor=colorSectionBg)

        table.cell(summaryTbl, 0, 10, "Signal Direction", bgcolor=color.black, text_color=color.white, text_size=curTextSize)
        table.cell(summaryTbl, 1, 10, signalText, bgcolor=signalBg, text_color=signalTxtColor, text_size=curTextSize)
        table.cell(summaryTbl, 2, 10, "", bgcolor=signalBg)
        table.cell(summaryTbl, 3, 10, "", bgcolor=signalBg)
        table.cell(summaryTbl, 4, 10, "", bgcolor=signalBg)
        table.cell(summaryTbl, 5, 10, "", bgcolor=signalBg)
        table.cell(summaryTbl, 6, 10, "", bgcolor=signalBg)

    // --- Render Ultra-Compact 5-Day Breakdown Performance Table ---
    if not showPerfTable
        table.delete(perfTbl)
    else
        // Row 0: Performance Table Header
        table.cell(perfTbl, 0, 0, "Last 5 Days Signals Performance", bgcolor=colorHeaderBg, text_color=color.white, text_size=curTextSize)
        table.cell(perfTbl, 1, 0, "Today (D1)", bgcolor=colorHeaderBg, text_color=color.yellow, text_size=curTextSize)
        table.cell(perfTbl, 2, 0, "D2", bgcolor=colorHeaderBg, text_color=color.white, text_size=curTextSize)
        table.cell(perfTbl, 3, 0, "D3", bgcolor=colorHeaderBg, text_color=color.silver, text_size=curTextSize)
        table.cell(perfTbl, 4, 0, "D4", bgcolor=colorHeaderBg, text_color=color.silver, text_size=curTextSize)
        table.cell(perfTbl, 5, 0, "D5", bgcolor=colorHeaderBg, text_color=color.gray, text_size=curTextSize)
        table.cell(perfTbl, 6, 0, "5D Total", bgcolor=colorHeaderBg, text_color=colorTotalColor, text_size=curTextSize)

        // Totals
        int tot_std_alerts    = array.sum(std_alerts_5d)
        int tot_strong_alerts = array.sum(strong_alerts_5d)
        float tot_pts         = math.max(0.0, array.sum(pts_5d))
        int tot_prof          = array.sum(profit_5d)
        int tot_loss          = array.sum(loss_5d)

        // Row 1: Standard Buy Alerts
        table.cell(perfTbl, 0, 1, "Std Buy Alerts", bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        for i = 0 to 4
            table.cell(perfTbl, i + 1, 1, str.tostring(array.get(std_alerts_5d, i)), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        table.cell(perfTbl, 6, 1, str.tostring(tot_std_alerts), bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)

        // Row 2: Strong Buy Alerts
        table.cell(perfTbl, 0, 2, "Strong Buy Alerts", bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        for i = 0 to 4
            table.cell(perfTbl, i + 1, 2, str.tostring(array.get(strong_alerts_5d, i)), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        table.cell(perfTbl, 6, 2, str.tostring(tot_strong_alerts), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)

        // Row 3: Points Captured
        table.cell(perfTbl, 0, 3, "Pts Captured (Max)", bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        for i = 0 to 4
            table.cell(perfTbl, i + 1, 3, str.tostring(math.max(0.0, array.get(pts_5d, i)), "#.##"), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)
        table.cell(perfTbl, 6, 3, str.tostring(tot_pts, "#.##"), bgcolor=color.black, text_color=colorTotalColor, text_size=curTextSize)

        // Row 4: Profit / Loss Ratio
        table.cell(perfTbl, 0, 4, "Profit / Loss Entries", bgcolor=color.black, text_color=color.white, text_size=curTextSize)
        for i = 0 to 4
            string pl_str = str.tostring(array.get(profit_5d, i)) + " / " + str.tostring(array.get(loss_5d, i))
            table.cell(perfTbl, i + 1, 4, pl_str, bgcolor=color.black, text_color=color.silver, text_size=curTextSize)
        table.cell(perfTbl, 6, 4, str.tostring(tot_prof) + " / " + str.tostring(tot_loss), bgcolor=color.black, text_color=color.yellow, text_size=curTextSize)

        // Row 5: Win Rate (%)
        table.cell(perfTbl, 0, 5, "Win Rate (%)", bgcolor=colorSectionBg, text_color=color.white, text_size=curTextSize)
        for i = 0 to 4
            int total_day_entries = array.get(profit_5d, i) + array.get(loss_5d, i)
            float day_wr = total_day_entries > 0 ? (array.get(profit_5d, i) / float(total_day_entries)) * 100.0 : 0.0
            table.cell(perfTbl, i + 1, 5, str.tostring(math.max(0.0, day_wr), "#.#") + "%", bgcolor=color.black, text_color=colorCEColor, text_size=curTextSize)
        
        int overall_entries = tot_prof + tot_loss
        float overall_wr = overall_entries > 0 ? (tot_prof / float(overall_entries)) * 100.0 : 0.0
        table.cell(perfTbl, 6, 5, str.tostring(math.max(0.0, overall_wr), "#.#") + "%", bgcolor=colorSectionBg, text_color=color.yellow, text_size=curTextSize)
