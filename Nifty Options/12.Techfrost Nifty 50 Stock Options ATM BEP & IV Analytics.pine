StockAnalytics s50 = f_eval_nifty_stock_single("BAJAJFINSV", is_b2)

// Build Evaluated Stock List Array
array<StockAnalytics> stockList = array.new<StockAnalytics>()

if s1.enabled and not na(s1.spot_c)  => array.push(stockList, s1)
if s2.enabled and not na(s2.spot_c)  => array.push(stockList, s2)
if s3.enabled and not na(s3.spot_c)  => array.push(stockList, s3)
