StockAnalytics s46 = f_eval_nifty_stock_single("BEL",        is_b2)
StockAnalytics s47 = f_eval_nifty_stock_single("SHRIRAMFIN", is_b2)
StockAnalytics s48 = f_eval_nifty_stock_single("TRENT",      is_b2)
