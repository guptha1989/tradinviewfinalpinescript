StockAnalytics s27 = f_eval_nifty_stock_single("ADANIENT",   is_b2 or is_top)
StockAnalytics s28 = f_eval_nifty_stock_single("ADANIPORTS", is_b2 or is_top)
StockAnalytics s29 = f_eval_nifty_stock_single("COALINDIA",  is_b2 or is_top)
StockAnalytics s30 = f_eval_nifty_stock_single("CIPLA",      is_b2 or is_top)
StockAnalytics s31 = f_eval_nifty_stock_single("DRREDDY",    is_b2 or is_top)
StockAnalytics s32 = f_eval_nifty_stock_single("GRASIM",     is_b2 or is_top)
StockAnalytics s33 = f_eval_nifty_stock_single("EICHERMOT",  is_b2 or is_top)
StockAnalytics s34 = f_eval_nifty_stock_single("HEROMOTOCO", is_b2 or is_top)
StockAnalytics s35 = f_eval_nifty_stock_single("HDFCLIFE",   is_b2 or is_top)
StockAnalytics s36 = f_eval_nifty_stock_single("SBILIFE",    is_b2)
StockAnalytics s37 = f_eval_nifty_stock_single("DIVISLAB",   is_b2)
StockAnalytics s38 = f_eval_nifty_stock_single("HINDALCO",   is_b2)
StockAnalytics s39 = f_eval_nifty_stock_single("BPCL",       is_b2)
StockAnalytics s40 = f_eval_nifty_stock_single("ONGC",       is_b2)
StockAnalytics s41 = f_eval_nifty_stock_single("JSWSTEEL",   is_b2)
