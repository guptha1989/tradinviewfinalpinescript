//@version=6
indicator("Techfrost Intrinsic Time Value and BEP Analytics", shorttitle="TF IVTVBEP", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500, precision=2)

// ==========================================
// ENUMS & INPUTS
// ==========================================

enum UnderlyingAsset
    auto      = "Auto-Detect"
    nifty     = "NIFTY"
    banknifty = "BANKNIFTY"
    crudeoil  = "CRUDEOIL"
    gold      = "GOLD"
    stock     = "Stock (Equity)"

enum OptionType
    auto = "Auto-Detect"
    ce   = "Call (CE)"
    pe   = "Put (PE)"

enum StrikeMode
    atm  = "ATM (At The Money)"
    itm  = "ITM (In The Money)"
    otm  = "OTM (Out of The Money)"
    both = "Both ITM & OTM"

enum OffsetChoice
    offset5   = "5 Points"
    offset10  = "10 Points"
    offset15  = "15 Points"
    offset20  = "20 Points"
    offset25  = "25 Points"
    offset40  = "40 Points"
    offset50  = "50 Points"
    offset100 = "100 Points"
    offset150 = "150 Points"
    offset200 = "200 Points"

enum StaticBasis
    dayOpen   = "Day Open Price (9:15 AM Open)"
    prevClose = "Previous Day Close / Settlement Price"
    first5Min = "First 5 Min Candle Close"

enum TimeValueFormula
    standard = "Option Price - Intrinsic Value"
    custom   = "Strike Price - Intrinsic Value"

// --- Instrument Settings ---
underlyingInput    = input.enum(UnderlyingAsset.auto, "Underlying Asset", group="Instrument Settings")
optionTypeInput    = input.enum(OptionType.auto, "Option Type", group="Instrument Settings")
manualStrikeInput  = input.int(0, "Manual Strike Selection (0 = Auto)", minval=0, group="Instrument Settings",
  tooltip="Enter strike price manually (e.g. 24000). Leave at 0 to auto-detect from chart symbol.")
spotTickerOverride = input.symbol("", "Spot Symbol Override (e.g. NSE:RELIANCE)", group="Instrument Settings")
strikeOverride     = input.float(0.0, "Strike Price Override", minval=0.0, group="Instrument Settings")

// --- Strike & Calculation Basis Settings ---
strikeModeInput       = input.enum(StrikeMode.atm, "Strike Selection Mode", group="Calculation Settings",
  tooltip="Choose whether to calculate metrics for ATM, ITM, OTM, or Both ITM & OTM strikes relative to selected chart option.")
offsetChoiceInput     = input.enum(OffsetChoice.offset100, "Strike Offset Points", group="Calculation Settings",
  tooltip="Offset points used to determine ITM / OTM strike levels (e.g. 50, 100, 150, 200).")
staticBasisInput      = input.enum(StaticBasis.dayOpen, "Static Values Calculation Basis", group="Calculation Settings",
  tooltip="Basis for Static Intrinsic, Static Time Value, and Static BEP: Day Open, Previous Day Close, or First 5 Min Close.")
timeValueFormulaInput = input.enum(TimeValueFormula.standard, "Time Value Formula", group="Calculation Settings",
  tooltip="Formula for Time Value: Option Price - Intrinsic Value OR Strike Price - Intrinsic Value.")

// --- Plot Controls: Realtime Metrics ---
showCE_IV_RT_Input     = input.bool(true, "Show CE Realtime Intrinsic Line", group="Realtime Plots")
showPE_IV_RT_Input     = input.bool(true, "Show PE Realtime Intrinsic Line", group="Realtime Plots")
showAvg_IV_RT_Input    = input.bool(true, "Show Avg Realtime Intrinsic Line", group="Realtime Plots")

showCE_TV_RT_Input     = input.bool(true, "Show CE Realtime Time Value Line", group="Realtime Plots")
showPE_TV_RT_Input     = input.bool(true, "Show PE Realtime Time Value Line", group="Realtime Plots")
showAvg_TV_RT_Input    = input.bool(true, "Show Avg Realtime Time Value Line", group="Realtime Plots")

showPD_CE_CloseInput   = input.bool(true, "Show CE Prev Day Close Line", group="Previous Day Close Plots")
showPD_PE_CloseInput   = input.bool(true, "Show PE Prev Day Close Line", group="Previous Day Close Plots")

// --- Plot Controls: 5-Day Static & Candle Overlays ---
show5D_Static_CE_IV    = input.bool(true, "Show 5-Day Static CE Intrinsic Lines", group="5-Day Static Plots")
show5D_Static_PE_IV    = input.bool(true, "Show 5-Day Static PE Intrinsic Lines", group="5-Day Static Plots")
show5D_Static_Avg_IV   = input.bool(true, "Show 5-Day Static Avg Intrinsic Lines", group="5-Day Static Plots")

show5D_Static_CE_TV    = input.bool(true, "Show 5-Day Static CE Time Value Lines", group="5-Day Static Plots")
show5D_Static_PE_TV    = input.bool(true, "Show 5-Day Static PE Time Value Lines", group="5-Day Static Plots")
show5D_Static_Avg_TV   = input.bool(true, "Show 5-Day Static Avg Time Value Lines", group="5-Day Static Plots")

show5D_Static_BEPInput = input.bool(true, "Show 5-Day Static BEP Level Lines", group="5-Day Static Plots")

showITMCandlesInput    = input.bool(true, "Show ITM Option Candles Overlay", group="Candle Overlay Plots")
showOTMCandlesInput    = input.bool(true, "Show OTM Option Candles Overlay", group="Candle Overlay Plots")
showOppCandlesInput    = input.bool(true, "Show Opposite Option Candles Overlay", group="Candle Overlay Plots")

showSignalPlotsInput   = input.bool(true, "Show Buy / Sell Signal Shapes", group="Display Controls")
showTableInput         = input.bool(true, "Show Summary Dashboard Table", group="Display Controls")
tableDisplayMode       = input.string("Today Only", "Table Display Mode", options=["Today Only", "5-Day Matrix"], group="Display Controls")
tablePosInput          = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Display Controls")
tableTextSizeInput     = input.string("Small", "Table Text Size", options=["Auto", "Tiny", "Small", "Normal", "Large"], group="Display Controls")

// Candle Overlays Formatting
colorITMBull      = input.color(color.new(#00E676, 50), "ITM Bullish Body", group="Candle Overlays Formatting")
colorITMBear      = input.color(color.new(#D50000, 50), "ITM Bearish Body", group="Candle Overlays Formatting")

colorOTMBull      = input.color(color.new(#00B0FF, 50), "OTM Bullish Body", group="Candle Overlays Formatting")
colorOTMBear      = input.color(color.new(#FF9100, 50), "OTM Bearish Body", group="Candle Overlays Formatting")

colorOppBull      = input.color(color.new(#2962FF, 40), "Opposite Bullish Body", group="Candle Overlays Formatting")
colorOppBear      = input.color(color.new(#FF6D00, 40), "Opposite Bearish Body", group="Candle Overlays Formatting")

// Signal Styling & Colors
colorSB_CE           = input.color(#00E676, "Strong Buy CE (SB CE) Arrow Color", group="Signal Styling & Colors")
colorSB_PE           = input.color(#FF1744, "Strong Buy PE (SB PE) Arrow Color", group="Signal Styling & Colors")
colorBuyCE           = input.color(#00E676, "Buy CE Crossover Arrow Color", group="Signal Styling & Colors")
colorBuyPE           = input.color(#FF1744, "Buy PE Crossover Arrow Color", group="Signal Styling & Colors")
colorSignalTextColor = input.color(color.white, "Signal Label Text Color", group="Signal Styling & Colors",
  tooltip="Color of signal text labels (SB CE, SB PE, BUY CE, BUY PE). Default is White for dark backgrounds.")

// ==========================================
// HELPER FUNCTIONS (GLOBAL SCOPE ONLY)
// ==========================================

f_is_digit(c) =>
    str.contains("0123456789", c)

f_fill_matrix_row(tbl, r_idx, label_str, v0, v1, v2, v3, v4, float v_rt, t_sz) =>
    float avg5d = (v0 + v1 + v2 + v3 + v4) / 5.0
    table.cell(tbl, 0, r_idx, label_str, bgcolor=#212121, text_color=color.white, text_size=t_sz)
    table.cell(tbl, 1, r_idx, str.tostring(v0, "#.##"), bgcolor=color.black, text_color=color.yellow, text_size=t_sz)
    table.cell(tbl, 2, r_idx, str.tostring(v1, "#.##"), bgcolor=color.black, text_color=color.white, text_size=t_sz)
    table.cell(tbl, 3, r_idx, str.tostring(v2, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=t_sz)
    table.cell(tbl, 4, r_idx, str.tostring(v3, "#.##"), bgcolor=color.black, text_color=color.silver, text_size=t_sz)
    table.cell(tbl, 5, r_idx, str.tostring(v4, "#.##"), bgcolor=color.black, text_color=color.gray, text_size=t_sz)
    table.cell(tbl, 6, r_idx, str.tostring(avg5d, "#.##"), bgcolor=#006064, text_color=color.aqua, text_size=t_sz)
    table.cell(tbl, 7, r_idx, na(v_rt) or v_rt <= 0 ? "N/A" : str.tostring(v_rt, "#.##"), bgcolor=#F57F17, text_color=color.yellow, text_size=t_sz)

f_fill_today_row(tbl, r_idx, label_str, v0, float v_rt, t_sz) =>
    table.cell(tbl, 0, r_idx, label_str, bgcolor=#212121, text_color=color.white, text_size=t_sz)
    table.cell(tbl, 1, r_idx, str.tostring(v0, "#.##"), bgcolor=color.black, text_color=color.yellow, text_size=t_sz)
    table.cell(tbl, 2, r_idx, na(v_rt) or v_rt <= 0 ? "N/A" : str.tostring(v_rt, "#.##"), bgcolor=#F57F17, text_color=color.yellow, text_size=t_sz)

// ==========================================
// TICKER PARSING & AUTO-DETECTION
// ==========================================

string cleanTicker = syminfo.ticker
int colonPos = str.pos(cleanTicker, ":")
if colonPos != -1
    cleanTicker := str.substring(cleanTicker, colonPos + 1)
cleanTicker := str.replace_all(cleanTicker, " ", "")

int tickerLen = str.length(cleanTicker)

// ----- Detect underlying -----
UnderlyingAsset actualUnderlying = na
if underlyingInput == UnderlyingAsset.auto
    if str.contains(cleanTicker, "BANKNIFTY")
        actualUnderlying := UnderlyingAsset.banknifty
    else if str.contains(cleanTicker, "NIFTY")
        actualUnderlying := UnderlyingAsset.nifty
    else if str.contains(cleanTicker, "CRUDEOIL")
        actualUnderlying := UnderlyingAsset.crudeoil
    else if str.contains(cleanTicker, "GOLD") and not str.contains(cleanTicker, "GOLDM") and not str.contains(cleanTicker, "GOLDPETAL")
        actualUnderlying := UnderlyingAsset.gold
    else if str.contains(cleanTicker, "GOLDM")
        actualUnderlying := UnderlyingAsset.gold
    else
        actualUnderlying := UnderlyingAsset.stock
else
    actualUnderlying := underlyingInput

// ----- Detect option type -----
bool isCall = false
bool isPut  = false

if optionTypeInput == OptionType.ce
    isCall := true
else if optionTypeInput == OptionType.pe
    isPut := true
else
    if str.contains(cleanTicker, "CE")
        isCall := true
    else if str.contains(cleanTicker, "PE")
        isPut := true
    else if str.match(cleanTicker, "C\\d+$") != ""
        isCall := true
    else if str.match(cleanTicker, "P\\d+$") != ""
        isPut := true

// ----- Strike extraction -----
float detectedStrike = na
string tickerWithoutCEPE = ""

if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
    tickerWithoutCEPE := str.substring(cleanTicker, 0, tickerLen - 2)

string matchC = str.match(cleanTicker, "C\\d+$")
string matchP = str.match(cleanTicker, "P\\d+$")

if matchC != ""
    detectedStrike := str.tonumber(str.substring(matchC, 1))
else if matchP != ""
    detectedStrike := str.tonumber(str.substring(matchP, 1))
else if tickerWithoutCEPE != ""
    string strikeDigits = str.match(tickerWithoutCEPE, "\\d+$")
    detectedStrike := str.tonumber(strikeDigits)

float chartStrikePrice = manualStrikeInput > 0 ? float(manualStrikeInput) : (strikeOverride > 0.0 ? strikeOverride : (not na(detectedStrike) ? detectedStrike : 24000.0))

// Universal Fail-Safe Option Ticker Construction
f_build_option_symbol(target_strike, target_is_ce) =>
    string st_digits = str.tostring(int(chartStrikePrice))
    int st_len = str.length(st_digits)
    
    if str.endswith(cleanTicker, "CE") or str.endswith(cleanTicker, "PE")
        int end_trim = 2
        string base_no_suffix = str.substring(cleanTicker, 0, str.length(cleanTicker) - end_trim)
        string pfx = str.substring(base_no_suffix, 0, str.length(base_no_suffix) - st_len)
        string sfx = target_is_ce ? "CE" : "PE"
        syminfo.prefix + ":" + pfx + str.tostring(target_strike) + sfx
    else if str.match(cleanTicker, "[CP]\\d+$") != ""
        string matchCP = str.match(cleanTicker, "[CP]\\d+$")
        int matchPos = str.pos(cleanTicker, matchCP)
        string pfx = str.substring(cleanTicker, 0, matchPos)
        string cp_letter = target_is_ce ? "C" : "P"
        syminfo.prefix + ":" + pfx + cp_letter + str.tostring(target_strike)
    else
        string rep_ticker = str.replace(cleanTicker, st_digits, str.tostring(target_strike))
        syminfo.prefix + ":" + rep_ticker

// ==========================================
// TARGET STRIKE SELECTION & CANDLE OVERLAYS
// ==========================================

int rawOffsetPts = switch offsetChoiceInput
    OffsetChoice.offset5   => 5
    OffsetChoice.offset10  => 10
    OffsetChoice.offset15  => 15
    OffsetChoice.offset20  => 20
    OffsetChoice.offset25  => 25
    OffsetChoice.offset40  => 40
    OffsetChoice.offset50  => 50
    OffsetChoice.offset100 => 100
    OffsetChoice.offset150 => 150
    OffsetChoice.offset200 => 200
    => 100
int offsetPts = (strikeModeInput == StrikeMode.atm) ? 0 : rawOffsetPts
int base_strike = int(chartStrikePrice)

// Resolve ITM & OTM strikes for Call & Put
int itm_ce_strike = base_strike - rawOffsetPts
int itm_pe_strike = base_strike + rawOffsetPts

int otm_ce_strike = base_strike + rawOffsetPts
int otm_pe_strike = base_strike - rawOffsetPts

int ce_strike = base_strike
int pe_strike = base_strike

if strikeModeInput == StrikeMode.itm
    ce_strike := itm_ce_strike
    pe_strike := itm_pe_strike
else if strikeModeInput == StrikeMode.otm
    ce_strike := otm_ce_strike
    pe_strike := otm_pe_strike
else if strikeModeInput == StrikeMode.both
    ce_strike := itm_ce_strike
    pe_strike := otm_pe_strike

// --- 1. ITM Candle Overlay ---
int current_itm_strike = isCall ? itm_ce_strike : itm_pe_strike
string itm_ticker = f_build_option_symbol(current_itm_strike, isCall)
[itm_o, itm_h, itm_l, itm_c] = request.security(itm_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)

bool itm_is_bull   = nz(itm_c) >= nz(itm_o)
color itm_body_col = itm_is_bull ? colorITMBull : colorITMBear
color itm_wick_col = itm_is_bull ? color.new(colorITMBull, 30) : color.new(colorITMBear, 30)

plotcandle(showITMCandlesInput ? itm_o : na,
           showITMCandlesInput ? itm_h : na,
           showITMCandlesInput ? itm_l : na,
           showITMCandlesInput ? itm_c : na,
           title="ITM Option Candle", color=itm_body_col, wickcolor=itm_wick_col, bordercolor=itm_wick_col)

// --- 2. OTM Candle Overlay ---
int current_otm_strike = isCall ? otm_ce_strike : otm_pe_strike
string otm_ticker = f_build_option_symbol(current_otm_strike, isCall)
[otm_o, otm_h, otm_l, otm_c] = request.security(otm_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)

bool otm_is_bull   = nz(otm_c) >= nz(otm_o)
color otm_body_col = otm_is_bull ? colorOTMBull : colorOTMBear
color otm_wick_col = otm_is_bull ? color.new(colorOTMBull, 30) : color.new(colorOTMBear, 30)

plotcandle(showOTMCandlesInput ? otm_o : na,
           showOTMCandlesInput ? otm_h : na,
           showOTMCandlesInput ? otm_l : na,
           showOTMCandlesInput ? otm_c : na,
           title="OTM Option Candle", color=otm_body_col, wickcolor=otm_wick_col, bordercolor=otm_wick_col)

// --- 3. Opposite Option Candle Overlay ---
string opp_ticker = f_build_option_symbol(base_strike, not isCall)
[opp_o, opp_h, opp_l, opp_c] = request.security(opp_ticker, timeframe.period, [open, high, low, close], ignore_invalid_symbol=true)

bool opp_is_bull   = nz(opp_c) >= nz(opp_o)
color opp_body_col = opp_is_bull ? colorOppBull : colorOppBear
color opp_wick_col = opp_is_bull ? color.new(colorOppBull, 30) : color.new(colorOppBear, 30)

plotcandle(showOppCandlesInput ? opp_o : na,
           showOppCandlesInput ? opp_h : na,
           showOppCandlesInput ? opp_l : na,
           showOppCandlesInput ? opp_c : na,
           title="Opposite Option Candle", color=opp_body_col, wickcolor=opp_wick_col, bordercolor=opp_wick_col)

// ==========================================
// 5-DAY HISTORICAL DATA FETCHING & PRICE RESOLUTION
// ==========================================

string spotTicker = ""
if str.length(spotTickerOverride) > 0
    spotTicker := spotTickerOverride
else
    if actualUnderlying == UnderlyingAsset.banknifty
        spotTicker := "NSE:BANKNIFTY"
    else if actualUnderlying == UnderlyingAsset.nifty
        spotTicker := "NSE:NIFTY"
    else if actualUnderlying == UnderlyingAsset.crudeoil
        spotTicker := "MCX:CRUDEOIL1!"
    else if actualUnderlying == UnderlyingAsset.gold
        spotTicker := "MCX:GOLD1!"
    else
        string rootGuess = str.match(cleanTicker, "^[A-Z&]+")
        spotTicker := syminfo.prefix + ":" + (rootGuess != "" ? rootGuess : cleanTicker)

string ce_ticker = f_build_option_symbol(ce_strike, true)
string pe_ticker = f_build_option_symbol(pe_strike, false)

// Fetch 5-Day Timestamps for Dates Header
[d0_t, d1_t, d2_t, d3_t, d4_t] = request.security(spotTicker, "D", [time[0], time[1], time[2], time[3], time[4]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

string date0_str = na(d0_t) ? "Today" : str.format("{0,date,dd-MMM}", d0_t)
string date1_str = na(d1_t) ? "T-1"   : str.format("{0,date,dd-MMM}", d1_t)
string date2_str = na(d2_t) ? "T-2"   : str.format("{0,date,dd-MMM}", d2_t)
string date3_str = na(d3_t) ? "T-3"   : str.format("{0,date,dd-MMM}", d3_t)
string date4_str = na(d4_t) ? "T-4"   : str.format("{0,date,dd-MMM}", d4_t)

// Fetch Previous Day Close (PDC) for CE & PE tickers across last 5 days
[ce_pdc0] = request.security(ce_ticker, "D", [close[1]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[ce_pdc1] = request.security(ce_ticker, "D", [close[2]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[ce_pdc2] = request.security(ce_ticker, "D", [close[3]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[ce_pdc3] = request.security(ce_ticker, "D", [close[4]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[ce_pdc4] = request.security(ce_ticker, "D", [close[5]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

[pe_pdc0] = request.security(pe_ticker, "D", [close[1]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_pdc1] = request.security(pe_ticker, "D", [close[2]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_pdc2] = request.security(pe_ticker, "D", [close[3]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_pdc3] = request.security(pe_ticker, "D", [close[4]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_pdc4] = request.security(pe_ticker, "D", [close[5]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Fetch 5-Day Reference Series based on staticBasisInput
f_get_5d_series() =>
    float p0 = staticBasisInput == StaticBasis.prevClose ? close[1] : (staticBasisInput == StaticBasis.first5Min ? open[0] : open[0])
    float p1 = staticBasisInput == StaticBasis.prevClose ? close[2] : (staticBasisInput == StaticBasis.first5Min ? open[1] : open[1])
    float p2 = staticBasisInput == StaticBasis.prevClose ? close[3] : (staticBasisInput == StaticBasis.first5Min ? open[2] : open[2])
    float p3 = staticBasisInput == StaticBasis.prevClose ? close[4] : (staticBasisInput == StaticBasis.first5Min ? open[3] : open[3])
    float p4 = staticBasisInput == StaticBasis.prevClose ? close[5] : (staticBasisInput == StaticBasis.first5Min ? open[4] : open[4])
    [p0, p1, p2, p3, p4]

[spot_r0, spot_r1, spot_r2, spot_r3, spot_r4] = request.security(spotTicker, "D", f_get_5d_series(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[ce_r0, ce_r1, ce_r2, ce_r3, ce_r4]           = request.security(ce_ticker, "D", f_get_5d_series(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
[pe_r0, pe_r1, pe_r2, pe_r3, pe_r4]           = request.security(pe_ticker, "D", f_get_5d_series(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// Fetch Live Realtime LTP
spot_ltp = request.security(spotTicker, timeframe.period, close, ignore_invalid_symbol=true)
ce_ltp   = request.security(ce_ticker, timeframe.period, close, ignore_invalid_symbol=true)
pe_ltp   = request.security(pe_ticker, timeframe.period, close, ignore_invalid_symbol=true)

spot_ltp := na(spot_ltp) ? chartStrikePrice : spot_ltp

// ==========================================
// 1. INTRINSIC VALUE CALCULATIONS (CE: max(0, Spot - Strike), PE: max(0, Strike - Spot))
// ==========================================

// Realtime Intrinsic Value (Live)
float ce_iv_rt  = math.max(0.0, spot_ltp - ce_strike)
float pe_iv_rt  = math.max(0.0, pe_strike - spot_ltp)
float avg_iv_rt = (ce_iv_rt + pe_iv_rt) / 2.0

// 5-Day Static Intrinsic Values (Day 0 to Day 4)
float ce_iv_d0 = math.max(0.0, spot_r0 - ce_strike)
float pe_iv_d0 = math.max(0.0, pe_strike - spot_r0)
float avg_iv_d0 = (ce_iv_d0 + pe_iv_d0) / 2.0

float ce_iv_d1 = math.max(0.0, spot_r1 - ce_strike)
float pe_iv_d1 = math.max(0.0, pe_strike - spot_r1)
float avg_iv_d1 = (ce_iv_d1 + pe_iv_d1) / 2.0

float ce_iv_d2 = math.max(0.0, spot_r2 - ce_strike)
float pe_iv_d2 = math.max(0.0, pe_strike - spot_r2)
float avg_iv_d2 = (ce_iv_d2 + pe_iv_d2) / 2.0

float ce_iv_d3 = math.max(0.0, spot_r3 - ce_strike)
float pe_iv_d3 = math.max(0.0, pe_strike - spot_r3)
float avg_iv_d3 = (ce_iv_d3 + pe_iv_d3) / 2.0

float ce_iv_d4 = math.max(0.0, spot_r4 - ce_strike)
float pe_iv_d4 = math.max(0.0, pe_strike - spot_r4)
float avg_iv_d4 = (ce_iv_d4 + pe_iv_d4) / 2.0

// ==========================================
// 2. TIME VALUE CALCULATIONS (Option Price - Intrinsic Value OR Strike - Intrinsic Value)
// ==========================================

// Realtime Time Values (Live)
float ce_tv_rt  = timeValueFormulaInput == TimeValueFormula.standard ? (ce_ltp - ce_iv_rt) : (ce_strike - ce_iv_rt)
float pe_tv_rt  = timeValueFormulaInput == TimeValueFormula.standard ? (pe_ltp - pe_iv_rt) : (pe_strike - pe_iv_rt)
float avg_tv_rt = (ce_tv_rt + pe_tv_rt) / 2.0

// 5-Day Static Time Values (Day 0 to Day 4)
float ce_tv_d0 = timeValueFormulaInput == TimeValueFormula.standard ? (ce_r0 - ce_iv_d0) : (ce_strike - ce_iv_d0)
float pe_tv_d0 = timeValueFormulaInput == TimeValueFormula.standard ? (pe_r0 - pe_iv_d0) : (pe_strike - pe_iv_d0)
float avg_tv_d0 = (ce_tv_d0 + pe_tv_d0) / 2.0

float ce_tv_d1 = timeValueFormulaInput == TimeValueFormula.standard ? (ce_r1 - ce_iv_d1) : (ce_strike - ce_iv_d1)
float pe_tv_d1 = timeValueFormulaInput == TimeValueFormula.standard ? (pe_r1 - pe_iv_d1) : (pe_strike - pe_iv_d1)
float avg_tv_d1 = (ce_tv_d1 + pe_tv_d1) / 2.0

float ce_tv_d2 = timeValueFormulaInput == TimeValueFormula.standard ? (ce_r2 - ce_iv_d2) : (ce_strike - ce_iv_d2)
float pe_tv_d2 = timeValueFormulaInput == TimeValueFormula.standard ? (pe_r2 - pe_iv_d2) : (pe_strike - pe_iv_d2)
float avg_tv_d2 = (ce_tv_d2 + pe_tv_d2) / 2.0

float ce_tv_d3 = timeValueFormulaInput == TimeValueFormula.standard ? (ce_r3 - ce_iv_d3) : (ce_strike - ce_iv_d3)
float pe_tv_d3 = timeValueFormulaInput == TimeValueFormula.standard ? (pe_r3 - pe_iv_d3) : (pe_strike - pe_iv_d3)
float avg_tv_d3 = (ce_tv_d3 + pe_tv_d3) / 2.0

float ce_tv_d4 = timeValueFormulaInput == TimeValueFormula.standard ? (ce_r4 - ce_iv_d4) : (ce_strike - ce_iv_d4)
float pe_tv_d4 = timeValueFormulaInput == TimeValueFormula.standard ? (pe_r4 - pe_iv_d4) : (pe_strike - pe_iv_d4)
float avg_tv_d4 = (ce_tv_d4 + pe_tv_d4) / 2.0

// ==========================================
// 3. 5-DAY BEP CALCULATIONS: (CE + PE) / 2.0
// ==========================================

float bep_stat_d0 = (ce_r0 + pe_r0) / 2.0
float bep_stat_d1 = (ce_r1 + pe_r1) / 2.0
float bep_stat_d2 = (ce_r2 + pe_r2) / 2.0
float bep_stat_d3 = (ce_r3 + pe_r3) / 2.0
float bep_stat_d4 = (ce_r4 + pe_r4) / 2.0

// ==========================================
// PER-BAR DAILY STATIC REFERENCE SERIES
// ==========================================

float bar_spot_ref = staticBasisInput == StaticBasis.prevClose ? request.security(spotTicker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true) : request.security(spotTicker, "D", open[0], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
float bar_ce_ref   = staticBasisInput == StaticBasis.prevClose ? request.security(ce_ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true) : request.security(ce_ticker, "D", open[0], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
float bar_pe_ref   = staticBasisInput == StaticBasis.prevClose ? request.security(pe_ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true) : request.security(pe_ticker, "D", open[0], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

float bar_ce_iv_stat  = math.max(0.0, bar_spot_ref - ce_strike)
float bar_pe_iv_stat  = math.max(0.0, pe_strike - bar_spot_ref)
float bar_avg_iv_stat = (bar_ce_iv_stat + bar_pe_iv_stat) / 2.0

float bar_ce_tv_stat  = timeValueFormulaInput == TimeValueFormula.standard ? (bar_ce_ref - bar_ce_iv_stat) : (ce_strike - bar_ce_iv_stat)
float bar_pe_tv_stat  = timeValueFormulaInput == TimeValueFormula.standard ? (bar_pe_ref - bar_pe_iv_stat) : (pe_strike - bar_pe_iv_stat)
float bar_avg_tv_stat = (bar_ce_tv_stat + bar_pe_tv_stat) / 2.0

float bar_bep_stat    = (bar_ce_ref + bar_pe_ref) / 2.0

float bar_ce_pdc      = request.security(ce_ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
float bar_pe_pdc      = request.security(pe_ticker, "D", close[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

// ==========================================
// PLOTTING ALL METRICS (EXPOSED IN TRADINGVIEW STYLE TAB)
// ==========================================

// --- Realtime Plots ---
plot(showCE_IV_RT_Input and ce_iv_rt > 0 ? ce_iv_rt : na, "CE Realtime Intrinsic", color=#00E676, linewidth=2)
plot(showPE_IV_RT_Input and pe_iv_rt > 0 ? pe_iv_rt : na, "PE Realtime Intrinsic", color=#FF5252, linewidth=2)
plot(showAvg_IV_RT_Input and avg_iv_rt > 0 ? avg_iv_rt : na, "Avg Realtime Intrinsic", color=#FF00FF, linewidth=2)

plot(showCE_TV_RT_Input and ce_tv_rt > 0 ? ce_tv_rt : na, "CE Realtime Time Value", color=#76FF03, linewidth=2)
plot(showPE_TV_RT_Input and pe_tv_rt > 0 ? pe_tv_rt : na, "PE Realtime Time Value", color=#FF6E40, linewidth=2)
plot(showAvg_TV_RT_Input and avg_tv_rt > 0 ? avg_tv_rt : na, "Avg Realtime Time Value", color=#FFD700, linewidth=2)

// --- Static Level Plots (Exposed Directly in TradingView Style Tab) ---
plot(show5D_Static_CE_IV and bar_ce_iv_stat > 0 ? bar_ce_iv_stat : na, "CE Static Intrinsic", color=#00E676, style=plot.style_linebr)
plot(show5D_Static_PE_IV and bar_pe_iv_stat > 0 ? bar_pe_iv_stat : na, "PE Static Intrinsic", color=#FF5252, style=plot.style_linebr)
plot(show5D_Static_Avg_IV and bar_avg_iv_stat > 0 ? bar_avg_iv_stat : na, "Avg Static Intrinsic", color=#FF00FF, style=plot.style_linebr)

plot(show5D_Static_CE_TV and bar_ce_tv_stat > 0 ? bar_ce_tv_stat : na, "CE Static Time Value", color=#76FF03, style=plot.style_linebr)
plot(show5D_Static_PE_TV and bar_pe_tv_stat > 0 ? bar_pe_tv_stat : na, "PE Static Time Value", color=#FF6E40, style=plot.style_linebr)
plot(show5D_Static_Avg_TV and bar_avg_tv_stat > 0 ? bar_avg_tv_stat : na, "Avg Static Time Value", color=#FFD700, style=plot.style_linebr)

plot(show5D_Static_BEPInput and bar_bep_stat > 0 ? bar_bep_stat : na, "Static BEP", color=color.aqua, style=plot.style_linebr)

plot(showPD_CE_CloseInput and bar_ce_pdc > 0 ? bar_ce_pdc : na, "CE Prev Day Close", color=#00E676, style=plot.style_linebr)
plot(showPD_PE_CloseInput and bar_pe_pdc > 0 ? bar_pe_pdc : na, "PE Prev Day Close", color=#FF5252, style=plot.style_linebr)

// ==========================================
// BUY / SELL SIGNALS & ALERTS LOGIC
// ==========================================

// 1. Strong Buy Conditions
bool sb_pe_cond = (pe_iv_rt > 0.0) and (ce_iv_rt <= 0.0)
bool sb_ce_cond = (ce_iv_rt > 0.0) and (pe_iv_rt <= 0.0)

var bool in_sb_pe = false
var bool in_sb_ce = false

bool sb_pe_signal = false
bool sb_ce_signal = false

if sb_pe_cond and not in_sb_pe
    in_sb_pe     := true
    in_sb_ce     := false
    sb_pe_signal := true

if pe_iv_rt <= 0.0
    in_sb_pe := false

if sb_ce_cond and not in_sb_ce
    in_sb_ce     := true
    in_sb_pe     := false
    sb_ce_signal := true

if ce_iv_rt <= 0.0
    in_sb_ce := false

// 2. Crossover Buy Conditions
bool buy_pe_signal = ta.crossover(pe_iv_rt, ce_iv_rt)
bool buy_ce_signal = ta.crossover(ce_iv_rt, pe_iv_rt)

// Visual Signal Plotshapes
plotshape(showSignalPlotsInput and sb_ce_signal, title="Strong Buy CE (SB CE)", style=shape.triangleup, location=location.belowbar, color=colorSB_CE, textcolor=colorSignalTextColor, size=size.small, text="SB CE")
plotshape(showSignalPlotsInput and sb_pe_signal, title="Strong Buy PE (SB PE)", style=shape.triangledown, location=location.abovebar, color=colorSB_PE, textcolor=colorSignalTextColor, size=size.small, text="SB PE")

plotshape(showSignalPlotsInput and buy_ce_signal and not sb_ce_signal, title="Buy CE Signal", style=shape.labelup, location=location.belowbar, color=colorBuyCE, textcolor=colorSignalTextColor, size=size.tiny, text="BUY CE")
plotshape(showSignalPlotsInput and buy_pe_signal and not sb_pe_signal, title="Buy PE Signal", style=shape.labeldown, location=location.abovebar, color=colorBuyPE, textcolor=colorSignalTextColor, size=size.tiny, text="BUY PE")

// TradingView Alert Conditions
alertcondition(sb_ce_signal, title="Strong Buy CE (SB CE)", message="STRONG BUY CE: CE Realtime Intrinsic Value > 0 and PE Realtime Intrinsic Value <= 0 on {{ticker}}!")
alertcondition(sb_pe_signal, title="Strong Buy PE (SB PE)", message="STRONG BUY PE: PE Realtime Intrinsic Value > 0 and CE Realtime Intrinsic Value <= 0 on {{ticker}}!")

alertcondition(buy_ce_signal, title="Buy CE (Crossover)", message="BUY CE Signal: CE Realtime Intrinsic Value Crossed Above PE Realtime Intrinsic Value on {{ticker}}!")
alertcondition(buy_pe_signal, title="Buy PE (Crossover)", message="BUY PE Signal: PE Realtime Intrinsic Value Crossed Above CE Realtime Intrinsic Value on {{ticker}}!")

// ==========================================
// SUMMARY DASHBOARD TABLE
// ==========================================

var table summaryTable = na
if showTableInput and barstate.islast
    table.delete(summaryTable)
    
    position_choice = tablePosInput == "Top Right" ? position.top_right :
                      tablePosInput == "Top Left" ? position.top_left :
                      tablePosInput == "Bottom Right" ? position.bottom_right : position.bottom_left
                      
    t_sz = tableTextSizeInput == "Tiny" ? size.tiny :
           tableTextSizeInput == "Small" ? size.small :
           tableTextSizeInput == "Normal" ? size.normal : size.large
           
    modeTitle = strikeModeInput == StrikeMode.atm ? "ATM" : (strikeModeInput == StrikeMode.itm ? "ITM" : (strikeModeInput == StrikeMode.otm ? "OTM" : "Both ITM & OTM"))
    basisTag  = staticBasisInput == StaticBasis.prevClose ? "Prev Settlement" : (staticBasisInput == StaticBasis.first5Min ? "First 5Min Close" : "Day Open")

    if tableDisplayMode == "Today Only"
        summaryTable := table.new(position_choice, 3, 9, border_width=1, border_color=color.gray)

        // Row 0: Banner Header
        table.cell(summaryTable, 0, 0, "Asset: " + syminfo.ticker, bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
        table.cell(summaryTable, 1, 0, "CE/PE Strikes: " + str.tostring(ce_strike) + "/" + str.tostring(pe_strike) + " (" + modeTitle + ")", bgcolor=#FFEE58, text_color=color.black, text_size=t_sz)
        table.cell(summaryTable, 2, 0, "Basis: " + basisTag, bgcolor=#1565C0, text_color=color.white, text_size=t_sz)

        // Row 1: Header Titles
        table.cell(summaryTable, 0, 1, "Metric", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
        table.cell(summaryTable, 1, 1, "Today Static (" + basisTag + ")", bgcolor=#37474F, text_color=color.yellow, text_size=t_sz)
        table.cell(summaryTable, 2, 1, "Realtime LTP", bgcolor=#37474F, text_color=color.orange, text_size=t_sz)

        // Rows 2-4: Intrinsic Values
        f_fill_today_row(summaryTable, 2, "CE Static Intrinsic (" + str.tostring(ce_strike) + ")", ce_iv_d0, ce_iv_rt, t_sz)
        f_fill_today_row(summaryTable, 3, "PE Static Intrinsic (" + str.tostring(pe_strike) + ")", pe_iv_d0, pe_iv_rt, t_sz)
        f_fill_today_row(summaryTable, 4, "Avg Static Intrinsic", avg_iv_d0, avg_iv_rt, t_sz)

        // Rows 5-7: Static Time Values
        f_fill_today_row(summaryTable, 5, "CE Static Time Value (" + str.tostring(ce_strike) + ")", ce_tv_d0, ce_tv_rt, t_sz)
        f_fill_today_row(summaryTable, 6, "PE Static Time Value (" + str.tostring(pe_strike) + ")", pe_tv_d0, pe_tv_rt, t_sz)
        f_fill_today_row(summaryTable, 7, "Avg Static Time Value", avg_tv_d0, avg_tv_rt, t_sz)

        // Row 8: Static BEP
        f_fill_today_row(summaryTable, 8, "Static BEP", bep_stat_d0, na, t_sz)
    else
        summaryTable := table.new(position_choice, 8, 9, border_width=1, border_color=color.gray)

        // Row 0: Banner Header
        table.cell(summaryTable, 0, 0, "Asset: " + syminfo.ticker, bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
        table.cell(summaryTable, 1, 0, "CE/PE Strikes: " + str.tostring(ce_strike) + "/" + str.tostring(pe_strike) + " (" + modeTitle + ")", bgcolor=#FFEE58, text_color=color.black, text_size=t_sz)
        string offsetDisplay = strikeModeInput == StrikeMode.atm ? "0 (ATM)" : str.tostring(offsetPts) + " pts (" + modeTitle + ")"
        table.cell(summaryTable, 2, 0, "Offset: " + offsetDisplay, bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
        table.cell(summaryTable, 3, 0, "Basis: " + basisTag, bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
        table.cell(summaryTable, 4, 0, "5-Day Analytics Matrix", bgcolor=#1565C0, text_color=color.white, text_size=t_sz)
        table.cell(summaryTable, 5, 0, "", bgcolor=#1565C0)
        table.cell(summaryTable, 6, 0, "", bgcolor=#1565C0)
        table.cell(summaryTable, 7, 0, "", bgcolor=#1565C0)

        // Row 1: Dates Header
        table.cell(summaryTable, 0, 1, "Metric (" + basisTag + ")", bgcolor=#37474F, text_color=color.white, text_size=t_sz)
        table.cell(summaryTable, 1, 1, date0_str + " (Today)", bgcolor=#37474F, text_color=color.yellow, text_size=t_sz)
        table.cell(summaryTable, 2, 1, date1_str, bgcolor=#37474F, text_color=color.white, text_size=t_sz)
        table.cell(summaryTable, 3, 1, date2_str, bgcolor=#37474F, text_color=color.white, text_size=t_sz)
        table.cell(summaryTable, 4, 1, date3_str, bgcolor=#37474F, text_color=color.white, text_size=t_sz)
        table.cell(summaryTable, 5, 1, date4_str, bgcolor=#37474F, text_color=color.white, text_size=t_sz)
        table.cell(summaryTable, 6, 1, "5-Day Avg", bgcolor=#37474F, text_color=color.aqua, text_size=t_sz)
        table.cell(summaryTable, 7, 1, "Realtime LTP", bgcolor=#37474F, text_color=color.orange, text_size=t_sz)

        // Rows 2-4: Intrinsic Values
        f_fill_matrix_row(summaryTable, 2, "CE Static Intrinsic (" + str.tostring(ce_strike) + ")", ce_iv_d0, ce_iv_d1, ce_iv_d2, ce_iv_d3, ce_iv_d4, ce_iv_rt, t_sz)
        f_fill_matrix_row(summaryTable, 3, "PE Static Intrinsic (" + str.tostring(pe_strike) + ")", pe_iv_d0, pe_iv_d1, pe_iv_d2, pe_iv_d3, pe_iv_d4, pe_iv_rt, t_sz)
        f_fill_matrix_row(summaryTable, 4, "Avg Static Intrinsic", avg_iv_d0, avg_iv_d1, avg_iv_d2, avg_iv_d3, avg_iv_d4, avg_iv_rt, t_sz)

        // Rows 5-7: Static Time Values
        f_fill_matrix_row(summaryTable, 5, "CE Static Time Value (" + str.tostring(ce_strike) + ")", ce_tv_d0, ce_tv_d1, ce_tv_d2, ce_tv_d3, ce_tv_d4, ce_tv_rt, t_sz)
        f_fill_matrix_row(summaryTable, 6, "PE Static Time Value (" + str.tostring(pe_strike) + ")", pe_tv_d0, pe_tv_d1, pe_tv_d2, pe_tv_d3, pe_tv_d4, pe_tv_rt, t_sz)
        f_fill_matrix_row(summaryTable, 7, "Avg Static Time Value", avg_tv_d0, avg_tv_d1, avg_tv_d2, avg_tv_d3, avg_tv_d4, avg_tv_rt, t_sz)

        // Row 8: Static BEP
        f_fill_matrix_row(summaryTable, 8, "Static BEP", bep_stat_d0, bep_stat_d1, bep_stat_d2, bep_stat_d3, bep_stat_d4, na, t_sz)
